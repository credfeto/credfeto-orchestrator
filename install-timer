#!/bin/bash

# Installs a systemd system-level service and timer that runs the orchestrator
# on a fixed interval as the current user, even when the user is not logged in.

# How often the timer fires.  Override with ORCHESTRATOR_TIMER_INTERVAL in the
# environment before running install-timer; any value accepted by systemd's
# OnUnitActiveSec is valid (e.g. "30sec", "1min", "5min").
ORCHESTRATOR_TIMER_INTERVAL="${ORCHESTRATOR_TIMER_INTERVAL:-30sec}"

# Upper bound on how long the ExecStartPre steps plus oneshot itself may run before systemd
# kills the unit and reports it failed. Type=oneshot has NO start timeout by default (infinity),
# so a single network hang anywhere in the unit — e.g. the self-update git fetch below — would
# otherwise leave the service permanently "activating" and the timer would never fire again,
# silently stopping the orchestrator until a human notices and manually intervenes (#1098). Set
# comfortably above oneshot's own AGENT_TIMEOUT_MINUTES (default 90) to leave margin for the
# self-update and agent-startup steps. Override with ORCHESTRATOR_TIMEOUT_START_SEC.
ORCHESTRATOR_TIMEOUT_START_SEC="${ORCHESTRATOR_TIMEOUT_START_SEC:-6300}"

# Grace period for ExecStop (removing the agent container) before systemd SIGKILLs the unit on
# shutdown. Kept short: this only has to outlast a `podman rm -f`, and a long stop timeout
# delays every reboot. Too short and the SIGKILL re-creates the very orphan this is preventing
# (#1361). Override with ORCHESTRATOR_TIMEOUT_STOP_SEC.
ORCHESTRATOR_TIMEOUT_STOP_SEC="${ORCHESTRATOR_TIMEOUT_STOP_SEC:-90}"

# Start rate limiting: more than ORCHESTRATOR_START_LIMIT_BURST starts within
# ORCHESTRATOR_START_LIMIT_INTERVAL_SEC leaves the unit failed until `systemctl reset-failed`.
# Sized against the timer interval (default 30sec): 10 failures in 15 minutes means a genuinely
# wedged service is stopped within ~5 minutes rather than retrying ~3,000 times over 19.5 hours
# (#1361), while staying far above any plausible rate of isolated, self-recovering failures.
# Override with ORCHESTRATOR_START_LIMIT_BURST / ORCHESTRATOR_START_LIMIT_INTERVAL_SEC.
ORCHESTRATOR_START_LIMIT_INTERVAL_SEC="${ORCHESTRATOR_START_LIMIT_INTERVAL_SEC:-900}"
ORCHESTRATOR_START_LIMIT_BURST="${ORCHESTRATOR_START_LIMIT_BURST:-10}"

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\n\033[32m✓\033[0m %s\n' "$*"
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

is_ai_agent() {
    [ "${CLAUDECODE}" = "1" ]
}

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

case "${REPO_DIR}" in
    *$'\n'*) die "install-timer: REPO_DIR contains a newline; aborting." ;;
esac

CURRENT_USER=$(id -un)
case "${CURRENT_USER}" in
    *$'\n'*) die "install-timer: CURRENT_USER contains a newline; aborting." ;;
esac
[[ "${CURRENT_USER}" =~ ^[a-zA-Z0-9._-]+$ ]] || die "install-timer: CURRENT_USER contains invalid characters; aborting."
SERVICE_NAME="credfeto-orchestrator-${CURRENT_USER}"
[[ "${SERVICE_NAME}" =~ ^[a-zA-Z0-9._-]+$ ]] || die "install-timer: SERVICE_NAME contains unsafe characters: ${SERVICE_NAME}"
UNIT_DIR="/etc/systemd/system"

check_required_tools() {
    local tool
    for tool in id sudo systemctl git; do
        command -v "${tool}" >/dev/null 2>&1 || die "Required tool not found: ${tool}"
    done
}

# Writes content to dest via sudo tee.
write_unit_file() {
    local dest="$1"
    local content="$2"
    printf '%s\n' "${content}" | sudo tee "${dest}" > /dev/null || die "Failed to write ${dest}"
}

create_service_unit() {
    local owner_filter="${1:-}"
    local dest="${UNIT_DIR}/${SERVICE_NAME}.service"
    local exec_start="${REPO_DIR}/oneshot"
    [ -n "${owner_filter}" ] && exec_start="${exec_start} --owner ${owner_filter}"
    # RuntimeDirectory creates /run/<name>/ owned by User= before the service
    # starts, providing an isolated location for the ssh-agent socket.
    # XDG_RUNTIME_DIR must point to the user's real session dir (/run/user/<uid>)
    # so that Podman stores container state there instead of a root-owned path.
    # containers.conf sets cgroup_manager=cgroupfs; the systemd manager requires
    # D-Bus access that is denied for non-root users in system services.
    local runtime_dir="${SERVICE_NAME}"
    local ssh_socket="/run/${runtime_dir}/ssh-agent.socket"
    local owner_uid
    owner_uid=$(id -u) || die "Failed to get UID for ${CURRENT_USER}"
    local content
    content="[Unit]
Description=Credfeto Orchestrator for ${CURRENT_USER}
After=network-online.target
Wants=network-online.target
# Fire the failure-notifier unit whenever this one enters the failed state. This is the ONLY
# alerting path that survives oneshot being too broken to report on itself: it runs as a
# separate unit, so it works when oneshot dies before (or instead of) reaching its own
# notify_discord_* calls. A stale podman name reservation after a host reboot made every
# invocation fail at \`podman run\` for 19.5 hours with no alert whatsoever (#1361).
OnFailure=${SERVICE_NAME}-failure.service
# Stop retrying a wedged service forever. Without this the unit re-ran every ~30s for ~3,000
# consecutive failures, burning host resources and drowning the journal, with nothing ever
# escalating. Exceeding the burst leaves the unit failed (which fires OnFailure= above) until
# a human runs 'systemctl reset-failed' — deliberately \"stop and shout\" rather than
# \"retry silently forever\". Paired with OnFailure=: rate limiting without alerting would
# just be a quieter outage.
StartLimitIntervalSec=${ORCHESTRATOR_START_LIMIT_INTERVAL_SEC}
StartLimitBurst=${ORCHESTRATOR_START_LIMIT_BURST}

[Service]
Type=oneshot
# See ORCHESTRATOR_TIMEOUT_START_SEC above: without this, a hung ExecStartPre step never times
# out and the timer stops firing forever (#1098).
TimeoutStartSec=${ORCHESTRATOR_TIMEOUT_START_SEC}
User=${CURRENT_USER}
RuntimeDirectory=${runtime_dir}
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Delegate=cpu memory pids io grants this service ownership of its cgroup
# subtree so the process can manage subtree_control and child cgroups.  For
# Type=oneshot, systemd does NOT write subtree_control automatically; oneshot
# moves itself to a leaf sub-cgroup then writes the controllers itself so
# container sub-cgroups get pids.max, memory.max etc.  plain Delegate=yes
# grants no specific controllers so the write would be rejected.
Delegate=cpu memory pids io
# XDG_RUNTIME_DIR must be the real user session dir so Podman uses the correct
# runtime state directory for the owner's session.
# DBUS_SESSION_BUS_ADDRESS points at the user session bus; not required for
# cgroupfs but ensures other D-Bus Podman operations find the right socket.
# SSH_AUTH_SOCK is set separately so the ssh-agent socket stays isolated in
# RuntimeDirectory.
Environment=XDG_RUNTIME_DIR=/run/user/${owner_uid}
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${owner_uid}/bus
Environment=SSH_AUTH_SOCK=${ssh_socket}
# Declared explicitly, rather than relying on systemd's generic INVOCATION_ID, so oneshot's
# self-update staleness check (#1298) has an unambiguous, unit-specific signal that the
# ExecStartPre self-update below actually ran immediately before it — INVOCATION_ID is set for
# ANY systemd unit's main process, including a manual shell that happens to be a descendant of an
# unrelated systemd --user session, which would otherwise wrongly gate a manual/interactive run.
Environment=ORCHESTRATOR_SELF_UPDATE_MANAGED=1
WorkingDirectory=${REPO_DIR}
# A root-run diagnostic command against REPO_DIR (e.g. a bare 'sudo git ... status', whose optional
# index-refresh side effect reowns .git/index to root) can leave files under REPO_DIR owned by
# someone other than ${CURRENT_USER}, which then makes the self-update merge below fail with
# \"index file open failed: Permission denied\" (#1300) and the unit reports failed indefinitely
# until a human notices and manually re-runs setup-owner. Mirrors setup-owner's clone_or_pull_repo
# detect-then-chown pattern so this automatic self-update path self-heals the same way the manual
# one already does (#1302). ExecStartPre steps run as User=${CURRENT_USER} by default, so only the
# '+' prefix lets this step run with the privilege needed to chown files it doesn't own; it is also
# '-'-prefixed (tolerate failure) so a chown failure, e.g. racing a sibling --owner unit's
# concurrent operation on this same shared checkout, as already called out for setup-owner (#1300
# review), does not stop the unit: the fetch/merge immediately after remains the real gate and
# fails clearly if ownership is still broken. The find is detect-before-write, same as setup-owner:
# a healthy checkout is never chowned, so a healed checkout stays distinguishable from one that was
# never broken. setup-owner groups both checks with a \( -o \) so a single walk stops at the first
# match either way; that grouping would need backslash-escaped parentheses here, and systemd's own
# Exec line parser applies its own escape-sequence handling before /bin/sh ever sees the string,
# which has changed across systemd versions for escapes it does not recognise (e.g.
# systemd/systemd#4697). Repeating '-print -quit' on each side of -o instead keeps the same single
# tree walk without needing parentheses at all: -o's lower precedence still lets the first branch
# whose test matches print and stop the walk, so it costs no more than the grouped form.
ExecStartPre=+-/bin/sh -c '[ -z \"\$(/usr/bin/find \"${REPO_DIR}\" -not -user ${CURRENT_USER} -print -quit -o -not -group ${CURRENT_USER} -print -quit 2>/dev/null)\" ] || /usr/bin/chown -R ${CURRENT_USER}:${CURRENT_USER} \"${REPO_DIR}\"'
# Both self-update steps are '-'-prefixed (tolerate failure) and timeout-wrapped: a stalled or
# unreachable git remote must not block the run, and a diverged/dirty checkout must not stop the
# orchestrator from running with whatever was last successfully pulled (#1098). Genuine repo
# corruption still surfaces via oneshot's own git error handling once it starts. The merge step
# retries once, clearing any stale *.lock file anywhere under .git first, if the first attempt
# fails — a lock left by a previous merge killed mid-write (e.g. by this same timeout) otherwise
# wedges every subsequent merge identically, forever, since git never clears a stale lock on its
# own (#1298). A merge killed while updating the branch ref leaves its lock at
# .git/refs/heads/<branch>.lock, not directly under .git/, so this must search recursively rather
# than glob only the top level. Deletion is age-gated (-mmin +1, comfortably above this step's own
# 30-second timeout): REPO_DIR is the SAME checkout for every --owner variant installed for this
# user, so an unconditional delete could remove a lock a DIFFERENT concurrently-running unit's
# merge is still legitimately holding, not just one left by a killed process — the age gate is
# what tells a genuinely stale lock (older than any merge this step could still be running) apart
# from a sibling unit's merge being in flight right now (#1298 review). oneshot's own
# git_commits_behind check (lib/git) is the backstop if even the retry does not converge.
ExecStartPre=-/usr/bin/timeout 60 /usr/bin/git -C \"${REPO_DIR}\" fetch origin
ExecStartPre=-/usr/bin/timeout 30 /bin/sh -c 'git -C \"${REPO_DIR}\" merge --ff-only origin/main || { find \"${REPO_DIR}\"/.git -name \"*.lock\" -mmin +1 -delete; git -C \"${REPO_DIR}\" merge --ff-only origin/main; }'
# -f scopes this to the ssh-agent bound to THIS instance's own socket, not every ssh-agent
# belonging to this user — an unscoped 'pkill -u <user> ssh-agent' kills the agent of any other
# concurrently-running instance (--owner variants share the same User=) or interactive session
# for this user (#1098).
ExecStartPre=-/usr/bin/pkill -u ${CURRENT_USER} -f \"ssh-agent -a ${ssh_socket}\"
ExecStartPre=-/usr/bin/rm -f ${ssh_socket}
ExecStartPre=/usr/bin/ssh-agent -a ${ssh_socket}
# All paths below must be absolute. The %h specifier expands to the home of
# the user that launched systemd (root), not the service User= home directory.
ExecStartPre=-/usr/bin/pkill -u ${CURRENT_USER} gpg-agent
ExecStartPre=/usr/bin/gpgconf --launch gpg-agent
# 0660 = owner + group only. The container gains the owner's primary GID via
# --group-add in oneshot so the developer user can connect without world access.
# Use gpgconf to find the socket path dynamically: with loginctl enable-linger
# the socket lives under XDG_RUNTIME_DIR, not ~/.gnupg.
ExecStartPre=/bin/sh -c '/usr/bin/chmod 0660 \$(/usr/bin/gpgconf --list-dirs agent-extra-socket)'
ExecStart=${exec_start}
# Remove the agent container on the way down so a shutdown cannot strand it (#1361). The
# originating incident was a host reboot whose shutdown completed in under a minute: the running
# container was SIGKILLed mid---rm-teardown, which desynced podman's two layers and left the
# container NAME reserved in containers/storage with no libpod record, wedging every subsequent
# run. '-' prefixes tolerate failure (nothing to remove is the normal case, and a failing
# ExecStop must never block shutdown). KillMode=mixed sends SIGTERM to the main process only,
# giving oneshot and podman a chance to tear down cleanly instead of every process in the cgroup
# being killed at once. TimeoutStopSec bounds that grace period so a hung teardown cannot delay
# shutdown indefinitely.
ExecStop=-/usr/bin/podman rm -f orchestrator-${CURRENT_USER}
KillMode=mixed
TimeoutStopSec=${ORCHESTRATOR_TIMEOUT_STOP_SEC}
# Security hardening — limit the blast radius if the service is compromised.
# PrivateTmp is deliberately NOT set: rootless Podman keeps a long-lived pause
# process that holds the namespace it is first created in, and under PrivateTmp the
# private (empty) /var/tmp leaks into that persistent process, breaking every later
# image pull with \"mkdir /var/tmp/...: no such file or directory\". The agent runs
# in a container with its own filesystem, so PrivateTmp adds little isolation here.
# ProtectSystem=full makes /usr, /boot, and /etc read-only; the home directory
# and /dev remain writable (rootless Podman needs /dev/fuse for fuse-overlayfs).
# CapabilityBoundingSet is restricted to CAP_SETUID/CAP_SETGID — the only caps
# rootless Podman needs: its setuid helpers newuidmap/newgidmap require them to
# map the owner subuid/subgid ranges. An empty set (or dropping these) masks the
# file capabilities on those helper binaries, breaking container start with
# \"newuidmap: Could not set caps\". AmbientCapabilities stays empty so the
# long-running service process itself holds no capabilities — newuidmap gains
# CAP_SETUID transiently from its own file caps for the moment it runs.
# NoNewPrivileges must stay off: with it on, the kernel ignores the newuidmap
# file capabilities on exec, which also breaks the userns setup. Granting the
# caps ambiently instead would let the host-namespace process setuid(0) to root,
# a far worse posture than re-enabling setuid binaries for this unprivileged,
# no-sudo user.
# LockPersonality prevents changing the execution domain (e.g. via personality(2)).
# MemoryDenyWriteExecute=no is explicit: containers and JIT compilers need pages
# that are both writable and executable, so this restriction must remain off.
NoNewPrivileges=no
ProtectSystem=full
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=no"
    write_unit_file "${dest}" "${content}"
}

# The unit referenced by the service's OnFailure=. Runs as a SEPARATE unit so it still fires
# when the orchestrator itself is too broken to report anything - which is exactly the case
# this exists for (#1361). Deliberately minimal: no ExecStartPre self-update, no ssh/gpg agent
# setup, no Delegate=, nothing that could itself fail while trying to report a failure.
create_failure_unit() {
    local dest="${UNIT_DIR}/${SERVICE_NAME}-failure.service"
    local content
    content="[Unit]
Description=Report failure of ${SERVICE_NAME}.service to Discord

[Service]
Type=oneshot
User=${CURRENT_USER}
# No OnFailure= here: if reporting a failure itself fails there is nothing further to escalate
# to, and a unit that triggered itself on failure would loop.
ExecStart=${REPO_DIR}/notify-unit-failure ${SERVICE_NAME}.service"
    write_unit_file "${dest}" "${content}"
}

create_timer_unit() {
    local dest="${UNIT_DIR}/${SERVICE_NAME}.timer"
    local content
    content="[Unit]
Description=Credfeto Orchestrator Timer for ${CURRENT_USER}

[Timer]
OnBootSec=${ORCHESTRATOR_TIMER_INTERVAL}
OnUnitActiveSec=${ORCHESTRATOR_TIMER_INTERVAL}
Unit=${SERVICE_NAME}.service

[Install]
WantedBy=timers.target"
    write_unit_file "${dest}" "${content}"
}

main() {
    local owner_filter=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --owner)
                shift
                [ -n "${1:-}" ] || die "--owner requires a value"
                [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] \
                    || die "--owner value contains invalid characters: $1"
                owner_filter="$1"
                shift
                ;;
            *)
                die "Unknown argument: $1"
                ;;
        esac
    done

    [ "$(id -u)" -ne 0 ] || die "install-timer must not be run as root — run as yourself; it uses sudo internally"
    is_ai_agent && die "install-timer must not be run inside a Claude Code session"

    check_required_tools

    if [ -n "${owner_filter}" ]; then
        SERVICE_NAME="${SERVICE_NAME}-${owner_filter}"
        [[ "${SERVICE_NAME}" =~ ^[a-zA-Z0-9._-]+$ ]] \
            || die "install-timer: resulting SERVICE_NAME contains unsafe characters: ${SERVICE_NAME}"
    fi

    info "Installing Credfeto Orchestrator systemd timer for user ${CURRENT_USER}..."
    info "Repository: ${REPO_DIR}"

    create_service_unit "${owner_filter}"
    info "Service unit written to ${UNIT_DIR}/${SERVICE_NAME}.service"

    create_failure_unit
    info "Failure-notifier unit written to ${UNIT_DIR}/${SERVICE_NAME}-failure.service"

    create_timer_unit
    info "Timer unit written to ${UNIT_DIR}/${SERVICE_NAME}.timer"

    info "Reloading systemd daemon..."
    sudo systemctl daemon-reload || die "Failed to reload systemd daemon"

    info "Enabling ${SERVICE_NAME}.timer..."
    sudo systemctl enable "${SERVICE_NAME}.timer" || die "Failed to enable ${SERVICE_NAME}.timer"

    info "Starting ${SERVICE_NAME}.timer..."
    sudo systemctl start "${SERVICE_NAME}.timer" || die "Failed to start ${SERVICE_NAME}.timer"

    success "Credfeto Orchestrator timer installed and started for user ${CURRENT_USER}"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
