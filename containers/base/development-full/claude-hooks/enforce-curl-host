#!/usr/bin/env bash
# Blocks curl from reaching a fixed set of destination hosts, matching this repo's own
# claude-settings.json WebFetch(domain:...) deny entries: api.github.com, github.com,
# registry.npmjs.org, raw.githubusercontent.com, api.nuget.org. Exit 2 = blocked, 0 = allowed.
#
# curl is on claude-settings.json's blanket Bash(curl *) permissions.allow, and its danger
# is in the *destination*, not the verb - a permissions.allow prefix pattern cannot express
# "except this host" (see issue #1318, split from #1315). Unlike enforce-ssh-host-and-key's
# positive host *allowlist* (ssh's own use in this repo is narrow and fixed-form: exactly
# `ssh user@host.lan command`), curl is legitimately used here with many flags and dynamic
# header/token values, so this hook is a destination *denylist* instead: reuse the same small
# set of domains already denied to WebFetch, rather than inventing a broader curl-specific
# allowlist policy. Deliberately does not restrict outbound-data flags (-d/--data/-T/
# --upload-file) or any other flag beyond the ones named below - narrower in scope than
# enforce-ssh-host-and-key on purpose, per #1318's resolution.
#
# wget is not covered by this hook at all: it has zero real usage anywhere in this repo's
# own scripts/Dockerfiles/instructions (confirmed on #1318 itself), so it was removed
# entirely - from command-allowlist and permissions.allow - rather than given a matching
# hook, the same treatment scp got from #1315/enforce-ssh-host-and-key. wget is simply not
# on command-allowlist any more, so reject-obfuscated-commands blocks it outright before
# any hook would ever see it.
#
# Every non-flag literal word (does not start with '-') in a curl call is checked as a
# potential URL/host argument, regardless of which preceding flag (if any) it belongs to,
# EXCEPT the word immediately following a known value-taking flag (VALUE_FLAGS below, e.g.
# -o/--output, -H/--header, -d/--data, ...), which is skipped entirely - a filename, header,
# or token value is otherwise exceedingly unlikely to collide with one of the five denied
# host strings exactly (host matching is exact-match on the host component only, not a
# substring test), but a plain output filename that happens to equal one of them (e.g.
# `curl -o github.com https://example.com`) would be a false positive without this skip
# (confirmed live during review). --url's explicit form is covered two ways: as a separate
# word (`--url <value>`, the value is itself a non-flag word checked normally) and as a
# glued word (`--url=<value>`, handled explicitly below since the whole word otherwise starts
# with '-' and would never reach the host check).
#
# A non-literal (substitution/expansion) word in a position that isn't a recognised flag name
# is NOT failed closed here, unlike ssh's target position: curl is routinely called in this
# repo with dynamic Authorization headers, tokens, and URLs ($GH_TOKEN, $NUGET_TOKEN, $URL,
# ...), and a blanket non-literal-argument block would make ordinary curl calls unusable.
# This is a deliberate, narrower scope than enforce-ssh-host-and-key's fail-closed target-word
# check, matching #1318's resolution to restrict destinations, not harden every possible
# dynamic-value bypass - accepted as a residual gap for a non-literal word that could itself
# evaluate to a bypass flag (e.g. --config="$X") rather than a value, tracked in #1461 rather
# than closed here, since closing it would mean failing closed on every dynamic curl argument
# at all, not just this narrow case, re-opening the exact usability trade-off #1318 already
# decided against.
#
# A literal word anywhere in the call containing a brace/tilde/glob/backslash character
# (`{`, `}`, `~`, `*`, `?`, `[`, `]`, `\`) is blocked outright, applied uniformly rather than
# only to specific positions: shfmt's static AST does not perform brace expansion (or
# tilde/glob expansion, which only resolves against the filesystem at runtime), so a single
# literal word like `https://api.github.com{,}` or `{-K,cfg.txt}` is exactly what this hook
# sees, while real bash expands either into two argv words at runtime (confirmed live) - the
# first hiding a denied host from the check below, the second hiding a bypass flag from the
# check after it. Same defence enforce-ssh-host-and-key already applies to its own
# single-word check, broadened here to every word since curl's grammar has no single fixed
# "the interesting word is here" position the way ssh's does.
#
# Combined short options (e.g. `-sK` meaning `-s -K`) are blocked outright too, UNLESS the
# whole cluster exactly matches one of SAFE_CLUSTERS (`fsSL`, `sf` - confirmed via a repo-wide
# grep as the only combined clusters actually used here, and both composed entirely of
# no-value flags, so there's no glued-value ambiguity in either). Resolving an arbitrary
# combined cluster correctly (which flags take a value, and therefore consume the remaining
# characters or the next word) needs real curl getopt awareness this hook does not implement;
# rather than build that, any cluster outside the two confirmed-safe spellings is rejected,
# same "positive allowlist over exhaustive classification" choice enforce-ssh-host-and-key's
# header explains for its own target charset. Accepted trade-off: a glued alpha-only value for
# a value-taking flag (e.g. `-oresult`, no separate word) is indistinguishable from an unsafe
# cluster by this same check and is blocked too - a false positive (this repo's own curl usage
# always gives -o's value as a separate word, confirmed via repo-wide grep), not a bypass, so
# left as-is rather than adding more special-casing for a pattern with no real usage here.
#
# -K/--config and --connect-to are blocked outright whenever present (regardless of any
# denied host elsewhere in the same call): a curl config file can set `url = <host>` (and any
# other option) with content this hook cannot see or parse, making the literal-word host scan
# below moot for -K/--config, and --connect-to can redirect the real TCP destination to a
# different host than the one written in the URL argument
# (`curl --connect-to safe.example:443:api.github.com:443 https://safe.example/` actually
# connects to api.github.com while every literal word in the command still reads
# "safe.example", confirmed live) - both are concrete bypasses of the literal-word host match,
# not generic hardening, so they're in scope even though outbound-data flags are not. -x/
# --proxy is blocked outright for the identical reason: curl connects to the proxy address,
# not to the host named in the URL (confirmed live), the same destination-redirection threat
# class as --connect-to.
#
# Uses the same shfmt-parsed AST approach and base64-per-word transport as
# enforce-ssh-host-and-key, for the same reasons documented in that hook's own header (a
# tab/newline-joined transport can be desynced by a real tab/newline byte inside a
# legitimately quoted word). Fails closed on missing jq/shfmt or an unparseable command.

export LC_ALL=C

block() {
  printf 'Blocked (command did not run - fix and retry, do not wait for it): %s\n' "$1" >&2
  exit 2
}

# Same list as enforce-ssh-host-and-key, duplicated rather than shared - every hook in this
# family is a standalone, independently-deployed script (see that hook's own header). Only
# checks the fixed positions immediately after word 0 (see `positions` below), so a wrapper
# invoked with its own leading argument (`timeout 30 curl ...`, `env FOO=bar curl ...`) or
# stacked wrappers (`sudo timeout curl ...`) would put `curl` past where this hook looks -
# a known, pre-existing, shared limitation across this hook family, tracked in #1320 rather
# than fixed per-hook. Currently not a live gap in practice: every name in this list is also
# in command-blocklist, which reject-obfuscated-commands (running before this hook in the
# PreToolUse chain) rejects outright regardless of position or arguments, so none of these
# wrapper forms reach this hook in the first place today - confirmed live. If a name were ever
# removed from command-blocklist without a matching fix here, this hook's own wrapper handling
# would silently stop being sufficient on its own.
WRAPPERS=(env nice command sudo doas exec nohup stdbuf builtin setsid timeout ionice taskset chroot nsenter flock watch time)

is_wrapper() {
  local w
  for w in "${WRAPPERS[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

MARKER='(non-literal)'

# Reused verbatim from claude-settings.json's WebFetch(domain:...) deny entries. Kept in sync
# with that file by test/enforce-curl-host.bats's own parity test, mirroring how
# test/command-allowlist-parity.bats already keeps command-allowlist and permissions.allow
# from drifting apart.
DENIED_HOSTS=(api.github.com github.com registry.npmjs.org raw.githubusercontent.com api.nuget.org)

# Flags whose immediate next word is an opaque value (filename, header, token, ...), never a
# host or a flag - skipped entirely rather than checked. Deliberately scoped to the flags this
# repo's own curl usage and general common practice actually use with a separate value word
# (confirmed via a repo-wide grep for -o specifically); not an exhaustive list of every
# value-taking curl option.
VALUE_FLAGS=(-o --output -H --header -d --data --data-raw --data-binary --data-urlencode -F --form -A --user-agent -e --referer -u --user -b --cookie -c --cookie-jar -D --dump-header -w --write-out -T --upload-file -X --request)

# Combined short-option clusters confirmed (repo-wide grep) as the only ones actually used
# here - see the header for why an arbitrary cluster isn't resolved instead.
SAFE_CLUSTERS=(fsSL sf)

host_denied() {
  local h="${1,,}" d
  for d in "${DENIED_HOSTS[@]}"; do
    [ "$h" = "$d" ] && return 0
  done
  return 1
}

is_value_flag() {
  local w
  for w in "${VALUE_FLAGS[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

is_safe_cluster() {
  local w
  for w in "${SAFE_CLUSTERS[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

has_expansion_metachar() {
  case "$1" in
    *"\\"* | *'{'* | *'}'* | *'~'* | *'*'* | *'?'* | *'['* | *']'*) return 0 ;;
  esac
  return 1
}

# Extracts the host component from a URL or bare-host word: strips a leading scheme://,
# then a leading user:pass@ userinfo prefix, then everything from the first /, ?, or #
# (path/query/fragment), then a trailing :port. Good enough for an exact-match comparison
# against the five fixed denied hosts above - not a general-purpose URL parser, and does not
# need to be one for this comparison. Sets EXTRACTED_HOST rather than printing + capturing via
# $(...), avoiding an extra subshell fork per word checked.
extract_host() {
  local w="$1"
  case "$w" in
    *://*) w="${w#*://}" ;;
  esac
  case "$w" in
    *@*) w="${w#*@}" ;;
  esac
  w="${w%%/*}"
  w="${w%%\?*}"
  w="${w%%#*}"
  w="${w%%:*}"
  # A trailing "." makes a syntactically valid absolute FQDN that DNS/curl resolve identically
  # to the same name without it (confirmed live: curl connects to the same host either way) -
  # stripped here so "api.github.com." doesn't slip past the exact-match check below.
  w="${w%.}"
  EXTRACTED_HOST="${w,,}"
}

check_host_word() {
  extract_host "$1"
  [ -n "$EXTRACTED_HOST" ] || return 0
  host_denied "$EXTRACTED_HOST" && block "curl to '${EXTRACTED_HOST}' is not permitted - use the appropriate CLI tool (gh, npm, dotnet nuget, ...) for this host instead"
  return 0
}

command -v jq >/dev/null 2>&1 || block 'jq is not available to parse the tool payload - failing closed'

input=$(cat)
raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""') || block 'tool payload could not be parsed by jq - failing closed'

[ -z "$raw_cmd" ] && exit 0

command -v shfmt >/dev/null 2>&1 || block 'shfmt is not available to parse the command - failing closed'

ast=$(printf '%s' "$raw_cmd" | shfmt --tojson 2>/dev/null) || block 'command could not be parsed as shell - failing closed'

# One compact JSON array per CallExpr, one per line. literal_value folds a word's Parts into
# one concatenated string as long as EVERY part is a bare Lit, an ordinary single/double-quoted
# literal with no expansion inside it, or empty - not just a single-Part word, unlike
# enforce-ssh-host-and-key's own version of this function: a word built from several adjacent
# quote/literal parts with zero actual expansion anywhere (e.g. `cu''rl`, `--connect-to''`,
# `https://api.github.com''` - bash concatenates these into one fixed string with no runtime
# unpredictability at all) is exactly as statically determined as a single-Part word, but the
# single-Part version of this check nulled it out anyway purely because of the Part count,
# turning it into the opaque MARKER used below and silently hiding it from every check that
# relies on the real text (command-name match, host match, the -K/--connect-to/-x outright
# block) - confirmed live as a real bypass during review. Any part that isn't one of those
# literal forms (a $-expansion, command/process substitution, extglob, ...) still nulls the
# whole word, same as before - this only widens what counts as literal, it does not narrow it.
calls=$(printf '%s' "$ast" | jq -c '
  def literal_value:
    def part_lit:
      if (.Dollar // false) then null
      elif .Type == "Lit" then (.Value // "")
      elif .Type == "SglQuoted" then (.Value // "")
      elif .Type == "DblQuoted" then
        (.Parts // []) as $dp |
        if ($dp | length) == 0 then ""
        elif ($dp | length) == 1 and ($dp[0].Type == "Lit") then ($dp[0].Value // "")
        else null
        end
      else null
      end;
    (.Parts // []) as $parts |
    reduce $parts[] as $p (""; if . == null then null else ($p | part_lit) as $pl | (if $pl == null then null else . + $pl end) end);
  .. | objects | select(.Type? == "CallExpr") | select((.Args // [] | length) > 0) |
  [ .Args[] | literal_value ]
') || block 'command structure could not be analysed - failing closed'

while IFS= read -r call_line; do
  [ -z "$call_line" ] && continue

  words=()
  while IFS= read -r entry; do
    case "$entry" in
      L:*)
        decoded=$(
          printf '%s' "${entry#L:}" | base64 -d 2>/dev/null
          printf '.'
        )
        words+=("${decoded%.}")
        ;;
      *) words+=("$MARKER") ;;
    esac
  done < <(printf '%s' "$call_line" | jq -r '.[] | if . == null then "N" else "L:" + (. | @base64) end')

  positions=(0)
  is_wrapper "${words[0]:-}" && positions+=(1)

  for i in "${positions[@]}"; do
    tok="${words[$i]:-}"
    [ "$tok" = "curl" ] || [[ "$tok" == */curl ]] || continue

    skip_next=0
    for ((j = i + 1; j < ${#words[@]}; j++)); do
      arg="${words[$j]}"

      has_expansion_metachar "$arg" && block 'a curl argument contains a character that could expand into more than one word at runtime (brace/tilde/glob/backslash) - only plain arguments are permitted'

      case "$arg" in
        -K* | --config | --config=*) block 'curl -K/--config is not permitted - its contents (including the URL) are not visible to this check' ;;
        --connect-to | --connect-to=*) block 'curl --connect-to is not permitted - it can redirect the real connection to a different host than the one written in the URL' ;;
        -x* | --proxy | --proxy=* | --preproxy | --preproxy=* | --socks4 | --socks4=* | --socks4a | --socks4a=* | --socks5 | --socks5=* | --socks5-hostname | --socks5-hostname=*)
          block 'curl -x/--proxy (or --preproxy/--socks4/--socks4a/--socks5/--socks5-hostname) is not permitted - the real connection goes to the proxy address, not the host named in the URL'
          ;;
      esac

      if [ "$skip_next" = 1 ]; then
        skip_next=0
        continue
      fi

      [ "$arg" = "$MARKER" ] && continue

      case "$arg" in
        --url=*)
          check_host_word "${arg#--url=}"
          continue
          ;;
      esac

      if is_value_flag "$arg"; then
        skip_next=1
        continue
      fi

      if [[ "$arg" =~ ^-[A-Za-z]{2,}$ ]]; then
        is_safe_cluster "${arg#-}" || block "curl combined short flags '${arg}' are not permitted except -fsSL/-sf - use separate flags"
        continue
      fi

      case "$arg" in
        -*) continue ;;
      esac

      check_host_word "$arg"
    done
  done
done <<<"$calls"

exit 0
