#!/usr/bin/env bash
# Blocks any tool call that reads or writes a secret-bearing file: one whose
# basename matches a pattern in the secret-files list next to this hook
# (.env, .env.*, *.env and .database by default). Exit 2 = blocked, 0 =
# allowed.
#
# This is the second of two layers. The first is lib/podman, which masks
# every matching file under the repository with a read-only /dev/null mount
# when it starts an agent container, so even a command this hook cannot see
# through reads nothing. This layer catches the reads the mask does not
# cover (a file created after the container started, a secret outside the
# repository) and tells the agent why, rather than letting it puzzle over an
# empty file.
#
# Dispatch is on the payload's tool_name:
#   Read, Edit, Write  check .tool_input.file_path
#   NotebookEdit       checks .tool_input.notebook_path
#   Bash (or empty)    checks every literal word of every simple command,
#                      the command name included, and every redirection
#                      target that is not a heredoc
#   anything else      blocks
#
# A word is blocked when its basename, or the basename of what it resolves
# to through symlinks, matches a pattern. A word naming an existing
# directory passes, so `ls .env/` on a directory is fine. An unquoted word
# with a glob character is also expanded in the current directory and each
# match checked, so `cat .e*` blocks. A word containing whitespace is
# blocked only when it names an existing file, because such a word is
# usually prose (a commit message or a PR body that mentions .env) rather
# than a path. The value of an exclusion option (--exclude, --exclude-dir,
# --include, -name, -iname, -path, -ipath, -g, --glob, --ignore, as a
# separate word or in --option=value form) passes, so the searches
# ai/global/tool-preferences.instructions.md requires still run.
#
# Fails closed when jq, shfmt or realpath is missing, or when the payload or
# the command cannot be parsed.
#
# Accepted gap: a word that is not fully literal (a variable, a command
# substitution, an ANSI-C quoted string) is not checked, since its value is
# only known at run time. reject-obfuscated-commands already refuses the
# usual ways of building a path at run time, and the Layer 1 mask still
# hides every matching file in the repository.
#
# The pattern list is read from secret-files in this hook's directory. A
# secret-files.local in the same directory takes precedence when present:
# a host-only override, never shipped (the image build refuses one and
# install-claude-hooks never installs one). One bash glob pattern per line;
# blank lines and #-comments are ignored.

# Byte-exact pattern semantics regardless of the host locale.
export LC_ALL=C

case "${BASH_SOURCE[0]}" in
  */*) HOOK_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) HOOK_DIR="." ;;
esac

block() {
  printf 'Blocked (command did not run - fix and retry, do not wait for it): %s\n' "$1" >&2
  exit 2
}

PATTERNS=()

load_patterns() {
  local file="${HOOK_DIR}/secret-files" line
  [ -f "${HOOK_DIR}/secret-files.local" ] && file="${HOOK_DIR}/secret-files.local"
  [ -r "$file" ] || block "${file##*/} is missing or unreadable - failing closed"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] && PATTERNS+=("$line")
  done <"$file"
  [ "${#PATTERNS[@]}" -gt 0 ] || block "${file##*/} lists no pattern - failing closed"
}

# Prints the pattern the basename of $1 matches, if any.
matching_pattern() {
  local base="${1%/}" pat
  base="${base##*/}"
  [ -n "$base" ] || return 1
  for pat in "${PATTERNS[@]}"; do
    # shellcheck disable=SC2053  # the pattern is deliberately unquoted so it matches as a glob
    if [[ $base == $pat ]]; then
      printf '%s' "$pat"
      return 0
    fi
  done
  return 1
}

deny() {
  local token="$1" pat="$2" hint=""
  [ "$pat" = ".database" ] && hint=' Query the database with querydb, which reads the connection settings itself (see ai/global/sql.instructions.md).'
  block "'${token}' names a secret-bearing file (matches '${pat}'). Never read or write .env, .env.*, *.env or .database files; exclude them from searches as ai/global/tool-preferences.instructions.md describes.${hint}"
}

# Checks one path-like word. $2 is 1 when the word contains whitespace, in
# which case only an existing file blocks.
check_word() {
  local word="$1" prose="$2" path pat resolved
  [ -n "$word" ] || return 0
  path="$word"
  case "$path" in
    \~/*) path="${HOME}${path#\~}" ;;
  esac
  [ -d "$path" ] && return 0
  if [ "$prose" = 1 ] && [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  pat=$(matching_pattern "$path") && deny "$word" "$pat"
  if [ -e "$path" ]; then
    resolved=$(realpath -e -- "$path" 2>/dev/null) || resolved=""
    if [ -n "$resolved" ] && [ ! -d "$resolved" ]; then
      pat=$(matching_pattern "$resolved") && deny "$word" "$pat"
    fi
  fi
  return 0
}

check_file_tool() {
  local path abs pat resolved
  command -v realpath >/dev/null 2>&1 || block 'realpath is not available to resolve paths - failing closed'
  path=$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // ""') || block 'tool payload could not be parsed by jq - failing closed'
  [ -z "$path" ] && block "${tool_name} payload has no file path - failing closed"
  case "$path" in
    \~ | \~/*) abs="${HOME}${path#\~}" ;;
    /*) abs="$path" ;;
    *) abs="${PWD}/${path}" ;;
  esac
  load_patterns
  pat=$(matching_pattern "$abs") && deny "$path" "$pat"
  if [ -e "$abs" ]; then
    resolved=$(realpath -e -- "$abs" 2>/dev/null) || resolved=""
    if [ -n "$resolved" ]; then
      pat=$(matching_pattern "$resolved") && deny "$path" "$pat"
    fi
  fi
  exit 0
}

is_exclusion_option() {
  case "$1" in
    --exclude | --exclude-dir | --include | -name | -iname | -path | -ipath | -g | --glob | --ignore) return 0 ;;
  esac
  return 1
}

is_exclusion_assignment() {
  case "$1" in
    --exclude=* | --exclude-dir=* | --include=* | --glob=* | --ignore=*) return 0 ;;
  esac
  return 1
}

# Checks one word from the transport: $1 is its flags (g = the unquoted
# part holds a glob character), $2 its text.
check_transport_word() {
  local flags="$1" word="$2" prose=0 match
  case "$word" in
    *[[:space:]]*) prose=1 ;;
  esac
  check_word "$word" "$prose"
  if [[ $flags == *g* ]]; then
    while IFS= read -r match; do
      [ -n "$match" ] && check_word "$match" 0
    done < <(compgen -G "$word" 2>/dev/null)
  fi
}

# ---- main ------------------------------------------------------------------

command -v jq >/dev/null 2>&1 || block 'jq is not available to parse the tool payload - failing closed'

input=$(cat)
tool_name=$(printf '%s' "$input" | jq -r '.tool_name // ""') || block 'tool payload could not be parsed by jq - failing closed'

case "$tool_name" in
  Read | Edit | Write | NotebookEdit) check_file_tool ;;
  Bash | "") : ;;
  *) block "unrecognised tool_name '${tool_name}' - failing closed" ;;
esac

raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""') || block 'tool payload could not be parsed by jq - failing closed'

[ -z "$raw_cmd" ] && exit 0

command -v shfmt >/dev/null 2>&1 || block 'shfmt is not available to parse the command - failing closed'
command -v realpath >/dev/null 2>&1 || block 'realpath is not available to resolve paths - failing closed'

ast=$(printf '%s' "$raw_cmd" | shfmt --tojson 2>/dev/null) || block 'command could not be parsed as shell - failing closed'

# One jq pass over the AST: a line "C" per simple command followed by one
# line per word, and a line "R" per non-heredoc redirection followed by its
# target word. A word line is "N" when the word is not fully literal, else
# "L<flags>:<base64 of the text>", the text joined as bash passes it to the
# command (quotes and the backslashes bash removes are gone). The same word
# decoding enforce-allowed-dirs uses.
transport=$(printf '%s' "$ast" | jq -r '
  def part_info:
    if .Type == "Lit" then {ok: true, q: "u", t: .Value, v: (.Value | gsub("\\\\(?<c>.)"; "\(.c)"))}
    elif .Type == "SglQuoted" and ((.Dollar // false) | not) then {ok: true, q: "s", t: .Value, v: .Value}
    elif .Type == "DblQuoted" and ((.Dollar // false) | not) and all((.Parts // [])[]; .Type == "Lit")
      then ((.Parts // []) | map(.Value) | join("")) as $raw
        | {ok: true, q: "d", t: $raw, v: ($raw | gsub("\\\\(?<c>[$`\"\\\\])"; "\(.c)"))}
    else {ok: false}
    end;
  def word_line:
    [(.Parts // [])[] | part_info] as $ps
    | if ($ps | length) == 0 or any($ps[]; .ok | not) then "N"
      else
        ([$ps[] | select(.q == "u") | .t] | join("")) as $u
        | "L" + (if ($u | test("[*?\\[]")) then "g" else "" end) + ":" + ($ps | map(.v) | join("") | @base64)
      end;
  .. | objects
  | if .Type? == "CallExpr" and ((.Args // []) | length) > 0 then "C", (.Args[] | word_line)
    elif (.Redirs? | type) == "array" then (.Redirs[] | select(.Hdoc == null) | "R", (.Word | word_line))
    else empty end
') || block 'command structure could not be analyzed - failing closed'

load_patterns

skip_next=0
while IFS= read -r line; do
  case "$line" in
    C | R)
      skip_next=0
      ;;
    L*:*)
      tag="${line%%:*}"
      # $(...) strips trailing newlines; the sentinel keeps them.
      decoded=$(
        printf '%s' "${line#*:}" | base64 -d 2>/dev/null
        printf '.'
      )
      word="${decoded%.}"
      if [ "$skip_next" = 1 ]; then
        skip_next=0
        continue
      fi
      if is_exclusion_option "$word"; then
        skip_next=1
        continue
      fi
      is_exclusion_assignment "$word" && continue
      check_transport_word "${tag#L}" "$word"
      ;;
    *)
      # "N": not fully literal, so its value is unknown here (accepted gap).
      skip_next=0
      ;;
  esac
done <<<"$transport"

exit 0
