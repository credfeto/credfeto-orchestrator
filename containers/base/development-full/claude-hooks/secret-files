# shellcheck shell=bash disable=SC2148,SC2211
# File-name patterns the block-secret-file-reads hook refuses to let the
# agent read or write, and that lib/podman masks with /dev/null when it
# starts an agent container. One bash glob pattern per line, matched against
# a file's basename only (never its directory); blank lines and #-comments
# are ignored. This copy is baked root:root 0444 into the container; on a
# host, a secret-files.local next to it (hand-written, never shipped) takes
# precedence - see the hook header.

# Environment files holding API tokens and webhook URLs.
.env
.env.*
*.env

# The database connection settings file read by querydb.
.database
