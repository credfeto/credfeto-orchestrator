#!/usr/bin/env bash
# Rewrites specific, known-safe-to-cache `gh` read calls into a read of a small persistent
# cache file instead of letting them run against the live GitHub API every time. Never
# blocks: this hook only ever allows (with or without a rewrite) or passes through silently
# -- a parse failure, missing shfmt, or a non-matching command all just mean "no rewrite this
# time", never a denial. Exit is always 0.
#
# Currently handles exactly one lookup:
#   * `gh api user --jq '.login'` (single/double/unquoted `.login`) -> reads/populates
#     "${XDG_CACHE_HOME:-${HOME}/.cache}/orchestrator/global/user.json" instead. This is the
#     literal command lib/github's resolve_gh_me runs on the host side; the agent's own Bash
#     tool sometimes reaches for the same thing to resolve its own GitHub identity.
#
# Why this doesn't reopen #1344:
#   Issue #1344 explicitly reviewed and rejected a blanket `gh api user*` permissions.allow
#   entry for the agent's own Bash tool ("no real justification"). This hook does not grant
#   that: the agent's literal `gh api user --jq '.login'` call is never executed as written --
#   it is rewritten (via hookSpecificOutput.updatedInput, same mechanism enforce-git-dash-c's
#   -C auto-insert uses) into a cache read that only ever calls the live API once per fresh
#   copy of the cache file, not once per agent attempt. entrypoint.sh already seeds this same
#   cache file eagerly at container start (containers/agent/entrypoint.sh's
#   seed_orchestrator_cache), so the rewritten command's own `gh api user` fallback below is
#   normally a no-op; it exists only to self-heal a cache entrypoint.sh failed to seed (that
#   seeding is deliberately non-fatal -- see entrypoint.sh's own comment, #1086 precedent).
#
# Matching is deliberately narrow and whole-command-only (not "does this command contain a
# matching call anywhere", unlike enforce-git-dash-c/block-git-worktree/etc.): the entire
# parsed command must be exactly one bare call with no pipes, redirects, backgrounding,
# negation, or surrounding statements. This hook is a convenience optimisation, not a
# security control -- failing to match a call embedded in something more complex just means
# no rewrite happens this time (falls through to the normal permission check, i.e. today's
# behaviour), never a false allow.
#
# Adding another cached lookup later: extend the jq match below to also recognise the new
# call shape, and give it its own cache filename under global/ (or local/, for something
# that should not persist across container invocations) alongside user.json.

export LC_ALL=C

input=$(cat)
raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""')

[ -z "$raw_cmd" ] && exit 0

# Cheap pre-filter before the shfmt/jq parse below: this hook runs on every single Bash tool
# call, unlike the AST walk it guards. word_literal further down only ever resolves a plain
# Lit/SglQuoted/single-Lit-DblQuoted word to text, so any command that can possibly match
# is_match_gh_api_user_login must literally contain "login" as plain text somewhere in its
# source - a strict superset of the AST matcher's accept set, so this can only skip commands
# that were always going to fail to match anyway.
case "$raw_cmd" in
  *login*) ;;
  *) exit 0 ;;
esac

command -v shfmt > /dev/null 2>&1 || exit 0
ast=$(printf '%s' "$raw_cmd" | shfmt --tojson 2> /dev/null) || exit 0

# Resolves the whole command to one base64-encoded literal argv word per output line, but
# only when it is a single bare CallExpr statement with nothing else going on (see header
# comment): no pipes/redirects/backgrounding/negation/surrounding statements, and no per-
# command variable-assignment prefix (Cmd.Assigns, e.g. `GH_TOKEN=x gh api user --jq
# '.login'`) - a call with one of those still runs as that specific environment, which the
# fixed rewrite below does not reproduce, so it must not match. Anything not matching that
# shape produces zero output lines, which the word-count check below already rejects (no
# separate empty-string sentinel needed). One base64-per-line entry per word, decoded in the
# read loop below, rather than a delimiter-joined single line (tab or otherwise): bash's
# `read -ra` with IFS set to a single character still treats it as IFS *whitespace* (tab is
# one of the three default whitespace chars) and collapses/strips consecutive or trailing
# empty fields, so a trailing empty-string argument (e.g. `gh api user --jq '.login' ''`)
# would have silently been absorbed rather than counted - the same class of bug
# enforce-ssh-host-and-key's own base64-per-line transport was introduced to fix (see its
# header comment). word_literal (same shape as enforce-ssh-host-and-key's literal_value)
# resolves a single-part Lit/SglQuoted/DblQuoted(single-Lit-part) word to its literal value,
# rejecting an ANSI-C/locale-quoted word (shfmt's Dollar flag, e.g. $'...') even when it would
# otherwise look like a plain SglQuoted; anything else (an expansion, a multi-part word)
# resolves to the empty string, which can never equal one of the plain-ASCII literals compared
# against below regardless of how it's transported.
words=()
while IFS= read -r entry; do
  words+=("$(printf '%s' "$entry" | base64 -d 2> /dev/null)")
done < <(printf '%s' "$ast" | jq -r '
  def word_literal:
    if ((.Parts // []) | length) == 1 then
      (.Parts[0] as $p |
        if ($p.Dollar // false) then ""
        elif $p.Type == "Lit" then $p.Value
        elif $p.Type == "SglQuoted" then $p.Value
        elif $p.Type == "DblQuoted" and (($p.Parts // []) | length) == 1 and $p.Parts[0].Type == "Lit" then $p.Parts[0].Value
        else "" end)
    else "" end;
  if ((.Stmts // []) | length) == 1 then
    (.Stmts[0] as $s |
      if (($s.Negated // false) == false) and (($s.Background // false) == false) and (($s.Redirs // []) | length) == 0 and (($s.Cmd.Assigns // []) | length) == 0 and $s.Cmd.Type == "CallExpr" then
        ($s.Cmd.Args[]? | word_literal | @base64)
      else empty end)
  else empty end
')

is_match_gh_api_user_login() {
  [ "${#words[@]}" -eq 5 ] || return 1
  { [ "${words[0]}" = "gh" ] || [[ "${words[0]}" == */gh ]]; } || return 1
  [ "${words[1]}" = "api" ] || return 1
  [ "${words[2]}" = "user" ] || return 1
  [ "${words[3]}" = "--jq" ] || return 1
  [ "${words[4]}" = ".login" ] || return 1
  return 0
}

is_match_gh_api_user_login || exit 0

# The rewritten command is returned as literal shell text -- "$HOME"/"$XDG_CACHE_HOME" are
# expanded by whichever shell actually runs it (inside the container, as the developer user),
# not by this hook, exactly like every other hook's rewrite in this chain. The cache directory
# expression itself is kept byte-identical to entrypoint.sh's own
# "${XDG_CACHE_HOME:-${HOME}/.cache}/orchestrator/global" (see that file's seed_orchestrator_cache)
# so the two cannot silently drift apart; test/entrypoint-cache-path-parity.bats asserts the two
# literal copies actually match. Computed into a local var once rather than repeated inline, so
# only one copy needs to stay in sync with entrypoint.sh's expression, not three. The write on a
# cache miss goes to a temp file then an atomic same-directory rename (matching
# seed_orchestrator_cache's own write, so a concurrent cat here can never observe a
# partially-written file) rather than a bare "> user.json" redirect.
new_cmd=$(cat << 'CMDEOF'
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/orchestrator/global"; mkdir -p "$cache_dir" && { [ -s "$cache_dir/user.json" ] || { gh api user --jq '.login' > "$cache_dir/user.json.tmp.$$" && mv "$cache_dir/user.json.tmp.$$" "$cache_dir/user.json"; }; } && cat "$cache_dir/user.json"
CMDEOF
)

# Merged into the original tool_input, not built fresh from just the rewritten command
# (#1367) -- see ai/local/claude-hooks.instructions.md's "Non-ASCII / Layer 0 block" section
# for why a jq -n-built replacement would silently drop sibling fields like
# run_in_background/timeout back to their defaults.
printf '%s' "$input" | jq --arg cmd "$new_cmd" \
  '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow", updatedInput: ((.tool_input // {}) + {command: $cmd})}}'

exit 0
