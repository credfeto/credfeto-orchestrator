#!/usr/bin/env bash
# Restricts ssh and scp to (a) targets in the .lan private-network suffix
# (e.g. dns-01.lan, dns-01.dns.lan) and (b) sessions where a usable SSH key
# is actually loaded - blocks any other destination, and blocks outright if
# no key is available, rather than falling back to password auth.
# Exit 2 = blocked, 0 = allowed.
#
# ssh/scp are on claude-settings.json's blanket Bash(ssh *)/Bash(scp *)
# permissions.allow, and the danger both pose is in the *destination*, not
# the verb - a permissions.json prefix pattern cannot express "except this
# host", so the restriction lives here instead (see issue #1315). Parses the
# command with shfmt (mvdan/sh) and walks the resulting AST, same approach as
# the sibling enforce-git-dash-c/block-git-worktree hooks (see
# enforce-git-dash-c's header for the full rationale) - text/regex scanning
# for a hostname would miss obfuscated forms and false-positive on unrelated
# text, so this only inspects actual ssh/scp call expressions.
#
# Key precondition (checked once, lazily, the first time a call actually
# resolves a target host to verify - a target-less call like `ssh -V` never
# connects anywhere, so it is left alone): this container never mounts raw
# private key files - see CHANGELOG ("Replace ~/.ssh volume mount with SSH
# agent socket forwarding so private key files are never exposed inside the
# agent container") - so a "valid key" check here means the forwarded
# ssh-agent (SSH_AUTH_SOCK) has at least one loaded identity (`ssh-add -l`
# exits 0), the same local-state-only verification style as the sibling
# enforce-git-identity hook's `gpg --list-secret-keys` check. This does not
# attempt to prove the key would actually authenticate against any
# particular host - only that key-based auth is configured at all, so a
# call can never silently fall back to interactive password auth.
#
# Host extraction approximates each tool's own option parser rather than
# reusing a shared one (ssh and scp accept different flag sets), skipping
# every known non-value flag, and every known value flag together with its
# separate-token value, before treating the first remaining non-flag word as
# the target. A handful of flags are blocked outright instead of parsed -
# -o/-F/-J (ssh and scp) and -D/-L/-R/-W/-w (ssh only) - because each can
# redirect the connection to, or open a tunnel toward, a host this hook
# cannot see in the positional target argument (arbitrary config overrides,
# a jump host, a forwarded port to an arbitrary destination), the same
# "cannot classify as safe, block outright" treatment enforce-git-dash-c
# gives `git config --file`/`--blob`. The blocked-flag check matches on the
# flag letter alone (classify_flag below), independent of whether its value
# is attached ("-oProxyCommand=x") or a separate token ("-o ProxyCommand=x")
# - an earlier version of this hook only checked the exact-token form and so
# missed the attached form entirely, letting exactly the redirection vectors
# this hook exists to close straight through (round 1 review). A target that
# isn't a single plain-literal word still fails closed (blocked) rather than
# guessed at. Two known remaining gaps, both narrower than the one above and
# left deliberately unaddressed for now:
#   * A flag this hook doesn't recognise at all (not in any BLOCKED_FLAGS or
#     VALUE_FLAGS array above) is treated as an ordinary boolean flag and
#     skipped, not blocked - this hook is a blocklist of known-dangerous
#     flags layered on ssh/scp's actual grammar, not a from-scratch allowlist
#     of every safe flag either tool supports. Closing this would mean
#     enumerating ssh/scp's complete flag surface (all of it, not just the
#     value- and redirection-relevant subset covered here) - real risk of
#     getting an obscure or version-specific flag's arity wrong and breaking
#     legitimate usage for no security benefit, so left as a blocklist.
#   * A blocked flag bundled behind other short boolean flags in one token
#     (e.g. "-vo ProxyCommand=x" for "-v -oProxyCommand=x") is not decoded
#     and so is not caught - real-world ssh/scp usage essentially never does
#     this, and reject-obfuscated-commands' job is exactly this class of
#     disguised intent for the command name.
# Revisit either gap if it is ever actually exploited.
#
# Obfuscated command names (quote-splices, substitutions, ${IFS} games) are
# NOT this hook's job - reject-obfuscated-commands rejects those
# categorically before this hook ever runs. Anything here that is not a
# plain literal word is deliberately treated as opaque.
#
# Fails closed: shfmt missing, the command not parsing as shell, or no
# ssh-agent key available all block the command.

# Byte-exact pattern semantics regardless of the host locale.
export LC_ALL=C

# The message says the command never ran (not "blocked mid-run") because a denial is easy to
# misread as "started, now wait for it" - which then waits forever, since a denied call never
# started in the first place (#1281).
block() {
  printf 'Blocked (command did not run - fix and retry, do not wait for it): %s\n' "$1" >&2
  exit 2
}

# Known wrapper names for the defense-in-depth `sudo ssh ...` check below -
# mirrors the "Wrapper commands" section of command-blocklist, which is what
# actually bans these upstream in the normal PreToolUse chain.
WRAPPERS=(env nice command sudo doas exec nohup stdbuf builtin setsid timeout ionice taskset chroot nsenter flock watch time)

is_in() {
  local needle="$1" straw
  shift
  for straw in "$@"; do
    [ "$needle" = "$straw" ] && return 0
  done
  return 1
}

# Flags that redirect the connection/tunnel somewhere this hook cannot see
# and verify - blocked outright rather than parsed. -o covers arbitrary
# ssh_config overrides (Hostname, ProxyCommand, ProxyJump, ...); -F an
# arbitrary alternate config file that could set the same; -J an explicit
# jump host; -D/-L/-R/-W/-w open a tunnel to a host of their own.
SSH_BLOCKED_FLAGS=(-o -F -J -D -L -R -W -w)
SCP_BLOCKED_FLAGS=(-o -F -J)

# Remaining ssh flags that take a value as a separate token when not
# attached to the flag itself (e.g. "-p 2222" vs. attached "-p2222" - both
# handled, since an attached value never produces a separate token to skip).
SSH_VALUE_FLAGS=(-B -b -c -E -e -I -i -l -m -O -p -Q -S)
# Remaining scp value flags, same convention.
SCP_VALUE_FLAGS=(-c -i -l -P -S -X)

# Classifies word $2 (already known to start with '-') against the blocked-
# and value-flag arrays for tool $1 ("ssh" or "scp"), advancing the caller's
# loop index $k accordingly. Blocks outright on a match against the blocked
# set - checked against the flag letter alone (${w:0:2}), independent of
# whether the rest of the word is an attached value, so "-o" and
# "-oProxyCommand=x" are both caught. Must be called as a plain statement,
# never inside $(...) - block's exit would only kill a subshell there and
# silently fail the check open.
classify_flag() {
  local tool="$1" w="$2"
  local flag="${w:0:2}" blocked_flags value_flags
  case "$tool" in
    ssh)
      blocked_flags=("${SSH_BLOCKED_FLAGS[@]}")
      value_flags=("${SSH_VALUE_FLAGS[@]}")
      ;;
    scp)
      blocked_flags=("${SCP_BLOCKED_FLAGS[@]}")
      value_flags=("${SCP_VALUE_FLAGS[@]}")
      ;;
  esac
  if is_in "$flag" "${blocked_flags[@]}"; then
    block "${tool} ${flag} is not permitted - it can redirect the connection to a host this check cannot verify"
  fi
  if [ "$w" = "$flag" ] && is_in "$flag" "${value_flags[@]}"; then
    k=$((k + 2))
  else
    k=$((k + 1))
  fi
}

# Host is allowed only if it ends in the .lan private-network suffix
# (case-insensitive - hostnames are conventionally case-insensitive).
host_allowed() {
  case "${1,,}" in
    *.lan) return 0 ;;
    *) return 1 ;;
  esac
}

# Extracts the host from an scp positional word, or prints nothing if the
# word looks like a local path. Forms: "scp://[user@]host[:port][/path]",
# "[user@]host:path". A bare "host:path" (no user@) is only treated as
# remote if the part before the first ':' contains no '/' - a local relative
# path with a colon in it (e.g. "./a:b") is not mistaken for a host.
#
# The non-URI form finds the FIRST ':' before ever looking for '@' - real
# scp/ssh syntax treats everything up to the first ':' as the [user@]host
# spec and everything after it as the path, so only an '@' inside that
# pre-colon spec is part of the host (round 4 code review: the previous
# version searched the whole word for '@' before restricting to the
# pre-colon portion, so a crafted "evil.com:x@dns-01.lan:y" extracted
# dns-01.lan as the host while real scp - verified via `scp -v`, which
# reported "Executing: program ssh host evil.com" - connects to evil.com).
scp_target_host() {
  local w="$1" spec
  case "$w" in
    scp://*)
      spec="${w#scp://}"
      spec="${spec#*@}"
      spec="${spec%%/*}"
      printf '%s' "${spec%%:*}"
      ;;
    *:*)
      spec="${w%%:*}"
      case "$spec" in
        */* | . | ..) ;; # local path shape, not a host
        *) printf '%s' "${spec#*@}" ;;
      esac
      ;;
  esac
}

MARKER=$'\x01'

# Only "already confirmed OK" is worth caching: require_ssh_key always exits
# on failure (via block), so a failed check is never observed again to cache.
key_ok=0
require_ssh_key() {
  [ "$key_ok" = 1 ] && return 0
  if [ -n "${SSH_AUTH_SOCK:-}" ] && command -v ssh-add >/dev/null 2>&1 && ssh-add -l >/dev/null 2>&1; then
    key_ok=1
    return 0
  fi
  block 'no usable SSH key is loaded in the forwarded ssh-agent - ssh/scp requires key-based auth, not a password fallback'
}

input=$(cat)
raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""')

[ -z "$raw_cmd" ] && exit 0

command -v shfmt >/dev/null 2>&1 || block 'shfmt is not available to parse the command - failing closed'

ast=$(printf '%s' "$raw_cmd" | shfmt --tojson 2>/dev/null) || block 'command could not be parsed as shell - failing closed'

# One line per CallExpr: every word that is a single plain literal - bare
# (git -C X) or wrapped in one layer of ordinary quoting with no expansion
# inside it ("git" -C "X", 'git' -C 'X') - is emitted verbatim; anything else
# (a substitution, an expansion, or quoting that mixes literal text with
# either of those, e.g. "dns-01.$HOST") is represented as a marker byte.
# Layer 0 of reject-obfuscated-commands (which runs before this hook)
# guarantees a real 0x01 byte can never appear in the input, so the marker
# is unambiguous and opaque to the checks below. Unwrapping exactly one
# layer of quoting here matters in practice - quoting a hostname/path is
# entirely ordinary style, not an obfuscation attempt, and without this a
# call as plain as `ssh "dns-01.lan"` would be misclassified as non-literal
# and blocked (round 1 code review).
#
# ANSI-C ($'...') and locale ($"...") quoting - shfmt sets Dollar: true on
# these, same node Type as ordinary quoting otherwise - are excluded from
# unwrapping despite carrying only a single Lit part: their
# .Value/.Parts[0].Value is the raw, pre-decode source text, not what bash
# actually passes to the command at execution time (round 2 code review:
# $'-\x6fProxyCommand=x' decodes to the real argument -oProxyCommand=x, but
# this hook saw the literal text "-\x6fProxyCommand=x" and let it straight
# through unblocked before this exclusion was added).
#
# Root cause behind that bug, and now closed exhaustively rather than one
# form at a time: shfmt's Value/Parts[0].Value is ALWAYS the raw source
# text, for EVERY node type - not just $'...'/$"..." - and any character
# that triggers one of bash's word-expansion phases makes that raw text
# differ from what the command actually receives at execution time. Round 3
# closed backslash escaping (a quote-removal-phase transform: a bare
# `-\oProxyCommand=x`, unquoted, really is the argument -oProxyCommand=x at
# execution time). Round 4 found this still didn't cover brace expansion or
# pathname expansion (globbing) - `ssh {-oProxyCommand=x,dns-01}.lan` is one
# Lit word ending in ".lan" to this hook (and to reject-obfuscated-commands,
# which never runs it through shell expansion either), but bash's brace
# expansion turns it into TWO argv words at execution time, one a live -o
# flag - verified via `shfmt --tojson` (one Lit) against real bash brace
# expansion (two words) side by side.
#
# Rather than keep adding one expansion mechanism at a time, this now
# enumerates bash's complete set of word-expansion phases (per bash(1)
# EXPANSION) and excludes any value containing a character that can trigger
# one: brace expansion ({ } ,), tilde expansion (~), pathname expansion (* ?
# [ ]), and quote removal of an escape (\), on top of the node-type check
# already excluding parameter/command/arithmetic expansion (anything that
# isn't a single Lit/SglQuoted/pure-DblQuoted node isn't unwrapped at all,
# and unquoted results of THOSE expansions are the only source of the
# remaining phase, word splitting - already excluded transitively). A plain
# .lan hostname or scp path never legitimately needs any of these
# characters, so this costs nothing in real usability. Comma is
# deliberately NOT excluded on its own - it is inert without an enclosing
# { }, which is already excluded, and excluding it too would needlessly
# reject ordinary path/filename content.
calls=$(printf '%s' "$ast" | jq -r --arg marker "$MARKER" '
  def literal_value:
    if (.Parts | length) != 1 then null
    else
      .Parts[0] as $p |
      (if ($p.Dollar // false) then null
       elif $p.Type == "Lit" then $p.Value
       elif $p.Type == "SglQuoted" then $p.Value
       elif $p.Type == "DblQuoted" and (($p.Parts // []) | length) == 1 and ($p.Parts[0].Type == "Lit")
         then $p.Parts[0].Value
       else null
       end) as $v |
      if $v == null then null
      elif ($v | contains("\\")) or ($v | contains("{")) or ($v | contains("}"))
        or ($v | contains("~")) or ($v | contains("*")) or ($v | contains("?"))
        or ($v | contains("[")) or ($v | contains("]"))
        then null
      else $v
      end
    end;
  .. | objects | select(.Type? == "CallExpr") | select((.Args // [] | length) > 0) |
  [ .Args[] | literal_value // $marker ] |
  join("\t")') || block 'command structure could not be analyzed - failing closed'

while IFS= read -r call_line; do
  [ -z "$call_line" ] && continue
  IFS=$'\t' read -ra words <<<"$call_line"

  # Only the command-name position, and the position immediately after a
  # known wrapper name in the command-name position, are checked - a token
  # appearing anywhere else is an ordinary argument, not an ssh/scp
  # invocation (e.g. `grep -r ssh .`, `find . -name scp`).
  positions=(0)
  is_in "${words[0]}" "${WRAPPERS[@]}" && positions+=(1)

  for i in "${positions[@]}"; do
    tok="${words[$i]:-}"

    if [ "$tok" = "ssh" ] || [[ "$tok" == */ssh ]]; then
      k=$((i + 1))
      target=""
      while [ "$k" -lt "${#words[@]}" ]; do
        w="${words[$k]}"
        case "$w" in
          "$MARKER")
            block 'ssh argument could not be verified (non-literal argument)'
            ;;
          --)
            k=$((k + 1))
            target="${words[$k]:-}"
            break
            ;;
          -*)
            classify_flag ssh "$w"
            continue
            ;;
          *)
            target="$w"
            break
            ;;
        esac
      done

      if [ -n "$target" ]; then
        host="${target##*@}"
        host_allowed "$host" || block "ssh target host '${host}' is not in the allowed .lan network"
        require_ssh_key
      fi

    elif [ "$tok" = "scp" ] || [[ "$tok" == */scp ]]; then
      k=$((i + 1))
      # Once true, every remaining word is a positional source/target - even
      # one that happens to start with '-' (a real filename) - never a flag
      # again, matching real scp's own end-of-options handling. Before this
      # was tracked, `scp -- -oddfile.txt user@host:/tmp/` still ran
      # "-oddfile.txt" through the flag classifier and blocked on it (round
      # 1 code review) - `--` was consumed but had no further effect.
      literal_from_here=0
      while [ "$k" -lt "${#words[@]}" ]; do
        w="${words[$k]}"
        if [ "$w" = "$MARKER" ]; then
          block 'scp argument could not be verified (non-literal argument)'
        fi
        if [ "$literal_from_here" = 0 ] && [ "$w" = "--" ]; then
          literal_from_here=1
          k=$((k + 1))
          continue
        fi
        if [ "$literal_from_here" = 0 ]; then
          case "$w" in
            -*)
              classify_flag scp "$w"
              continue
              ;;
          esac
        fi
        host=$(scp_target_host "$w")
        if [ -n "$host" ]; then
          host_allowed "$host" || block "scp target host '${host}' is not in the allowed .lan network"
          require_ssh_key
        fi
        k=$((k + 1))
      done
    fi
  done
done <<<"$calls"

exit 0
