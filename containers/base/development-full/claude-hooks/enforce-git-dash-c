#!/usr/bin/env bash
# Blocks git commands that don't use `git -C <dir>` format — unless the missing -C can be
# safely auto-corrected (see "Auto-correcting a missing -C" below).
# Exit 2 = blocked, 0 = allowed (with or without a rewrite).
#
# Like reject-obfuscated-commands (which runs before this hook in the
# PreToolUse chain), this parses the command with shfmt (mvdan/sh) and walks
# the resulting AST instead of approximating shell tokenization with text
# scanning — the previous hand-rolled quote/substitution/segment engine
# accumulated eight review rounds of bypasses (see PR #1159 / issue #1105)
# and is gone. The AST walk visits every call expression at any nesting
# depth ($()/backtick substitutions, loop/if bodies, pipelines, subshells),
# and heredoc bodies are naturally inert (they are redirect payloads in the
# AST, not commands), so prose that merely mentions "git push" is never
# falsely blocked while a live substitution inside a heredoc would still be
# checked.
#
# Rules, per call expression:
#   * eval/source/. are blocked outright — their string argument is a
#     second command line whose git hardening this hook cannot verify.
#   * A plain-literal token spelled `git` (or a path ending in /git) in the
#     command-name position, or in the position immediately after a known
#     wrapper name in the command-name position (which covers
#     wrapper-prefixed forms like `sudo git ...` for defense-in-depth, even
#     though wrappers are banned upstream), must be followed by `-C` —
#     optionally preceded by `-c <key>=<value>` global option pairs, e.g.
#     `git -c core.pager=cat -C /repo status`. Only these two positions are
#     checked — a `git` token appearing elsewhere is an ordinary argument
#     (e.g. `grep -r git .`), not a git invocation.
#   * Subcommand allowlist (#1387): whatever git subcommand follows -C (or
#     the bare git token, before any -C auto-correction below) must be in
#     GIT_ALLOWED_SUBCOMMANDS below. A missing subcommand or one not on the
#     list blocks outright, regardless of whether -C is present or would be
#     auto-corrected - this runs before the config/clone/auto-correct
#     handling below, so a disallowed subcommand is never rewritten into an
#     allowed-looking call. `config` and `clone` still need their own listed
#     entries: they pass through this gate first, then their existing
#     dedicated handling. Hardcoded here (not a data file like
#     command-allowlist) since this hook is its only consumer and the real
#     enforcement is this hook's own AST-based parse - unlike
#     claude-settings.json's permissions.allow, which does plain text
#     matching and can't reliably identify "the real subcommand" for a tool
#     whose subcommand follows a wildcarded -C <dir>, so that layer is kept
#     coarse (bare Bash(git -C *)) and this hook is the sole place that
#     enforces subcommand scope.
#   * Exemptions from the `-C` requirement, kept deliberately narrow — do
#     not widen without re-reading the PR #1159/#1105 bypass history above:
#       - `git clone ...` — creates a new repo, doesn't read an existing one.
#       - `git config ...` — governed by the config policy below instead.
#   * `git config` policy (applies with or without -C):
#       - Reads (--get, --get-all, --get-regexp, --get-urlmatch, --list) of
#         --global/--system scope are allowed anywhere; any other read still
#         requires -C like the rest of git.
#       - ALL writes (plain `key value` set, --add, --replace-all,
#         --unset, --unset-all) are blocked at every scope — local, global
#         and system. There is never a good reason for a session to change
#         git config: identity/signing are baked into the environment, and
#         many keys (alias.*, core.hooksPath, core.fsmonitor,
#         credential.*, filter/diff/merge drivers, ...) are arbitrary
#         code-execution vectors. git config is read-only here.
#       - --edit/-e, --file/-f, --blob, --rename-section and
#         --remove-section are blocked outright — interactive,
#         arbitrary-file or whole-section forms this hook cannot classify
#         as pure reads.
#   * Hook-bypass flags and overrides (#1399): blocks `--no-verify` (and its
#     unambiguous abbreviations, all of GIT_SUBCOMMANDS_HOOK_BYPASS_CHECK)
#     and short-form `-n`/bundles (commit only) via the AST walk - including
#     a simple-quoted, split-quoted or unquoted-backslash-escaped spelling
#     of any of these, since the shell already strips quoting/escaping
#     before git ever sees the argument - plus a `HUSKY=0` env-var override
#     via a separate raw-text regex. Full
#     rationale: ai/local/claude-hooks.instructions.md.
#
# Obfuscated command names (quote-splices, substitutions, ${IFS} games) are
# NOT this hook's job — reject-obfuscated-commands rejects those
# categorically before this hook ever runs. Anything here that is not a
# plain literal word is deliberately treated as opaque.
#
# Auto-correcting a missing -C (#1357):
#   A bare git call missing -C is not always block-only. If (a) no directory-changing
#   command - `cd`/`pushd`/`popd`, plain or wrapped (`command cd ...`, `builtin cd ...`) or
#   backslash-escaped (`\cd ...`) - appears anywhere in the command (one earlier in the same
#   command means this hook's own $PWD no longer represents what a later call would actually
#   see at execution time - this hook parses the command statically and never runs any part
#   of it, so it cannot track such a call's effect), and (b) `git rev-parse --show-toplevel`,
#   run from the hook's own $PWD, succeeds (a sanity check that $PWD is inside a real,
#   enclosing git repository and not some unrelated directory) and $PWD itself is writable by
#   the hook process - the one place this hook itself executes anything, as distinct from
#   never running the user's command above - then every bare git call in the command is
#   rewritten in place - `-C "<$PWD>"` is inserted immediately after the `git` token itself
#   (the hook's own $PWD, not `git rev-parse --show-toplevel`'s output - a subdirectory of
#   the repo is not equivalent to its root for relative pathspec resolution, so injecting the
#   toplevel instead of $PWD would silently change what a call with a relative path argument
#   operates on), since global options like -C/-c may appear in any relative order, so there
#   is no need to skip past any existing -c pairs first - and the rewritten command is
#   returned via hookSpecificOutput.updatedInput instead of blocking. Otherwise (a
#   directory-changing call present, $PWD not inside a repository, or $PWD is not writable)
#   the command is blocked exactly as before.
#
#   This differs from the $PWD-injection idea rejected in #1217 (see
#   ai/local/claude-hooks.instructions.md's "Prefer auto-correction over blocking" note):
#   that rejection was about injecting $PWD verbatim with no repository-boundary check, no
#   writability check, and no guard against a preceding directory-changing call - which
#   really would have been a no-op, since git already auto-discovers the repo root from $PWD
#   identically whether -C is passed or not, making -C effectively optional everywhere. The
#   cd-guard and writability check here are not present in that rejected idea: they are
#   exactly what keeps this from being the same no-op - the cases this hook cannot be
#   confident about (no enclosing repo, an unwritable/foreign checkout, or a
#   directory-changing call this hook cannot see through) still block outright; only the
#   unambiguous, single-directory case is resolved automatically instead of demanding the
#   agent spell out a path this hook can already derive safely.
#
# Fails closed: shfmt missing or the command not parsing as shell blocks
# the command.

# Byte-exact pattern semantics regardless of the host locale.
export LC_ALL=C

# The message says the command never ran (not "blocked mid-run") because a denial is easy to
# misread as "started, now wait for it" - which then waits forever, since a denied call never
# started in the first place (#1281).
block() {
  printf 'Blocked (command did not run - fix and retry, do not wait for it): %s\n' "$1" >&2
  exit 2
}

# Generic array-membership check, same shape as enforce-allowed-dirs' own
# in_list() - shared by is_wrapper() below and is_allowed_subcommand()
# further down instead of each hand-rolling its own scan loop.
in_list() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [ "$needle" = "$item" ] && return 0
  done
  return 1
}

# Known wrapper names for the defense-in-depth `sudo git ...` check below —
# mirrors the "Wrapper commands" section of command-blocklist, which is what
# actually bans these upstream in the normal PreToolUse chain.
WRAPPERS=(env nice command sudo doas exec nohup stdbuf builtin setsid timeout ionice taskset chroot nsenter flock watch time)

is_wrapper() {
  in_list "$1" "${WRAPPERS[@]}"
}

# Allowed git subcommands (#1387), split by -C policy so it's obvious where
# a new subcommand belongs when this list is next extended. `worktree` is
# listed in the -C-required bucket even though it also gets its own
# dedicated handling further down (block-git-worktree's separate add/non-add
# split) - it still has to clear this gate first.
#
#   - GIT_SUBCOMMANDS_NO_REPO: creates a new repo rather than reading an
#     existing one, so -C doesn't apply.
GIT_SUBCOMMANDS_NO_REPO=(clone)
#   - GIT_SUBCOMMANDS_BESPOKE_POLICY: has its own -C policy (see
#     check_config_call) instead of the generic -C requirement.
GIT_SUBCOMMANDS_BESPOKE_POLICY=(config)
#   - GIT_SUBCOMMANDS_REQUIRE_C: the default case - must be preceded by -C.
#     cherry-pick added back (#1411) after a confirmed live need; the other subcommands #1394
#     dropped as having no confirmed use (am, mv, remote, restore, revert, rm, tag) stay blocked -
#     see test/enforce-git-dash-c.bats's pinned-blocked cases for those.
GIT_SUBCOMMANDS_REQUIRE_C=(add branch checkout cherry-pick commit diff fetch log ls-remote merge pull push rebase reset rev-list rev-parse show stash status switch worktree)

# Combined allowlist derived from the three lists above - single source of
# truth for is_allowed_subcommand(), so the lists above and the "is this
# subcommand permitted at all" gate can never drift apart.
GIT_ALLOWED_SUBCOMMANDS=("${GIT_SUBCOMMANDS_NO_REPO[@]}" "${GIT_SUBCOMMANDS_BESPOKE_POLICY[@]}" "${GIT_SUBCOMMANDS_REQUIRE_C[@]}")

is_allowed_subcommand() {
  in_list "$1" "${GIT_ALLOWED_SUBCOMMANDS[@]}"
}

# Subcommands whose git hooks --no-verify/-n actually skips (#1399) - see
# ai/local/claude-hooks.instructions.md for why `am` is deliberately excluded.
GIT_SUBCOMMANDS_HOOK_BYPASS_CHECK=(cherry-pick commit merge pull push rebase)

# Sentinel for an ANSI-C-quoted word ($'...') containing a backslash escape (#1399 code
# review), used only by check_hook_bypass_flags below. Unlike a plain $'...' with no
# escapes - whose source text already is its own value, safe to resolve like any other
# quoting - a $'...' with an escape (\t, \x2d, \045, ...) decodes to a value this hook
# cannot compute without re-implementing bash's ANSI-C escape rules in jq, so it is neither
# resolved (that would silently trust unparsed escape syntax as if it were literal text,
# which is worse than not resolving at all) nor treated as the ordinary opaque marker
# (silently allowed through, same as a genuinely dynamic $VAR/$(...) - but this construct,
# unlike those, is fully static and just not decoded here yet). It gets its own sentinel so
# check_hook_bypass_flags can fail closed on it specifically instead. Built the same way as
# the resolved-line's own opaque marker below (see the "calls" extraction comment) - a codepoint
# via jq's implode, not a typed escape sequence - using a different codepoint so it can never
# collide with that marker.
ANSI_C_ESCAPE_MARKER=$(jq -rn '[2] | implode')

input=$(cat)
raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""')

[ -z "$raw_cmd" ] && exit 0

# HUSKY=0 override (#1399): the AST walk below only extracts each call's
# Args, not its env-var Assigns, so this checks raw_cmd directly via a regex
# anchored to a real assignment boundary (start/end of string, a shell
# separator, or a `(`/`)` subshell boundary - #1399 code review round 3:
# `(HUSKY=0 ...)` previously slipped past a boundary class that only
# recognised `;`/`&`/`|`/whitespace) rather than a substring match - see
# ai/local/claude-hooks.instructions.md for the full rationale and the one
# known residual false-positive class this trades off.
husky_re='(^|[;&|()[:space:]])HUSKY=("0"|'\''0'\''|0)($|[;&|()[:space:]])'
[[ "$raw_cmd" =~ $husky_re ]] && block 'HUSKY=0 is not permitted - hook bypass is blocked'

command -v shfmt > /dev/null 2>&1 || block 'shfmt is not available to parse the command - failing closed'

ast=$(printf '%s' "$raw_cmd" | shfmt --tojson 2> /dev/null) || block 'command could not be parsed as shell - failing closed'

# Three lines per CallExpr (words/offsets tab-joined, resolved \x1f-joined - see that line's
# own comment below for why), in a single AST walk: the words line (every word - a
# single plain literal emitted verbatim; anything else - quoted text, substitutions,
# expansions - represented as a \u0001 marker, unambiguous since Layer 0 of
# reject-obfuscated-commands, which runs before this hook, guarantees a real \x01 byte
# can never appear in the input, so it can never equal "git"/"-C"/"-c" and is opaque to
# the checks below), then the offsets line (each word's raw_cmd byte offset one past its
# end - shfmt's own End.Offset - used by the auto-correction rewrite below to know
# exactly where to splice "-C <dir>" in after a bare git token), then the resolved line
# (#1399 - used only by check_hook_bypass_flags below, never for command-name/-C/subcommand
# identification: a word built entirely from Lit/SglQuoted/DblQuoted-of-only-those pieces is
# concatenated to its real literal value even when quoted - "--no-verify" or '--no-verify' is
# indistinguishable from --no-verify to git itself, since the shell already stripped the
# quoting before git ever saw the argument - while a word containing any real expansion
# ($VAR, $(...), ...) still resolves to the same opaque marker value as the words line's own
# (built via jq's own implode from the identical codepoint the words line spells as a typed
# escape instead, so both lines agree on what "opaque" means despite the different spelling).
# The resolved line is joined with \x1f (unit separator), not tab: unlike the words/ends
# lines, an arg here can genuinely resolve to an empty string (e.g. a bare '' or "" literal),
# and `IFS=$'\t' read -ra` collapses consecutive tabs - tab is "IFS whitespace" to bash,
# so a real empty field between two tabs silently vanishes instead of surviving as an empty
# array element, undercounting the resolved array against words/ends and tripping the
# desync fail-close below on a completely unrelated, harmless command (confirmed live: a
# bare `echo foo '' bar` was blocked by this before the fix). \x1f is not IFS whitespace, so
# `read -ra` preserves empty fields between it. A resolved value is also folded back to the
# opaque marker, even when resolve_parts did produce one, if it contains a raw tab/newline/CR/
# \x1f byte: a quoted argument may legitimately embed one of these (a multi-line commit
# message, a tab-containing pathspec), and letting it through as-is would corrupt this
# \x1f-joined transport - the words line never had this risk, since quoted text was always
# opaque there - and no flag this scan ever matches contains whitespace, so folding these to
# opaque costs nothing real. A $'...' (ANSI-C quoted) word is a separate case: with no backslash escape its
# source text already is its value, resolved like any other quoting, but with an escape
# (\t, \x2d, \045, ...) the source text and the decoded value differ and this hook does not
# implement bash's ANSI-C decoding rules, so it gets its own distinct sentinel instead
# (ANSI_C_ESCAPE_MARKER, a different codepoint from the opaque marker so the two can never
# collide, computed once above) rather than being silently resolved to raw, undecoded escape
# syntax or folded into the opaque marker itself - check_hook_bypass_flags fails closed on it
# explicitly rather than either. Kept as a separate line rather than
# widening the words line's own resolution: the "an obfuscated git name is opaque to this
# hook" test relies on the words line staying conservative for the command-name/-C gate,
# which must keep treating adjacent-quoted-literal splicing as opaque and deferring to
# reject-obfuscated-commands upstream - only the hook-bypass argument scan benefits from the
# richer resolution). A fourth quoting form - a bare backslash in an unquoted word, e.g.
# --no-\verify - is decoded too (#1399 code review round 3): outside any quoting, bash's own
# rule is simply "drop the backslash, keep the next character literally" for any character
# (not just shell metacharacters), so shfmt's raw, undecoded Lit.Value (which keeps the
# backslash - confirmed live via shfmt --tojson) is exactly one gsub away from the real
# argument value, unlike the ANSI-C case above where decoding would mean reimplementing a
# whole escape-sequence table. This decode applies only to a Lit part at the top level of an
# arg's own Parts (resolve_parts' new `unquoted` flag, true only for that top-level call);
# a Lit nested inside a DblQuoted keeps its raw text unchanged, since backslash inside double
# quotes is special only before $, `, ", \ and newline - not before an arbitrary letter like
# the unquoted case - so "--no-\verify" in quotes really does stay --no-\verify at runtime
# and must not be decoded the same way.
# richer resolution). Read below in two pure-bash passes over this same already-computed
# string - no further jq forked per call: the first scans only the words lines to answer
# "does cd appear anywhere in the command" (the auto-correction gate - see the header
# comment), which must be known in full before the first block-or-rewrite decision, not
# discovered mid-walk; the second is the real per-call processing loop.
calls=$(printf '%s' "$ast" | jq -r '
  def resolve_parts(unquoted):
    if length == 0 then ""
    else
      reduce .[] as $p (
        "";
        if . == null then null
        elif $p.Type == "Lit" then
          . + (if unquoted then ($p.Value | gsub("\\\\(?<c>.)"; "\(.c)")) else $p.Value end)
        elif $p.Type == "SglQuoted" then . + ($p.Value // "")
        elif $p.Type == "DblQuoted" then
          (($p.Parts // []) | resolve_parts(false)) as $inner
          | (if $inner == null then null else . + $inner end)
        else null
        end
      )
    end;
  .. | objects | select(.Type? == "CallExpr") | select((.Args // [] | length) > 0) |
  ([ .Args[] | if (.Parts | length) == 1 and .Parts[0].Type == "Lit" then .Parts[0].Value else "\u0001" end ] | join("\t")),
  ([ .Args[] | (.End.Offset | tostring) ] | join("\t")),
  ([ .Args[] |
     if (.Parts | any(.Type == "SglQuoted" and (.Dollar // false) and ((.Value // "") | test("\\\\")))) then
       ([2] | implode)
     else
       (.Parts | resolve_parts(true)) as $r |
       if $r == null or ($r | explode | any(. == 9 or . == 10 or . == 13 or . == 31)) then
         ([1] | implode)
       else
         $r
       end
     end
  ] | join(""))
')

# Directory-changing command names that gate the auto-correction feature below - same
# reasoning as is_wrapper()/WRAPPERS above, reused rather than a bespoke check: a plain or
# backslash-escaped `cd`/`pushd`/`popd`, or one immediately after a known wrapper name (e.g.
# `command cd ...`, `builtin cd ...`), all really do change the shell's working directory.
CD_NAMES=(cd pushd popd '\cd' '\pushd' '\popd')

is_cd_name() {
  local w
  for w in "${CD_NAMES[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

# A directory-changing call appearing anywhere in the command, at any nesting depth, in the
# command-name position (or immediately after a wrapper name in that position) gates the
# auto-correction feature below: this hook parses statically and never runs any part of the
# command, so such a call earlier in program order means its own $PWD is no longer a safe
# stand-in for what a later bare git call in the same command would actually see.
HAS_CD=false
while IFS= read -r words_line && IFS= read -r _ends_line && IFS= read -r _resolved_line; do
  [ -z "$words_line" ] && continue
  IFS=$'\t' read -ra cd_check_words <<< "$words_line"
  if is_cd_name "${cd_check_words[0]}"; then
    HAS_CD=true
  elif is_wrapper "${cd_check_words[0]}" && is_cd_name "${cd_check_words[1]:-}"; then
    HAS_CD=true
  fi
done <<< "$calls"

# Populated only when at least one call needs a missing -C rewritten; each entry is a byte
# offset into raw_cmd, immediately after a git token, at which " -C <dir>" is spliced in.
# Insertions are applied highest-offset-first so an earlier (lower-offset) insertion still to
# be applied is never shifted by one already made.
INSERT_OFFSETS=()
# The directory injected via -C. Always the hook's own $PWD, never `git rev-parse
# --show-toplevel`'s output: -C's target also anchors relative pathspec resolution, so
# injecting the repo root instead of $PWD would silently change what a call with a relative
# path argument operates on whenever the hook runs from a subdirectory of the repo, not just
# its root. `git rev-parse --show-toplevel` below is used purely as an existence check - does
# $PWD sit inside a real, enclosing git repository - never as the value injected.
INJECT_DIR=""
# 0 = not yet attempted, 1 = resolved ($PWD is inside a git working tree and is itself
# writable), 2 = attempted and failed (not inside a repository, or $PWD is not writable) -
# computed at most once per hook invocation, not once per call: every bare-git call in one
# command shares the same hook $PWD.
PWD_RESOLVED=0

# Called at the exact point this hook would otherwise block for a missing -C (see the
# "Auto-correcting a missing -C" header comment for the full reasoning). Blocks (exits 2)
# instead of queuing a rewrite whenever this hook cannot be confident the injected directory
# is both correct and real: a directory-changing call anywhere in the command, no enclosing
# git repository at the hook's own $PWD, or a $PWD that is not writable.
maybe_autocorrect_or_block() {
  local offset="$1" msg='git commands must use "git -C <dir>" format'
  [ "$HAS_CD" = "true" ] && block "$msg"
  if [ "$PWD_RESOLVED" -eq 0 ]; then
    if git rev-parse --show-toplevel > /dev/null 2>&1 && [ -w "$PWD" ]; then
      INJECT_DIR="$PWD"
      PWD_RESOLVED=1
    else
      PWD_RESOLVED=2
    fi
  fi
  [ "$PWD_RESOLVED" -eq 2 ] && block "$msg"
  INSERT_OFFSETS+=("$offset")
}

# Applies the `git config` policy documented in the header. Reads the
# surrounding loop's state: words (tokens of the call), j (index of the
# `config` token), has_C. Either blocks (exits) or returns 0 to allow.
check_config_call() {
  local global_scope="" read_flag="" write_flag="" nonflag=0 k tk
  k=$((j + 1))
  while [ "$k" -lt "${#words[@]}" ]; do
    tk="${words[$k]}"
    case "$tk" in
      --global | --system) global_scope="$tk" ;;
      --get | --get-all | --get-regexp | --get-urlmatch | --list | -l) read_flag="$tk" ;;
      --add | --replace-all | --unset | --unset-all) write_flag="$tk" ;;
      --edit | -e | --file | -f | --blob | --rename-section | --remove-section)
        block "git config ${tk} is not permitted"
        ;;
      -*) : ;;
      *) nonflag=$((nonflag + 1)) ;;
    esac
    k=$((k + 1))
  done

  # A write is any explicit write flag, or the plain `git config key value`
  # set form (no read flag, more than one non-flag token — non-literal
  # tokens count via the \u0001 marker, so a quoted/variable value cannot
  # disguise a write as a single-key read). git config is strictly
  # read-only for sessions, at every scope.
  if [ -n "$write_flag" ] || { [ -z "$read_flag" ] && [ "$nonflag" -gt 1 ]; }; then
    block 'git config writes are not permitted at any scope'
  fi

  # Read: global/system reads with an explicit read flag are safe anywhere;
  # everything else needs -C like the rest of git.
  [ -n "$global_scope" ] && [ -n "$read_flag" ] && return 0
  [ "$has_C" = 1 ] && return 0
  maybe_autocorrect_or_block "${ends[$i]}"
  return 0
}

# Blocks the git-hook-bypass flag (#1399) on subcommands whose hooks it
# actually skips (GIT_SUBCOMMANDS_HOOK_BYPASS_CHECK above). Reads the
# surrounding loop's state: resolved (per-word values, quoted literals
# unwrapped - see the "calls" extraction comment above; words/j/sub are left
# untouched, only this scan benefits from the richer resolution), j (index
# of the subcommand token), sub (subcommand name). See
# ai/local/claude-hooks.instructions.md for why -n is scoped to commit only,
# why -[!-]* avoids misreading long flags as bundles, why -F/-c/-C values
# are skipped, why -m consumes a value only on commit/merge/cherry-pick, and
# why a bundle is walked character-by-character rather than scanned as a
# whole (#1399 code review round 6).
check_hook_bypass_flags() {
  local k=$((j + 1)) tk
  while [ "$k" -lt "${#resolved[@]}" ]; do
    tk="${resolved[$k]}"
    case "$tk" in
      "$ANSI_C_ESCAPE_MARKER")
        block "git ${sub}: an ANSI-C quoted (\$'...') argument with escape sequences cannot be checked for a hook-bypass flag - spell it out plainly instead"
        ;;
      --no-verify | --no-v | --no-ve | --no-ver | --no-veri | --no-verif)
        block "git ${sub} --no-verify is not permitted - hook bypass is blocked"
        ;;
      -m) case "$sub" in commit | merge | cherry-pick) k=$((k + 1)) ;; esac ;;
      -F | -c | -C) k=$((k + 1)) ;;
      -m* | -F* | -c* | -C*) : ;;
      -[!-]*)
        # Walked one character at a time to match git's own short-option bundling rule
        # exactly: the instant a value-consuming letter (F/c/C anywhere, m only on
        # commit/merge/cherry-pick) is hit, every character remaining in this token is
        # its attached value - not a further flag - regardless of position (confirmed
        # live: `git commit -aCbogusrev` and `git commit -Cbogusrev` fail identically,
        # both resolving "bogusrev" as -C's value). Only when nothing remains after that
        # letter does it fall through to consuming the *next* word instead (the
        # bundle-trailing case, #1399 code review round 4). A whole-token substring test
        # for the letter n (this scan's previous approach) got this wrong whenever such a
        # letter appeared anywhere but first in the bundle: `-aFnotes.txt` is `-a -F
        # notes.txt` with no -n flag at all, yet the old substring test matched the n
        # inside "notes.txt" and falsely blocked it (#1399 code review round 6).
        local bundle="${tk:1}" pos=0 bc
        while [ "$pos" -lt "${#bundle}" ]; do
          bc="${bundle:$pos:1}"
          case "$bc" in
            n)
              [ "$sub" = "commit" ] && block 'git commit -n is not permitted - hook bypass is blocked'
              ;;
            F | c | C)
              [ "$((pos + 1))" -eq "${#bundle}" ] && k=$((k + 1))
              break
              ;;
            m)
              case "$sub" in
                commit | merge | cherry-pick)
                  [ "$((pos + 1))" -eq "${#bundle}" ] && k=$((k + 1))
                  ;;
              esac
              break
              ;;
          esac
          pos=$((pos + 1))
        done
        ;;
    esac
    k=$((k + 1))
  done
}

while IFS= read -r words_line && IFS= read -r ends_line && IFS= read -r resolved_line; do
  [ -z "$words_line" ] && continue
  IFS=$'\t' read -ra words <<< "$words_line"
  IFS=$'\t' read -ra ends <<< "$ends_line"
  IFS=$'\x1f' read -ra resolved <<< "$resolved_line"

  # Fails closed on a desync between the three paired lines (e.g. a future edit to the jq
  # query above changing one line's word count but not the others') rather than silently
  # splicing at a wrong offset, or scanning the wrong resolved value against the wrong word -
  # consistent with this hook's fail-closed design throughout.
  { [ "${#words[@]}" -eq "${#ends[@]}" ] && [ "${#words[@]}" -eq "${#resolved[@]}" ]; } ||
    block 'internal parse desync between words, offsets and resolved values - failing closed'

  case "${words[0]}" in
    eval | source | .)
      block "git hardening cannot be verified inside ${words[0]} - use a plain git -C <dir> command instead"
      ;;
  esac

  # Only the command-name position, and the position immediately after a
  # known wrapper name in the command-name position, are checked — a `git`
  # token appearing anywhere else is an ordinary argument, not a git
  # invocation (e.g. `grep -r git .`, `find . -name git`).
  positions=(0)
  is_wrapper "${words[0]}" && positions+=(1)

  for i in "${positions[@]}"; do
    tok="${words[$i]:-}"
    if [ "$tok" = "git" ] || [[ "$tok" == */git ]]; then
      j=$((i + 1))
      # skip `-c <key>=<value>` global option pairs before -C
      while [ "${words[$j]:-}" = "-c" ]; do
        j=$((j + 2))
      done
      has_C=0
      if [ "${words[$j]:-}" = "-C" ]; then
        has_C=1
        j=$((j + 2))
        # `-c` pairs may also follow -C
        while [ "${words[$j]:-}" = "-c" ]; do
          j=$((j + 2))
        done
      fi
      sub="${words[$j]:-}"

      if [ -z "$sub" ]; then
        block "git commands must include a subcommand"
      elif ! is_allowed_subcommand "$sub"; then
        block "git subcommand '${sub}' is not permitted"
      fi

      in_list "$sub" "${GIT_SUBCOMMANDS_HOOK_BYPASS_CHECK[@]}" && check_hook_bypass_flags

      if in_list "$sub" "${GIT_SUBCOMMANDS_BESPOKE_POLICY[@]}"; then
        check_config_call
        continue
      fi

      [ "$has_C" = 1 ] && continue
      in_list "$sub" "${GIT_SUBCOMMANDS_NO_REPO[@]}" && continue

      maybe_autocorrect_or_block "${ends[$i]}"
      continue
    fi
  done
done <<< "$calls"

if [ "${#INSERT_OFFSETS[@]}" -gt 0 ]; then
  insertion=" -C $(printf '%q' "$INJECT_DIR")"
  mapfile -t sorted_offsets < <(printf '%s\n' "${INSERT_OFFSETS[@]}" | sort -rn -u)
  new_cmd="$raw_cmd"
  for off in "${sorted_offsets[@]}"; do
    new_cmd="${new_cmd:0:off}${insertion}${new_cmd:off}"
  done
  # Merge into the original tool_input, not jq -n from scratch - see
  # claude-hooks.instructions.md's auto-correction checklist for why.
  printf '%s' "$input" | jq --arg cmd "$new_cmd" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow", updatedInput: ((.tool_input // {}) + {command: $cmd})}}'
fi

exit 0
