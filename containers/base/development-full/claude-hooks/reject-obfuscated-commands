#!/usr/bin/env bash
# Categorically rejects any Bash command that is not built from plain,
# obviously-spelled commands, using a real shell parser instead of text
# scanning.
#
# History (PR #1159 / issue #1105): eight code-review rounds each found a new
# bypass in the previous, hand-rolled regex/character-scanning approach —
# separators, keyword prefixes, quote-splicing, ${IFS} word-splitting,
# brace expansion, redirection prefixes, wrapper flags (`env -i`), and
# eval — because approximating shell tokenization with text scanning is an
# arms race that never converges. This version delegates parsing to shfmt
# (mvdan/sh — a complete, battle-tested shell parser, already baked into
# this image and self-checked by the Dockerfile) and applies policy to the
# resulting AST instead. A new obfuscation technique needs no change here:
# anything that does not parse into plain-literal command words is rejected
# by shape, not by enumerating tricks.
#
# Decision layers, in order (all fail closed):
#   0. A fixed, small table of known-benign Unicode punctuation (em/en dash,
#      curly quotes, arrows, ellipsis, non-breaking space) is normalized to
#      its plain-ASCII equivalent first — AI-authored commands routinely
#      pick this up as gratuitous formatting, not obfuscation. Any
#      non-printable or non-ASCII byte still present after that fixed
#      substitution (control bytes, homoglyphs, zero-width/bidi-override
#      characters, or anything else outside the table): reject. If
#      normalization changed anything and the command clears every layer
#      below, the normalized command is returned via
#      hookSpecificOutput.updatedInput instead of the original — the
#      command that actually runs is the corrected one, not a shrug.
#   1. shfmt missing, or the command does not parse as shell: reject.
#   2. Structure: function definitions and declare/export/local/readonly
#      clauses are rejected outright; every environment-variable assignment
#      (standalone or per-command prefix) must not target a variable on
#      env-var-blocklist; every command name in the AST — at any nesting
#      depth, including inside $(...)/backtick substitutions — must be a
#      single plain literal word matching ^[A-Za-z0-9_./][A-Za-z0-9_./-]*$,
#      with one carved-out exception: the literal single-character name `[`
#      (the `test` builtin's bracket form).
#      Anything else (quote-splice, escape, substitution, brace expansion,
#      leading redirection or dash) is obfuscation by definition: reject.
#   3. Known interpreters handed an inline-code flag (bash -c, python3 -c,
#      perl -e, ...): reject — the string argument is a second command line
#      this hook cannot see into.
#   4. command-blocklist (known-bad names: eval, sub-shells, wrapper
#      commands like env/nice/sudo that can smuggle another command behind
#      their own flag grammar): reject with a per-name message.
#   5. command-allowlist (known-good names): anything not listed is
#      rejected. Extending policy = adding one line to a data file, not
#      changing this logic. Path-qualified names (/usr/bin/git, ./git,
#      <hooks-path>/pre-commit) are matched by basename.
#
# Deliberate residual gaps (accepted, ~1%): a listed command doing damage
# via plain arguments (the claude-settings.json allow/deny layer covers
# that), and writing a script file then executing it under an allowlisted
# basename — no command-string filter can close that class.
#
# This hook runs first in the PreToolUse chain. Exit 2 = blocked, 0 = allowed.

# Byte-exact pattern semantics regardless of the host locale: under a UTF-8
# collation locale (e.g. en_GB.UTF-8), the bash range [ -~] does NOT mean
# "printable ASCII" and misclassifies ordinary letters.
export LC_ALL=C

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

COMMAND_ALLOWLIST="${HOOK_DIR}/command-allowlist"
COMMAND_BLOCKLIST="${HOOK_DIR}/command-blocklist"
ENV_VAR_BLOCKLIST="${HOOK_DIR}/env-var-blocklist"

# The message says the command never ran (not "blocked mid-run") because a denial is easy to
# misread as "started, now wait for it" - which then waits forever, since a denied call never
# started in the first place (#1281).
block() {
  printf 'Blocked (command did not run - fix and retry, do not wait for it): %s\n' "$1" >&2
  exit 2
}

# Interpreters whose inline-code flag hands them a string to parse and run
# as a brand-new command line this hook cannot see into. Sub-shells are
# additionally banned outright via command-blocklist; this check exists so
# an interpreter that IS allowlisted for running script files (python3)
# still cannot be handed inline code, and so the error message names the
# actual problem.
INTERPRETERS=(bash sh dash zsh ksh mksh csh tcsh fish python python2 python3 perl perl5 ruby irb node nodejs deno php lua lua5.1 lua5.3 tclsh wish osascript)
# Flags that hand virtually every interpreter above a literal string of code
# to run, so they are checked whatever the interpreter is.
INLINE_CODE_FLAGS=(-c -e --eval --command -ne -pe)
# Flags that only mean "run code" for node: -p/--print is node's inline
# "evaluate and print" flag, and -i/--interactive starts node's REPL - not
# itself an inline-code flag, but exactly as dangerous as one. For the shells
# in INTERPRETERS -p is privileged mode and -i is an ordinary interactive
# shell, neither of which runs a string of code, so checking these for every
# interpreter would misreport them as inline-code re-invocation. A bare `node`
# with no recognised flag at all falls through with nothing to check here; a
# script-path argument is required by permissions.allow, not by this hook.
# node -c is blocked too even though it is node's own --check alias, because
# -c is in the shared set above; use node --check instead.
NODE_ONLY_INLINE_FLAGS=(-p --print -i --interactive)

is_interpreter() {
  local w
  for w in "${INTERPRETERS[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

# $1 is the argument word, $2 the interpreter's base name.
#
# Known, accepted limitation (#1545): Layer 3/3b call this for every
# argument after the interpreter name, not only the positions where the
# interpreter itself still parses options. A script's own argument that
# looks like an inline-code flag is therefore rejected too, whether it is
# an exact match (node .github/actions/a/b.js -p) or matches the glued
# short-flag case below (python3 script.py -env prod, python3 -m pytest
# -pno:cacheprovider, node .github/actions/a/b.js -config x). This fails
# closed, so nothing is exploitable. Stopping the scan at the first
# non-dash argument is not a safe fix: it would reopen shapes such as
# python3 -W ignore -c code, where an option's value comes before the real
# flag. A correct fix needs per-interpreter argument-position tracking.
is_inline_code_flag() {
  local f
  local -a flags=("${INLINE_CODE_FLAGS[@]}")
  case "$2" in
    node | nodejs) flags+=("${NODE_ONLY_INLINE_FLAGS[@]}") ;;
  esac
  for f in "${flags[@]}"; do
    [ "$1" = "$f" ] && return 0
    # A long flag glued to its value with '=' (node --eval="code",
    # --print="code") is exactly as dangerous as the space-separated form
    # and is not caught by the exact-match check above.
    case "$f" in
      --*) [ "${1#"${f}"=}" != "$1" ] && return 0 ;;
    esac
  done
  # A short inline-code flag glued directly to its value with no separator
  # (node -ecode, -pcode, python3 -ccode, perl -peCODE - accepted the same
  # way -C3 works for other tools) is also not caught by the exact-match
  # check above. Deliberately shared across every interpreter, -p?* included:
  # a glued -p word is perl/ruby's -pe with its code attached as well as
  # node's -p, while a shell's privileged-mode -p is always passed on its own.
  case "$1" in
    -c?* | -e?* | -p?*) return 0 ;;
  esac
  return 1
}

input=$(cat)
raw_cmd=$(printf '%s' "$input" | jq -r '.tool_input.command // .command // ""')

[ -z "$raw_cmd" ] && exit 0

# ---- Layer 0: normalize known-benign punctuation, then require printable
# ASCII only ------------------------------------------------------------
# AI-authored commands often contain "smart" punctuation (em/en dash, curly
# quotes, arrows, ellipsis, non-breaking space) that is gratuitous
# formatting, not obfuscation. Rewrite exactly this fixed, small,
# unconditionally-applied substitution table before the ASCII check; every
# other byte — control bytes, homoglyphs of shell metacharacters,
# zero-width/bidi-override characters, or any non-ASCII byte not in this
# table — still blocks exactly as before. This cannot loosen the check: the
# table never grows implicitly and nothing outside it is ever accepted.
cmd="$raw_cmd"
cmd=${cmd//$'\xe2\x80\x94'/-}   # em dash -> hyphen
cmd=${cmd//$'\xe2\x80\x93'/-}   # en dash -> hyphen
cmd=${cmd//$'\xe2\x80\x98'/\'}  # left single quote -> '
cmd=${cmd//$'\xe2\x80\x99'/\'}  # right single quote -> '
cmd=${cmd//$'\xe2\x80\x9c'/\"}  # left double quote -> "
cmd=${cmd//$'\xe2\x80\x9d'/\"}  # right double quote -> "
cmd=${cmd//$'\xc2\xa0'/ }       # non-breaking space -> space
cmd=${cmd//$'\xe2\x86\x92'/->}  # right arrow -> ->
cmd=${cmd//$'\xe2\x86\x90'/<-}  # left arrow -> <-
cmd=${cmd//$'\xe2\x80\xa6'/...} # ellipsis -> ...

NON_PRINTABLE_RE=$'[^ -~\t\n\r]'
if [[ "$cmd" =~ $NON_PRINTABLE_RE ]]; then
  block 'command contains non-printable or non-ASCII characters'
fi

# ---- Layer 1: parse with a real shell parser (fail closed) -----------------
command -v shfmt > /dev/null 2>&1 || block 'shfmt is not available to parse the command - failing closed'

ast=$(printf '%s' "$cmd" | shfmt --tojson 2> /dev/null) || block 'command could not be parsed as shell - not a simple, obvious command'

# ---- Layer 2: structural policy on the AST ----------------------------------

if [ "$(printf '%s' "$ast" | jq '[.. | objects | select(.Type? == "FuncDecl")] | length')" != "0" ]; then
  block 'defining shell functions is not a simple, obvious command'
fi

if [ "$(printf '%s' "$ast" | jq '[.. | objects | select(.Type? == "DeclClause")] | length')" != "0" ]; then
  block 'declare/export/local/readonly clauses are not permitted - not a simple, obvious command'
fi

# Every assigned variable name (standalone `FOO=bar` statements and
# per-command `FOO=bar cmd` prefixes alike) is checked against the env-var
# blocklist: assignments to parser/loader/git-identity variables (IFS, PATH,
# LD_PRELOAD, GIT_*, ...) change what other commands mean or bypass the git
# identity guardrails, so they are rejected even though the command itself
# may be plain. The blocklist is loaded once, not re-read from disk per
# assignment.
mapfile -t env_var_patterns < <(grep -vE '^[[:space:]]*(#|$)' "$ENV_VAR_BLOCKLIST" 2> /dev/null)

while IFS= read -r var; do
  [ -z "$var" ] && continue
  for pattern in "${env_var_patterns[@]}"; do
    [ -z "$pattern" ] && continue
    # Case-insensitive: npm matches npm_config_* env keys with /i, so
    # NPM_config_script_shell=... is honoured as much as npm_config_... is,
    # and a glob matched under LC_ALL=C is case-sensitive (#1385 security
    # review). Both sides lower-cased, so an all-caps pattern (PATH, GIT_*)
    # keeps matching its own spelling too.
    # shellcheck disable=SC2254  # patterns from the blocklist file are globs by design
    case "${var,,}" in
      ${pattern,,})
        block "assignment to ${var} is not permitted - it changes how other commands are interpreted"
        ;;
    esac
  done
done < <(printf '%s' "$ast" | jq -r '.. | objects | select(.Type? == "CallExpr") | .Assigns[]? | .Name.Value // empty')

# Emit two lines per CallExpr anywhere in the AST (at any nesting depth:
# $(...)/backtick substitutions, loop and if bodies, pipelines, subshells,
# process substitutions): the words line (command-name word followed by each
# argument word, tab-separated - a word that is anything other than a single
# plain literal is represented as a \x01 marker; layer 0 already guarantees a
# real \x01 byte can never appear in the input, so the marker is unambiguous,
# and it fails the command-name allowlist regex), then the resolved line
# (same approach as enforce-git-dash-c's own resolve_parts, trimmed to just
# the Lit/SglQuoted/DblQuoted-of-only-those-parts concatenation - no
# unquoted-backslash decode, no ANSI-C-escape sentinel). Unlike that hook's
# own --no-verify check, the ANSI-C gap here IS load-bearing where an
# interpreter has a broad, unscoped allow entry (e.g. the pre-existing
# Bash(python3 *)): python3 $'\x2d\x63' '...' passes this check, since
# shfmt stores an ANSI-C string's raw, undecoded source text in Lit.Value,
# not the runtime value bash actually passes - tracked as #1552, not fixed
# here. It does not chain to a working bypass for node specifically, since
# every node permissions.allow shape requires the .github/actions/*/*.js
# script path to be node's first positional argument, and node stops
# parsing its own flags there.
#
# The resolved line itself exists because the words line's own "single Lit part" test
# treats a glued flag+quoted-value word (node --eval="code", node -e"code")
# as opaque and skips it entirely in the interpreter-flag check below, which
# is exactly the shape needed to run inline code once node is on
# command-allowlist. Resolving a word entirely built from literal/quoted
# pieces - even when the value itself is dynamic-looking, since the shell
# has already stripped the quoting before the interpreter ever sees it -
# closes that gap; a word containing a genuine expansion ($VAR, $(...), ...)
# still folds to the same \x01 marker as the words line's own opaque case,
# since its real value cannot be known statically. Used only for the
# interpreter-flag check (Layer 3/3b below), never for command-name/
# allowlist identification, which stays on the words line - matching
# enforce-git-dash-c's own stated rationale for the same split. Joined with
# \x1f (unit separator), not tab, because a resolved value can genuinely be
# an empty string and `IFS=$'\t' read -ra` collapses consecutive tabs,
# silently dropping an empty field and desyncing the array against words;
# \x1f is not IFS whitespace, so empty fields survive between delimiters.
# An empty resolved value is still folded to the marker, though, because
# `read -ra` drops a trailing empty field even with a non-whitespace IFS
# (`cmd a ""` would otherwise leave resolved one entry shorter than words).
# A value on either line containing a raw tab/newline/CR/\x1f byte is also
# folded back to the marker (unsafe_for_transport): a quoted argument may
# legitimately embed one, and so may a plain single-Lit word, since shfmt
# keeps an unquoted backslash-escaped tab (`a\<TAB>b`, one word at runtime)
# as a single Lit whose raw Value still contains the tab byte. Left as-is,
# that one word would split into two words[] entries while resolved[] kept
# one, shifting every later words[i]/resolved[i] pairing so Layer 3/3b read
# the wrong argument and could miss a real inline-code flag. No flag this
# check matches contains whitespace or is empty, so folding costs nothing
# real, and the loop below also fails closed if the two lines ever split
# into different field counts. The jq program itself is guarded the same
# way as the ast=$(...) assignment above: if it errored, $calls would be
# empty, the loop would process nothing and the hook would fall through to
# exit 0.
calls=$(printf '%s' "$ast" | jq -r '
  def resolve_parts:
    if length == 0 then ""
    else
      reduce .[] as $p (
        "";
        if . == null then null
        elif $p.Type == "Lit" then . + $p.Value
        elif $p.Type == "SglQuoted" then . + ($p.Value // "")
        elif $p.Type == "DblQuoted" then
          (($p.Parts // []) | resolve_parts) as $inner
          | (if $inner == null then null else . + $inner end)
        else null
        end
      )
    end;
  def unsafe_for_transport:
    . == null or . == "" or (explode | any(. == 9 or . == 10 or . == 13 or . == 31));
  .. | objects | select(.Type? == "CallExpr") | select((.Args // [] | length) > 0) |
  ([ .Args[] |
     (if (.Parts | length) == 1 and .Parts[0].Type == "Lit" then .Parts[0].Value else null end) as $w |
     if ($w | unsafe_for_transport) then "\u0001" else $w end
  ] | join("\t")),
  ([ .Args[] |
     (.Parts | resolve_parts) as $r |
     if ($r | unsafe_for_transport) then "\u0001" else $r end
  ] | join("\u001f"))
') || block 'command AST could not be analysed - failing closed'

MARKER=$'\x01'
# `[` (the `test` builtin's bracket form) is a single-character command name
# that the generic pattern below cannot match (it requires an alnum/_/./
# leading character); it is carved out as its own literal alternative rather
# than loosening the generic pattern, so no other punctuation-led name is
# newly permitted. `]` is never checked here - it is a trailing argument
# word, not the command name.
NAME_RE='^(\[|[A-Za-z0-9_./][A-Za-z0-9_./-]*)$'

# Loaded once, not re-read from disk per CallExpr.
mapfile -t command_blocklist_lines < <(grep -vE '^[[:space:]]*(#|$)' "$COMMAND_BLOCKLIST" 2> /dev/null)
mapfile -t command_allowlist < <(grep -vE '^[[:space:]]*(#|$)' "$COMMAND_ALLOWLIST" 2> /dev/null)

is_allowlisted() {
  local w
  for w in "${command_allowlist[@]}"; do
    [ "$1" = "$w" ] && return 0
  done
  return 1
}

# Blocks if any argument from index $1 onwards is an inline-code flag for the
# interpreter whose base name is $2. Shared by Layer 3 (the command name is
# the interpreter) and Layer 3b (an argument names a nested interpreter).
# Reads the current call's resolved array, which the loop below has already
# checked is index-aligned with words.
check_inline_flags_from() {
  local i arg
  for ((i = $1; i < ${#resolved[@]}; i++)); do
    arg="${resolved[$i]}"
    [ "$arg" = "$MARKER" ] && continue
    if is_inline_code_flag "$arg" "$2"; then
      block 'interpreter re-invocation with inline code is not a simple, obvious command'
    fi
  done
}

while IFS= read -r call_line && IFS= read -r resolved_line; do
  [ -z "$call_line" ] && continue
  IFS=$'\t' read -ra words <<< "$call_line"
  IFS=$'\x1f' read -ra resolved <<< "$resolved_line"
  # Layers 3/3b pair words[i] with resolved[i] by index; if some unforeseen
  # AST shape ever makes the two transports split into different field
  # counts, every later pairing is wrong and an inline-code flag can be
  # read at the wrong index, so fail closed rather than check misaligned
  # data.
  if [ "${#words[@]}" -ne "${#resolved[@]}" ]; then
    block 'command arguments could not be analysed consistently - failing closed'
  fi
  name="${words[0]}"

  if ! [[ "$name" =~ $NAME_RE ]]; then
    block 'command name is quoted, escaped, or dynamically substituted - not a simple, obvious command'
  fi

  base="${name##*/}"

  # ---- Layer 3: interpreter re-invocation (command name itself) --------
  if is_interpreter "$base"; then
    check_inline_flags_from 1 "$base"
  fi

  # ---- Layer 4a: narrow, argument-scoped allowance for `set -e` --------
  # `set -e` (exit-on-error) at the top of a multi-statement script is
  # common, safe, AI-authored shell hygiene (#1349) - but `set` is
  # deliberately NOT added to command-allowlist wholesale: that would also
  # permit `set -x` (tracing every subsequent command, including argument
  # values, to the log), `set -o <anything>` (reconfiguring shell option
  # state generally), `set -- ...` (reassigning positional parameters), and
  # bare `set` (dumping every shell variable and its value - including
  # anything secret - to stdout). Only this single, argument-free-except-`-e`
  # invocation is allowed; everything else naming `set` still falls through
  # to Layer 5 and is rejected there, since `set` itself is absent from
  # command-allowlist.
  if [ "$base" = "set" ] && [ "${#words[@]}" -eq 2 ] && [ "${words[1]}" = "-e" ]; then
    continue
  fi

  # ---- Layer 4: known-bad names ----------------------------------------
  blocked_reason=""
  for entry in "${command_blocklist_lines[@]}"; do
    bad_name="${entry%%$'\t'*}"
    [ -z "$bad_name" ] && continue
    if [ "$base" = "$bad_name" ]; then
      bad_reason="${entry#*$'\t'}"
      [ "$bad_reason" = "$entry" ] && bad_reason=""
      blocked_reason="${bad_reason:-is not permitted - no legitimate need for it in this workflow}"
      break
    fi
  done
  if [ -n "$blocked_reason" ]; then
    block "${base} ${blocked_reason}"
  fi

  # ---- Layer 3b: interpreter re-invocation (nested in an arg) ----------
  # An allowlisted runner (uv, npx, bun, npm, ...) can itself launch another
  # interpreter as a plain argument (`uv run python3 -c "..."`); that
  # nested interpreter's inline-code flag is exactly as dangerous as if it
  # had been the command name, so scan every argument word (not just
  # words[0], already covered by Layer 3 above) for a nested interpreter
  # name and check what follows it too. The interpreter name itself is
  # identified from the words line (command identification stays there, per
  # the resolved line's own header comment); the flag scan after it uses
  # the resolved line, same as Layer 3 above.
  for idx in "${!words[@]}"; do
    [ "$idx" -eq 0 ] && continue
    tok="${words[$idx]}"
    [ "$tok" = "$MARKER" ] && continue
    if is_interpreter "${tok##*/}"; then
      check_inline_flags_from $((idx + 1)) "${tok##*/}"
    fi
  done

  # ---- Layer 5: known-good names only ----------------------------------
  if ! is_allowlisted "$base"; then
    block "${base} is not on the known-good command allowlist - extend ${COMMAND_ALLOWLIST##*/} if it is legitimately required"
  fi
done <<< "$calls"

# Everything above ran against the normalized command and none of it
# blocked. If Layer 0's substitution table actually changed anything, hand
# the normalized command back so it's what actually executes — rather than
# just allowing the original text, which would still contain the
# now-pointless Unicode punctuation.
#
# Merge into the original tool_input, not jq -n from scratch - see
# claude-hooks.instructions.md's auto-correction checklist for why (same
# defect as enforce-git-dash-c's missing-`-C` auto-correct).
if [ "$cmd" != "$raw_cmd" ]; then
  printf '%s' "$input" | jq --arg cmd "$cmd" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow", updatedInput: ((.tool_input // {}) + {command: $cmd})}}'
fi

exit 0
