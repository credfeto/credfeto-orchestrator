      "type": "http",
      "url": "https://workflow-mcp.markridgwell.com/mcp",
      "headersHelper": "/etc/claude-code/mcp/cfwf-mcp-headers"
    },
    "kb": {
      "type": "http",
      "url": "https://memory.markridgwell.com/dev/mcp",
      "headersHelper": "/etc/claude-code/mcp/kb-mcp-headers"
    },
    "build-dotnet": {
      "type": "stdio",
      "command": "/home/developer/.dotnet/tools/credfeto-build-dotnet",
      "env": {
        "BUILD_MCP_REPO_ROOT": "/workspace/repo"
      }
    }
  }
}
