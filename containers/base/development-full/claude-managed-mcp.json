{
  "mcpServers": {
    "cfwf": {
      "type": "http",
      "url": "https://workflow-mcp.markridgwell.com/mcp",
      "headersHelper": "/etc/claude-code/mcp/cfwf-mcp-headers"
    },
    "kb": {
      "type": "http",
      "url": "https://memory.markridgwell.com/dev/mcp",
      "headersHelper": "/etc/claude-code/mcp/kb-mcp-headers"
    },
    "build-dotnet": {
      "type": "stdio",
      "command": "/etc/claude-code/mcp/build-dotnet-mcp"
    },
    "changelog": {
      "type": "stdio",
      "command": "/etc/claude-code/mcp/changelog-mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "alwaysLoad": true
    },
    "rider": {
      "url": "http://127.0.0.1:64482/stream",
      "type": "http"
    },
    "webstorm": {
      "url": "http://127.0.0.1:64542/stream",
      "type": "http"
    }
  }
}
