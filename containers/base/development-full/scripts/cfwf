#!/bin/bash

# cfwf (Credfeto WorkFlow): one flat command for each recurring multi-step gh
# pattern that agents would otherwise re-derive as a fresh multi-statement
# script every session. Run `cfwf help` for usage.

readonly ITEM_LIMIT=10000
readonly FIELD_LIMIT=100
readonly LABEL_LIMIT=1000
readonly TITLE_LIMIT=256
readonly LABEL_NAME_LIMIT=50
readonly BODY_LIMIT=65536
readonly BODY_REFUSED_EXIT=8
readonly ISSUE_NOT_FOUND_EXIT=9
# The same code as ISSUE_NOT_FOUND_EXIT, so not found reads alike from pr view, pr comments, pr reply,
# release view, tag view and the issue commands.
readonly PR_NOT_FOUND_EXIT=9
readonly RELEASE_NOT_FOUND_EXIT=9
readonly TAG_NOT_FOUND_EXIT=9
# The verdict codes of pr checks, which every cfwf command that judges checks shares.
readonly CHECKS_FAILED_EXIT=3
readonly CHECKS_PENDING_EXIT=4
readonly NO_CHECKS_EXIT=5
readonly API_PAGE_SIZE=100
# The body leak rules, as extended regular expressions matched byte by byte in the C locale.
# NAME=value, where NAME is upper case and TOKEN, SECRET, KEY or PASSWORD is the whole of it or
# follows an underscore (so MONKEY=banana passes), and the value, after an optional opening quote,
# does not start with $: a value that does is a variable or secret reference such as ${...},
# ${{ ... }} or $NAME, not the secret itself.
readonly SECRET_ASSIGNMENT_PATTERN="(^|[^A-Za-z0-9_])([A-Z0-9_]*_)?(TOKEN|SECRET|KEY|PASSWORD)=[\"']?[^[:space:]\$\"']"
# Prints an extended regular expression for 20 or more token characters, at least one of them a
# digit. ERE has no lookahead, so it says where the first digit is: after 0 to 18 other token
# characters, with enough after it to make 20, or after 19 or more.
bearer_value_pattern() {
    local token='[A-Za-z0-9._~+/=-]' other='[A-Za-z._~+/=-]' alternatives="" before
    for before in {0..18}; do
        alternatives+="${alternatives:+|}${other}{${before}}[0-9]${token}{$((19 - before)),}"
    done
    printf '(%s|%s{19,}[0-9])' "${alternatives}" "${other}"
}
# An Authorization header with a value, as written in a header, a curl -H or JSON: the name, a
# colon or an equals sign and one character that is not whitespace. The scheme is not looked at
# (Basic, Bearer, Digest, Negotiate, a signature), and nor is whether the value is a placeholder,
# so nothing has to tell a secret from an example of one. Nothing has to come before the name, so
# Proxy-Authorization is one too. The name with no value after it, as in prose, passes. The quote
# that closes the name may be escaped with a backslash, as it is in JSON held inside a string.
readonly AUTHORIZATION_HEADER_PATTERN="([Aa]uthorization|AUTHORIZATION)(\\\\?[\"'])?[[:space:]]*[:=][[:space:]]*[^[:space:]]"
# Bearer anywhere and a value of 20 or more token characters with a digit among them, which
# ordinary prose ("a Bearer token", "Bearer authentication-mechanism-description") never has.
BEARER_PATTERN="(^|[^A-Za-z0-9])([Bb]earer|BEARER)[[:space:]]+$(bearer_value_pattern)"
readonly BEARER_PATTERN
# Keys that are a prefix and a set number of characters: an npm token, a Google API key and a
# legacy OpenAI key. The prefix with fewer after it (npm_config_registry) passes; a longer run is
# refused too, since the first of it is a key. TOKEN_PATTERN adds the word start before the prefix,
# so a word ending in sk- passes.
readonly FIXED_LENGTH_KEY_PATTERN='npm_[A-Za-z0-9]{36}|AIza[A-Za-z0-9_-]{35}|sk-[A-Za-z0-9]{48}'
# A password is whatever lies between the colon and the @ of a URL's user:password@host, or after
# the user name x-access-token that a Git remote URL carries a GitHub token under. It cannot hold
# whitespace, a slash, a question mark or a hash: a URL has to percent-encode those in a password,
# and they end the host part of a URL with a port and no password, whose path or query may hold @.
# Nor can it hold a double quote or a backtick, which no URL holds unencoded and which close a URL
# with a port written in JSON or as Markdown code, where an email address may follow with no space.
readonly PASSWORD_PATTERN='[^[:space:]/?#@"`]+'
# What comes before the colon that starts a password: a URL's :// and its user name, which may be
# empty and holds no colon, or the user name x-access-token wherever it is written. A user name
# may hold an unencoded @ (an email address as the login of a mail server URL), the first colon
# being what ends it, so only whitespace, a slash, a question mark and a hash, which end the host
# of a URL with no user name, are left out with the colon: a colon and an @ further on are then in
# the path, the query or the fragment.
readonly URL_USER_PATTERN='://[^[:space:]/:?#]*'
# The password of a credential, from its colon to an @. A password may hold an unencoded @, the
# last one before the host ends being the one that ends it, so it may start with any number of
# them: a colon and an @ with a second @ further on (user:@secret@host) is a password, while an
# empty password (user:@host) has no second one. What the password is does not matter: a
# placeholder is refused like any other, so nothing has to tell a real one from an example.
readonly CREDENTIAL_PASSWORD_PATTERN=":@*${PASSWORD_PATTERN}@"
readonly URL_CREDENTIAL_PATTERN="${URL_USER_PATTERN}${CREDENTIAL_PASSWORD_PATTERN}"
readonly ACCESS_TOKEN_USER_PATTERN="x-access-token${CREDENTIAL_PASSWORD_PATTERN}"
# A Discord webhook URL with its id and the start of its token: the URL is the credential.
readonly DISCORD_WEBHOOK_PATTERN='[Dd]iscord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]'
readonly TOKEN_PATTERN="(^|[^A-Za-z0-9])((gh[porsu]_|xox[abprs]-|glpat-|sk-ant-|sk-proj-)[A-Za-z0-9_-]|${FIXED_LENGTH_KEY_PATTERN}|${ACCESS_TOKEN_USER_PATTERN})|github_pat_[A-Za-z0-9_]|A[KS]IA[0-9A-Z]{16}|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----|${DISCORD_WEBHOOK_PATTERN}|${URL_CREDENTIAL_PATTERN}|${AUTHORIZATION_HEADER_PATTERN}|${BEARER_PATTERN}|${SECRET_ASSIGNMENT_PATTERN}"
# A host path is one of three shapes. First, /home/ and the like at the start of a path: the start
# of a line or after any byte that cannot continue a word or a relative path (a letter, digit, dot,
# tilde or dash), so ./tmp/ and ~/tmp/ pass while a slash, a colon, a comma, markdown emphasis and
# the like, and file:/// (its third slash), all start one. A boundary byte other than a slash that
# itself follows a slash is a segment of a URL path (https://example.com/_/home/x), so it does not
# start one; a slash always does. Second, a home, root's home, a user runtime directory
# or tmp deeper inside an absolute path (/mnt/c/Users/, /var/home/, /var/root/, /private/tmp/,
# /var/tmp/), the same directories as the first shape:
# here the path must not follow a slash either, unless as file://, so the path of a URL
# (https://example.com/home/x, whose host follows //) passes. Third, a Windows drive path under
# Users, with either slash, in any case.
readonly HOST_PATH_DIRECTORIES='/(home|root|run/user|tmp|Users)/'
readonly HOST_PATH_PATTERN='(^|^[^A-Za-z0-9.~/-]|[^/][^A-Za-z0-9.~/-]|/)'"${HOST_PATH_DIRECTORIES}"'|(^|[^A-Za-z0-9.~/-]|file://)(/[A-Za-z0-9._-]+)+'"${HOST_PATH_DIRECTORIES}"'|(^|[^A-Za-z0-9])[A-Za-z]:[\\/]+[Uu][Ss][Ee][Rr][Ss][\\/]'
# Every UTF-8 byte of a multi-byte character is 0x80 or above, so a byte scan finds exactly the C0
# controls (except tab and newline; carriage return is one) and DEL, and the C1 controls U+0080 to
# U+009F, which UTF-8 writes as 0xC2 and then 0x80 to 0x9F. NUL is mapped to 0x01 before the scan
# (write_nul_free_copy). Other invisible characters, such as bidi formatting ones, are not refused.
readonly CONTROL_PATTERN=$'[\x01-\x08\x0b-\x1f\x7f]|\xc2[\x80-\x9f]'
# A whole line of valid UTF-8 (RFC 3629): ASCII but NUL, or a two, three or four byte sequence with
# no overlong form, no surrogate and nothing above U+10FFFF. A line it does not match holds a raw
# byte from another encoding (a Latin-1 or CP1252 0x85, say) or a broken sequence, which the C1
# byte scan above cannot see and wc -m does not count.
readonly UTF8_LINE_PATTERN=$'([\x01-\x7f]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf]{2}|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf]{2}|[\xf1-\xf3][\x80-\xbf]{3}|\xf4[\x80-\x8f][\x80-\xbf]{2})*'
# The two plan-approval keywords, matched as whole words without regard to case
# (check_comment_for_approval_keywords): an agent's comment that holds one outside a quote can be
# read as a human approving a plan. A letter, digit or underscore on either side makes a longer
# word (plan_approved), which passes; underscores with nothing but a boundary beyond them are
# Markdown emphasis (_approved_, __lgtm__), which renders as the keyword alone, so it is refused.
# SIGNS_OFF_DEF matches it too, one line at a time, so it is written with nothing but what grep -E,
# jq's regular expressions and gh's (gojq, Go's) read alike, and holds no quote or backslash, so it
# goes in a jq string as it is.
readonly APPROVAL_KEYWORD_PATTERN='(^|[^A-Za-z0-9_])_*(approved|lgtm)_*([^A-Za-z0-9_]|$)'
readonly OWNER_PATTERN='[A-Za-z0-9][A-Za-z0-9-]*'
readonly REPOSITORY_PATTERN="${OWNER_PATTERN}/[A-Za-z0-9_.-]+"
# The start of every URL gh answers a write with: any host, with or without a port, then any owner
# and any repository. issue_create says why neither the host nor the repository is compared with anything.
readonly REPOSITORY_URL_PATTERN='^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+'
# A character that may come just before a bare owner/repo, then any underscores that open Markdown
# emphasis (_owner/repo#5_, __owner/repo__; * is a boundary byte itself); a letter, digit,
# underscore, slash, dot or dash before those means it is part of a longer word, path or host name.
readonly REFERENCE_BOUNDARY='(^|[^A-Za-z0-9_./-])_*'
# Characters that, just before an owner/repo#n or owner/repo@sha, put it inside a URL, a query or
# another path, so it is not a cross-reference. A colon is not one of them: Related:owner/repo#5
# is as much a reference as "Fixes: owner/repo#5", and the :// of a URL leaves a slash, not a
# colon, just before its path; is_cross_reference skips only a host:port, whose "owner" is all
# digits. A bare owner/repo of a listed private owner after one of them (REPO=owner/repo) is still
# a reference.
readonly URL_PATH_BYTES='~@#%?&=+'
# The start of a link to a repository: github.com (or www.github.com) followed by / or : (an SSH
# remote), api.github.com/repos/, raw.githubusercontent.com/ or codeload.github.com/. It must
# not follow a letter, digit, dot or dash, so another host that ends in the same letters
# (notgithub.com, docs.github.com, gist.github.com, whose paths are not repositories) is not read
# as one. Dots are allowed after such a boundary, and two dots anywhere, because a host name never
# holds those: they are sentence punctuation, such as an ellipsis.
readonly REPOSITORY_LINK_PREFIX='(^|[^A-Za-z0-9.-]|\.\.)\.*((www\.)?github\.com[:/]|api\.github\.com/repos/|raw\.githubusercontent\.com/|codeload\.github\.com/)'
# First path segments of github.com URLs that are GitHub's own pages, never an owner, including
# user-attachments, where every pasted image or file is stored. assets is not listed: it is a real
# account, and an attachment under a repository (<owner>/<repo>/assets/...) is that repository's.
readonly GITHUB_RESERVED_PATHS=" about account advisories apps codespaces collections contact copilot customer-stories dashboard enterprise enterprises events explore features issues join login logout marketplace new notifications organizations orgs pricing pulls readme resources search security sessions settings signup site solutions sponsors stars team topics trending user-attachments users watching "
readonly PRIORITIES=(Security Urgent High Medium Low)
# PRIORITIES as the help and error texts name them, comma-separated with "or" before the last,
# built from PRIORITIES (no priority holds a space) so a new priority cannot leave them naming the
# old ones.
readonly PRIORITIES_BUT_LAST="${PRIORITIES[*]:0:${#PRIORITIES[@]}-1}"
readonly PRIORITY_LIST="${PRIORITIES_BUT_LAST// /, } or ${PRIORITIES[-1]}"
readonly NEW_ISSUE_STATUS="Not Started"
readonly NEW_PR_STATUS="Development"
# The ten workflow states, in board order, which the project's built-in "Status" field carries
# (#1519). cfwf is installed alone and cannot source lib/project-status, which holds the same list;
# test/status-mapping-parity.bats fails when the two differ.
readonly WORKFLOW_STATES=("Not Started" Planning Approved Development "AI Simplify" "AI Review" "AI Security Review" "AI Coverage" "Human Review" Complete)
# The custom field every board used before #1519. While boards are being converted one at a time,
# a board that still has it is read and written through it; a converted board has only Status.
readonly LEGACY_FIELD="Workflow Status"

# The labels the repositories share, copied from .github/labels.yml as name|colour|description
# (cfwf is installed alone and cannot read that file; test/standard-labels-parity.bats fails
# when this copy and the file differ). A label created by "issue create" that is listed here
# gets this colour and description.
readonly STANDARD_LABELS='.NET update|a870c9|Update to .net global.json
AI-Work|ffa500|Work for an AI Agent
auto-pr|0000aa|Pull request created automatically
Blocked|ff0000|Blocked by a dependency or external factor
Bug|d73a4a|Generic bug fix
C#|db6baa|C# Source Files
C# Project|db6baa|C# Project Files
C# Solution|db6baa|C# Solutions
Change Log|53fcd4|Changelog tracking file
Changelog Not Required|08f5f8|No changelog entry required for this pull request
Config Change|d8bb50|Configuration files changes
dependencies|0366d6|Updates to dependencies
DO NOT MERGE|ff0000|This pull request should not be merged yet
dotnet|db6baa|Dotnet package updates
Editorconfig|00dead|Editor config file change
Enhancement|a2eeef|Enhancement to project
github-actions|e09cf4|Github actions workflow files
High|ffa500|High Priority
Low|cc8899|Low Priority
Markdown|5319e7|Markdown files
Medium|ffff00|Medium Priority
Migration Script|b680e5|SQL Migration scripts
never-close|1d76db|This issue should never be closed — it is a permanent tracking issue
no-pr-activity|ffff00|Pull Request has had no activity for a long time
npm|e99695|npm package update
On Hold|ff0000|Do not work on this
Performance|0075ca|Performance enhancement or issue
Powershell|23bc12|Powershell Source Files
Read Me|5319e7|Repository readme file
Refactor|30027a|Code refactoring
Security|ee0701|Security issue, e.g. use of insecure packages, or security fix
Setup|5319e7|Setup instructions
Solidity|413cd1|Solidity Source Files
SQL|413cd1|SQL Source Files
Static Code Analysis Rules|00dead|Ruleset for static code analysis files
Tech Debt|30027a|Technical debt
Unit Tests|0e8a16|Unit test and integration test projects
Urgent|ff0000|Urgent Priority'

# The number of arguments cfwf was given, so an argument it does not know can be named by its
# position on the command line rather than by its value (unknown_argument).
ARGUMENT_COUNT=0
CURRENT_COMMAND=""
MODE=""
REPO=""
PR=""
declare -gA REQUESTED_FIELDS=()
ISSUE=""
STATUS=""
SHA=""
BRANCH=""
TAG=""
ALL_CHECKS=""
TARGET_NUMBER=""
TARGET_TYPE=""
TARGET_URL_KIND=""
OWNER=""
PROJECT_ID=""
PROJECT_NUMBER=""
FIELD_ID=""
FIELD_NAME=""
OPTION_ID=""
ITEM_STATUS=""
GH_ERR_FILE=""
GH_OUTPUT=""
GH_ERROR=""
TITLE=""
BODY_FILE=""
PRIORITY=""
LABELS=()
CREATED_URL=""
# What the EXIT trap says of CREATED_URL when a run fails after the item it names came to be.
CREATED_NOTE="the issue was already created"
BODY_PATH_TMP=""
SCAN_TMP=""
VALUE_TMP=""
declare -gA REPOSITORY_VISIBILITY=()
declare -gA PRIVATE_OWNERS=()
PRIVATE_OWNERS_LOADED=""

die() {
    printf 'cfwf: %s\n' "$*" >&2
    exit 1
}

# The EXIT trap, installed once in main: removes every temporary file cfwf may have made, and,
# when it exits non-zero after an issue or a pull request was created, or an existing pull request
# was found, names it (CREATED_NOTE says which) so it is never lost.
cleanup() {
    local exit_status=$?
    if [ "${exit_status}" -ne 0 ] && [ -n "${CREATED_URL}" ]; then
        printf 'cfwf: %s: %s\n' "${CREATED_NOTE}" "${CREATED_URL}" >&2
    fi
    rm -f "${GH_ERR_FILE}" "${BODY_PATH_TMP}" "${SCAN_TMP}" "${VALUE_TMP}"
}

# Creates a temporary file on first use and stores its path in the global variable named by $1
# (GH_ERR_FILE, BODY_PATH_TMP, SCAN_TMP or VALUE_TMP), leaving one that is already set alone, so
# each is made at most once per run and the EXIT trap (cleanup) removes it. GH_ERR_FILE is the one
# file gh's stderr is captured in: each caller reads it straight after its own gh call, so one file
# serves them all.
ensure_temp_file() {
    local path
    [ -z "${!1}" ] || return 0
    path=$(mktemp) || die "could not create a temporary file"
    printf -v "$1" '%s' "${path}"
}

usage_general() {
    cat << 'USAGE'
Usage: cfwf <command> [options]

Commands:
  workflow-status --set    Move an issue or PR to a Workflow board status
  workflow-status --check  Print the current Workflow board status of an issue or PR
  closing-issue-labels     Print the labels of the issues a PR closes (Blocked and On-Hold excluded)
  issue create             Create an issue and put it on the Workflow board as Not Started
  issue view               Print an issue's title, state, labels, assignees and body (exit 9 when not found)
  issue plan-status        Print whether an issue has a plan and is Blocked, and the comments since the plan
  issue list               List a repository's open issues, highest priority first, one line each
  issue search             Search one repository's issues by words in their title or body, one line each
  body check               Check a body for leaks without posting it (exit 8 when refused)
  repo view                Print a repository's default branch, visibility, merge methods and description
  repo collaborators       List a repository's collaborators and their roles, sorted by login in the C locale
  auth status              Print the authenticated login, the host and the gh version, never a token
  pr checks                Judge the checks on a PR's, a branch's or a commit's head (exit 0, 3, 4 or 5)
  pr comments              Print a PR's comments, reviews and review threads (exit 9 when not found)
  pr reply                 Reply to an inline review comment of a PR (exit 8 when the body is refused)
  pr view                  Print a PR's state and metadata, one key and value a line (exit 9 when not found)
  pr list                  List a repository's open pull requests, one line each
  pr create                Create a draft PR and put it on the Workflow board as Development (prints the existing one's URL if the branch has one)
  comment add              Post a comment on a PR or an issue and print its URL
  release view             Print a repository's latest release, one key and value a line (exit 9 when it has none)
  release list             List a repository's releases, newest first, one line each
  tag view                 Print the commit a repository's tag points to (exit 9 when not found)
  help [command]           Show this help, or the help for one command

Run 'cfwf help <command>' for the options of a command.
USAGE
}

usage_workflow_status() {
    cat << 'USAGE'
Usage:
  cfwf workflow-status --set --repo <owner/repo> (--pr <n> | --issue <n>) --status <name>
  cfwf workflow-status --check --repo <owner/repo> (--pr <n> | --issue <n>)

Both name the item the same way: --repo plus --pr or --issue. The board is looked up from
the repository: the project titled "Workflow" linked to it, and that project's built-in
"Status" field, which carries the workflow states. A board that still has the old
"Workflow Status" field (boards are converted one repository at a time) is read and written
through that field instead. No ids are needed.

--status is one of Not Started, Planning, Approved, Development, AI Simplify, AI Review,
AI Security Review, AI Coverage, Human Review or Complete, matched without regard to case.

--set adds the item to the board if it is not already there (idempotent) and sets its status
to --status. It exits 0 when gh reports the write succeeded, and that is all: it does not
read the value back. A write whose call succeeded is done, and GitHub can lag behind a write
by seconds, so a read straight afterwards that disagrees is lag, not a failed write.
Do not poll or repeat the write; if a later step reads the value, check again at that step.

--check prints the item's current status on one line, for example "Development", or (unset)
when it has none. It exits non-zero when the item is not on the board.

--check reads the board with a read-only GraphQL query for the single item (gh api graphql),
because gh project has no command that reads one item and listing the whole board is capped
and can be slow to show a freshly added item. This query (which 'cfwf pr create' also makes,
for a pull request that already exists) and that of 'cfwf pr comments' are the only places
cfwf uses GraphQL, and both only read:
every board write uses native gh project commands, and every other write a native gh command
or the REST API. If the query fails, cfwf warns on stderr and falls back to listing the board.
USAGE
    printf 'The fallback listing reads at most %s items.\n' "${ITEM_LIMIT}"
}

usage_closing_issue_labels() {
    cat << 'USAGE'
Usage: cfwf closing-issue-labels --repo <owner/repo> --pr <n>

Prints the sorted, de-duplicated labels across every issue the PR closes, one per line,
with Blocked and On-Hold left out.
USAGE
}

usage_issue_create() {
    cat << USAGE
Usage: cfwf issue create --repo <owner/repo> --priority <priority> --title <title> --body-file <file> [--label <label> ...]

Creates an issue and puts it on the repository's Workflow board in one step, as Not Started
(there is no --status), then prints the issue URL and nothing else.

--repo       Always required; never taken from the current directory.
--priority   Always required, exactly once: ${PRIORITY_LIST} (matched
             without regard to case). It is applied as the issue's priority label.
--title      The issue title. It is checked for leaks as the body is. In a repository owned by
             credfeto or funfair-tech (owner matched without regard to case) it must be
             "prefix: text" or "prefix(name): text" with a lower-case prefix (letters and
             digits, starting with a letter, with single - between parts), for example
             "oneshot: ..." or "tool(cfwf): ..."; any other title is a
             usage error (exit 2), and there is no option to skip it.
--body-file  The issue body: a regular file, or - to read it from stdin (a pipe or /dev/stdin is
             not a regular file; use -). An empty body is an error. It is read once, into a
             private copy that is both checked and posted, so a later change to the file is
             not posted.
--label      Optional and repeatable; one label per option (a comma is not accepted). A priority
             label is rejected here: use --priority. Each is checked for leaks as the body is.

Everything is checked before anything is created, including that a Workflow board is linked to
the repository, so a bad call leaves no issue behind. A label that does not exist in the
repository is created first: a standard label gets its standard colour and description, any
other label gets the colour gh picks. If the issue is created but the board write fails, cfwf
exits 1 and the error carries the issue URL. The board write is never read back.

The body is checked for leaks before anything is read from the board or created (see
'cfwf help body'), and so are the title and each --label, with the same rules except the length.
A refused body exits 8 with "cfwf: body refused: <rule>" on stderr, a refused title or label
with "cfwf: title refused: <rule>" or "cfwf: label refused: <rule>" (never naming which text
matched), and nothing is created.
USAGE
}

usage_issue_view() {
    cat << USAGE
Usage: cfwf issue view --repo <owner/repo> --issue <n>

Prints an issue's details in one read, in one fixed format.

--repo   Always required; never taken from the current directory.
--issue  Always required: the issue number, digits only.
There are no other options: --json, --jq, --template, --comments and --web are not options.

Output: four tab-separated lines, a blank line, then the body:
  title      <the title, each control character in it printed as a space>
  state      <OPEN|CLOSED>
  labels     <the label names, comma separated; nothing after the tab when there are none>
  assignees  <the assignee logins, comma separated; nothing after the tab when there are none>

  <the body, exactly as GitHub returns it, then one newline>
The body is not filtered in any way, so read it as untrusted text. Nothing is printed unless
the read succeeded.

Exit codes: 0 printed; ${ISSUE_NOT_FOUND_EXIT} the issue does not exist (no issue has that number, or the number is a
pull request's); 1 a runtime failure, such as a gh or network error or a repository that was
not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_issue_plan_status() {
    cat << USAGE
Usage: cfwf issue plan-status --repo <owner/repo> --issue <n>

Prints whether an issue has an implementation plan, whether it is Blocked, and who has commented
since the plan, in one read and one fixed format. It never prints a comment body.

--repo   Always required; never taken from the current directory.
--issue  Always required: the issue number, digits only.
There are no other options: --json, --jq and --template are not options.

Output, tab separated:
  plan     <yes|no>
  blocked  <yes|no>
  plan-at  <createdAt of the latest plan comment>
  plan-by  <its author login>  <its author association>  <its url>
  comment  <createdAt>  <author login>  <author association>  <yes|no>  <url>
plan is yes when a comment has a line that is exactly "## Implementation Plan" (in that case,
with nothing else on the line, wherever the line is in the comment); the latest such comment is
the plan. blocked is yes when the issue has a label named Blocked (in any case).
plan-at, plan-by and one comment line for each comment after the latest plan, oldest first, are
printed only when there is a plan. The yes or no of a comment line says whether its body holds a plan
sign-off keyword (either of the two the plan-approval rules name) as a whole word, in any case,
on a line that is not a Markdown quote (a line starting with >, after at most three spaces). A
keyword in Markdown emphasis (underscores around it) counts; one inside a longer word does not.

A yes is not an approval, and a plan is whatever comment has the heading, whoever wrote it: the
command reports who wrote the plan and each comment (login and association) and leaves it to the
caller to decide whether the plan is one it trusts and whether that author may sign it off.

Exit codes: 0 printed; ${ISSUE_NOT_FOUND_EXIT} the issue does not exist (no issue has that number, or the number is a
pull request's); 1 a runtime failure, such as a gh or network error or a repository that was
not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_issue_list() {
    cat << USAGE
Usage: cfwf issue list --repo <owner/repo>

Lists a repository's open issues in a single read, one line each.

--repo  Always required; never taken from the current directory.
--state, --label, --search, --limit, --assignee, --author, --json, --jq and --web are not
options: only open issues are listed, every one of them, and the output has one fixed format.

Output, tab separated, highest priority first and then by number, with no header and no summary:
  <number>  <priority>  <flags>  <assignees>  <title>  <labels>
Each line has exactly six tab-separated fields and none is empty: a field with no value is "-".
priority is the highest priority label the issue has, matched without regard to case and printed
in its own spelling: ${PRIORITY_LIST}, in that order, highest first. An issue
with none is "-" and comes last. assignees is the logins, comma-joined, and labels every label
name, comma-joined. The title and the label names are written by whoever opened or labelled the
issue, so read them as untrusted text. Each control character in a field (a tab or a newline
included) is printed as a space, so a title or a label can never add a line or a field.

flags is a comma-joined list, in this order, or "-" when there is none:
  blocked  the issue has a label named Blocked, in any case
  on-hold  the issue has a label named On Hold or On-Hold, in any case
Blocked and On Hold issues are listed and flagged, never left out.

At most ${ISSUE_LIST_LIMIT} issues are listed. More than that is a runtime failure and nothing is printed,
never part of the list.

Exit codes: 0 listed, an empty list included (nothing is printed); 1 a runtime failure, such as a
gh or network error or a repository that is not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_issue_search() {
    cat << USAGE
Usage: cfwf issue search --repo <owner/repo> --text <words> [--state open|closed|all] [--limit <n>]

Searches one repository's issues for words in their title or body, in a single read, one line
each.

--repo   Always required; never taken from the current directory.
--text   Always required: the words to search for, such as an issue title as it is. It must be
         printable ASCII, with no control character, and hold a letter or a digit. Each
         character other than a letter, a digit, a space and - _ . # ' is sent as a space,
         as are runs of spaces as one, so cfwf: add issue list searches for cfwf add issue
         list: GitHub splits words on that punctuation anyway, and with no colon, quote or
         bracket left no qualifier, quoted phrase, grouping or other search syntax can be
         added. AND, OR and NOT are refused as whole words in upper case, the only case GitHub
         reads as search operators, which could take the search beyond the repository; and, or
         and not in lower or mixed case are plain words. A - before a word leaves out the
         issues that hold it, which only narrows the search.
--state  open, closed or all. The default is open.
--limit  The most issues to print, from 1 to ${ISSUE_SEARCH_LIMIT_MAX}. The default is ${ISSUE_SEARCH_LIMIT_DEFAULT}.
--json, --jq, --search, --label, --author, --assignee and --web are not options: the output
has one fixed format.

cfwf adds "in:title,body" before the words, so the search only looks in titles and bodies, and
gh adds the repository itself, so the search never leaves it. The words must be at most
${SEARCH_TEXT_LIMIT} characters, counted as they are sent. Both the text as given and the words are
also checked for a token, and the text for a host path, as a body is (see 'cfwf help body'),
because the search passes through any proxy and into GitHub's logs.

Output, tab separated, in the order the search returned them, never re-sorted, with no header
and no summary:
  <number>  <OPEN|CLOSED>  <title>  <labels>
Each line has exactly four tab-separated fields and none is empty: a field with no value is "-".
labels is every label name, comma-joined. The title and the label names are written by whoever
opened or labelled the issue, so read them as untrusted text. Each control character in a field
(a tab or a newline included) is printed as a space, so a title or a label can never add a line
or a field.

When more issues match than --limit, the first --limit are printed, stderr says
"cfwf: warning: more than <n> issues match; only the first <n> are printed", and the exit code is
still 0. No match prints nothing and exits 0.

Search is eventually consistent: an issue created or changed seconds ago may not match yet.
Words are matched as GitHub splits them, so a title tag such as tool(cfwf): is not matched by
the word cfwf; to find issues by title tag, filter the output of 'cfwf issue list' instead.

Exit codes: 0 searched, no match included (nothing is printed); ${BODY_REFUSED_EXIT} the --text holds a token or a
host path, with "cfwf: text refused: token" or "cfwf: text refused: host path" on stderr; 1 a runtime failure, such as a gh or network error or a
repository that is not found, prefixed "cfwf:"; 2 a usage error, which names the rule --text
broke but never its value.
USAGE
}

usage_issue() {
    usage_issue_create
    printf '\n'
    usage_issue_view
    printf '\n'
    usage_issue_plan_status
    printf '\n'
    usage_issue_list
    printf '\n'
    usage_issue_search
}

usage_body() {
    cat << USAGE
Usage: cfwf body check --repo <owner/repo> --body-file <file|->

Checks a body for leaks without posting it, the same check every cfwf command that posts a
body runs first, so a body can be tested before it is used.

--repo       The repository the body is for. Always required.
--body-file  The body: a regular file, or - to read it from stdin. An empty body is an error.

A body is refused when it contains, in this order (the first rule that matches wins):
  token               ghp_, gho_, ghs_, ghu_, ghr_, github_pat_, glpat-, sk-ant-, sk-proj-,
                      xoxa-, xoxb-, xoxp-, xoxr- or xoxs- followed by a token character,
                      npm_ and 36 letters or digits, AIza and 35 letters, digits, _ or -,
                      sk- and 48 letters or digits, an AWS access key id (AKIA or ASIA and
                      16 upper-case letters or digits), a PRIVATE KEY block line, a Discord
                      webhook URL (discord.com or discordapp.com /api/webhooks/<digits>/
                      and a token character), a URL with a password
                      (<scheme>://<user>:<password>@) or x-access-token:<token>@, where
                      the password holds no whitespace, /, ?, #, double quote or backtick
                      and may be anything else, a placeholder included (describe such a
                      URL in words instead), an Authorization or Proxy-Authorization
                      header with any value after its : or =, whatever the scheme and
                      placeholder or not (the header name alone passes), Bearer and 20 or
                      more token characters with a digit among them (so hyphenated prose
                      after Bearer passes), or
                      NAME=value where NAME is upper case and is TOKEN, SECRET, KEY or
                      PASSWORD or ends in _TOKEN, _SECRET, _KEY or _PASSWORD, and the value
                      (after an optional quote) does not start with \$, so a reference such
                      as \${...}, \${{ ... }} or \$NAME passes. Lower-case names and the
                      NAME: value and NAME = value forms are not checked.
  host path           /home/, /Users/, /root/, /run/user/ or /tmp/ at the start of a path: the
                      start of a line, or after any character but a letter, digit, ., ~ or -
                      (so file:///home/... and PATH=...:/home/... are refused, while
                      ./tmp/x and ~/tmp/x pass), except a character other than / that itself
                      follows /, as in the URL path https://example.com/_/home/x;
                      /home/, /Users/, /root/, /run/user/ or /tmp/ deeper inside an absolute
                      path (/mnt/c/Users/..., /var/home/..., /var/root/..., /private/tmp/...,
                      /var/tmp/...), but
                      not in the path of a URL such as https://example.com/home/x; or a
                      Windows drive path under Users
                      (C:\Users\... or C:/Users/..., in any case)
  control character   a C0 control other than tab and newline (carriage return included, so
                      CRLF line endings are refused), DEL, or a C1 control (U+0080 to
                      U+009F); other invisible characters, such as bidi formatting ones,
                      are not refused
  invalid UTF-8       a byte that is not part of valid UTF-8, such as a lone 0x85 from
                      Latin-1 or CP1252 text, a broken or overlong sequence, or a
                      surrogate
  too long            more than ${BODY_LIMIT} characters
  private repository  only when --repo is public: a github.com/<owner>/<repo>,
                      api.github.com/repos/<owner>/<repo>,
                      raw.githubusercontent.com/<owner>/<repo> or
                      codeload.github.com/<owner>/<repo> link (gists and the
                      user-attachments of pasted images and files are not
                      repositories), a git@github.com:<owner>/<repo> remote, or a standalone
                      <owner>/<repo>#<n> or <owner>/<repo>@<sha> reference (not inside a
                      path or a URL, <sha> 7 to 40 hex digits, and with no letter, digit, _
                      or - straight after <n> or <sha>, so docs/setup.md#1-intro is not one,
                      though one in Markdown emphasis, _<owner>/<repo>#<n>_, still is)
                      to a repository that is private or that the caller cannot see, or
                      any <owner>/<repo> whose owner is listed in
                      CFWF_PRIVATE_OWNERS (space-separated owners, refused with no lookup).
                      A wiki (<owner>/<repo>.wiki) counts as its repository. The target
                      itself always passes. Each other repository is looked up once per
                      run with gh repo view. The target's own visibility is only checked
                      when the text names another repository: only then is a --repo that
                      GitHub does not show the caller (a typo, a renamed repository, no
                      access) a runtime failure, never a pass. Text that names no other
                      repository passes without a lookup of --repo.

A refusal prints "cfwf: body refused: <rule>", with "(line <n>)" where there is one, on stderr
and exits ${BODY_REFUSED_EXIT}. The matched text is never printed. There is no option to skip
the check.

Exit codes: 0 the body passes (nothing is printed); ${BODY_REFUSED_EXIT} refused; 1 a runtime
failure, including a scan that fails or a visibility lookup that fails other than as not found
(access denied, HTTP 403, among them); 2 a usage error.
USAGE
}

usage_repo_view() {
    cat << 'USAGE'
Usage: cfwf repo view --repo <owner/repo>

Prints a repository's default branch, visibility, allowed merge methods and description in a
single read. It only reads, so the repository can be any the caller can see.

--repo  Always required; never taken from the current directory.
--json, --jq, --template, --branch and --web are not options: the output has one fixed format.

Output, one line for each field, always in this order, each <field><TAB><value>:
  default-branch      the default branch; nothing after the tab for an empty repository
  visibility          GitHub's own value: PUBLIC, PRIVATE or INTERNAL
  allow-merge-commit  yes or no: whether a pull request may be merged with a merge commit
  allow-squash-merge  yes or no: whether a pull request may be squash merged
  allow-rebase-merge  yes or no: whether a pull request may be rebase merged
  description         the description; nothing after the tab when there is none
A merge method GitHub did not give prints nothing after the tab: read that as not known, never as
no. Each control character in a value (a tab or a newline included) is printed as a space, so a
line is always one field. The description is written by whoever owns the repository and is not
filtered in any other way, so read it as untrusted text. Nothing is printed unless the read
succeeded.

Exit codes: 0 printed; 1 a runtime failure, such as a gh or network error or a repository that was
not found or that the caller cannot see, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_repo_collaborators() {
    cat << USAGE
Usage: cfwf repo collaborators --repo <owner/repo>

Lists a repository's collaborators and the role of each, every page read before anything is
printed.

--repo  Always required; never taken from the current directory.
--json, --jq, --affiliation, --permission, --paginate and --limit are not options: every
collaborator is listed (GitHub's default affiliation, all), in one fixed format.

Output, tab separated, sorted by login in the C locale (byte order, so every upper-case letter
comes before every lower-case one), with no header and no summary:
  <login>  <role>
Each line has exactly two tab-separated fields and neither is empty. role is GitHub's own name for
the collaborator's role: admin, maintain, write, triage or read, or the name of a custom role, and
"-" when GitHub gives none. Each control character in a role is printed as a space. A login is
letters, digits, - and _, with [bot] after an app's; an answer holding anything else as a login is
a runtime failure and nothing is printed.

At most ${COLLABORATOR_LIMIT} collaborators are listed. More than that is a runtime failure and nothing is
printed, never part of the list.

GitHub shows a repository's collaborators only to a caller with push access to it. Without it the
read is refused (HTTP 403), which is a runtime failure, never an empty list.

Exit codes: 0 listed, an empty list included (nothing is printed); 1 a runtime failure, such as a
gh or network error, no push access or a repository that was not found or that the caller cannot
see, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_repo() {
    usage_repo_view
    printf '\n'
    usage_repo_collaborators
}

usage_auth() {
    cat << 'USAGE'
Usage: cfwf auth status [--rate-limit]

Prints who gh is authenticated as, the host it is pointed at and its version, and proves the
credential works by asking GitHub. It never prints a token.

--rate-limit  Also print what is left of the REST (core) and GraphQL rate limits.
There is no --repo and no way to name a host: --hostname, --show-token, --active, --json and --jq
are not options.

Output, one line for each field, always in this order, each <field><TAB><value>:
  login  the authenticated login, as GitHub answers now, never from a cache
  host   the value of GH_HOST, or github.com when it is unset or empty
  gh     the version of gh
and then, with --rate-limit:
  core-remaining     the REST requests left before the limit resets
  core-limit         the REST requests allowed between resets
  core-reset         when the REST limit resets, ISO 8601 in UTC
  graphql-remaining  the GraphQL points left before the limit resets
  graphql-limit      the GraphQL points allowed between resets
  graphql-reset      when the GraphQL limit resets, ISO 8601 in UTC
Nothing is printed unless every read asked for succeeded.

gh is asked only for its version, for the authenticated user and, with --rate-limit, for the rate
limit. cfwf never runs gh auth status, gh auth token or gh config and never asks gh for a response
header, so no token, header or configuration value is ever in its hands. No environment variable
but GH_HOST is printed, and gh's own configured default host is not consulted.

Exit codes: 0 printed; 1 a runtime failure, prefixed "cfwf:": "cfwf: not authenticated" when gh
has no credential or GitHub refuses the one it has (HTTP 401), and another message for any other
failed read; 2 a usage error.
USAGE
}

usage_pr_list() {
    cat << USAGE
Usage: cfwf pr list --repo <owner/repo> [--issue <n>] [--head <branch>]

Lists a repository's open pull requests in a single read, one line each.

--repo   Always required; never taken from the current directory.
--issue  An issue number, above 0. It does not change which pull requests are listed: it adds
         the flag "issue" to each one whose head branch holds that number.
--head   Lists only the pull requests whose head branch has exactly this name: never a prefix, a
         pattern or a search, and not the owner:branch form. A fork's branch of the same name
         matches too, flagged "fork": ignore that line when looking for the pull request of a
         branch in this repository.
--json, --jq, --search, --state, --limit, --author, --app, --base, --draft and --web are not
options: only open pull requests are listed, and the output has one fixed format.

Output, tab separated, sorted by number, with no header and no summary:
  <number>  <head>  <base>  <author>  <draft|ready>  <flags>  <url>  <title>
Each line has exactly eight tab-separated fields and none is empty: a field with no value is "-".
Each control character in a field (a tab or a newline included) is printed as a space, so a title
or a branch name can never add a line or a field.

flags is a comma-joined list, in this order, or "-" when there is none:
  issue           the head branch holds the --issue number: a run of digits with that value and
                  no digit on either side, so --issue 12 flags feat/12-x and feat/012-x but not
                  feat/123-x. Never set without --issue.
  github-actions  the author is app/github-actions
  fork            the head branch is in another repository. Anyone can open such a pull
                  request, with any branch name and title and without access to this repository,
                  so it is never the pull request of a branch in this repository, and its
                  "issue" flag and its title are no proof of earlier work on an issue.

At most ${PR_LIST_LIMIT} pull requests are listed. More than that to list (with --head, more on that
branch) is a runtime failure and nothing is printed, never part of the list.

Exit codes: 0 listed, an empty list included (nothing is printed); 1 a runtime failure, such as a
gh or network error or a repository that is not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_pr() {
    cat << USAGE
Usage: cfwf pr checks --repo <owner/repo> (--pr <n> | --sha <40-hex> | --branch <name>) [--all]

Judges the checks on one head commit in a single read, and never waits or polls: poll by running
it again later.

--repo    Always required; never taken from the current directory.
--pr      The pull request's head commit; required checks come from its base branch.
--sha     That commit (40 hexadecimal digits); required checks come from the default branch.
--branch  The branch tip, such as main after a merge; required checks come from that branch.
--all     Judge every check, not only the required ones.
Exactly one of --pr, --sha and --branch. --json, --jq, --template, --watch and --interval are not
options: the output has one fixed format.

The head is resolved first, so a check on an older head (before a force-push) is never counted.
The check runs and commit statuses of that commit are read: the newest run of a name from each app
is judged, whichever check suite it is in, so a run cancelled or failed in an older suite (before a
PR was marked ready, say) no longer counts once a newer run of that name exists, and a name fails
when any of those, or a commit status of that name, failed. A skipped run never replaces a run of
its name that ran and decided, so a newer suite whose job skips itself cannot hide an older failure;
a skipped run counts (as a pass) only when no run of its name ran, or when the newest that did was
cancelled (superseded, say by that suite's cancel-in-progress) before it. The required checks of
the branch are read from its branch protection and its rulesets (one pinned to an app is satisfied
only by a run from that app, though a failed commit status of its name still fails it); read access
to the repository is enough. Without --all only the required checks are judged, or every check when
the branch requires none.

Each check is judged as:
  pass     success, skipped or neutral (a status: success)
  fail     failure, cancelled, timed_out, action_required, startup_failure, stale or any other
           conclusion (a status: failure, error or any other state)
  pending  no conclusion yet (a status: pending), or a required check with no result at all
A run that has a conclusion counts as finished, whatever its status says.

Output, tab separated, sorted by name, then a summary:
  <name>  <pass|fail|pending>  <completed_at>  <run_id>
  summary passed=<a> failed=<b> pending=<c> head=<sha>
Each check line has exactly four tab-separated fields; the summary is the last line and the only
one with no tab, so a check named "summary" is never taken for it.
A name required more than once (from two apps, or from an app and any source) is printed once for
each, as "<name> (app <id>)" where an app is required.
completed_at and run_id are empty for a result not finished or not found; run_id is the commit
status id for a status. Nothing is printed unless every read succeeded.

Exit codes: 0 every judged check passed; ${CHECKS_FAILED_EXIT} at least one failed; ${CHECKS_PENDING_EXIT} none failed and at least one is
pending; ${NO_CHECKS_EXIT} the head has no check runs or statuses at all (expected for a PR whose checks wait
until it is marked ready, so not a pass); 1 a runtime failure, such as a gh or network error,
prefixed "cfwf:" and never reported as a failed check; 2 a usage error.

Run 'cfwf pr comments --help' for pr comments, which prints a pull request's comments, reviews and
review threads.
Run 'cfwf pr reply --help' for pr reply, which replies to an inline review comment.
Run 'cfwf pr view --help' for pr view, which prints a pull request's state and metadata.
Run 'cfwf pr list --help' for pr list, which lists a repository's open pull requests.
Run 'cfwf pr create --help' for pr create, which creates a draft pull request on the Workflow board.
USAGE
}

usage_pr_create() {
    cat << USAGE
Usage: cfwf pr create --repo <owner/repo> --head <branch> --title <title> --body-file <file|-> [--base <branch>]

Creates a draft pull request and puts it on the repository's Workflow board in one step, as
${NEW_PR_STATUS}, then prints the pull request URL and nothing else. When the head branch already has an
open pull request, none is created: that one's URL is printed instead (see below).

--repo       Always required; never taken from the current directory.
--head       Always required: the name of the head branch, which must already be pushed to the
             repository. The branch name alone, not the owner:branch form, and never taken from
             the current directory. A branch in a fork is not supported.
--title      Always required: a Conventional Commits title, <type>[(<scope>)][!]: <description>,
             with a lower-case type, such as "feat(cfwf): add a command". At most ${TITLE_LIMIT}
             characters. It is checked for leaks as the body is.
--body-file  Always required: the pull request body, a regular file, or - to read it from stdin
             (a pipe or /dev/stdin is not a regular file; use -). An empty body is an error. It is
             read once, into a private copy that is both checked and posted, so a later change to
             the file is not posted. There is no --body.
--base       Optional: the branch to merge into. Default: the repository's default branch, read
             from GitHub. It must not be the --head.
The pull request is always a draft and always ${NEW_PR_STATUS}: there is no --draft, --ready or --status,
and --label, --assignee, --reviewer, --fill, --web, --json and --jq are not options either.

Everything is checked before anything is created, including that a Workflow board is linked to
the repository and that the head branch is there, so a bad call leaves no pull request behind.
The body is checked for leaks before anything is read from the board or created (see
'cfwf help body'), and so is the title, with the same rules except the length. A refused body
exits ${BODY_REFUSED_EXIT} with "cfwf: body refused: <rule>" on stderr and a refused title with "cfwf: title refused:
<rule>" (never naming which text matched), and nothing is created.

When a pull request already exists. The same pull request is an open one in this repository whose
head branch is exactly --head, whatever its base; one from a fork's branch of the same name is
ignored. cfwf looks for it before creating, and again if the create fails (so one opened in the
meantime is found; the create is never run twice). When there is one, cfwf exits 0 and prints its
URL: its title, body and draft state are neither read nor changed, and stderr carries
  cfwf: note: an open pull request already exists for the --head (base <base>); its title and body were not changed
Its Workflow status only moves forward: one that is not on the board, has no status or is before
${NEW_PR_STATUS} is set to ${NEW_PR_STATUS}, and one at ${NEW_PR_STATUS} or later is left as it is. The
title and body given are still checked in full, so a bad call fails the same way either way. More
than one such pull request (the same head into two bases) is a runtime failure.

If the pull request is created but the board write fails, cfwf exits 1, prints nothing on stdout
and stderr ends with "cfwf: the pull request was already created: <url>"; a failure after an
existing pull request was found ends with "cfwf: the pull request already exists: <url>". The
board write is never read back.

Exit codes: 0 created, or it already existed; 1 a runtime failure, such as a gh or network error,
no Workflow board, or a head branch that is not found, prefixed "cfwf:"; 2 a usage error; ${BODY_REFUSED_EXIT} the
body or the title was refused by the leak check.
USAGE
}

usage_pr_view() {
    cat << USAGE
Usage: cfwf pr view --repo <owner/repo> --pr <n> [--field <name> ...]

Prints a pull request's state and metadata in a single read.

--repo   Always required; never taken from the current directory.
--pr     The pull request's number, above 0.
--field  Optional and repeatable: one of the fields below. Only the fields named are printed.
--json, --jq and --template are not options: the output has one fixed format.

Fields, in the order they are printed whatever order they are asked for in (one named more than
once is printed once):
  state            OPEN, CLOSED or MERGED
  draft            yes or no
  title            the title
  url              the pull request's URL
  base             the base branch
  head             the head branch
  head-sha         the head commit
  auto-merge       on or off
  review-decision  GitHub's own value, such as APPROVED, CHANGES_REQUESTED or REVIEW_REQUIRED;
                   empty when there is none
  merge-state      GitHub's own value, such as BEHIND, BLOCKED, CLEAN, DIRTY, DRAFT or UNKNOWN
  mergeable        GitHub's own value: MERGEABLE, CONFLICTING or UNKNOWN
  created-at       when it was created
  merged-at        when it was merged; empty when it is not merged
  merge-commit     the merge commit's SHA; empty when it is not merged
  labels           the label names, comma-joined
  assignees        the assignees' logins, comma-joined
  author           the author's login
  commit-authors   the distinct logins of the commit authors, in the order first seen, comma-joined
                   (a commit can have several authors; one with no login is left out)
  files            the changed paths, one a line; only when asked for alone
  body             the body, unchanged, byte for byte; only when asked for alone

With no --field, every field but files and body is printed, each as one line:
  <field><TAB><value>
A field with no value prints its name, the tab and nothing after it. Each control character in a
value (a tab or a newline included) is printed as a space, so a line is always one field. The same
is done to each path of files. Asking for files or body together with another field is a usage
error.

GitHub is asked only for what the fields printed need, so name the fields wanted: the commits are
read only for commit-authors, which the default output includes.

gh lists at most 100 files and reads at most 100 commits. files is refused (exit 1) when the pull
request changes more files than gh listed, never printed in part; commit-authors has no such
check, so on a pull request of more than 100 commits it can miss an author.

Exit codes: 0 printed; ${PR_NOT_FOUND_EXIT} the pull request does not exist (the number of an issue included); 1 a
runtime failure, such as a gh or network error, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_pr_comments() {
    cat << USAGE
Usage: cfwf pr comments --repo <owner/repo> --pr <n>

Prints everything said on a pull request: its top-level comments, its reviews and its review
threads with their inline comments, each list read to its end.

--repo  Always required; never taken from the current directory.
--pr    The pull request's number, above 0.
--json, --jq, --template and --unresolved are not options: the output has one fixed format.

The output is blocks separated by one blank line, in this order: the pull request; each top-level
comment, oldest first; each review, oldest first; each review thread, followed by its inline
comments in thread order; then the summary. A block is header lines, each a key, a tab and a
value, and then, for a block that can have a body, the body's lines, each starting with "| " (an
empty line is "|" alone):
  pr               <owner/repo>#<n>
  review-decision  GitHub's own value, such as APPROVED, CHANGES_REQUESTED or REVIEW_REQUIRED;
                   empty when there is none
  comment          a top-level comment's id
  review           a review's id; on an inline comment, the id of the review it belongs to
  thread           the id of the thread's first inline comment
  inline           an inline comment's id, the id 'cfwf pr reply --comment-id' takes
  in-reply-to      the id of the comment an inline comment answers; empty on a thread's first
  author           who wrote it (see below)
  association      GitHub's own value, such as OWNER, MEMBER, COLLABORATOR, CONTRIBUTOR or NONE
  state            a review's state: APPROVED, CHANGES_REQUESTED, COMMENTED, DISMISSED or PENDING
  created-at       when a comment was written
  submitted-at     when a review was submitted; empty for one not submitted
  minimized        yes or no: whether the comment is hidden; it is printed either way
  url              its URL
  resolved         yes or no, for a thread
  outdated         yes or no, for a thread
  path             the file a thread is on
  line             the line a thread is on; empty for an outdated or file-level thread
  original-line    the line the thread was first on
  comments         the number of inline comments in a thread
  lines            the number of body lines that follow; the last header of a comment, a review
                   and an inline comment
  summary comments=<a> reviews=<b> reviews-empty=<c> threads=<d> unresolved=<e> inline=<f>

A header value has each control character (a tab or a newline included), U+2028 and U+2029
printed as a space, so it is always one line with one tab. A body has its trailing line ends
dropped and the same characters in a line (a tab included) printed as a space, so a body line
never holds a tab and always starts with "|": no body can pass for a header, a blank separator or
the summary. Bidi formatting characters are not changed. The summary is the last line and the only
line that is not empty and has neither a tab nor a leading "|"; output without it is a cut-off
copy, so run the command again.

A review with a blank body and the state COMMENTED is only the wrapper GitHub puts around inline
comments. It is not printed; it is counted as reviews-empty, and its inline comments are printed in
their threads.

author is who GitHub says wrote the item, and cfwf makes no trust decision: the caller decides
whose words to act on. A user prints as the login alone (credfeto); a bot as app/<slug>
(app/github-actions); any other kind of account as <kind>/<login> (mannequin/<login>); a deleted
account as an empty value. No login holds a slash, so only a user can print as a user's login.

Every page of every list is read before anything is printed, and the items read are checked
against GitHub's own counts. Nothing is printed when a read fails, when the lists changed or were
cut short while they were read, when one thread has more than ${API_PAGE_SIZE} comments, or when one list
has more than ${DISCUSSION_PAGE_LIMIT} pages of ${API_PAGE_SIZE} items.

Exit codes: 0 printed; ${PR_NOT_FOUND_EXIT} the pull request does not exist (the number of an issue included); 1 a
runtime failure, such as a gh or network error, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_pr_reply() {
    cat << USAGE
Usage: cfwf pr reply --repo <owner/repo> --pr <n> --comment-id <id> --body-file <file|->

Posts one reply in the review thread of an inline comment.

--repo        Always required; never taken from the current directory.
--pr          The pull request's number, above 0.
--comment-id  The id of an inline comment of that pull request: any "inline" id that
              'cfwf pr comments' prints. The id of a reply is taken as its thread: GitHub keeps a
              thread flat, so the reply is posted to the thread's first comment.
--body-file   The reply: a regular file, or - to read it from stdin. There is no --body. An empty
              body is an error. It is read once, into a private copy that is both checked and
              posted.

The body is checked for leaks before the comment is read or anything is posted (see 'cfwf help
body'). A refused body exits ${BODY_REFUSED_EXIT} with "cfwf: body refused: <rule>" on stderr, never naming the text
that matched, and nothing is posted. There is no option to skip the check. No other word is
refused in the body: a plan sign-off is read only from an issue's top-level comments, so an inline
reply can never be taken for one.

On success it prints three lines, with the keys 'cfwf pr comments' uses:
  inline       the new comment's id
  in-reply-to  the id of the thread's first comment
  url          the new comment's URL

It posts once and never tries again. When GitHub refuses the post with HTTP 400, 401, 403, 404,
410 or 422, the error says the reply was not posted. After any other failure (a timeout, an HTTP
5xx, any other HTTP 4xx, an answer that is not a comment) it says the reply may have been posted:
do not run it again blindly. Run 'cfwf pr comments', look in the thread for an inline block with
the same in-reply-to and your own author value (your login, or app/<slug> when you post as an
app), allow a few seconds for GitHub to catch up, and post again only if it is not there.

Exit codes: 0 posted; ${BODY_REFUSED_EXIT} the body was refused; ${PR_NOT_FOUND_EXIT} --comment-id is not an inline review comment of that
pull request (the id of a top-level comment or of a review included); 1 a runtime failure, such as
a blank or unreadable body, a failed read or a failed or unverifiable post, prefixed "cfwf:"; 2 a
usage error.
USAGE
}

usage_comment() {
    cat << USAGE
Usage: cfwf comment add --repo <owner/repo> (--pr <n> | --issue <n>) --body-file <file|->

Posts a top-level comment on a pull request or an issue, then prints the comment URL and
nothing else.

--repo       Always required; never taken from the current directory.
--pr         The pull request to comment on. Exactly one of --pr and --issue is required.
--issue      The issue to comment on.
--body-file  The comment: a regular file, or - to read it from stdin. An empty body is an error.
             It is read once, into a private copy that is both checked and posted.

There is no --body (the comment is only ever taken from --body-file), and no --edit-last,
--json or --jq.

The body is checked for leaks before anything is posted (see 'cfwf help body'). It is also
refused when either of the two plan-approval keywords is on a line that is not a Markdown quote
(a line starting with >, after at most three spaces), as a whole word in any case, because
such a comment could be read as a human approving a plan; quoting a human's own approval on
a > line is allowed. A refused body exits ${BODY_REFUSED_EXIT} with "cfwf: body refused: <rule>",
with "(line <n>)" where there is one, on stderr, never naming the matched text, and nothing
is posted. 'cfwf body check' does not apply the keyword rule.

Exit codes: 0 posted; ${BODY_REFUSED_EXIT} refused; 1 a runtime failure, including an unreadable or
blank body, a failed post or a result that is not a comment URL (the comment may then have
been posted); 2 a usage error.
USAGE
}

usage_release_view() {
    cat << USAGE
Usage: cfwf release view --repo <owner/repo>

Prints the latest release of a repository in a single read. It only reads, so the repository can
be any the caller can see, such as that of a GitHub Action.

--repo  Always required; never taken from the current directory.
There is no option that names a release: only the latest is printed. --json, --jq and --template
are not options: the output has one fixed format.

The latest release is the one GitHub marks as latest, which is never a draft or a pre-release.

Output, one line for each field, in this order:
  tag           the release's tag
  published-at  when it was published
  url           the release's URL
  name          the release's name; nothing after the tab when it has none
Each line is <field><TAB><value>. Each control character in a value (a tab or a newline included)
is printed as a space, so a line is always one field. The tag and the name are chosen by whoever
publishes the release, so read them as untrusted text. The release's notes are never printed.

Run 'cfwf tag view' with the tag for the commit to pin it to.

Exit codes: 0 printed; ${RELEASE_NOT_FOUND_EXIT} the repository has no latest release; 1 a runtime failure, such as a gh
or network error or a repository that is not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_release_list() {
    cat << USAGE
Usage: cfwf release list --repo <owner/repo>

Lists the releases of a repository in a single read, one line each. It only reads, so the
repository can be any the caller can see, such as that of a GitHub Action.

--repo  Always required; never taken from the current directory.
--json, --jq, --limit, --order, --exclude-drafts and --exclude-pre-releases are not options: the
output has one fixed format.

Output, tab separated, newest first by publication time and then by tag, with no header and no
summary:
  <tag>  <published-at>  <flags>  <name>
Each line has exactly four tab-separated fields and none is empty: a field with no value is "-".
Each control character in a field (a tab or a newline included) is printed as a space, so a name
can never add a line or a field. The tag and the name are chosen by whoever publishes the release,
so read them as untrusted text. The release's notes are never printed.

flags is a comma-joined list, in this order, or "-" when there is none:
  latest      the release GitHub marks as latest. It is not always the first line: a release
              published after it for an older version, such as a backport, is listed above it.
  prerelease  the release is marked as a pre-release

Draft releases are never listed. The order is by time, never by version: to find the lowest
version that meets a rule, read every line. Releases published at the same time are in reverse
text order of their tags, so v1.0.1 is above v1.0.0 and v9 is above v10.

At most ${RELEASE_LIST_LIMIT} releases are listed. More than that is a runtime failure and nothing is printed,
never part of the list.

Exit codes: 0 listed, an empty list included (nothing is printed); 1 a runtime failure, such as a
gh or network error or a repository that is not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

usage_release() {
    usage_release_view
    printf '\n'
    usage_release_list
}

usage_tag_view() {
    cat << USAGE
Usage: cfwf tag view --repo <owner/repo> --tag <tag>

Prints the commit a tag of a repository points to, which is the SHA to pin a GitHub Action to. It
only reads, so the repository can be any the caller can see.

--repo  Always required; never taken from the current directory.
--tag   The tag's own name, such as v4 or v4.2.2, without refs/tags/ before it. It must be a tag
        name git allows, with no control character. Only a tag is looked up, and only by its
        exact name: never a branch, a commit SHA, a prefix or a pattern.
--json, --jq and --template are not options: the output has one fixed format.

Output, two lines, each <field><TAB><value>:
  sha   the commit the tag points to: 40 hexadecimal digits
  type  lightweight (the tag names the commit itself) or annotated (the tag names a tag object,
        which names the commit)
The sha is the commit's for both types, never the tag object's. A tag that points to anything
else (a tree, a blob or another tag) is a runtime failure.

A tag can be moved, and a major version tag such as v4 is moved on purpose: the answer is where
the tag points now.

Exit codes: 0 printed; ${TAG_NOT_FOUND_EXIT} the repository has no tag of that name; 1 a runtime failure, such as a gh
or network error or a repository that is not found, prefixed "cfwf:"; 2 a usage error.
USAGE
}

# Prints the usage of $1: a command, or a command and its subcommand as one word pair. A pair it
# does not know prints the usage of its command, so help for a mistyped subcommand still helps.
usage_for() {
    case "$1" in
        workflow-status) usage_workflow_status ;;
        closing-issue-labels) usage_closing_issue_labels ;;
        issue) usage_issue ;;
        "issue create") usage_issue_create ;;
        "issue view") usage_issue_view ;;
        "issue plan-status") usage_issue_plan_status ;;
        "issue list") usage_issue_list ;;
        "issue search") usage_issue_search ;;
        body | "body check") usage_body ;;
        repo) usage_repo ;;
        "repo view") usage_repo_view ;;
        "repo collaborators") usage_repo_collaborators ;;
        auth | "auth status") usage_auth ;;
        pr | "pr checks") usage_pr ;;
        "pr view") usage_pr_view ;;
        "pr list") usage_pr_list ;;
        "pr create") usage_pr_create ;;
        "pr comments") usage_pr_comments ;;
        "pr reply") usage_pr_reply ;;
        comment | "comment add") usage_comment ;;
        release) usage_release ;;
        "release view") usage_release_view ;;
        "release list") usage_release_list ;;
        tag | "tag view") usage_tag_view ;;
        *" "*) usage_for "${1%% *}" ;;
        *) usage_general ;;
    esac
}

usage_error() {
    printf 'cfwf: %s\n\n' "$1" >&2
    usage_for "${CURRENT_COMMAND}" >&2
    exit 2
}

# Refuses (exit 2) an argument that is not a known $1 (option, subcommand or command); $2 is the
# number of arguments left, counting it. It is named by its position on the command line, never by
# its value: a stray value (a title the shell split, say) can hold a token, and a usage error comes
# before the leak check, so echoing it would be the leak.
unknown_argument() {
    usage_error "unknown $1 (argument $((ARGUMENT_COUNT - $2 + 1)); its value is not shown)"
}

# Succeeds when $1 matches the extended regular expression $2, byte by byte in the C locale as the
# leak rules are, so an answer from GitHub is judged the same whatever locale cfwf is run in. What
# each group matched is left in BASH_REMATCH.
matches_pattern() {
    local LC_ALL=C
    [[ "$1" =~ $2 ]]
}

# Refuses (exit 2) the value $1 of the option $3 unless it matches the pattern $2, naming the option
# and the rule $4 it broke but never the value: a free-text value such as a title can hold a token,
# and a usage error comes before the leak check, so echoing it would be the leak. The match is made
# in the C locale, as the leak rules are, so a byte that is not valid UTF-8 gets the same answer
# whatever locale cfwf is run in, and is left to the leak check's invalid UTF-8 rule. The one
# exception is a title whose text is only such bytes and whitespace: has_visible_text, which classes
# in C.UTF-8, finds no visible character there, so check_title_shape refuses it as a usage error.
validate() {
    local value="$1" pattern="$2" flag="$3" rule="$4"
    matches_pattern "${value}" "${pattern}" || usage_error "invalid value for ${flag}: ${rule}"
}

# gh reads 0123 as 123 and answers with the URL of 123, so a number is kept without its leading
# zeros: every URL built from it, and every URL gh answers with, then names it the same way.
without_leading_zeros() {
    local number="${1#"${1%%[!0]*}"}"
    printf '%s\n' "${number:-0}"
}

assign_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo)
            # The value goes in REST paths (repos/<owner>/<repo>/...), where an owner or repository
            # of . or .. would be read as a path segment and reach another endpoint.
            validate "${value}" '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' "${flag}" "it must be <owner>/<repo>"
            [[ "/${value}/" != *"/./"* && "/${value}/" != *"/../"* ]] \
                || usage_error "invalid value for ${flag}: neither the owner nor the repository can be . or .."
            REPO="${value}"
            ;;
        --pr)
            validate "${value}" '^[0-9]+$' "${flag}" "it must be a number"
            PR=$(without_leading_zeros "${value}")
            ;;
        --issue)
            validate "${value}" '^[0-9]+$' "${flag}" "it must be a number"
            ISSUE=$(without_leading_zeros "${value}")
            ;;
        --status)
            # Only ever compared against the board's own option names, never put in a filter.
            validate "${value}" '^[^[:cntrl:]]+$' "${flag}" "it must not contain a control character"
            STATUS="${value}"
            ;;
    esac
}

parse_options() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --set | --check)
                if [ -n "${MODE}" ] && [ "${MODE}" != "${1#--}" ]; then
                    usage_error "--set and --check are mutually exclusive"
                fi
                MODE="${1#--}"
                shift
                ;;
            --repo | --pr | --issue | --status)
                [ "$#" -ge 2 ] || usage_error "$1 needs a value"
                assign_option "$1" "$2"
                shift 2
                ;;
            -h | --help)
                usage_for "${CURRENT_COMMAND}"
                exit 0
                ;;
            *)
                unknown_argument option "$#"
                ;;
        esac
    done
}

require() {
    local variable="$1" flag="$2"
    [ -n "${!variable}" ] || usage_error "missing required option ${flag}"
}

# Resolves --pr/--issue into the number, the content type the board reports for it, and the
# URL path segment, so --set and --check name an item the same way.
require_target() {
    if [ -n "${PR}" ] && [ -n "${ISSUE}" ]; then
        usage_error "--pr and --issue are mutually exclusive"
    fi
    [ -n "${PR}${ISSUE}" ] || usage_error "missing required option --pr or --issue"

    if [ -n "${PR}" ]; then
        TARGET_NUMBER="${PR}"
        TARGET_TYPE="PullRequest"
        TARGET_URL_KIND="pull"
    else
        TARGET_NUMBER="${ISSUE}"
        TARGET_TYPE="Issue"
        TARGET_URL_KIND="issues"
    fi
}

require_gh() {
    command -v gh > /dev/null 2>&1 || die "gh is not installed"
}

require_git() {
    command -v git > /dev/null 2>&1 || die "git is not installed"
}

repository_not_found() {
    die "the repository $1 was not found, or the caller cannot see it"
}

# Finds the open project titled "Workflow" linked to REPO (a closed one left over from a
# replaced board is ignored) and sets PROJECT_ID, PROJECT_NUMBER and OWNER. The owner is read
# from the project's own path rather than assumed to be the repository's owner.
resolve_project() {
    local projects resource_path
    projects=$(gh repo view "${REPO}" --json projectsV2 \
        --jq '.projectsV2.Nodes[] | select(.title=="Workflow" and .closed != true) | [.id, (.number|tostring), .resourcePath] | @tsv') \
        || die "could not read the projects of ${REPO}"
    [ -n "${projects}" ] || die "no project titled Workflow is linked to ${REPO}"
    [[ "${projects}" != *$'\n'* ]] || die "more than one project titled Workflow is linked to ${REPO}"

    IFS=$'\t' read -r PROJECT_ID PROJECT_NUMBER resource_path <<< "${projects}"
    [[ "${PROJECT_ID}" =~ ^[A-Za-z0-9_=-]+$ ]] || die "unexpected project id for ${REPO}: ${PROJECT_ID}"
    [[ "${PROJECT_NUMBER}" =~ ^[0-9]+$ ]] || die "unexpected project number for ${REPO}: ${PROJECT_NUMBER}"
    [[ "${resource_path}" =~ ^/(users|orgs)/([A-Za-z0-9_.-]+)/projects/[0-9]+$ ]] \
        || die "unexpected project path for ${REPO}: ${resource_path}"
    OWNER="${BASH_REMATCH[2]}"
}

# Prints the workflow state named $1 (matched without regard to case) in its canonical spelling,
# or nothing when it is not one of WORKFLOW_STATES.
canonical_workflow_state() {
    local state
    for state in "${WORKFLOW_STATES[@]}"; do
        if [ "${state,,}" = "${1,,}" ]; then
            printf '%s' "${state}"
            return 0
        fi
    done
}

# Finds the field that carries the workflow on this project and the option named STATUS, setting
# FIELD_ID, FIELD_NAME and OPTION_ID and rewriting STATUS to its canonical spelling. STATUS must be
# one of WORKFLOW_STATES. The built-in "Status" field is used once the board is converted (#1519);
# while the board still has the old "Workflow Status" field, that field is used, so --set, --check
# and the conversion always agree on which value is the real one.
resolve_status() {
    local rows kind field option name canonical
    local -A options=()
    canonical=$(canonical_workflow_state "${STATUS}")
    if [ -z "${canonical}" ]; then
        local valid
        valid=$(printf '%s, ' "${WORKFLOW_STATES[@]}")
        die "unknown --status (valid: ${valid%, })"
    fi
    STATUS="${canonical}"

    # $kind and $field below are jq variables, not shell ones.
    # shellcheck disable=SC2016
    rows=$(gh project field-list "${PROJECT_NUMBER}" --owner "${OWNER}" --format json -L "${FIELD_LIMIT}" \
        --jq ".fields[] | select(.name==\"Status\" or .name==\"${LEGACY_FIELD}\")"' | .name as $kind | .id as $field | .options[]? | [$kind, $field, .id, .name] | @tsv') \
        || die "could not read the fields of project ${PROJECT_NUMBER}"

    local legacy_present=0
    while IFS=$'\t' read -r kind field option name; do
        [ -n "${kind}" ] || continue
        [ "${kind}" != "${LEGACY_FIELD}" ] || legacy_present=1
        [ "${name,,}" = "${STATUS,,}" ] || continue
        options["${kind}"]="${field}|${option}"
    done <<< "${rows}"

    # While the board still has the old field it is the one used, whatever Status holds: --check
    # reads it first, and a conversion copies it onto Status, so a write to Status alone on a board
    # whose conversion stopped part way would be invisible and then overwritten.
    kind=Status
    [ "${legacy_present}" -eq 0 ] || kind="${LEGACY_FIELD}"
    [ -n "${options[${kind}]:-}" ] || die "project ${PROJECT_NUMBER} has no '${STATUS}' option on its ${kind} field"
    FIELD_NAME="${kind}"
    FIELD_ID="${options[${kind}]%%|*}"
    OPTION_ID="${options[${kind}]#*|}"
}

# The board read below uses read-only GraphQL: gh project has no command that reads one
# item, and listing the whole board is capped and can be slow to show a freshly added item
# (both seen in practice, #1491). Every write stays on native gh project commands and the query
# here contains no mutation. If the GraphQL call fails for any reason the board listing is used
# instead, with a warning so the failure is visible.

# Runs gh with the given arguments and no stdin, keeping stdout in GH_OUTPUT and stderr in GH_ERROR
# so that anything gh writes to stderr can never end up inside a value. Returns gh's exit status.
# Each caller uses GH_OUTPUT and GH_ERROR before its next gh call.
gh_capture() {
    local status=0
    ensure_temp_file GH_ERR_FILE
    GH_OUTPUT=$(gh "$@" < /dev/null 2> "${GH_ERR_FILE}") || status=$?
    GH_ERROR=$(< "${GH_ERR_FILE}")
    return "${status}"
}

# Prints the first line of $1, printable characters only (no terminal escape sequences), at most
# 200 characters: the form in which any gh error is quoted.
printable_first_line() {
    local text="${1%%$'\n'*}"
    text="${text//[![:print:]]/}"
    printf '%s' "${text:0:200}"
}

# The text to quote when a gh_capture call failed: gh can put a raw error body on stdout when --jq
# is used, so that is the fallback when stderr is empty.
gh_failure_text() {
    printable_first_line "${GH_ERROR:-${GH_OUTPUT}}"
}

# A jq definition, put before a filter that uses it: printable is the string it is given with each
# control character (C0, a tab or a newline included, DEL, and C1, U+0080 to U+009F) turned into a
# space, so it fits on one line of the output, cannot be taken for a field separator and carries no
# terminal escape. The range is written out because gh's --jq (gojq, Go regular expressions) reads
# [[:cntrl:]] as ASCII only, so it would let a C1 control such as U+009B (CSI) through, where jq's
# would not.
readonly PRINTABLE_DEF='def printable: gsub("[\\x{0}-\\x{1f}\\x{7f}-\\x{9f}]"; " ");'
# A jq definition, put before a filter that uses it: field is one field of a tab-separated row, the
# value it is given as a printable string, or - when there is none. No field is ever empty, because
# a reader that splits a row on tabs with read collapses consecutive tabs.
readonly ROW_FIELD_DEF="${PRINTABLE_DEF}"' def field: (. // "") | tostring | printable | if . == "" then "-" else . end;'
# A jq definition, put before a filter that uses it: line is one line of a command that prints a
# field a line, the name it is given, a tab and the value as a printable string, nothing when there
# is none, so every line has exactly one tab.
readonly LINE_DEF="${PRINTABLE_DEF}"' def line(key; value): key + "\t" + (value // "" | tostring | printable);'

# fall_back_to_listing warns about the failed direct read, quoting the given error text, then
# sets ITEM_STATUS from listing the board with the given jq filter. Returns non-zero when the
# listing fails too.
fall_back_to_listing() {
    printf 'cfwf: warning: the direct GraphQL read failed (%s); falling back to listing the board\n' "$1" >&2
    ITEM_STATUS=$(gh project item-list "${PROJECT_NUMBER}" --owner "${OWNER}" --format json -L "${ITEM_LIMIT}" --jq "$2")
}

# Sets ITEM_STATUS to the target's workflow state on the Workflow project, "(unset)" when it has
# none, or "" when it is not on that project. The state is the built-in "Status" value; while a
# board still has the old "Workflow Status" field (it is converted one repository at a time,
# #1519) that field's value is used instead, and a built-in Todo, In Progress or Done, which is not
# a workflow state, reads as "(unset)". issue(number:) resolves only an issue and pullRequest(number:) only a pull request
# (chosen by --issue or --pr), so a number of the other type comes back as not found. GitHub's
# "no such issue/pull request with that number" answer means "not found", not a failure (any
# other error, such as an unreadable repository, still falls back). Returns non-zero only when
# both the direct read and the board listing fail.
read_target_status() {
    local accessor="issue" states="" state
    [ "${TARGET_TYPE}" = "PullRequest" ] && accessor="pullRequest"
    ITEM_STATUS=""
    # The ten states as a jq array literal (gh --jq takes no --arg); no state contains a quote.
    for state in "${WORKFLOW_STATES[@]}"; do
        states+="${states:+,}\"${state}\""
    done
    # $legacy / $status: the two field values; the old field wins while the board still has it.
    local pick="(if \$legacy != null then \$legacy elif (\$status != null and ([${states}] | index(\$status)) != null) then \$status else \"(unset)\" end)"
    if gh_capture api graphql \
        -f query="query(\$o:String!,\$r:String!,\$n:Int!){repository(owner:\$o,name:\$r){${accessor}(number:\$n){projectItems(first:100){nodes{project{id} legacy:fieldValueByName(name:\"${LEGACY_FIELD}\"){... on ProjectV2ItemFieldSingleSelectValue{name}} status:fieldValueByName(name:\"Status\"){... on ProjectV2ItemFieldSingleSelectValue{name}}}}}}}" \
        -f o="${REPO%%/*}" -f r="${REPO#*/}" -F n="${TARGET_NUMBER}" \
        --jq ".data.repository.${accessor}.projectItems.nodes[] | select(.project.id==\"${PROJECT_ID}\") | (.legacy.name // null) as \$legacy | (.status.name // null) as \$status | ${pick}"; then
        ITEM_STATUS="${GH_OUTPUT}"
        return 0
    fi
    case "${GH_ERROR}${GH_OUTPUT}" in
        *"Could not resolve to an Issue with the number"* | *"Could not resolve to a PullRequest with the number"*) return 0 ;;
    esac

    # The listing names a field by its lower-cased first word, so Workflow Status is "workflow Status".
    fall_back_to_listing "$(gh_failure_text)" ".items[] | select(((.content.repository // \"\") | ascii_downcase)==\"${REPO,,}\" and .content.number==${TARGET_NUMBER} and .content.type==\"${TARGET_TYPE}\") | (.[\"workflow Status\"] // null) as \$legacy | (.status // null) as \$status | ${pick}"
}

# Adds the item at the given URL to the board (idempotent) and sets its status on the field
# resolve_status chose. resolve_project and resolve_status must already have run. Never reads the
# values back.
put_item_on_board() {
    local item_url="$1"
    local item_id

    item_id=$(gh project item-add "${PROJECT_NUMBER}" --owner "${OWNER}" --url "${item_url}" \
        --format json --jq '.id') || die "could not add ${item_url} to project ${PROJECT_NUMBER}"
    [[ "${item_id}" =~ ^[A-Za-z0-9_=-]+$ ]] || die "unexpected item id returned for ${item_url}: ${item_id}"

    gh project item-edit --project-id "${PROJECT_ID}" --id "${item_id}" \
        --field-id "${FIELD_ID}" --single-select-option-id "${OPTION_ID}" > /dev/null \
        || die "could not set the ${FIELD_NAME} of ${item_url}"
}

workflow_status_set() {
    require REPO --repo
    require STATUS --status
    require_target
    require_gh

    local item_url="https://github.com/${REPO}/${TARGET_URL_KIND}/${TARGET_NUMBER}"

    resolve_project
    resolve_status
    put_item_on_board "${item_url}"

    printf 'Set %s to %s\n' "${item_url}" "${STATUS}"
}

workflow_status_check() {
    require REPO --repo
    [ -z "${STATUS}" ] || usage_error "--status is only valid with --set"
    require_target
    require_gh

    resolve_project

    read_target_status || die "could not read the status of ${REPO}#${TARGET_NUMBER}: both the direct query and the listing of project ${PROJECT_NUMBER} failed"
    [ -n "${ITEM_STATUS}" ] || die "${REPO}#${TARGET_NUMBER} is not on project ${PROJECT_NUMBER}"
    printf '%s\n' "${ITEM_STATUS}"
}

cmd_workflow_status() {
    CURRENT_COMMAND="workflow-status"
    parse_options "$@"
    case "${MODE}" in
        set) workflow_status_set ;;
        check) workflow_status_check ;;
        *) usage_error "workflow-status needs --set or --check" ;;
    esac
}

cmd_closing_issue_labels() {
    CURRENT_COMMAND="closing-issue-labels"
    parse_options "$@"
    [ -z "${MODE}${STATUS}${ISSUE}" ] || usage_error "closing-issue-labels takes only --repo and --pr"
    require REPO --repo
    require PR --pr
    require_gh

    # Each closing issue is read from its own repository: a PR can close an issue in another repo.
    local references issue_repo number failed=0 loop_status
    references=$(gh pr view "${PR}" --repo "${REPO}" --json closingIssuesReferences \
        --jq '.closingIssuesReferences[] | [(.repository.owner.login + "/" + .repository.name), (.number | tostring)] | @tsv') \
        || die "could not read the closing issues of ${REPO}#${PR}"

    # The labels that could be read are still printed, but a failure to read any closing issue
    # makes the command exit non-zero, so a caller never mistakes a partial list for a complete one.
    {
        while IFS=$'\t' read -r issue_repo number; do
            [ -n "${number}" ] || continue
            if [[ "${issue_repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && "${number}" =~ ^[0-9]+$ ]]; then
                gh issue view "${number}" --repo "${issue_repo}" --json labels --jq '.labels[].name' || {
                    printf 'cfwf: warning: could not fetch the labels of %s#%s\n' "${issue_repo}" "${number}" >&2
                    failed=1
                }
            else
                printf 'cfwf: warning: unexpected closing issue reference: %s %s\n' "${issue_repo}" "${number}" >&2
                failed=1
            fi
        done <<< "${references}"
        [ "${failed}" -eq 0 ]
    } | { grep -vE '^(Blocked|On-Hold)$' || true; } | sort -u
    loop_status="${PIPESTATUS[0]}"
    [ "${loop_status}" -eq 0 ] || exit 1
}

# Prints the canonical spelling of the priority named by $1 (matched without regard to case),
# or nothing when it is not one of PRIORITIES.
canonical_priority() {
    local candidate
    for candidate in "${PRIORITIES[@]}"; do
        if [ "${candidate,,}" = "${1,,}" ]; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    return 1
}

# Looks the label named by $1 (matched without regard to case) up in STANDARD_LABELS and sets
# STANDARD_NAME, STANDARD_COLOUR and STANDARD_DESCRIPTION. Returns non-zero for any other label.
STANDARD_NAME=""
STANDARD_COLOUR=""
STANDARD_DESCRIPTION=""
standard_label() {
    local name colour description
    while IFS='|' read -r name colour description; do
        if [ "${name,,}" = "${1,,}" ]; then
            STANDARD_NAME="${name}"
            STANDARD_COLOUR="${colour}"
            STANDARD_DESCRIPTION="${description}"
            return 0
        fi
    done <<< "${STANDARD_LABELS}"
    return 1
}

# True when the C.UTF-8 locale exists, so that bash counts characters and not bytes in it: an
# assignment of a locale that is not installed is silently ignored.
utf8_locale_available() {
    local LC_ALL=C.UTF-8 accented=$'\303\251'
    [ "${#accented}" -eq 1 ]
}

# Called just before a length is counted or a character classed in C.UTF-8 (validate_visible_text,
# has_visible_text and check_body_for_leaks), so a host without it is refused rather than left to
# count or class bytes and judge a valid multi-byte title, label or body wrongly. Nothing else
# needs the locale, so --help and usage errors still work.
require_utf8_locale() {
    utf8_locale_available || die "the C.UTF-8 locale is not installed, so lengths cannot be counted in characters"
}

# Refuses a value that is only whitespace or longer than GitHub accepts, so the call fails here and
# not half way through creating things. GitHub counts characters, and bash counts bytes in the C
# locale a container usually has, so the length is taken in a UTF-8 one.
validate_visible_text() {
    local value="$1" limit="$2" flag="$3"
    require_utf8_locale
    local LC_ALL=C.UTF-8
    [[ "${value}" =~ [^[:space:]] && "${#value}" -le "${limit}" ]] \
        || usage_error "invalid value for ${flag}: it must not be blank or longer than ${limit} characters"
}

# Refuses (exit 2) the flag $2 when the variable $1 it sets is already set: $3, when given, says
# why.
assign_once() {
    [ -z "${!1}" ] || usage_error "$2 can only be given once${3:+: $3}"
}

# Assigns --repo ($1) its value $2, refusing a second one.
assign_repository_option() {
    assign_once REPO "$1"
    assign_option "$1" "$2"
}

assign_issue_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --pr | --issue)
            [ -z "${PR}${ISSUE}" ] || usage_error "--pr or --issue can only be given once, and not both"
            assign_option "${flag}" "${value}"
            ;;
        --priority)
            assign_once PRIORITY "${flag}" "an issue has exactly one priority"
            PRIORITY=$(canonical_priority "${value}") \
                || usage_error "unknown --priority (expected ${PRIORITY_LIST})"
            ;;
        --title)
            assign_once TITLE "${flag}"
            validate "${value}" '^[^[:cntrl:]]+$' "${flag}" "it must not contain a control character"
            validate_visible_text "${value}" "${TITLE_LIMIT}" "${flag}"
            TITLE="${value}"
            ;;
        --body-file)
            assign_once BODY_FILE "${flag}"
            validate "${value}" '^[^[:cntrl:]]+$' "${flag}" "it must not contain a control character"
            BODY_FILE="${value}"
            ;;
        --label)
            # gh splits a --label value on commas, so a comma could never be part of a name.
            validate "${value}" '^[^[:cntrl:],]+$' "${flag}" "it must not contain a comma or a control character"
            validate_visible_text "${value}" "${LABEL_NAME_LIMIT}" "${flag}"
            LABELS+=("${value}")
            ;;
    esac
}

# Succeeds when $1 is exactly one of the remaining arguments.
is_one_of() {
    local candidate="$1" option
    shift
    for option in "$@"; do
        [ "${option}" != "${candidate}" ] || return 0
    done
    return 1
}

# Parses the options of a command: $1 is the function that assigns each one (called with the flag,
# then its value for a flag that takes one), $2 the space-separated flags that take a value and $3
# those that take none; the rest are the arguments. Help is the current command's.
parse_command_options() {
    local assign="$1"
    local -a with_value switches
    read -ra with_value <<< "$2"
    read -ra switches <<< "$3"
    shift 3
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h | --help)
                usage_for "${CURRENT_COMMAND}"
                exit 0
                ;;
            *)
                # A whole argument is compared with each flag, so one argument holding two flags
                # and a space is an unknown option, not a match.
                if is_one_of "$1" "${switches[@]}"; then
                    "${assign}" "$1"
                    shift
                    continue
                fi
                is_one_of "$1" "${with_value[@]}" || unknown_argument option "$#"
                [ "$#" -ge 2 ] || usage_error "$1 needs a value"
                "${assign}" "$1" "$2"
                shift 2
                ;;
        esac
    done
}

parse_issue_options() {
    parse_command_options assign_issue_option "--repo --priority --title --body-file --label" "" "$@"
}

parse_body_options() {
    parse_command_options assign_issue_option "--repo --body-file" "" "$@"
}

# Copies the body (stdin when BODY_FILE is -) to a private temporary file, BODY_PATH_TMP, and
# points BODY_FILE at that copy, refusing a missing, unreadable or blank body, then runs the leak
# check on the copy for REPO. The copy is what gh is given, so a body file that is rewritten after
# the check (by a writer that has not finished, or between the check and the post) can never be
# posted unchecked.
resolve_body() {
    ensure_temp_file BODY_PATH_TMP
    if [ "${BODY_FILE}" = "-" ]; then
        cat > "${BODY_PATH_TMP}" || die "could not read the body from stdin"
    else
        # The path is never printed: it is usually a host path (a temporary or runtime directory),
        # which is what the leak check refuses to post.
        if [ ! -f "${BODY_FILE}" ] || [ ! -r "${BODY_FILE}" ]; then
            die "cannot read the --body-file"
        fi
        cat -- "${BODY_FILE}" > "${BODY_PATH_TMP}" || die "could not read the --body-file"
    fi
    BODY_FILE="${BODY_PATH_TMP}"
    LC_ALL=C grep -q '[^[:space:]]' "${BODY_FILE}" || die "the body is empty"
    check_body_for_leaks "${BODY_FILE}" "${REPO}"
}

# Refuses the text $1 names (body, title or label) under the rule $2. It names only the subject,
# the rule and, for a body, the line $3, never the matched text: echoing a token into a transcript
# would itself be the leak. A title or a label is a single line, so it has no line number.
refuse_text() {
    local subject="$1" rule="$2" line="${3:-}"
    [ "${subject}" = body ] || line=""
    printf 'cfwf: %s refused: %s%s\n' "${subject}" "${rule}" "${line:+ (line ${line})}" >&2
    exit "${BODY_REFUSED_EXIT}"
}

# Refuses the text $1 names under the rule $2 when the extended regular expression $3 matches a
# line of the file $4, naming that line. grep is given the path, so a file it cannot read is its
# own error (status 2) and not a failed redirection that looks like no match; any grep failure
# dies, because treating it as no match would pass the text unchecked. Any further arguments are
# extra grep options: -xv refuses the first line the pattern does not match as a whole.
refuse_first_match() {
    local subject="$1" rule="$2" pattern="$3" file="$4" match status
    shift 4
    match=$(LC_ALL=C grep -naE -m1 "$@" -e "${pattern}" -- "${file}")
    status=$?
    [ "${status}" -le 1 ] || die "could not scan the ${subject}"
    [ "${status}" -ne 0 ] || refuse_text "${subject}" "${rule}" "${match%%:*}"
}

# Writes a copy of the file $1 (the text $2 names) to SCAN_TMP with each NUL turned into 0x01,
# because no pattern can hold a NUL and 0x01 is refused as a control character too. The copy is a
# file and not a pipe so that a failure here stops the check rather than leaving it nothing to scan.
write_nul_free_copy() {
    ensure_temp_file SCAN_TMP
    LC_ALL=C tr '\000' '\001' < "$1" > "${SCAN_TMP}" || die "could not scan the $2"
}

# Applies the token, host path, control character and invalid UTF-8 rules, in that order, to the
# file $1 (the text $2 names), refusing at the first that matches. The UTF-8 rule comes before the
# length is counted, because wc -m does not count a byte that is not valid UTF-8.
check_text_patterns() {
    local text="$1" subject="$2"
    refuse_first_match "${subject}" token "${TOKEN_PATTERN}" "${text}"
    refuse_first_match "${subject}" "host path" "${HOST_PATH_PATTERN}" "${text}"
    write_nul_free_copy "${text}" "${subject}"
    refuse_first_match "${subject}" "control character" "${CONTROL_PATTERN}" "${SCAN_TMP}"
    refuse_first_match "${subject}" "invalid UTF-8" "${UTF8_LINE_PATTERN}" "${SCAN_TMP}" -xv
}

# Fills PRIVATE_OWNERS (lower-cased) from the space-separated CFWF_PRIVATE_OWNERS, once per run:
# the body, the title and each label are all checked against the same list.
load_private_owners() {
    local owner
    local -a owners
    [ -z "${PRIVATE_OWNERS_LOADED}" ] || return 0
    read -ra owners <<< "${CFWF_PRIVATE_OWNERS:-}"
    for owner in "${owners[@]}"; do
        [[ "${owner}" =~ ^${OWNER_PATTERN}$ ]] || die "CFWF_PRIVATE_OWNERS holds a value that is not an owner login"
        PRIVATE_OWNERS["${owner,,}"]=1
    done
    PRIVATE_OWNERS_LOADED=1
}

# Prints "<line $1>\t<owner/repo>" for the owner/repo $2 as matched, without the trailing full
# stops of a sentence, the .git of a clone URL and then the .wiki of a wiki (owner/repo.wiki, or
# its clone URL owner/repo.wiki.git), since a wiki has its repository's visibility: the
# repository is what is compared with the target and looked up. Prints nothing when no repository
# name is left, as for the ellipsis in "github.com/owner/...", which names no repository.
print_reference() {
    local reference="$2"
    while [[ "${reference}" == *. ]]; do
        reference="${reference%.}"
    done
    reference="${reference%.git}"
    [[ "${reference,,}" != *.wiki ]] || reference="${reference:0:-5}"
    [ -n "${reference#*/}" ] || return 0
    printf '%s\t%s\n' "$1" "${reference}"
}

# Succeeds when the owner/repo word $1, which followed the byte $2 (empty at the start of a line),
# is a cross-reference: it ends in # and digits alone, or in @ and a commit SHA alone, either of
# them followed only by the underscores that close Markdown emphasis (owner/repo#5_), $2 is not
# one of URL_PATH_BYTES, and it is not the port and path of a host:port (localhost:8080/api#1).
is_cross_reference() {
    [[ "$1" =~ (\#[0-9]+|@[0-9A-Fa-f]{7,40})_*$ ]] || return 1
    [ "$2" != ":" ] || [[ ! "${1%%/*}" =~ ^[0-9]+$ ]] || return 1
    [ -z "$2" ] || [[ "${URL_PATH_BYTES}" != *"$2"* ]]
}

# Prints "<line>\t<owner/repo>" for each repository the text in the file $1 names: links
# (REPOSITORY_LINK_PREFIX) and git@github.com:owner/repo remotes, standalone owner/repo#n and
# owner/repo@sha references, and bare owner/repo words whose owner is in PRIVATE_OWNERS (a bare
# owner/repo is otherwise left alone, because a relative file path has the same shape).
repository_references() {
    local body="$1" links words match text owner boundary
    # grep's output is taken whole and its status checked, because a grep that fails inside a
    # process substitution would look like a body naming no repository.
    links=$(LC_ALL=C grep -inoaE "${REPOSITORY_LINK_PREFIX}${REPOSITORY_PATTERN}" -- "${body}")
    [ "$?" -le 1 ] || return 2
    words=$(LC_ALL=C grep -noaE "${REFERENCE_BOUNDARY}${REPOSITORY_PATTERN}([#@][A-Za-z0-9_-]+)?" -- "${body}")
    [ "$?" -le 1 ] || return 2

    # A link ends with owner/repo, and the owner follows the last / or : before it, whichever host
    # the link names.
    while IFS= read -r match; do
        [ -n "${match}" ] || continue
        text="${match#*:}"
        owner="${text%/*}"
        owner="${owner##*[/:]}"
        print_reference "${match%%:*}" "${owner}/${text##*/}"
    done <<< "${links}"

    # One pass finds both shapes. The longest match takes in every word character and dash after a
    # # or an @, so a cross-reference is one whose # is followed by digits alone, or whose @ is
    # followed by a commit SHA alone (7 to 40 hex digits, GitHub's owner/repo@sha autolink):
    # docs/setup.md#1-intro (a heading anchor), fix/foo#12abc and owner/action@v4 are not. grep
    # cannot look ahead, so taking those characters in is how it sees them; none of them can start
    # the next reference.
    while IFS= read -r match; do
        [ -n "${match}" ] || continue
        text="${match#*:}"
        # What REFERENCE_BOUNDARY matched: a byte (or nothing at the start of a line) and any
        # emphasis underscores. The byte is what says whether the word is inside a URL or a path.
        boundary="${text%%[A-Za-z0-9]*}"
        text="${text#"${boundary}"}"
        owner="${text%%/*}"
        is_cross_reference "${text}" "${boundary:0:1}" || [ -n "${PRIVATE_OWNERS["${owner,,}"]:-}" ] || continue
        print_reference "${match%%:*}" "${text%%[#@]*}"
    done <<< "${words}"
}

# Reads the repository $1 with one gh repo view: the fields $2 (comma separated) through the jq
# filter $3, whose output is left in GH_OUTPUT. Returns 1 when GitHub does not show the repository
# to the caller (it is not there, or the caller cannot see it, which GitHub answers alike) and 2 on
# any other failure, with gh's error in GH_ERROR, so each caller says what a missing repository
# means to it and a transport error is never read as one.
read_repository() {
    gh_capture repo view "$1" --json "$2" --jq "$3" && return 0
    [[ "${GH_ERROR}" != *"Could not resolve to a Repository"* && "${GH_ERROR}" != *"HTTP 404"* ]] || return 1
    return 2
}

# Records in REPOSITORY_VISIBILITY whether the repository $1 is public, private (or internal) or
# missing (GitHub does not show it to the caller), asking GitHub once per run; any other failure
# dies with $2.
look_up_visibility() {
    local repository="$1" failure="$2" key="${1,,}" read_status=0
    [ -z "${REPOSITORY_VISIBILITY["${key}"]:-}" ] || return 0
    read_repository "${repository}" visibility .visibility || read_status=$?
    if [ "${read_status}" -eq 1 ]; then
        REPOSITORY_VISIBILITY["${key}"]=missing
        return 0
    fi
    [ "${read_status}" -eq 0 ] || die "${failure}"
    case "${GH_OUTPUT,,}" in
        public) REPOSITORY_VISIBILITY["${key}"]=public ;;
        private | internal) REPOSITORY_VISIBILITY["${key}"]=private ;;
        *) die "${failure}: gh gave an unexpected answer" ;;
    esac
}

# Succeeds when the repository $1, named in the text, is public. One GitHub does not show the
# caller counts as private, since the caller cannot tell it apart from one; any other failure dies
# with $2.
repository_is_public() {
    look_up_visibility "$1" "$2"
    [ "${REPOSITORY_VISIBILITY["${1,,}"]}" = public ]
}

# Succeeds when the target repository $1 is public. A target GitHub does not show the caller dies:
# counting it as private would skip every private repository check and pass the text unchecked.
# Any other failure dies with $2.
target_is_public() {
    repository_is_public "$1" "$2" && return 0
    [ "${REPOSITORY_VISIBILITY["${1,,}"]}" != missing ] || repository_not_found "$1"
    return 1
}

# Refuses the text in the file $1, for the repository $2, when the repository is public and the
# text names a private one; $3 names the text (body, title or label). The target's own visibility
# is only looked up once the text names some other repository, so text that names none costs no
# gh call. The repository a refused reference names is never printed.
check_repository_references() {
    local text="$1" target="$2" subject="$3" references line reference owner place
    load_private_owners
    references=$(repository_references "${text}") || die "could not scan the ${subject}"
    [ -n "${references}" ] || return 0
    references=$(sort -t$'\t' -k1,1n -s <<< "${references}") || die "could not scan the ${subject}"
    while IFS=$'\t' read -r line reference; do
        owner="${reference%%/*}"
        [ "${reference,,}" != "${target,,}" ] || continue
        [[ "${GITHUB_RESERVED_PATHS}" != *" ${owner,,} "* ]] || continue

        target_is_public "${target}" "could not read the visibility of ${target}" || return 0

        [ -z "${PRIVATE_OWNERS["${owner,,}"]:-}" ] || refuse_text "${subject}" "private repository" "${line}"
        place="in the ${subject}"
        [ "${subject}" != body ] || place="on line ${line} of the body"
        repository_is_public "${reference}" "could not read the visibility of the repository named ${place}" \
            || refuse_text "${subject}" "private repository" "${line}"
    done <<< "${references}"
}

# Refuses (exit 8) a body that would leak something if posted, applying the rules in order and
# stopping at the first that matches. $1 must be the exact file gh will be given.
check_body_for_leaks() {
    local body="$1" target="$2"
    local length
    check_text_patterns "${body}" body
    require_utf8_locale
    # A count that fails or is not a number is a scan failure (exit 1), never "too long" or a pass.
    length=$(LC_ALL=C.UTF-8 wc -m < "${body}") || die "could not count the characters of the body"
    length="${length//[[:space:]]/}"
    [[ "${length}" =~ ^[0-9]+$ ]] || die "could not count the characters of the body"
    [ "${length}" -le "${BODY_LIMIT}" ] || refuse_text body "too long"
    check_repository_references "${body}" "${target}" body
}

# Refuses (exit 8) a short value, the --title or a --label that $3 names (title or label), with the
# same rules as a body except the length, which validate_visible_text has already checked. The
# value is written to VALUE_TMP because the rules read a file, and the reference scan reads it more
# than once.
check_value_for_leaks() {
    local value="$1" target="$2" subject="$3"
    ensure_temp_file VALUE_TMP
    printf '%s\n' "${value}" > "${VALUE_TMP}" || die "could not scan the ${subject}"
    check_text_patterns "${VALUE_TMP}" "${subject}"
    check_repository_references "${VALUE_TMP}" "${target}" "${subject}"
}

# Sets ISSUE_LABELS to the labels to put on the issue: the priority first, then each --label
# with a standard label written in its standard spelling and a repeat (in any case) dropped.
# A priority label given as a --label is refused, pointing at --priority.
ISSUE_LABELS=()
collect_issue_labels() {
    local label canonical
    local -A seen=()
    ISSUE_LABELS=("${PRIORITY}")
    for label in "${LABELS[@]}"; do
        if canonical=$(canonical_priority "${label}"); then
            usage_error "'${label}' is a priority; use --priority ${canonical}, not --label"
        fi
        if standard_label "${label}"; then
            label="${STANDARD_NAME}"
        fi
        [ -z "${seen["${label,,}"]:-}" ] || continue
        seen["${label,,}"]=1
        ISSUE_LABELS+=("${label}")
    done
}

# Creates every label in ISSUE_LABELS that the repository does not have yet. A label that
# turns up between the listing and the create ("already exists") is not an error.
ensure_labels_exist() {
    local existing_names label output
    local -a create
    local -A existing=()
    existing_names=$(gh label list --repo "${REPO}" --limit "${LABEL_LIMIT}" --json name --jq '.[].name') \
        || die "could not read the labels of ${REPO}"
    while IFS= read -r label; do
        [ -n "${label}" ] && existing["${label,,}"]=1
    done <<< "${existing_names}"

    for label in "${ISSUE_LABELS[@]}"; do
        [ -z "${existing["${label,,}"]:-}" ] || continue
        # The name follows -- so a name that starts with a dash is not read as a flag.
        create=(label create --repo "${REPO}")
        if standard_label "${label}"; then
            create+=(--color "${STANDARD_COLOUR}" --description "${STANDARD_DESCRIPTION}")
        fi
        create+=(-- "${label}")
        output=$(gh "${create[@]}" 2>&1) || label_create_failed "${label}" "${output}"
    done
}

label_create_failed() {
    case "$2" in
        *"already exists"* | *already_exists*) return 0 ;;
    esac
    die "could not create the label '$1' in ${REPO}: ${2%%$'\n'*}"
}

# The owners whose repositories take only titles of the shape TITLE_SHAPE_PATTERN. Hard-coded, with
# no environment variable or option, because either would be a way to skip the check.
readonly TITLE_CHECK_OWNERS=(credfeto funfair-tech)
# "prefix: text" or "prefix(name): text" with a lower-case prefix; a single hyphen may join two
# parts of the prefix, as in create-project. The name holds no bracket or colon and does not start
# or end with whitespace. Neither the name nor the text is case-checked. The text, the last group,
# is only captured here: this is matched byte by byte in the C locale, where the first byte of a
# multi-byte space looks like text, so check_title_shape asks has_visible_text about it instead.
readonly TITLE_SHAPE_PATTERN='^[a-z][a-z0-9]*(-[a-z0-9]+)*(\([^():[:space:]]([^():]*[^():[:space:]])?\))?: +(.*)$'
readonly TITLE_SHAPE_RULE='it must be "prefix: text" or "prefix(name): text" with a lower-case prefix, for example "oneshot: ..." or "tool(cfwf): ..."'
# The characters that show nothing although C.UTF-8 classes them as graphic, not as [:space:]: the
# no-break spaces U+00A0, U+2007 and U+202F, U+2800 (the blank braille pattern), and Unicode's
# Default_Ignorable_Code_Point set (soft hyphen, zero-width spaces and joiners, direction marks, the
# Hangul fillers, variation selectors, the byte order mark and tags). As bytes, for a bash pattern
# bracket: a regular expression bracket refuses a multi-byte range.
# U+00A0, U+2007, U+202F and U+2800.
INVISIBLE_CHARACTERS=$'\302\240\342\200\207\342\200\257\342\240\200'
# U+00AD, U+034F, U+061C, U+115F, U+1160, U+17B4, U+17B5 and U+180B-U+180F.
INVISIBLE_CHARACTERS+=$'\302\255\315\217\330\234\341\205\237\341\205\240\341\236\264\341\236\265\341\240\213-\341\240\217'
# U+200B-U+200F, U+202A-U+202E, U+2060-U+206F and U+3164.
INVISIBLE_CHARACTERS+=$'\342\200\213-\342\200\217\342\200\252-\342\200\256\342\201\240-\342\201\257\343\205\244'
# U+FE00-U+FE0F, U+FEFF, U+FFA0 and U+FFF0-U+FFF8.
INVISIBLE_CHARACTERS+=$'\357\270\200-\357\270\217\357\273\277\357\276\240\357\277\260-\357\277\270'
# U+1BCA0-U+1BCA3, U+1D173-U+1D17A and U+E0000-U+E0FFF.
INVISIBLE_CHARACTERS+=$'\360\233\262\240-\360\233\262\243\360\235\205\263-\360\235\205\272\363\240\200\200-\363\240\277\277'
readonly INVISIBLE_CHARACTERS

# Succeeds when $1 holds a character that is neither whitespace nor in INVISIBLE_CHARACTERS, judged
# in C.UTF-8 so that a multi-byte space such as U+3000 counts as whitespace and a non-ASCII letter
# counts as text. Each character is classed on its own: bash matches a pattern against a string
# that is not valid UTF-8 byte by byte, where a range would take in the bytes of a letter. Every
# copy of an invisible character is dropped at once, so this loops once per distinct one.
has_visible_text() {
    require_utf8_locale
    local LC_ALL=C.UTF-8 text="$1" character
    while [[ "${text}" =~ [^[:space:]] ]]; do
        character="${BASH_REMATCH[0]}"
        # The pattern is unquoted on purpose: its ranges must match as ranges.
        [[ "${character}" == [${INVISIBLE_CHARACTERS}] ]] || return 0
        text="${text//"${character}"/}"
    done
    return 1
}

# Succeeds when the repository $1 (owner/repo) belongs to one of TITLE_CHECK_OWNERS.
title_check_applies() {
    # Lower-cased in the C locale, where I is always i, whatever locale cfwf is run in.
    local LC_ALL=C owner="${1%%/*}"
    is_one_of "${owner,,}" "${TITLE_CHECK_OWNERS[@]}"
}

# Refuses (exit 2) the title $1 for the repository $2 unless it has the title shape, never echoing
# the title, since this runs before the leak check. The text after the prefix must hold a visible
# character, so a title such as "fix: " followed only by U+3000 is refused.
check_title_shape() {
    title_check_applies "$2" || return 0
    validate "$1" "${TITLE_SHAPE_PATTERN}" --title "${TITLE_SHAPE_RULE}"
    has_visible_text "${BASH_REMATCH[-1]}" || usage_error "invalid value for --title: ${TITLE_SHAPE_RULE}"
}

issue_create() {
    parse_issue_options "$@"
    require REPO --repo
    [ -n "${PRIORITY}" ] || usage_error "--priority is required (${PRIORITY_LIST})"
    require TITLE --title
    require BODY_FILE --body-file
    check_title_shape "${TITLE}" "${REPO}"
    collect_issue_labels
    require_gh
    resolve_body
    check_value_for_leaks "${TITLE}" "${REPO}" title
    local label
    for label in "${LABELS[@]}"; do
        check_value_for_leaks "${label}" "${REPO}" label
    done

    # The board is resolved before anything is written, so a repository with no Workflow
    # board fails here and leaves no issue behind.
    STATUS="${NEW_ISSUE_STATUS}"
    resolve_project
    resolve_status
    ensure_labels_exist

    local args=(issue create --repo "${REPO}" --title "${TITLE}" --body-file "${BODY_FILE}")
    local url
    for label in "${ISSUE_LABELS[@]}"; do
        args+=(--label "${label}")
    done
    url=$(gh "${args[@]}") || die "could not create the issue in ${REPO}"
    url="${url##*$'\n'}"
    # Neither the host nor the repository in the URL is compared with anything: gh may be reached
    # through a proxy that answers with its own host, and a renamed or transferred repository
    # answers with its new name.
    [[ "${url}" =~ ${REPOSITORY_URL_PATTERN}/issues/[0-9]+$ ]] \
        || die "gh returned an unexpected result for the new issue, which may have been created: ${url}"
    CREATED_URL="${url}"

    put_item_on_board "${url}"
    printf '%s\n' "${url}"
}

# Runs a subcommand of the command $1. The arguments up to -- are its subcommands, each followed by
# the function that runs it, and those after -- are the arguments as given after the command. The
# subcommand becomes part of CURRENT_COMMAND, so a usage error prints the usage of that one.
dispatch_subcommand() {
    local command="$1" names="" handler
    local -A handlers=()
    shift
    while [ "$1" != "--" ]; do
        handlers["$1"]="$2"
        names+="${names:+, }$1"
        shift 2
    done
    shift
    CURRENT_COMMAND="${command}"
    case "${1:-}" in
        -h | --help)
            usage_for "${command}"
            return 0
            ;;
        "")
            usage_error "${command} needs a subcommand (${names})"
            ;;
    esac
    handler="${handlers["$1"]:-}"
    [ -n "${handler}" ] || unknown_argument "${command} subcommand" "$#"
    CURRENT_COMMAND="${command} $1"
    shift
    "${handler}" "$@"
}

assign_issue_read_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --issue)
            assign_once ISSUE "${flag}"
            assign_option "${flag}" "${value}"
            ;;
    esac
}

# Parses and checks the options of a command that reads one issue: --repo and --issue, both
# required, each once, and nothing else.
parse_issue_read_options() {
    parse_command_options assign_issue_read_option "--repo --issue" "" "$@"
    require REPO --repo
    require ISSUE --issue
}

# How GitHub answers gh issue view for a number that is neither an issue nor a pull request.
readonly ISSUE_NOT_FOUND_TEXT='Could not resolve to an issue or pull request with the number'
issue_not_found() {
    printf 'cfwf: %s\n' "$*" >&2
    exit "${ISSUE_NOT_FOUND_EXIT}"
}

unexpected_issue_result() {
    die "gh returned an unexpected result for ${REPO}#${ISSUE}"
}

# A jq definition, put before a filter that uses it: signs_off is whether the comment body it is
# given holds a plan sign-off keyword on a line that is not a Markdown quote: a > after at most
# three spaces, because Markdown reads a deeper indent, or a tab, as code. The body is split into
# lines first, so ^ and $ in either pattern mean the same to jq, where they match at every line,
# and to gh's gojq, where they match only at the ends of the text.
readonly SIGNS_OFF_DEF='def signs_off: any(split("\n")[]; (test("^ {0,3}>") | not) and test("'"${APPROVAL_KEYWORD_PATTERN}"'"; "i"));'
# A jq definition, put before a filter that uses it, and the one place that says which labels make
# an issue Blocked or On Hold, so issue plan-status and issue list cannot disagree: is_blocked and
# is_on_hold are whether the issue it is given has a label that, lower-cased, is blocked, or is
# on hold (the standard label) or on-hold.
# $name below is a jq variable, not a shell one.
# shellcheck disable=SC2016
readonly HOLD_LABELS_DEF='def has_label_named($name): any(.labels[]; .name | ascii_downcase == $name); def is_blocked: has_label_named("blocked"); def is_on_hold: has_label_named("on hold") or has_label_named("on-hold");'
# What ends the output of a filter whose last field must keep its trailing newlines: a command
# substitution drops every newline at the end of what it captures, and none before this.
readonly OUTPUT_END=$'\x1f'

# Reads the issue ISSUE of REPO with one gh issue view: the fields $1 (comma separated, on top of
# url) through the jq filter $2, which brings any definition it uses with it and whose output is
# left in GH_OUTPUT. gh issue view answers a pull request's number with the pull request, so the
# url is read to tell the two apart, and the first line of the answer says which it is. A number
# that is no issue exits ISSUE_NOT_FOUND_EXIT; any other failed read dies with gh's error, so a
# transport error is never read as a missing issue.
read_issue() {
    local fields="$1" filter="$2" kind
    if ! gh_capture issue view "${ISSUE}" --repo "${REPO}" --json "url,${fields}" \
        --jq "(if (.url | test(\"/pull/[0-9]+\$\")) then \"pull\" else \"issue\" end), (${filter})"; then
        [[ "${GH_ERROR}${GH_OUTPUT}" != *"${ISSUE_NOT_FOUND_TEXT}"* ]] || issue_not_found "${REPO}#${ISSUE} was not found"
        die "could not read ${REPO}#${ISSUE}: $(gh_failure_text)"
    fi
    kind="${GH_OUTPUT%%$'\n'*}"
    [ "${kind}" != pull ] || issue_not_found "${REPO}#${ISSUE} is a pull request, not an issue"
    [[ "${GH_OUTPUT}" == issue$'\n'* ]] || unexpected_issue_result
    GH_OUTPUT="${GH_OUTPUT#*$'\n'}"
}

issue_view() {
    local state
    parse_issue_read_options "$@"
    require_gh
    read_issue "title,state,labels,assignees,body" \
        "${PRINTABLE_DEF}"' [("title\t" + (.title | printable)), ("state\t" + .state),
          ("labels\t" + ([.labels[].name | printable] | join(","))),
          ("assignees\t" + ([.assignees[].login | printable] | join(","))),
          "", ((.body // "") + "\u001f")] | join("\n")'
    state="${GH_OUTPUT#*$'\n'}"
    state="${state%%$'\n'*}"
    [[ "${state}" == "state"$'\t'@(OPEN|CLOSED) && "${GH_OUTPUT}" == *"${OUTPUT_END}" ]] \
        || unexpected_issue_result
    printf '%s\n' "${GH_OUTPUT%"${OUTPUT_END}"}"
}

issue_plan_status() {
    parse_issue_read_options "$@"
    require_gh
    # $comments and $plan below are jq variables, not shell ones.
    # shellcheck disable=SC2016
    read_issue "labels,comments" \
        "${PRINTABLE_DEF} ${SIGNS_OFF_DEF} ${HOLD_LABELS_DEF}"' (.comments // []) as $comments
         | ([$comments | to_entries[] | select(.value.body // "" | split("\n") | any(rtrimstr("\r") == "## Implementation Plan")) | .key] | last) as $plan
         | ("plan\t" + (if $plan == null then "no" else "yes" end)),
           ("blocked\t" + (if is_blocked then "yes" else "no" end)),
           (select($plan != null)
            | ($comments[$plan]
               | ["plan-at", .createdAt], ["plan-by", (.author.login // ""), (.authorAssociation // ""), .url]),
              ($comments[($plan + 1):][]
               | ["comment", .createdAt, (.author.login // ""), (.authorAssociation // ""),
                  (if (.body // "" | signs_off) then "yes" else "no" end), .url])
            | map(printable) | join("\t"))'
    printf '%s\n' "${GH_OUTPUT}"
}

# The most issues issue list prints. One more is asked for, so a repository with more open ones is
# seen to have more and is refused, never listed in part.
readonly ISSUE_LIST_LIMIT=1000
# A jq definition, put before a filter that uses it: label_names is the names of the labels of the
# issue it is given, and label_list those names comma-joined, made printable by field once the
# whole is joined.
readonly LABEL_LIST_DEF='def label_names: [.labels[].name]; def label_list: label_names | join(",");'
# PRIORITIES joined by spaces (no priority holds one), so the row pattern and the issue list program
# below take their priorities from PRIORITIES rather than a copy of them.
readonly PRIORITY_NAMES="${PRIORITIES[*]}"
# A row of issue list: six fields, none empty, the second a priority and the third a flags value.
readonly ISSUE_LIST_ROW_PATTERN=$'^[0-9]+\t('"${PRIORITY_NAMES// /|}"$'|-)\t(-|blocked|on-hold|blocked,on-hold)\t[^\t]+\t[^\t]+\t[^\t]+$'

# PRIORITIES as the items of a jq array literal, each quoted and comma-separated (gh --jq takes no
# --arg; no priority holds a space or a quote), built from PRIORITY_NAMES as the row pattern is.
readonly PRIORITY_ARRAY_ITEMS="\"${PRIORITY_NAMES// /\",\"}\""
# A jq definition, put before a filter that uses it and after HOLD_LABELS_DEF: flags is the flags
# value of an issue list row for the issue it is given, blocked then on-hold, comma-joined.
readonly ISSUE_FLAGS_DEF='def flags: [(if is_blocked then "blocked" else empty end), (if is_on_hold then "on-hold" else empty end)] | join(",");'
# The jq program of issue list: the number of issues on its first line, then a row for each,
# highest priority first and then by number. The priorities are written into the program from
# PRIORITIES, as one jq array literal, so nothing of the caller's is in it; each is matched
# lower-cased and printed as written. Each issue's rank is worked out once, before the sort, from
# its label names lower-cased once. Every value goes through field, so no title or label can add a
# line or a field and none is empty.
# $priorities, $lowered, $names, $priority and $rank below are jq variables, not shell ones.
# shellcheck disable=SC2016
readonly ISSUE_LIST_PROGRAM="${ROW_FIELD_DEF} ${LABEL_LIST_DEF} ${HOLD_LABELS_DEF} ${ISSUE_FLAGS_DEF} [${PRIORITY_ARRAY_ITEMS}]"' as $priorities
    | ($priorities | map(ascii_downcase) | to_entries) as $lowered
    | map((label_names | map(ascii_downcase)) as $names
          | {rank: ([$lowered[] | .value as $priority | select($names | index($priority) != null) | .key]
                    | .[0] // ($priorities | length)),
             issue: .})
    | sort_by([.rank, .issue.number])
    | (length | tostring),
      (.[] | .rank as $rank | .issue
       | [(.number | field), ($priorities[$rank] | field), (flags | field),
          ([.assignees[].login] | join(",") | field), (.title | field), (label_list | field)]
       | join("\t"))'

# Lists the open issues of REPO in one read. Nothing is printed until the whole answer has been
# checked: the count, the rows and the shape of each row (take_checked_rows).
issue_list() {
    local unexpected
    parse_command_options assign_repository_option "--repo" "" "$@"
    require REPO --repo
    require_gh
    unexpected="gh returned an unexpected result for the open issues of ${REPO}"
    gh_capture issue list --repo "${REPO}" --state open --limit "$((ISSUE_LIST_LIMIT + 1))" \
        --json number,title,labels,assignees --jq "${ISSUE_LIST_PROGRAM}" \
        || die "could not list the open issues of ${REPO}: $(gh_failure_text)"

    take_checked_rows "${ISSUE_LIST_LIMIT}" "${ISSUE_LIST_ROW_PATTERN}" "${unexpected}" \
        "${REPO} has more than ${ISSUE_LIST_LIMIT} open issues, so none is printed"
    print_counted_rows
}

readonly ISSUE_SEARCH_LIMIT_DEFAULT=30
readonly ISSUE_SEARCH_LIMIT_MAX=100
# The most characters --text may hold, counted on the words alone, so the qualifiers cfwf and gh add
# take nothing from it. It is cfwf's own cap at the figure GitHub documents for a search: the GraphQL
# search gh issue list runs took over 1000 characters when tried.
readonly SEARCH_TEXT_LIMIT=256
# --text must be printable ASCII (0x20 to 0x7E; matches_pattern matches in the C locale). A control
# character or a byte above ASCII (an accented letter, a no-break space, invalid UTF-8) is refused,
# not turned into a space: GitHub does not split words on it, so a space would silently cut a word
# in two (cafe with an accent would search for caf) rather than only dropping a separator.
readonly SEARCH_TEXT_PATTERN='^[[:print:]]*$'
# The characters kept in the words as they are; every other printable ASCII character is turned
# into a space (search_words). Letters, digits and the space are words and their separator. _ . # '
# have no meaning outside a qualifier's value (.. is a range only after one), and # finds #123. A -
# before a word leaves out the issues that hold it, which only narrows the search, so it is kept.
# Each character turned into a space is punctuation GitHub's search already splits words on, so the
# words searched are the ones the text holds, while its search meaning is gone: : starts a qualifier
# (repo:, org:, is:, in:, author:), so with none left no qualifier can be added; " quotes a phrase;
# ( and ) group, which matters because gh puts the words in brackets before its own repo:
# qualifier; < > = compare and @ (@me) and , (a list) and * only mean anything inside a qualifier's
# value; the rest (/ + ; | \ ~ ! $ % & ? ` [ ] { }) are plain punctuation. So the words can never
# take the search to another repository.
readonly SEARCH_WORD_CHARACTERS=$'A-Za-z0-9 _.#\'-'
# AND, OR and NOT as whole words, matched on the words cfwf sends: GitHub's issue search reads only
# the upper-case forms as operators (lower and mixed case are plain words), and an operator could
# bind the words to the qualifiers differently from how they read. A word is what search_words
# splits on, the space alone, so one joined to a kept character (OR-tools, NOT-FOUND, v1.OR.2) is a
# plain word; a leading - (-NOT) still makes it one of the three.
readonly SEARCH_OPERATOR_PATTERN='(^| )-?(AND|OR|NOT)( |$)'
# The jq program of issue search: the number of issues on its first line, then a row for each, in
# the order the search returned them.
readonly ISSUE_SEARCH_PROGRAM="${ROW_FIELD_DEF} ${LABEL_LIST_DEF}"' (length | tostring), (.[] | [(.number | field), (.state | field), (.title | field), (label_list | field)] | join("\t"))'
# A row of issue search: four fields, none empty, the second a state.
readonly ISSUE_SEARCH_ROW_PATTERN=$'^[0-9]+\t(OPEN|CLOSED)\t[^\t]+\t[^\t]+$'
# The words cfwf sends for --text: SEARCH_TEXT, the text as given with every character outside
# SEARCH_WORD_CHARACTERS turned into a space and the spaces between words collapsed to one, and
# SEARCH_TEXT_GIVEN, the text as given, which the leak rules are applied to.
SEARCH_TEXT=""
SEARCH_TEXT_GIVEN=""
SEARCH_STATE=""
SEARCH_LIMIT=""

# Prints the printable ASCII text $1 as the words to search for: each character outside
# SEARCH_WORD_CHARACTERS a space, then one space between words and none at either end. The text
# has no tab or newline, so read splits it on spaces alone.
search_words() {
    local LC_ALL=C
    local -a words
    read -ra words <<< "${1//[^${SEARCH_WORD_CHARACTERS}]/ }"
    printf '%s\n' "${words[*]}"
}

assign_issue_search_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --text)
            assign_once SEARCH_TEXT "${flag}"
            validate "${value}" "${SEARCH_TEXT_PATTERN}" "${flag}" "it must be printable ASCII, with no control character"
            validate "${value}" '[A-Za-z0-9]' "${flag}" "it must hold a letter or a digit"
            SEARCH_TEXT_GIVEN="${value}"
            SEARCH_TEXT=$(search_words "${value}")
            ! matches_pattern "${SEARCH_TEXT}" "${SEARCH_OPERATOR_PATTERN}" \
                || usage_error "invalid value for ${flag}: it must not hold AND, OR or NOT, which are search operators"
            ;;
        --state)
            assign_once SEARCH_STATE "${flag}"
            validate "${value}" '^(open|closed|all)$' "${flag}" "it must be open, closed or all"
            SEARCH_STATE="${value}"
            ;;
        --limit)
            assign_once SEARCH_LIMIT "${flag}"
            validate "${value}" '^[0-9]+$' "${flag}" "it must be a number from 1 to ${ISSUE_SEARCH_LIMIT_MAX}"
            SEARCH_LIMIT=$(without_leading_zeros "${value}")
            # The length is compared first, so a run of digits too long for bash's integers is refused
            # as too big rather than wrapping round.
            if [ "${#SEARCH_LIMIT}" -gt "${#ISSUE_SEARCH_LIMIT_MAX}" ] || [ "${SEARCH_LIMIT}" -lt 1 ] \
                || [ "${SEARCH_LIMIT}" -gt "${ISSUE_SEARCH_LIMIT_MAX}" ]; then
                usage_error "invalid value for ${flag}: it must be a number from 1 to ${ISSUE_SEARCH_LIMIT_MAX}"
            fi
            ;;
    esac
}

# Searches the issues of REPO for SEARCH_TEXT in one read, one more than SEARCH_LIMIT asked for, so a
# search that matches more is seen to and is cut, with a warning, rather than refused: a ranked
# search returning more than was asked for is normal. Nothing is printed until the whole answer has
# been checked: the count, the rows and the shape of each row (take_checked_rows).
issue_search() {
    local query unexpected
    parse_command_options assign_issue_search_option "--repo --text --state --limit" "" "$@"
    require REPO --repo
    require SEARCH_TEXT --text
    SEARCH_STATE="${SEARCH_STATE:-open}"
    SEARCH_LIMIT="${SEARCH_LIMIT:-${ISSUE_SEARCH_LIMIT_DEFAULT}}"
    # The words are ASCII, so their length in bytes is in characters. It is the words sent that are
    # counted, so a title's punctuation and doubled spaces take nothing from it.
    [ "${#SEARCH_TEXT}" -le "${SEARCH_TEXT_LIMIT}" ] \
        || usage_error "invalid value for --text: it is too long: it must be at most ${SEARCH_TEXT_LIMIT} characters"
    # gh sends "( <query> ) repo:<owner/repo> type:issue" and its state, so it scopes the search to
    # --repo itself. The query starts with in:, so gh can never read it as a flag.
    query="in:title,body ${SEARCH_TEXT}"
    # A token is looked for in both the text as given and the words: turning punctuation into
    # spaces can hide a shape in one (https://user:secret@host is sent as https user secret host)
    # and form it in the other (Bearer(x) is sent as Bearer x), and either way the secret is sent.
    # A host path needs a /, which the words never hold, so only the text as given is checked for one.
    ! matches_pattern "${SEARCH_TEXT_GIVEN}" "${TOKEN_PATTERN}" || refuse_text text token
    ! matches_pattern "${SEARCH_TEXT}" "${TOKEN_PATTERN}" || refuse_text text token
    ! matches_pattern "${SEARCH_TEXT_GIVEN}" "${HOST_PATH_PATTERN}" || refuse_text text "host path"
    require_gh
    unexpected="gh returned an unexpected result for the search of the issues of ${REPO}"
    gh_capture issue list --repo "${REPO}" --state "${SEARCH_STATE}" --search "${query}" --limit "$((SEARCH_LIMIT + 1))" \
        --json number,state,title,labels --jq "${ISSUE_SEARCH_PROGRAM}" \
        || die "could not search the issues of ${REPO}: $(gh_failure_text)"

    take_checked_rows "$((SEARCH_LIMIT + 1))" "${ISSUE_SEARCH_ROW_PATTERN}" "${unexpected}" "${unexpected}"
    [ "${#COUNTED_ROWS[@]}" -le "${SEARCH_LIMIT}" ] \
        || printf 'cfwf: warning: more than %s issues match; only the first %s are printed\n' "${SEARCH_LIMIT}" "${SEARCH_LIMIT}" >&2
    print_counted_rows "${SEARCH_LIMIT}"
}

cmd_issue() {
    dispatch_subcommand issue create issue_create view issue_view plan-status issue_plan_status \
        list issue_list search issue_search -- "$@"
}

body_check() {
    parse_body_options "$@"
    require REPO --repo
    require BODY_FILE --body-file
    require_gh
    resolve_body
}

cmd_body() {
    dispatch_subcommand body check body_check -- "$@"
}

# A login as the REST API gives it: letters, digits, - and _ (the login of a managed user holds
# one), with [bot] after an app's. Nothing in it can add a field or a line to what is printed.
readonly LOGIN_PATTERN='^[A-Za-z0-9_-]+(\[bot\])?$'

# What repo view reads: the gh repo view --json fields, and the jq program that prints a line for
# each field, its name, a tab and its value made printable, with the description, the free text,
# last. A merge method is yes or no, and empty when GitHub gave neither.
readonly REPO_VIEW_FIELDS="defaultBranchRef,description,visibility,mergeCommitAllowed,squashMergeAllowed,rebaseMergeAllowed"
readonly REPO_VIEW_PROGRAM="${LINE_DEF}"' def allowed: if . == true then "yes" elif . == false then "no" else "" end;'\
' line("default-branch"; .defaultBranchRef.name), line("visibility"; .visibility),'\
' line("allow-merge-commit"; .mergeCommitAllowed | allowed), line("allow-squash-merge"; .squashMergeAllowed | allowed),'\
' line("allow-rebase-merge"; .rebaseMergeAllowed | allowed), line("description"; .description)'
# The whole of what repo view prints: its six lines in their order, each one field, with a
# visibility and nothing but yes, no or an empty value for a merge method.
readonly REPO_VIEW_PATTERN=$'^default-branch\t[^\t\n]*\nvisibility\t[A-Z_]+\nallow-merge-commit\t(yes|no)?\nallow-squash-merge\t(yes|no)?\nallow-rebase-merge\t(yes|no)?\ndescription\t[^\t\n]*$'

# Prints the default branch, visibility, merge methods and description of REPO from one read
# (read_repository, the read look_up_visibility makes). gh repo view is used rather than the REST
# repository endpoint, which gives the merge methods as null to a caller without push access.
# Nothing is printed until the answer has been checked to be the six lines.
repo_view() {
    local read_status=0
    parse_command_options assign_repository_option "--repo" "" "$@"
    require REPO --repo
    require_gh
    read_repository "${REPO}" "${REPO_VIEW_FIELDS}" "${REPO_VIEW_PROGRAM}" || read_status=$?
    [ "${read_status}" -ne 1 ] || repository_not_found "${REPO}"
    [ "${read_status}" -eq 0 ] || die "could not read ${REPO}: $(gh_failure_text)"
    matches_pattern "${GH_OUTPUT}" "${REPO_VIEW_PATTERN}" || die "gh returned an unexpected result for ${REPO}"
    printf '%s\n' "${GH_OUTPUT}"
}

# The most collaborators repo collaborators prints. A repository with more is refused, never listed
# in part.
readonly COLLABORATOR_LIMIT=1000

# Lists the collaborators of REPO and the role of each, sorted by login in the C locale, from one
# paged REST read: role_name exists only there, and with --paginate gh runs the jq program on each
# page, so a row is printed for each collaborator and there is no count to check the rows against.
# Each row ends with "end" (FIELDS_ROW_DEF), and nothing is printed until every row has been
# checked: its login is one and it has exactly its fields. GitHub answers a caller without push
# access with HTTP 403, which api_read dies on, so no access is never read as an empty list; a 404
# is the repository not being there or not being shown to the caller.
repo_collaborators() {
    local row login role end
    local -a rows=() lines=()
    parse_command_options assign_repository_option "--repo" "" "$@"
    require REPO --repo
    require_gh
    api_read "could not list the collaborators of ${REPO}" "repos/${REPO}/collaborators?per_page=${API_PAGE_SIZE}" \
        "${FIELDS_ROW_DEF} .[] | [.login, .role_name, \"end\"] | fields_row" --paginate \
        || repository_not_found "${REPO}"
    [ -n "${GH_OUTPUT}" ] || return 0

    mapfile -t rows <<< "${GH_OUTPUT}"
    [ "${#rows[@]}" -le "${COLLABORATOR_LIMIT}" ] \
        || die "${REPO} has more than ${COLLABORATOR_LIMIT} collaborators, so none is printed"
    for row in "${rows[@]}"; do
        IFS="${ROW_SEPARATOR}" read -r login role end <<< "${row}"
        if ! matches_pattern "${login}" "${LOGIN_PATTERN}" || [ "${end}" != end ]; then
            die "gh returned an unexpected result for the collaborators of ${REPO}"
        fi
        lines+=("${login}"$'\t'"${role:--}")
    done
    printf '%s\n' "${lines[@]}" | LC_ALL=C sort
}

cmd_repo() {
    dispatch_subcommand repo view repo_view collaborators repo_collaborators -- "$@"
}

RATE_LIMIT_ASKED=""
RATE_LIMIT_LINES=""
# A host name, with or without a port: what GH_HOST must be for auth status to print it.
readonly HOST_NAME_PATTERN='^[A-Za-z0-9.-]+(:[0-9]+)?$'
# The first line of gh --version, whose version number is all that is kept of it.
readonly GH_VERSION_PATTERN='^gh version ([0-9]+(\.[0-9]+)+[0-9A-Za-z.+-]*)( |$)'

# --rate-limit takes no value, so a second one changes nothing and is not refused.
assign_auth_option() {
    RATE_LIMIT_ASKED=1
}

# Ends a run whose read of the account failed, with $1 and gh's error, or with "not authenticated"
# when gh has no credential (its own prompt to log in) or GitHub refused the one it has (HTTP 401).
# Only what gh wrote to stderr is read for either, so nothing in an answer can pass for them.
auth_read_failed() {
    [[ "${GH_ERROR}" != *"HTTP 401"* && "${GH_ERROR}" != *"gh auth login"* ]] || die "not authenticated"
    die "$1: $(gh_failure_text)"
}

# Sets RATE_LIMIT_LINES to the six lines auth status prints for the REST (core) and GraphQL rate
# limits: what is left, the limit and when it resets, GitHub's epoch seconds as ISO 8601 in UTC.
# The answer is one row, refused unless each count is digits and each reset is such a time.
read_rate_limit() {
    local reset='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z' limit
    limit="([0-9]+)${ROW_SEPARATOR}([0-9]+)${ROW_SEPARATOR}(${reset})${ROW_SEPARATOR}"
    gh_capture api rate_limit \
        --jq "${FIELDS_ROW_DEF} .resources | [(.core, .graphql | .remaining, .limit, (.reset | if type == \"number\" then todate else null end)), \"end\"] | fields_row" \
        || auth_read_failed "could not read the rate limit"
    matches_pattern "${GH_OUTPUT}" "^${limit}${limit}end\$" || die "gh returned an unexpected result for the rate limit"
    printf -v RATE_LIMIT_LINES 'core-remaining\t%s\ncore-limit\t%s\ncore-reset\t%s\ngraphql-remaining\t%s\ngraphql-limit\t%s\ngraphql-reset\t%s' \
        "${BASH_REMATCH[@]:1:6}"
}

# Prints the authenticated login, the host gh is pointed at and the version of gh, and with
# --rate-limit the rate limits. The login is asked of GitHub each time, never taken from a cache:
# the read is what proves the credential works. gh is run only as gh --version, gh api user and gh
# api rate_limit, never as gh auth or gh config and never with an option that prints a response
# header or names a host, so no token, header or configuration value is ever read; GH_HOST is the
# one environment variable printed, and only when it is a host name. Nothing is printed until every
# read asked for has succeeded and been checked.
auth_status() {
    local host="${GH_HOST:-github.com}" version login
    parse_command_options assign_auth_option "" "--rate-limit" "$@"
    require_gh
    matches_pattern "${host}" "${HOST_NAME_PATTERN}" || die "GH_HOST is not a host name, with or without a port"
    gh_capture --version || die "could not read the version of gh: $(gh_failure_text)"
    matches_pattern "${GH_OUTPUT%%$'\n'*}" "${GH_VERSION_PATTERN}" || die "gh returned an unexpected version"
    version="${BASH_REMATCH[1]}"
    gh_capture api user --jq '.login // ""' || auth_read_failed "could not read the authenticated user"
    login="${GH_OUTPUT}"
    matches_pattern "${login}" "${LOGIN_PATTERN}" || die "gh returned an unexpected result for the authenticated user"
    [ -z "${RATE_LIMIT_ASKED}" ] || read_rate_limit

    printf 'login\t%s\nhost\t%s\ngh\t%s\n' "${login}" "${host}" "${version}"
    [ -z "${RATE_LIMIT_ASKED}" ] || printf '%s\n' "${RATE_LIMIT_LINES}"
}

cmd_auth() {
    dispatch_subcommand auth status auth_status -- "$@"
}

# Succeeds when $1 is a branch name git allows, as git itself judges it, so cfwf never has to keep
# a copy of git's rules in step. GIT_DIR=/dev/null keeps git out of any repository the caller is
# in: inside one, git check-ref-format --branch expands the previous-checkout syntax (@{-1}) and
# prints the branch it names, which is why the name it prints must also be the name given. Any
# byte git allows (+, @, %, a non-ASCII letter) is percent-encoded by branch_path when the name
# goes in an API path.
valid_branch_name() {
    local name="$1"
    require_git
    [ -n "${name}" ] && [ "$(GIT_DIR=/dev/null git check-ref-format --branch "${name}" 2> /dev/null)" = "${name}" ]
}

# Succeeds when $1 is a tag name git allows, judged by git as valid_branch_name judges a branch.
# The whole ref is checked, so a name that only a branch cannot have (a leading -, HEAD) is a tag
# like any other, and a . or .. component, which could change an API path, is refused.
valid_tag_name() {
    local name="$1"
    require_git
    [ -n "${name}" ] && GIT_DIR=/dev/null git check-ref-format "refs/tags/${name}" 2> /dev/null
}

# Prints the branch or tag name $1 as it goes in an API path: each byte other than a letter, digit,
# ., _, ~, - or / percent-encoded, so no name can alter the path or the query. / is kept, because
# GitHub reads a name with slashes from the rest of the path. The caller's own check
# (valid_branch_name or valid_tag_name) has already refused a . or .. component, the only path
# segments left unencoded that could change the path.
branch_path() {
    local LC_ALL=C
    local name="$1" encoded="" char code index
    for ((index = 0; index < ${#name}; index++)); do
        char="${name:index:1}"
        case "${char}" in
            [A-Za-z0-9._~/-]) encoded+="${char}" ;;
            *)
                # A byte above 127 can read as negative where char is signed, so it is masked.
                printf -v code '%d' "'${char}"
                printf -v char '%%%02X' "$((code & 255))"
                encoded+="${char}"
                ;;
        esac
    done
    printf '%s' "${encoded}"
}

assign_checks_option() {
    local flag="$1" value="${2:-}"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --pr)
            assign_once PR "${flag}"
            assign_option "${flag}" "${value}"
            ;;
        --sha)
            assign_once SHA "${flag}"
            validate "${value}" '^[0-9A-Fa-f]{40}$' "${flag}" "it must be a commit SHA of 40 hexadecimal digits"
            SHA="${value,,}"
            ;;
        --branch)
            assign_once BRANCH "${flag}"
            valid_branch_name "${value}" \
                || usage_error "invalid value for ${flag}: it must be a branch name git allows"
            BRANCH="${value}"
            ;;
        --all)
            ALL_CHECKS=1
            ;;
    esac
}

parse_pr_checks_options() {
    parse_command_options assign_checks_option "--repo --pr --sha --branch" "--all" "$@"
}

require_one_checks_target() {
    local targets="${PR:+x}${SHA:+x}${BRANCH:+x}"
    [ "${#targets}" -eq 1 ] || usage_error "give exactly one of --pr, --sha and --branch"
}

# Runs gh api on the endpoint $2 with the jq filter $3 (any further arguments are extra gh options)
# through gh_capture, so its output is in GH_OUTPUT. Returns 1 when GitHub answers 404, or 422 "No
# commit found for SHA", leaving the caller to say what that means, and dies with $1 and gh's error
# on any other failure, so a transport error (a proxy 502, a rate limit, no access) is never read as
# a result.
api_read() {
    local failure="$1" endpoint="$2" filter="$3"
    shift 3
    gh_capture api "${endpoint}" "$@" --jq "${filter}" && return 0
    [[ "${GH_ERROR}" != *"HTTP 404"* ]] || return 1
    # A commit endpoint answers a commit that is not in the repository with 422, not 404.
    [[ "${GH_ERROR}" != *"No commit found for SHA"*"HTTP 422"* ]] || return 1
    die "${failure}: $(gh_failure_text)"
}

# A jq definition, put before a filter that uses it: name_fields is two fields of a row for the check
# name it is given. The first, the name as JSON, is its key: every name keeps its own key, byte for
# byte, and no key holds a newline or ROW_SEPARATOR, which JSON writes as escapes. The second, the
# name made printable (PRINTABLE_DEF), is only printed; two names that print the same are still
# judged apart.
readonly NAME_FIELDS_DEF="${PRINTABLE_DEF} def name_fields: tojson, printable;"
# The fields of a row read from gh: \x1f, which no field holds (a name key escapes it, and a printed
# name has it turned into a space). A tab would not do: read collapses consecutive tabs, so an empty
# field would shift the rest.
readonly ROW_SEPARATOR=$'\x1f'
# A jq definition, put before a filter that uses it: app_of(f) is the app a required check must
# come from, read from its field f (app_id in branch protection, integration_id in a ruleset):
# empty for any source, which GitHub shows as a null (or -1) app_id and leaves out of a ruleset.
readonly APP_OF_DEF='def app_of(f): if (f // -1) == -1 then "" else (f | tostring) end;'
HEAD_SHA=""
RULES_BRANCH=""
BRANCH_READ=""
BRANCH_TIP=""
BRANCH_PATH=""
PROTECTION_ROWS=""

# Reads the branch $2 of the repository $1 once per run, so --branch, whose tip and protection both
# come from it, makes one call and sees one state: sets BRANCH_PATH to the branch as it goes in an
# API path (branch_path, worked out once and reused by read_required_checks), BRANCH_TIP to its tip
# and PROTECTION_ROWS to the checks its classic branch protection requires, one row (name, app id)
# each. checks lists each with its app; contexts, which GitHub keeps for older clients, repeats
# those names, so a name in contexts is taken as needing no particular app only when checks does
# not have it. A failed read dies with $3 and gh's error, and a branch that is not there dies with
# $4.
read_branch() {
    local repo="$1" branch="$2" failure="$3" missing="$4"
    [ "${BRANCH_READ}" != "${repo}${ROW_SEPARATOR}${branch}" ] || return 0
    BRANCH_PATH="$(branch_path "${branch}")"
    api_read "${failure}" "repos/${repo}/branches/${BRANCH_PATH}" \
        "${APP_OF_DEF} ${NAME_FIELDS_DEF} .commit.sha, (.protection.required_status_checks | select(.enforcement_level != \"off\") | (.checks // []) as \$checks
            | ((\$checks[] | [(.context | name_fields), app_of(.app_id)]),
               (.contexts[]? | select(. as \$name | \$checks | all(.context != \$name)) | [name_fields, \"\"]))
            | join(\"\\u001f\"))" \
        || die "${missing}"
    BRANCH_TIP="${GH_OUTPUT%%$'\n'*}"
    PROTECTION_ROWS=""
    [[ "${GH_OUTPUT}" != *$'\n'* ]] || PROTECTION_ROWS="${GH_OUTPUT#*$'\n'}"
    BRANCH_READ="${repo}${ROW_SEPARATOR}${branch}"
}

# Sets HEAD_SHA, the commit whose checks are judged, and RULES_BRANCH, the branch whose required
# checks apply: the PR's head and base, the branch's tip and the branch itself, or the given commit
# and the repository's default branch.
resolve_checks_head() {
    if [ -n "${PR}" ]; then
        api_read "could not read ${REPO}#${PR}" "repos/${REPO}/pulls/${PR}" "[.head.sha, .base.ref] | join(\"\\u001f\")" \
            || die "${REPO}#${PR} was not found"
        IFS="${ROW_SEPARATOR}" read -r HEAD_SHA RULES_BRANCH <<< "${GH_OUTPUT}"
    elif [ -n "${BRANCH}" ]; then
        read_branch "${REPO}" "${BRANCH}" "could not read the --branch of ${REPO}" "the --branch was not found in ${REPO}"
        HEAD_SHA="${BRANCH_TIP}"
        RULES_BRANCH="${BRANCH}"
    else
        api_read "could not read ${REPO}" "repos/${REPO}" '.default_branch' || repository_not_found "${REPO}"
        HEAD_SHA="${SHA}"
        RULES_BRANCH="${GH_OUTPUT}"
    fi
    [[ "${HEAD_SHA}" =~ ^[0-9a-f]{40}$ ]] || die "gh returned an unexpected head commit for ${REPO}"
    valid_branch_name "${RULES_BRANCH}" || die "gh returned an unexpected branch whose required checks apply for ${REPO}"
}

# Fills REQUIRED_CHECKS, keyed by check name (its key from name_fields) and the app id it must come from (empty for any
# source), joined by ROW_SEPARATOR, with the checks the branch $2 of the repository $1 requires:
# those of its classic branch protection and those of every ruleset that applies to it, without
# duplicates. The protection is read from the branch itself (read_branch, so a branch
# resolve_checks_head has already read is not read again, and the rulesets are read at the
# BRANCH_PATH it worked out), which needs only read access (its protection endpoint needs admin
# rights), and an enforcement level of off requires nothing whatever it lists. A branch that is not
# there is a runtime failure, and so is any failed read of the rulesets, a 404 included: GitHub
# answers a branch no ruleset applies to (whether or not it exists) with an empty list, so a 404
# means the rules could not be read, and taking it as none would judge too few checks. The one
# exception is RULESETS_NOT_IN_PLAN: a repository whose plan has no rulesets (a private one on
# GitHub Free) can have none, so that refusal is read as no rulesets. Each name
# read, here or by record_check_rows, has its printed form kept in PRINTED_NAME under its key.
declare -gA REQUIRED_CHECKS=() PRINTED_NAME=()
# The start of the HTTP 403 GitHub answers the rulesets read with when the repository's plan has
# no rulesets, as seen in practice (the REST reference lists only 200 for it).
readonly RULESETS_NOT_IN_PLAN='Upgrade to GitHub Pro or make this repository public'
read_required_checks() {
    local repo="$1" branch="$2" names name printed app
    read_branch "${repo}" "${branch}" "could not read the branch protection of ${repo}" \
        "the branch whose required checks apply was not found in ${repo}"
    names="${PROTECTION_ROWS}"
    if ! gh_capture api "repos/${repo}/rules/branches/${BRANCH_PATH}?per_page=${API_PAGE_SIZE}" --paginate \
        --jq "${APP_OF_DEF} ${NAME_FIELDS_DEF} .[]? | select(.type == \"required_status_checks\") | .parameters.required_status_checks[]?
            | [(.context | name_fields), app_of(.integration_id)] | join(\"\\u001f\")"; then
        [[ "${GH_ERROR}" == *"${RULESETS_NOT_IN_PLAN}"*"(HTTP 403)"* ]] || die "could not read the rulesets of ${repo}: $(gh_failure_text)"
        GH_OUTPUT=""
    fi
    names+=$'\n'"${GH_OUTPUT}"
    while IFS="${ROW_SEPARATOR}" read -r name printed app; do
        [ -n "${name}" ] || continue
        [[ "${app}" =~ ^[0-9]*$ ]] || die "gh returned an unexpected app for a required check of ${repo}"
        PRINTED_NAME["${name}"]="${printed}"
        REQUIRED_CHECKS["${name}${ROW_SEPARATOR}${app}"]=1
    done <<< "${names}"
}

# Sets VERDICT to pass, fail or pending for a check run whose conclusion is $1. A run with a
# conclusion has finished whatever its status says; any conclusion not listed as a pass fails, so
# one GitHub adds later is never mistaken for a pass.
check_run_verdict() {
    case "$1" in
        "") VERDICT=pending ;;
        success | skipped | neutral) VERDICT=pass ;;
        *) VERDICT=fail ;;
    esac
}

# Sets VERDICT for a commit status whose state is $1; a state not listed fails, as for a check run.
commit_status_verdict() {
    case "$1" in
        success) VERDICT=pass ;;
        pending) VERDICT=pending ;;
        *) VERDICT=fail ;;
    esac
}

# Records the rows $2 (name key, printed name, conclusion or state, id, completed_at, app id, kind) with the verdict
# function $1, keeping the newest result (highest id) of each group: the runs of one name from one
# app, across every check suite on the commit, as GitHub's merge gate is seen to take only the
# latest run of a required name. So a re-run, or a new run of the workflow in a new check suite (a
# PR marked ready, reopened or relabelled, which with cancel-in-progress leaves the older run
# cancelled), replaces the run before it whatever order GitHub lists them in, while a run of the
# same name from another app stays a result of its own and is still judged. Newest is creation order
# (the id): GitHub does not document how it orders runs, and creation order agrees with it when a
# newer run supersedes an older one, while a newer run that has not finished keeps the name pending.
# The rows are taken oldest first, so each one is newer than the run its group holds, and each
# replaces it, with one exception: a skipped check run did not run, so it replaces only a skipped
# run or a cancelled one (GROUP_YIELDS), never a run that ran and decided (finished or not). So a
# newer suite whose job skips itself (a relabelled PR whose job's if: is false) cannot hide an older
# failure, though GitHub counts skipped as a pass and may let it, while a run cancelled by that
# suite's cancel-in-progress was superseded, not decided, and the skipped run passes it as GitHub
# does. Taking the rows in id order is what makes the result the same whatever order GitHub lists
# them in.
# The kind is "run" for a check run and "status" for a commit status, which has no app id, so a
# status never replaces a check run (GitHub requires both to pass when a check run and a status
# share a name), and the combined status already has one per name. NAME_GROUPS indexes the groups of
# each name, one per line (a name key holds no newline), so judging a name reads only its own
# groups.
declare -gA GROUP_VERDICT=() GROUP_RUN_ID=() GROUP_COMPLETED_AT=() GROUP_YIELDS=() NAME_GROUPS=()
VERDICT=""
record_check_rows() {
    local verdict_of="$1" rows name printed result id completed_at app kind group skipped yields
    rows="$(LC_ALL=C sort -t "${ROW_SEPARATOR}" -k4,4n <<< "$2")" || die "could not sort the checks on ${HEAD_SHA}"
    while IFS="${ROW_SEPARATOR}" read -r name printed result id completed_at app kind; do
        [ -n "${name}" ] || continue
        [[ "${id}" =~ ^[0-9]+$ ]] || die "gh returned an unexpected id for a check on ${HEAD_SHA}"
        PRINTED_NAME["${name}"]="${printed}"
        group="${name}${ROW_SEPARATOR}${app}${ROW_SEPARATOR}${kind}"
        skipped=""
        yields=""
        if [ "${kind}" = run ]; then
            case "${result}" in
                skipped) skipped=1 yields=1 ;;
                cancelled) yields=1 ;;
            esac
        fi
        if [ -z "${GROUP_RUN_ID["${group}"]:-}" ]; then
            NAME_GROUPS["${name}"]+="${group}"$'\n'
        elif [ -n "${skipped}" ] && [ -z "${GROUP_YIELDS["${group}"]}" ]; then
            continue
        fi
        "${verdict_of}" "${result}"
        GROUP_VERDICT["${group}"]="${VERDICT}"
        GROUP_RUN_ID["${group}"]="${id}"
        GROUP_COMPLETED_AT["${group}"]="${completed_at}"
        GROUP_YIELDS["${group}"]="${yields}"
    done <<< "${rows}"
}

# Reads every check run (all pages, and filter=all, as GitHub's default filter=latest would leave
# out runs before record_check_rows could compare them by id) and the combined commit status of
# HEAD_SHA. Both endpoints answer for that one commit only; resolve_checks_head having found the current head first is what
# keeps a result on an older, force-pushed head out.
read_check_results() {
    local runs missing="the commit ${HEAD_SHA} was not found in ${REPO}"
    api_read "could not read the check runs of ${HEAD_SHA}" "repos/${REPO}/commits/${HEAD_SHA}/check-runs?per_page=${API_PAGE_SIZE}&filter=all" \
        "${NAME_FIELDS_DEF} .check_runs[]? | [(.name | name_fields), (.conclusion // \"\"), (.id | tostring), (.completed_at // \"\"), (.app.id // \"\" | tostring), \"run\"] | join(\"\\u001f\")" --paginate \
        || die "${missing}"
    runs="${GH_OUTPUT}"
    api_read "could not read the commit statuses of ${HEAD_SHA}" "repos/${REPO}/commits/${HEAD_SHA}/status?per_page=${API_PAGE_SIZE}" \
        "${NAME_FIELDS_DEF} .statuses[]? | [(.context | name_fields), .state, (.id | tostring), (if .state == \"pending\" then \"\" else (.updated_at // \"\") end), \"\", \"status\"] | join(\"\\u001f\")" --paginate \
        || die "${missing}"
    record_check_rows check_run_verdict "${runs}"
    record_check_rows commit_status_verdict "${GH_OUTPUT}"
}

# Sets VERDICT, RESULT_ID and RESULT_AT for the check named $1, from the app $2 (empty for any
# source): fail when the newest result of any of its groups failed, otherwise pending when any is
# pending, otherwise pass, and pending when it has no result at all. A check pinned to an app takes
# only that app's runs, and a commit status of its name only when the status failed: a status never
# satisfies it, but a failure is never hidden. RESULT_ID and RESULT_AT are those of the result that
# decided it (the newest, among results with the same verdict).
RESULT_ID=""
RESULT_AT=""
judge_check() {
    local name="$1" app="$2" group rest rank best=-1
    local -a groups=()
    VERDICT=pending
    RESULT_ID=""
    RESULT_AT=""
    [ -z "${NAME_GROUPS["${name}"]:-}" ] || mapfile -t groups <<< "${NAME_GROUPS["${name}"]%$'\n'}"
    for group in "${groups[@]}"; do
        rest="${group#*"${ROW_SEPARATOR}"}"
        if [ -n "${app}" ] && [ "${rest%%"${ROW_SEPARATOR}"*}" != "${app}" ]; then
            [ "${rest#*"${ROW_SEPARATOR}"}" = status ] && [ "${GROUP_VERDICT["${group}"]}" = fail ] || continue
        fi
        case "${GROUP_VERDICT["${group}"]}" in
            pass) rank=0 ;;
            pending) rank=1 ;;
            *) rank=2 ;;
        esac
        # A tie only chooses which id and time are printed, so comparing a status id with a check
        # run id, which GitHub numbers apart, never changes the verdict.
        if [ "${rank}" -gt "${best}" ] || { [ "${rank}" -eq "${best}" ] && [ "${GROUP_RUN_ID["${group}"]}" -gt "${RESULT_ID}" ]; }; then
            best="${rank}"
            VERDICT="${GROUP_VERDICT["${group}"]}"
            RESULT_ID="${GROUP_RUN_ID["${group}"]}"
            RESULT_AT="${GROUP_COMPLETED_AT["${group}"]}"
        fi
    done
}

# Prints a line for each judged check, sorted by name, and the summary, the only line with no tab
# (a check line always has four fields, so no check name can make one look like it), then exits
# with the verdict. Every read has already succeeded, so a failed read never leaves a partial
# report. A judged check is a name and the app it must come from (empty for any source), so a name
# required from two apps is judged, and printed, once for each; each of those lines pinned to an
# app shows it as "<name> (app <id>)". Checks are judged by name key and app; only the label is made
# printable here, so two checks whose lines look alike (names that differ only in a control
# character, or a check really named "<name> (app <id>)") are still judged, and counted, apart.
report_checks() {
    local check name app label passed=0 failed=0 pending=0
    local -a lines=()
    local -A judged=() required_count=()
    for check in "${!REQUIRED_CHECKS[@]}"; do
        judged["${check}"]=1
        name="${check%%"${ROW_SEPARATOR}"*}"
        required_count["${name}"]=$((${required_count["${name}"]:-0} + 1))
    done
    if [ -n "${ALL_CHECKS}" ] || [ "${#REQUIRED_CHECKS[@]}" -eq 0 ]; then
        for name in "${!NAME_GROUPS[@]}"; do
            [ -n "${required_count["${name}"]:-}" ] || judged["${name}${ROW_SEPARATOR}"]=1
        done
    fi

    for check in "${!judged[@]}"; do
        name="${check%%"${ROW_SEPARATOR}"*}"
        app="${check#*"${ROW_SEPARATOR}"}"
        judge_check "${name}" "${app}"
        case "${VERDICT}" in
            pass) passed=$((passed + 1)) ;;
            fail) failed=$((failed + 1)) ;;
            *) pending=$((pending + 1)) ;;
        esac
        label="${PRINTED_NAME["${name}"]}"
        [ -z "${app}" ] || [ "${required_count["${name}"]:-0}" -le 1 ] || label+=" (app ${app})"
        lines+=("${label}"$'\t'"${VERDICT}"$'\t'"${RESULT_AT}"$'\t'"${RESULT_ID}")
    done

    [ "${#lines[@]}" -eq 0 ] || printf '%s\n' "${lines[@]}" | LC_ALL=C sort
    printf 'summary passed=%s failed=%s pending=%s head=%s\n' "${passed}" "${failed}" "${pending}" "${HEAD_SHA}"

    [ "${#GROUP_VERDICT[@]}" -gt 0 ] || exit "${NO_CHECKS_EXIT}"
    [ "${failed}" -eq 0 ] || exit "${CHECKS_FAILED_EXIT}"
    [ "${pending}" -eq 0 ] || exit "${CHECKS_PENDING_EXIT}"
    exit 0
}

pr_checks() {
    parse_pr_checks_options "$@"
    require REPO --repo
    require_one_checks_target
    require_gh
    resolve_checks_head
    read_required_checks "${REPO}" "${RULES_BRANCH}"
    read_check_results
    report_checks
}

# The fields of pr view, in the order they are printed: the name, the gh pr view --json fields it is
# read from, and the jq expression of its value. A value that is null prints as empty.
readonly PR_VIEW_FIELDS=(
    'state|state|.state'
    'draft|isDraft|if .isDraft then "yes" else "no" end'
    'title|title|.title'
    'url|url|.url'
    'base|baseRefName|.baseRefName'
    'head|headRefName|.headRefName'
    'head-sha|headRefOid|.headRefOid'
    'auto-merge|autoMergeRequest|if .autoMergeRequest then "on" else "off" end'
    'review-decision|reviewDecision|.reviewDecision'
    'merge-state|mergeStateStatus|.mergeStateStatus'
    'mergeable|mergeable|.mergeable'
    'created-at|createdAt|.createdAt'
    'merged-at|mergedAt|.mergedAt'
    'merge-commit|mergeCommit|.mergeCommit.oid'
    'labels|labels|[.labels[]?.name] | join(",")'
    'assignees|assignees|[.assignees[]?.login] | join(",")'
    'author|author|.author.login'
    # Each login is kept where it is first seen: grouped by login, then put back in commit order.
    'commit-authors|commits|[.commits[]?.authors[]?.login | select(. != null and . != "")] | to_entries | group_by(.value) | map(min_by(.key)) | sort_by(.key) | map(.value) | join(",")'
    # changedFiles is the count print_view_files checks the list against.
    'files|files,changedFiles|.files[]?.path'
    'body|body|.body'
)
PR_VIEW_FIELD_NAMES=("${PR_VIEW_FIELDS[@]%%|*}")
readonly PR_VIEW_FIELD_NAMES
# The fields that are not a key and value line, so each is printed only when asked for alone.
readonly PR_VIEW_ALONE_FIELDS=(files body)
VIEW_NAMES=()
VIEW_EXPRESSIONS=()
VIEW_JSON_FIELDS=""

assign_view_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --pr)
            assign_once PR "${flag}"
            assign_option "${flag}" "${value}"
            # gh does not take 0 as a pull request's number: it looks for a branch of that name
            # instead, so the answer would be a failed read, or another pull request.
            [[ "${PR}" == *[1-9]* ]] || usage_error "invalid value for ${flag}: it must be a number above 0"
            ;;
        --field)
            is_one_of "${value}" "${PR_VIEW_FIELD_NAMES[@]}" \
                || usage_error "unknown --field: it must be one of the fields listed below"
            REQUESTED_FIELDS["${value}"]=1
            ;;
    esac
}

# Refuses (exit 2) a field that is printed only alone when another was asked for with it, then sets
# VIEW_NAMES and VIEW_EXPRESSIONS to the fields to print, in the order of PR_VIEW_FIELDS, and
# VIEW_JSON_FIELDS to the gh fields they are read from: the fields asked for, or with none asked
# for every field that is a key and value line.
resolve_view_fields() {
    local row name rest
    if [ "${#REQUESTED_FIELDS[@]}" -eq 0 ]; then
        for name in "${PR_VIEW_FIELD_NAMES[@]}"; do
            is_one_of "${name}" "${PR_VIEW_ALONE_FIELDS[@]}" || REQUESTED_FIELDS["${name}"]=1
        done
    elif [ "${#REQUESTED_FIELDS[@]}" -gt 1 ]; then
        for name in "${PR_VIEW_ALONE_FIELDS[@]}"; do
            [ -z "${REQUESTED_FIELDS["${name}"]:-}" ] \
                || usage_error "--field ${name} can only be asked for alone: it is not printed as a key and value line"
        done
    fi
    for row in "${PR_VIEW_FIELDS[@]}"; do
        name="${row%%|*}"
        [ -n "${REQUESTED_FIELDS["${name}"]:-}" ] || continue
        rest="${row#*|}"
        VIEW_NAMES+=("${name}")
        VIEW_JSON_FIELDS+="${VIEW_JSON_FIELDS:+,}${rest%%|*}"
        VIEW_EXPRESSIONS+=("${rest#*|}")
    done
}

# Reads the pull request in the one gh call pr view makes, with the jq program $1, leaving its
# output in GH_OUTPUT. A pull request GitHub does not have (the number of an issue is answered the
# same way) exits PR_NOT_FOUND_EXIT; any other failure, a repository that is not there included,
# dies with gh's error.
read_pull_request() {
    gh_capture pr view "${PR}" --repo "${REPO}" --json "${VIEW_JSON_FIELDS}" --jq "$1" && return 0
    case "${GH_ERROR}${GH_OUTPUT}" in
        *"Could not resolve to a PullRequest with the number"*)
            printf 'cfwf: the pull request %s#%s was not found\n' "${REPO}" "${PR}" >&2
            exit "${PR_NOT_FOUND_EXIT}"
            ;;
    esac
    die "could not read ${REPO}#${PR}: $(gh_failure_text)"
}

# Prints each of VIEW_NAMES as its name, a tab and its value made printable, so no value can add a
# line or a field. A final empty value keeps its tab: only newlines are dropped from GH_OUTPUT.
print_view_lines() {
    local program="" index
    for index in "${!VIEW_NAMES[@]}"; do
        program+="${program:+, }(\"${VIEW_NAMES[index]}\\t\" + ((${VIEW_EXPRESSIONS[index]}) // \"\" | tostring | printable))"
    done
    read_pull_request "${PRINTABLE_DEF} ${program}"
    printf '%s\n' "${GH_OUTPUT}"
}

# Prints the changed paths, one a line, each made printable so a path holding a newline stays one
# line. gh lists the first 100 files only, so the list is checked against the number of files the
# pull request changes and refused when it is short: part of a list is never printed as the whole.
print_view_files() {
    local changed listed
    local -a rows=()
    read_pull_request "${PRINTABLE_DEF} (.changedFiles | tostring), (${VIEW_EXPRESSIONS[0]} | tostring | printable)"
    mapfile -t rows <<< "${GH_OUTPUT}"
    changed="${rows[0]}"
    listed=$((${#rows[@]} - 1))
    [[ "${changed}" =~ ^[0-9]+$ ]] || die "gh returned an unexpected number of changed files for ${REPO}#${PR}"
    [ "${changed}" -le "${listed}" ] \
        || die "${REPO}#${PR} changes ${changed} files and gh listed only the first ${listed}, so none is printed"
    [ "${listed}" -eq 0 ] || printf '%s\n' "${rows[@]:1}"
}

# Prints the body as GitHub returns it. jq puts OUTPUT_END (\u001f) after it, so the body's own
# trailing newlines are kept, and it is taken off again before the body is printed.
print_view_body() {
    read_pull_request "(${VIEW_EXPRESSIONS[0]} // \"\") + \"\\u001f\""
    printf '%s' "${GH_OUTPUT%"${OUTPUT_END}"}"
}

pr_view() {
    parse_command_options assign_view_option "--repo --pr --field" "" "$@"
    require REPO --repo
    require PR --pr
    resolve_view_fields
    require_gh
    case "${VIEW_NAMES[0]}" in
        files) print_view_files ;;
        body) print_view_body ;;
        *) print_view_lines ;;
    esac
}

# The most pull requests pr list prints. One more is asked for, so a repository with more open ones
# is seen to have more and is refused, never listed in part.
readonly PR_LIST_LIMIT=1000
LIST_HEAD=""

assign_list_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --issue)
            assign_once ISSUE "${flag}"
            assign_option "${flag}" "${value}"
            [[ "${ISSUE}" == *[1-9]* ]] || usage_error "invalid value for ${flag}: it must be a number above 0"
            ;;
        --head) assign_branch_option LIST_HEAD "${flag}" "${value}" ;;
    esac
}

# Sets the variable $1 to the value $3 of the option $2, which can be given once and must be a
# branch name git allows that holds no control character (exit 2 otherwise), never echoing it. The
# owner:branch form is refused by git's own rules.
assign_branch_option() {
    assign_once "$1" "$2"
    if ! valid_branch_name "$3" || holds_control_character "$3"; then
        usage_error "invalid value for $2: it must be a branch name git allows, with no control character"
    fi
    printf -v "$1" '%s' "$3"
}

# Succeeds when $1 holds a control character of CONTROL_PATTERN, which leaves out a tab and a newline
# (git refuses both, so valid_branch_name or valid_tag_name is asked first), matched byte by byte in
# the C locale as the leak rules are. git allows a C1 control in a branch or tag name, and GitHub's
# answer has one made printable, a space, before it is compared (the head in pr list, the ref in
# resolve_tag), so a --head or a --tag holding one could never equal what it is compared with.
holds_control_character() {
    matches_pattern "$1" "${CONTROL_PATTERN}"
}

# Prints the jq program of pr list: the number of pull requests on its first line, then a row for
# each, sorted by number. Every string goes through field, so no value can add a line or a field
# and none is empty, which keeps a row at eight fields however it is split. ISSUE, digits only, is
# the one value of the caller's that is ever put in a jq program.
pr_list_program() {
    local holds_issue=false
    [ -z "${ISSUE}" ] || holds_issue="(.headRefName // \"\" | test(\"(^|[^0-9])0*${ISSUE}([^0-9]|\$)\"))"
    printf '%s' "${ROW_FIELD_DEF}" \
        ' sort_by(.number) | (length | tostring), (.[] | [(.number | field), (.headRefName | field), (.baseRefName | field), (.author.login | field),' \
        ' (if .isDraft then "draft" else "ready" end),' \
        " ([(if ${holds_issue} then \"issue\" else empty end)," \
        ' (if .author.login == "app/github-actions" then "github-actions" else empty end),' \
        ' (if .isCrossRepository then "fork" else empty end)] | join(",") | field),' \
        ' (.url | field), (.title | field)] | join("\t"))'
}

# Sets COUNTED_ROWS to the rows of the listing in GH_OUTPUT, whose first line is the number of rows
# its jq program says follow. That number must be one, at most $1 (otherwise the run dies with $3)
# and the number of rows that did follow: a row a value managed to add, or an answer cut short, dies
# with $2, so a caller that prints the rows never prints part of a list or a forged line.
COUNTED_ROWS=()
take_counted_rows() {
    local limit="$1" unexpected="$2" too_many="$3" count
    mapfile -t COUNTED_ROWS <<< "${GH_OUTPUT}"
    count="${COUNTED_ROWS[0]}"
    COUNTED_ROWS=("${COUNTED_ROWS[@]:1}")
    [[ "${count}" =~ ^[0-9]{1,9}$ ]] || die "${unexpected}"
    [ "${count}" -le "${limit}" ] || die "${too_many}"
    [ "${count}" -eq "${#COUNTED_ROWS[@]}" ] || die "${unexpected}"
}

# take_counted_rows with the limit $1, then each row must match the pattern $2 (in the C locale,
# with matches_pattern), or the run dies with $3; more than $1 rows dies with $4.
take_checked_rows() {
    local limit="$1" pattern="$2" unexpected="$3" too_many="$4" row
    take_counted_rows "${limit}" "${unexpected}" "${too_many}"
    for row in "${COUNTED_ROWS[@]}"; do
        matches_pattern "${row}" "${pattern}" || die "${unexpected}"
    done
}

# Prints the rows of COUNTED_ROWS, one a line, only the first $1 when it is given. An empty list
# prints nothing: printf with no rows would still print one empty line.
print_counted_rows() {
    local limit="${1:-${#COUNTED_ROWS[@]}}"
    [ "${#COUNTED_ROWS[@]}" -eq 0 ] || printf '%s\n' "${COUNTED_ROWS[@]:0:limit}"
}

# Sets COUNTED_ROWS to the rows of the open pull requests of REPO, those whose head branch is $1
# when it is not empty, in one read, and dies unless the whole answer passes: the count gh gave must
# be the number of rows, so a row a value managed to add is refused, and at most PR_LIST_LIMIT; each
# number must be one; and with $1 each head must be exactly it, whatever gh matched.
read_open_pull_requests() {
    local wanted_head="$1"
    local -a listing=(pr list --repo "${REPO}" --state open --limit "$((PR_LIST_LIMIT + 1))")
    local unexpected="gh returned an unexpected result for the open pull requests of ${REPO}"
    local row number head
    [ -z "${wanted_head}" ] || listing+=(--head "${wanted_head}")
    listing+=(--json "number,title,author,headRefName,baseRefName,isDraft,isCrossRepository,url" --jq "$(pr_list_program)")
    gh_capture "${listing[@]}" || die "could not list the open pull requests of ${REPO}: $(gh_failure_text)"

    take_counted_rows "${PR_LIST_LIMIT}" "${unexpected}" "${REPO} has more than ${PR_LIST_LIMIT} open pull requests, so none is printed"
    for row in "${COUNTED_ROWS[@]}"; do
        number="${row%%$'\t'*}"
        head="${row#*$'\t'}"
        head="${head%%$'\t'*}"
        [[ "${number}" =~ ^[0-9]+$ ]] || die "${unexpected}"
        [ -z "${wanted_head}" ] || [ "${head}" = "${wanted_head}" ] || die "${unexpected}"
    done
}

# Lists the open pull requests of REPO, those whose head branch is LIST_HEAD when it is set. Nothing
# is printed until read_open_pull_requests has checked the whole answer.
pr_list() {
    parse_command_options assign_list_option "--repo --issue --head" "" "$@"
    require REPO --repo
    require_gh

    read_open_pull_requests "${LIST_HEAD}"
    print_counted_rows
}

PR_HEAD=""
PR_BASE=""
EXISTING_PR_NUMBER=""
EXISTING_PR_BASE=""
EXISTING_PR_URL=""
# The shape of a Conventional Commits title: a lower-case type, an optional scope in brackets, an
# optional ! and a colon, one space and a description that starts with a visible character.
readonly PR_TITLE_PATTERN='^[a-z]+(\([^()]+\))?!?: [^[:space:]]'

assign_pr_create_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --head) assign_branch_option PR_HEAD "${flag}" "${value}" ;;
        --base) assign_branch_option PR_BASE "${flag}" "${value}" ;;
        *) assign_issue_option "${flag}" "${value}" ;;
    esac
}

# Refuses (exit 2) the title $1 of a pull request in the repository $2 unless it has the shape a
# title must have there. This is the one place that knows the rule, which today is the same for
# every repository.
validate_pull_request_title() {
    validate "$1" "${PR_TITLE_PATTERN}" --title "it must be a Conventional Commits title, <type>[(<scope>)][!]: <description>"
}

# Sets EXISTING_PR_NUMBER, EXISTING_PR_BASE and EXISTING_PR_URL to the one open pull request of
# REPO whose head branch is PR_HEAD in REPO itself, leaving them empty when there is none. A fork's
# pull request with a branch of the same name is anyone's to open, so it is never that one. The
# base is not part of the match, so the same head into two bases is two, which dies: nothing says
# which the caller means.
find_open_pull_request() {
    local row number base flags url found=0
    EXISTING_PR_NUMBER=""
    EXISTING_PR_BASE=""
    EXISTING_PR_URL=""
    read_open_pull_requests "${PR_HEAD}"
    for row in "${COUNTED_ROWS[@]}"; do
        IFS=$'\t' read -r number _ base _ _ flags url _ <<< "${row}"
        [[ ",${flags}," != *",fork,"* ]] || continue
        found=$((found + 1))
        [[ "${url}" =~ ${REPOSITORY_URL_PATTERN}/pull/${number}$ ]] \
            || die "gh returned an unexpected result for the open pull requests of ${REPO}"
        EXISTING_PR_NUMBER="${number}"
        EXISTING_PR_BASE="${base}"
        EXISTING_PR_URL="${url}"
    done
    [ "${found}" -le 1 ] || die "more than one open pull request has the --head as its head branch in ${REPO}"
}

# Prints the position of the workflow state $1 in WORKFLOW_STATES, the order of the board, and
# fails when it is not one of them.
workflow_state_index() {
    local index
    for index in "${!WORKFLOW_STATES[@]}"; do
        if [ "${WORKFLOW_STATES[index]}" = "$1" ]; then
            printf '%s' "${index}"
            return 0
        fi
    done
    return 1
}

# Finishes a run that found the pull request find_open_pull_request set: puts it on the board at
# STATUS unless it is already there at that state or a later one, since a status only moves
# forward, then prints its URL. Its title, body and draft state are neither read nor changed, which
# the note on stderr says, with its base, which may not be the one asked for. The status is read
# before the write to decide whether to write; the write itself is never read back.
use_existing_pull_request() {
    local current wanted
    CREATED_URL="${EXISTING_PR_URL}"
    CREATED_NOTE="the pull request already exists"
    TARGET_TYPE="PullRequest"
    TARGET_NUMBER="${EXISTING_PR_NUMBER}"
    read_target_status || die "could not read the status of ${REPO}#${TARGET_NUMBER}: both the direct query and the listing of project ${PROJECT_NUMBER} failed"
    if [ -z "${ITEM_STATUS}" ] || [ "${ITEM_STATUS}" = "(unset)" ]; then
        put_item_on_board "${EXISTING_PR_URL}"
    else
        current=$(workflow_state_index "${ITEM_STATUS}") \
            || die "unexpected status of ${REPO}#${TARGET_NUMBER} on project ${PROJECT_NUMBER}"
        wanted=$(workflow_state_index "${STATUS}")
        [ "${current}" -ge "${wanted}" ] || put_item_on_board "${EXISTING_PR_URL}"
    fi
    printf 'cfwf: note: an open pull request already exists for the --head (base %s); its title and body were not changed\n' "${EXISTING_PR_BASE}" >&2
    printf '%s\n' "${EXISTING_PR_URL}"
}

# Sets PR_BASE, when no --base was given, to the default branch of REPO, which must not be the head.
resolve_pull_request_base() {
    [ -z "${PR_BASE}" ] || return 0
    api_read "could not read ${REPO}" "repos/${REPO}" '.default_branch' || repository_not_found "${REPO}"
    PR_BASE="${GH_OUTPUT}"
    valid_branch_name "${PR_BASE}" || die "gh returned an unexpected default branch for ${REPO}"
    [ "${PR_BASE}" != "${PR_HEAD}" ] || die "the --head is the default branch of ${REPO}"
}

# Dies unless the branch PR_HEAD is in REPO, so a branch that was never pushed is refused here, in
# words that say what to do, and not by the create. The branch is never named in a message.
require_pushed_head() {
    api_read "could not read the --head of ${REPO}" "repos/${REPO}/branches/$(branch_path "${PR_HEAD}")" '.name' \
        || die "the --head was not found in ${REPO}: push the branch first"
    [ "${GH_OUTPUT}" = "${PR_HEAD}" ] || die "gh returned an unexpected result for the --head of ${REPO}"
}

# Creates the draft pull request, puts it on the board and prints its URL. The create is run once
# and never again: when it fails, for whatever reason, the open pull requests are read once more,
# and one that is there now (opened in the meantime, or by this create whose answer was lost) is
# used as an existing one, so no error text of gh's is ever matched. gh is given the head as the
# branch name alone, which it reads as a branch of --repo itself: the owner:branch form names a
# fork's owner, and gh does not support an organisation there.
create_pull_request() {
    local url failure
    if ! gh_capture pr create --repo "${REPO}" --head "${PR_HEAD}" --base "${PR_BASE}" --draft \
        --title "${TITLE}" --body-file "${BODY_FILE}"; then
        failure=$(gh_failure_text)
        find_open_pull_request
        [ -n "${EXISTING_PR_URL}" ] || die "could not create the pull request in ${REPO}: ${failure}"
        use_existing_pull_request
        return 0
    fi
    url="${GH_OUTPUT##*$'\n'}"
    # As for a new issue, neither the host nor the repository in the URL is compared with anything.
    [[ "${url}" =~ ${REPOSITORY_URL_PATTERN}/pull/[0-9]+$ ]] \
        || die "gh returned an unexpected result for the new pull request, which may have been created"
    CREATED_URL="${url}"
    CREATED_NOTE="the pull request was already created"

    put_item_on_board "${url}"
    printf '%s\n' "${url}"
}

pr_create() {
    parse_command_options assign_pr_create_option "--repo --head --base --title --body-file" "" "$@"
    require REPO --repo
    require PR_HEAD --head
    require TITLE --title
    require BODY_FILE --body-file
    validate_pull_request_title "${TITLE}" "${REPO}"
    [ "${PR_BASE}" != "${PR_HEAD}" ] || usage_error "--base and --head must be different branches"
    require_gh
    resolve_body
    check_value_for_leaks "${TITLE}" "${REPO}" title

    # The board is resolved before anything is written, so a repository with no Workflow board
    # fails here and leaves no pull request behind.
    STATUS="${NEW_PR_STATUS}"
    resolve_project
    resolve_status

    find_open_pull_request
    if [ -n "${EXISTING_PR_URL}" ]; then
        use_existing_pull_request
        return 0
    fi
    resolve_pull_request_base
    require_pushed_head
    create_pull_request
}

COMMENT_ID=""
REPLY_ROOT=""
REVIEW_DECISION=""
EMPTY_REVIEWS=0
UNRESOLVED_THREADS=0
INLINE_COMMENTS=0
# The three lists of a pull request's discussion, each paged on its own: whether it still has a page
# to read, the cursor of that page, the pages read, GitHub's count of its items, the items gathered
# and their printed blocks.
readonly DISCUSSION_LISTS=(comments reviews threads)
declare -gA LIST_OPEN=() LIST_CURSOR=() LIST_PAGES=() LIST_TOTAL=() LIST_GATHERED=() LIST_TEXT=() SEEN_CURSORS=()
# The printed blocks of the page being taken apart, in the order they came, and the list each is of.
PAGE_BLOCKS=()
PAGE_BLOCK_LISTS=()
readonly DISCUSSION_PAGE_LIMIT=100
# Starts a control row in the answer to the discussion read. No printed line can start with it or
# hold ROW_SEPARATOR: a header line starts with its key, a body line with |, and both bytes are
# control characters, which are printed as a space wherever GitHub's own text holds them.
readonly CONTROL_ROW=$'\x1e'
# How many fields each kind of control row has, its kind included, as PR_DISCUSSION_FILTER prints
# them. A row is refused unless it has exactly that many, because read drops an empty last field:
# without the count a row whose own id is missing would pass with the field before it as its id.
# The page row gives the review decision, then LIST_STATE_FIELDS fields for each list, then "end".
declare -grA DISCUSSION_ROW_FIELDS=([comment]=2 [review]=2 [empty-review]=2 [thread]=6 [inline]=4)
readonly LIST_STATE_FIELDS=4
readonly PAGE_ROW_FIELDS=$((2 + ${#DISCUSSION_LISTS[@]} * LIST_STATE_FIELDS + 1))
# One query text for every page: each list has its own cursor and its own @include switch, so a
# page asks only for the lists that are not finished. gh's --paginate drives a single cursor, so it
# cannot page three lists. Ids are fullDatabaseId, the ids the REST API uses, so the id printed for
# an inline comment is the one pr reply takes.
readonly DISCUSSION_PAGE_FIELDS="totalCount pageInfo{hasNextPage endCursor}"
readonly DISCUSSION_COMMENT_FIELDS="fullDatabaseId author{__typename login} authorAssociation createdAt isMinimized url body"
PR_DISCUSSION_QUERY="query(\$o:String!,\$r:String!,\$n:Int!,\$comments:Boolean!,\$reviews:Boolean!,\$threads:Boolean!,\$commentsAfter:String,\$reviewsAfter:String,\$threadsAfter:String)"
PR_DISCUSSION_QUERY+="{repository(owner:\$o,name:\$r){pullRequest(number:\$n){reviewDecision"
PR_DISCUSSION_QUERY+=" comments(first:${API_PAGE_SIZE},after:\$commentsAfter) @include(if:\$comments){${DISCUSSION_PAGE_FIELDS} nodes{${DISCUSSION_COMMENT_FIELDS}}}"
PR_DISCUSSION_QUERY+=" reviews(first:${API_PAGE_SIZE},after:\$reviewsAfter) @include(if:\$reviews){${DISCUSSION_PAGE_FIELDS} nodes{fullDatabaseId author{__typename login} authorAssociation state submittedAt url body}}"
PR_DISCUSSION_QUERY+=" reviewThreads(first:${API_PAGE_SIZE},after:\$threadsAfter) @include(if:\$threads){${DISCUSSION_PAGE_FIELDS} nodes{isResolved isOutdated path line originalLine"
PR_DISCUSSION_QUERY+=" comments(first:${API_PAGE_SIZE}){${DISCUSSION_PAGE_FIELDS} nodes{${DISCUSSION_COMMENT_FIELDS} replyTo{fullDatabaseId} pullRequestReview{fullDatabaseId}}}}}}}}"
readonly PR_DISCUSSION_QUERY
# The jq program for one page, put after PRINTABLE_DEF. It prints every block ready to print, each
# after a control row that names its kind and ends with its id, and the page's control row last, so
# an answer that was cut short has none. A list the page did not ask for is absent and counts as
# empty. gh runs it with gojq and the tests with jq, so it avoids what the two may read differently:
# an empty body is tested for, because they split an empty string differently, the end of a body
# is \z, the end of the text in both, and blank is a written-out character class, not \s. text is
# what every header value and every body line is printed through: printable, and the two Unicode
# line ends it leaves alone (U+2028 and U+2029) as a space too, so that neither a body nor a value
# GitHub does not choose, a file's path say, can start a new line for a reader that splits on them.
# shellcheck disable=SC2016  # the $ names below are jq variables
readonly PR_DISCUSSION_FILTER='
def text: if . == null then "" else tostring | printable | gsub("[\\x{2028}\\x{2029}]"; " ") end;
def id: .fullDatabaseId | text;
def flag: if . == true then "yes" else "no" end;
def who: if . == null then "" elif .__typename == "User" then .login | text elif .__typename == "Bot" then "app/" + (.login | text) else (.__typename | text | ascii_downcase) + "/" + (.login | text) end;
def header(key; value): key + "\t" + (value | text);
def row: "\u001e" + (map(text) | join("\u001f"));
def body_lines: . // "" | sub("[\\r\\n]+\\z"; "") | if . == "" then [] else split("\n") | map(rtrimstr("\r") | text | if . == "" then "|" else "| " + . end) end;
def block(headers): (.body | body_lines) as $lines | headers, header("lines"; $lines | length), $lines[];
def written: header("author"; .author | who), header("association"; .authorAssociation);
def comment_headers: written, header("created-at"; .createdAt), header("minimized"; .isMinimized | flag), header("url"; .url);
def wrapper_only: .state == "COMMENTED" and (.body // "" | test("[^ \\t\\r\\n]") | not);
def list_state: .totalCount, (.nodes | length), .pageInfo.hasNextPage, .pageInfo.endCursor;
.data.repository.pullRequest as $pr
| ($pr.comments.nodes[]? | (["comment", id] | row), block(header("comment"; id), comment_headers)),
  ($pr.reviews.nodes[]? | if wrapper_only then ["empty-review", id] | row
      else (["review", id] | row), block(header("review"; id), written, header("state"; .state), header("submitted-at"; .submittedAt), header("url"; .url)) end),
  ($pr.reviewThreads.nodes[]? | (.comments.nodes[0] | id) as $first
      | ([ "thread", .comments.pageInfo.hasNextPage, .comments.totalCount, (.comments.nodes | length), (.isResolved | flag), $first ] | row),
        header("thread"; $first), header("resolved"; .isResolved | flag), header("outdated"; .isOutdated | flag), header("path"; .path),
        header("line"; .line), header("original-line"; .originalLine), header("comments"; .comments.nodes | length),
        (.comments.nodes[]? | ([ "inline", (.replyTo | id), (.pullRequestReview | id), id ] | row),
            block(header("inline"; id), header("in-reply-to"; .replyTo | id), header("review"; .pullRequestReview | id), comment_headers))),
  ([ "page", $pr.reviewDecision, ($pr.comments | list_state), ($pr.reviews | list_state), ($pr.reviewThreads | list_state), "end" ] | row)'

assign_pr_comment_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --pr)
            assign_once PR "${flag}"
            assign_option "${flag}" "${value}"
            [ "${PR}" != 0 ] || usage_error "invalid value for ${flag}: it must be above 0"
            ;;
        --comment-id)
            assign_once COMMENT_ID "${flag}"
            validate "${value}" '^[0-9]{1,19}$' "${flag}" "it must be a number of at most 19 digits"
            COMMENT_ID=$(without_leading_zeros "${value}")
            [ "${COMMENT_ID}" != 0 ] || usage_error "invalid value for ${flag}: it must be above 0"
            ;;
        --body-file)
            assign_issue_option "${flag}" "${value}"
            ;;
    esac
}

# Exits PR_NOT_FOUND_EXIT with the message $1: what was asked for is not there, which a caller must
# be able to tell from a read that failed.
discussion_not_found() {
    printf 'cfwf: %s\n' "$1" >&2
    exit "${PR_NOT_FOUND_EXIT}"
}

discussion_incomplete() {
    die "the comments of ${REPO}#${PR} changed or were cut short while they were read; nothing is printed"
}

discussion_unexpected() {
    die "gh returned an unexpected answer for the comments of ${REPO}#${PR}; nothing is printed"
}

# Records what a page said of the list $1, of which $2 blocks were received: GitHub's count $3 of
# the list, the number $4 of items jq saw on the page, whether there is another page ($5) and the
# cursor $6 of that page. A cursor is checked before it is ever sent, and one seen before would
# read the same page for ever.
record_list_page() {
    local list="$1" received="$2" total="$3" count="$4" more="$5" cursor="$6"
    [[ "${total}" =~ ^[0-9]+$ && "${count}" =~ ^[0-9]+$ ]] || discussion_unexpected
    [ "${count}" -eq "${received}" ] || discussion_incomplete
    LIST_TOTAL["${list}"]="${total}"
    LIST_GATHERED["${list}"]=$((${LIST_GATHERED["${list}"]} + received))
    case "${more}" in
        false) LIST_OPEN["${list}"]=false ;;
        true)
            [[ "${cursor}" =~ ^[A-Za-z0-9+/=_-]+$ ]] || discussion_unexpected
            [ -z "${SEEN_CURSORS["${list} ${cursor}"]:-}" ] \
                || die "GitHub returned the same page of the ${list} of ${REPO}#${PR} twice; nothing is printed"
            SEEN_CURSORS["${list} ${cursor}"]=1
            LIST_PAGES["${list}"]=$((${LIST_PAGES["${list}"]} + 1))
            [ "${LIST_PAGES["${list}"]}" -lt "${DISCUSSION_PAGE_LIMIT}" ] \
                || die "the ${list} of ${REPO}#${PR} run to more than ${DISCUSSION_PAGE_LIMIT} pages; nothing is printed"
            LIST_CURSOR["${list}"]="${cursor}"
            ;;
        *) discussion_unexpected ;;
    esac
}

# Checks the control row of a thread: whether it has more comments than came with it ($1), its own
# count of its comments ($2), the comments that came with it ($3), whether it is resolved ($4) and
# the id of its first comment ($5). A thread that has more comments than one page holds is refused:
# its other comments would be feedback nobody saw.
record_thread_row() {
    local more="$1" total="$2" count="$3" resolved="$4" id="$5"
    [ "${more}" != true ] \
        || die "the thread that starts with the inline comment ${id} of ${REPO}#${PR} has more than ${API_PAGE_SIZE} comments, which cfwf cannot read; nothing is printed"
    [[ "${more}" = false && "${total}" =~ ^[0-9]+$ && "${count}" =~ ^[0-9]+$ ]] || discussion_unexpected
    [ "${total}" -eq "${count}" ] || discussion_incomplete
    [ "${resolved}" = yes ] || UNRESOLVED_THREADS=$((UNRESOLVED_THREADS + 1))
}

# Checks the page's own control row, which jq prints last, so a page that lost its end is never
# taken as whole: the first arguments are the blocks received for each list, one for each of
# DISCUSSION_LISTS in its order, and the rest are the row's fields. Each list the page was asked for is then recorded.
record_page_row() {
    local -a blocks=("${@:1:${#DISCUSSION_LISTS[@]}}") page=("${@:${#DISCUSSION_LISTS[@]} + 1}")
    local list position=0
    [ "${#page[@]}" -eq "${PAGE_ROW_FIELDS}" ] && [ "${page[PAGE_ROW_FIELDS - 1]}" = end ] || discussion_unexpected
    REVIEW_DECISION="${page[1]}"
    for list in "${DISCUSSION_LISTS[@]}"; do
        [ "${LIST_OPEN["${list}"]}" != true ] \
            || record_list_page "${list}" "${blocks[position]}" "${page[@]:2 + position * LIST_STATE_FIELDS:LIST_STATE_FIELDS}"
        position=$((position + 1))
    done
}

# Keeps the block $2, which is of the list $1, when it has any text.
keep_page_block() {
    [ -z "$2" ] || {
        PAGE_BLOCKS+=("$2")
        PAGE_BLOCK_LISTS+=("$1")
    }
}

# Adds the blocks kept from the page to the text of the list each is of, once for each list.
add_page_text() {
    local list index text
    for list in "${DISCUSSION_LISTS[@]}"; do
        text=""
        for index in "${!PAGE_BLOCKS[@]}"; do
            [ "${PAGE_BLOCK_LISTS[index]}" != "${list}" ] || text+="${PAGE_BLOCKS[index]}"
        done
        LIST_TEXT["${list}"]+="${text}"
    done
}

# Takes the page in GH_OUTPUT apart: each control row starts a block (its last field the block's id,
# digits) and the lines after it are that block's. The blocks received are counted against the
# page's own control row and a thread's inline blocks against the thread's count, so a page that
# lost a block is never taken as whole. A line is added only to its own block, a block is kept
# whole and a list's text is added to once a page, so the cost of adding a line grows neither with
# what the page holds nor with what was read before it: appending each line to one text for the
# list copies that text every time, and a page of long bodies then takes minutes to take apart.
record_discussion_page() {
    local line list="" kind block="" inline_expected=0 inline_received=0
    local -a fields page=() blocks=()
    local -A received=()
    PAGE_BLOCKS=()
    PAGE_BLOCK_LISTS=()
    while IFS= read -r line; do
        if [[ "${line}" != "${CONTROL_ROW}"* ]]; then
            [ -n "${list}" ] || discussion_unexpected
            block+="${line}"$'\n'
            continue
        fi
        IFS="${ROW_SEPARATOR}" read -ra fields <<< "${line#"${CONTROL_ROW}"}"
        kind="${fields[0]:-none}"
        if [ "${kind}" = page ]; then
            page=("${fields[@]}")
            continue
        fi
        [ "${#fields[@]}" -eq "${DISCUSSION_ROW_FIELDS["${kind}"]:--1}" ] && [[ "${fields[*]: -1}" =~ ^[0-9]+$ ]] || discussion_unexpected
        keep_page_block "${list}" "${block}"
        block=""
        case "${kind}" in
            comment) list=comments ;;
            review | empty-review) list=reviews ;;
            thread)
                list=threads
                record_thread_row "${fields[@]:1}"
                inline_expected=$((inline_expected + 10#${fields[3]}))
                ;;
            inline)
                [[ "${list}" = threads && "${fields[1]}" =~ ^[0-9]*$ && "${fields[2]}" =~ ^[0-9]*$ ]] || discussion_unexpected
                inline_received=$((inline_received + 1))
                ;;
        esac
        if [ "${kind}" = empty-review ]; then
            EMPTY_REVIEWS=$((EMPTY_REVIEWS + 1))
        else
            block=$'\n'
        fi
        [ "${kind}" = inline ] || received["${list}"]=$((${received["${list}"]:-0} + 1))
    done <<< "${GH_OUTPUT}"
    keep_page_block "${list}" "${block}"

    for list in "${DISCUSSION_LISTS[@]}"; do
        blocks+=("${received["${list}"]:-0}")
    done
    record_page_row "${blocks[@]}" "${page[@]}"
    [ "${inline_received}" -eq "${inline_expected}" ] || discussion_incomplete
    INLINE_COMMENTS=$((INLINE_COMMENTS + inline_received))
    add_page_text
}

# Reads the next page of every list that is not finished, in one call. A cursor goes only with a
# list that has one: an empty cursor is not the same as none. A pull request GitHub does not have
# (the number of an issue is answered the same way) exits PR_NOT_FOUND_EXIT, on gh's own error text
# alone, so that words in a comment can never pass for it; any other failure dies with gh's error.
read_discussion_page() {
    local list
    local -a arguments=(api graphql -f query="${PR_DISCUSSION_QUERY}" -f o="${REPO%%/*}" -f r="${REPO#*/}" -F n="${PR}")
    for list in "${DISCUSSION_LISTS[@]}"; do
        arguments+=(-F "${list}=${LIST_OPEN["${list}"]}")
        [ -z "${LIST_CURSOR["${list}"]}" ] || arguments+=(-f "${list}After=${LIST_CURSOR["${list}"]}")
        LIST_CURSOR["${list}"]=""
    done
    if ! gh_capture "${arguments[@]}" --jq "${PRINTABLE_DEF} ${PR_DISCUSSION_FILTER}"; then
        [[ "${GH_ERROR}" != *"Could not resolve to a PullRequest with the number"* ]] \
            || discussion_not_found "the pull request ${REPO}#${PR} was not found"
        die "could not read the comments of ${REPO}#${PR}: $(gh_failure_text)"
    fi
    record_discussion_page
}

# Reads every page of the three lists, then checks each list against GitHub's own count of it, so a
# list that changed while it was read is refused rather than printed with an item missing or twice.
read_pr_discussion() {
    local list
    for list in "${DISCUSSION_LISTS[@]}"; do
        LIST_OPEN["${list}"]=true
        LIST_CURSOR["${list}"]=""
        LIST_PAGES["${list}"]=0
        LIST_GATHERED["${list}"]=0
        LIST_TEXT["${list}"]=""
    done
    while [[ "${LIST_OPEN[*]}" == *true* ]]; do
        read_discussion_page
    done
    for list in "${DISCUSSION_LISTS[@]}"; do
        [ "${LIST_GATHERED["${list}"]}" -eq "${LIST_TOTAL["${list}"]}" ] || discussion_incomplete
    done
}

# Prints the discussion, which is complete: every page was read and counted first. The summary is
# the only line that is not empty and has neither a tab nor a leading |, so it also marks the
# output as whole.
print_pr_discussion() {
    local gathered_reviews="${LIST_GATHERED[reviews]}"
    printf 'pr\t%s#%s\nreview-decision\t%s\n' "${REPO}" "${PR}" "${REVIEW_DECISION}"
    printf '%s' "${LIST_TEXT[comments]}${LIST_TEXT[reviews]}${LIST_TEXT[threads]}"
    printf '\nsummary comments=%s reviews=%s reviews-empty=%s threads=%s unresolved=%s inline=%s\n' \
        "${LIST_GATHERED[comments]}" "$((gathered_reviews - EMPTY_REVIEWS))" "${EMPTY_REVIEWS}" \
        "${LIST_GATHERED[threads]}" "${UNRESOLVED_THREADS}" "${INLINE_COMMENTS}"
}

pr_comments() {
    parse_command_options assign_pr_comment_option "--repo --pr" "" "$@"
    require REPO --repo
    require PR --pr
    require_gh
    read_pr_discussion
    print_pr_discussion
}

# A jq definition, put before a filter that uses it: fields_row is the list it is given as one row,
# each field printable (nothing for one GitHub left out) and the fields joined by ROW_SEPARATOR. A
# filter ends its list with "end", because read drops an empty last field.
readonly FIELDS_ROW_DEF="${PRINTABLE_DEF} def fields_row: map(if . == null then \"\" else tostring | printable end) | join(\"\\u001f\");"

# Sets REPLY_ROOT to the comment a reply to COMMENT_ID is posted to: the comment itself, or the
# first comment of its thread when it is a reply, because GitHub refuses a reply to a reply. The
# comment must be an inline comment of the pull request PR; the id of anything else, which GitHub
# answers with 404, or of a comment on another pull request, exits PR_NOT_FOUND_EXIT. Only the
# number that ends pull_request_url is compared: gh may be reached through a proxy that answers
# with its own host.
resolve_reply_root() {
    local id parent pull end
    local missing="the comment ${COMMENT_ID} is not an inline review comment of ${REPO}#${PR}"
    api_read "could not read the comment ${COMMENT_ID} of ${REPO}" "repos/${REPO}/pulls/comments/${COMMENT_ID}" \
        "${FIELDS_ROW_DEF} [.id, .in_reply_to_id, .pull_request_url, \"end\"] | fields_row" \
        || discussion_not_found "${missing}"
    IFS="${ROW_SEPARATOR}" read -r id parent pull end <<< "${GH_OUTPUT}"
    [[ "${id}" = "${COMMENT_ID}" && "${parent}" =~ ^[0-9]*$ && "${end}" = end ]] \
        || die "gh returned an unexpected answer for the comment ${COMMENT_ID} of ${REPO}"
    [[ "${pull}" =~ /pulls/0*([0-9]+)$ && "${BASH_REMATCH[1]}" = "${PR}" ]] || discussion_not_found "${missing}"
    REPLY_ROOT="${parent:-${COMMENT_ID}}"
}

# The first line of gh's error when GitHub refused a post without making it: the line ends with one
# of the statuses that only ever mean the request was turned down as it stood (malformed, not
# signed in, not allowed, no such comment, gone, not valid). Every other status is left out on
# purpose, the rest of 4xx included: a 408, a 409 or a 429 can come from a proxy or a limit after
# the request was passed on, and saying "not posted" of a reply that is there leads to a duplicate,
# where saying "may have been posted" of one that is not costs the caller only a look.
readonly REPLY_REFUSED_PATTERN='\(HTTP (400|401|403|404|410|422)\)$'

# Posts the checked copy of the body as a reply to REPLY_ROOT, once. gh reads the body from the
# file, so it is never an argument, and the comment replied to is in the path. A post is never
# tried again: only an answer in REPLY_REFUSED_PATTERN says GitHub refused it, and after anything
# else the reply may be there, so a second post could be a duplicate. Neither the host nor the
# repository of the new comment's URL is compared with anything, for the reason issue_create gives.
post_reply() {
    local id url end reason
    local check="run 'cfwf pr comments' and look for it in the thread before posting again"
    if ! gh_capture api --method POST "repos/${REPO}/pulls/${PR}/comments/${REPLY_ROOT}/replies" -F "body=@${BODY_FILE}" \
        --jq "${FIELDS_ROW_DEF} [.id, .html_url, \"end\"] | fields_row"; then
        reason="$(gh_failure_text)"
        [[ ! "${GH_ERROR%%$'\n'*}" =~ ${REPLY_REFUSED_PATTERN} ]] || die "the reply was not posted: ${reason}"
        die "the reply may have been posted (${reason:-gh gave no error text}); ${check}"
    fi
    IFS="${ROW_SEPARATOR}" read -r id url end <<< "${GH_OUTPUT}"
    [[ "${id}" =~ ^[0-9]+$ && "${end}" = end && "${url}" =~ ${REPOSITORY_URL_PATTERN}/pull/${PR}#discussion_r${id}$ ]] \
        || die "the reply may have been posted (gh returned an unexpected answer); ${check}"
    printf 'inline\t%s\nin-reply-to\t%s\nurl\t%s\n' "${id}" "${REPLY_ROOT}" "${url}"
}

pr_reply() {
    parse_command_options assign_pr_comment_option "--repo --pr --comment-id --body-file" "" "$@"
    require REPO --repo
    require PR --pr
    require COMMENT_ID --comment-id
    require BODY_FILE --body-file
    require_gh
    resolve_body
    resolve_reply_root
    post_reply
}

cmd_pr() {
    dispatch_subcommand pr checks pr_checks view pr_view list pr_list comments pr_comments reply pr_reply create pr_create -- "$@"
}

# Refuses (exit 8) the body in the file $1 when one of the two plan-approval keywords is a whole
# word on a line that is not a Markdown quote: a > after at most three spaces, because Markdown
# reads a deeper indent, or a tab, as code. Quote lines are blanked, not deleted, in a copy so the
# line numbers stay those of the body. SCAN_TMP is reused: the leak check is done with it.
check_comment_for_approval_keywords() {
    ensure_temp_file SCAN_TMP
    LC_ALL=C sed -E 's/^ {0,3}>.*//' "$1" > "${SCAN_TMP}" || die "could not scan the body"
    refuse_first_match body "approval keyword" "${APPROVAL_KEYWORD_PATTERN}" "${SCAN_TMP}" -i
}

comment_add() {
    parse_command_options assign_issue_option "--repo --pr --issue --body-file" "" "$@"
    require REPO --repo
    require_target
    require BODY_FILE --body-file
    require_gh
    resolve_body
    check_comment_for_approval_keywords "${BODY_FILE}"

    local kind="issue" url
    [ -z "${PR}" ] || kind="pr"
    url=$(gh "${kind}" comment "${TARGET_NUMBER}" --repo "${REPO}" --body-file "${BODY_FILE}" < /dev/null) \
        || die "could not post the comment on ${REPO}#${TARGET_NUMBER}"
    url="${url##*$'\n'}"
    # As for issue create, the host and the repository are not compared: a proxy answers with its
    # own host and a renamed repository with its new name. pull and issues are both accepted
    # whichever was asked for, because GitHub answers a comment on a pull request made through its
    # issue number with the pull request URL.
    [[ "${url}" =~ ${REPOSITORY_URL_PATTERN}/(pull|issues)/${TARGET_NUMBER}#issuecomment-[0-9]+$ ]] \
        || die "gh returned an unexpected result for the comment, which may have been posted on ${REPO}#${TARGET_NUMBER}"
    printf '%s\n' "${url}"
}

cmd_comment() {
    dispatch_subcommand comment add comment_add -- "$@"
}

assign_release_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --repo) assign_repository_option "${flag}" "${value}" ;;
        --tag)
            assign_once TAG "${flag}"
            if ! valid_tag_name "${value}" || holds_control_character "${value}"; then
                usage_error "invalid value for ${flag}: it must be a tag name git allows, with no control character"
            fi
            TAG="${value}"
            ;;
    esac
}

# Ends a run whose read of something in REPO was answered 404, which is also how GitHub answers
# when the repository itself is not there or the caller cannot see it. That is a failed read, never
# a not found, so the repository is read first, and only when it is there does the run exit $1 with
# the message $2.
not_found_in_repository() {
    local code="$1" message="$2"
    api_read "could not read ${REPO}" "repos/${REPO}" '.id' || repository_not_found "${REPO}"
    printf 'cfwf: %s\n' "${message}" >&2
    exit "${code}"
}

# The jq program of release view: a line for each field, its name, a tab and its value made
# printable, with the name, the free text, last. The release's notes are never read.
readonly RELEASE_VIEW_PROGRAM="${LINE_DEF}"' line("tag"; .tag_name), line("published-at"; .published_at), line("url"; .html_url), line("name"; .name)'

# Prints the latest release of REPO, the one GitHub marks as latest, from one read. The tag is what
# a caller goes on to look up, so a release with none is refused.
release_view() {
    local first
    parse_command_options assign_release_option "--repo" "" "$@"
    require REPO --repo
    require_gh
    api_read "could not read the latest release of ${REPO}" "repos/${REPO}/releases/latest" \
        "${RELEASE_VIEW_PROGRAM}" \
        || not_found_in_repository "${RELEASE_NOT_FOUND_EXIT}" "${REPO} has no latest release"
    first="${GH_OUTPUT%%$'\n'*}"
    [[ "${first}" == "tag"$'\t'?* ]] || die "gh returned an unexpected result for the latest release of ${REPO}"
    printf '%s\n' "${GH_OUTPUT}"
}

# The most releases release list prints. One more is asked for, so a repository with more is seen
# to have more and is refused, never listed in part.
readonly RELEASE_LIST_LIMIT=1000
# The jq program of release list: the number of releases on its first line, then a row for each,
# newest first. A draft is dropped here as well as by gh, so one gh returned all the same is never
# listed. Publication times are ISO 8601 in UTC, which sort as text.
readonly RELEASE_LIST_PROGRAM="${ROW_FIELD_DEF}"' map(select(.isDraft != true)) | sort_by([(.publishedAt // ""), (.tagName // "")]) | reverse'\
' | (length | tostring), (.[] | [(.tagName | field), (.publishedAt | field),'\
' ([(if .isLatest == true then "latest" else empty end), (if .isPrerelease == true then "prerelease" else empty end)] | join(",") | field),'\
' (.name | field)] | join("\t"))'
# A row of release list: four fields, none empty, the third one of the values flags can have.
readonly RELEASE_ROW_PATTERN=$'^[^\t]+\t[^\t]+\t(-|latest|prerelease|latest,prerelease)\t[^\t]+$'

# Lists the releases of REPO in one read. Nothing is printed until the whole answer has been
# checked: the count, the rows and the shape of each row (take_checked_rows).
release_list() {
    local unexpected
    parse_command_options assign_release_option "--repo" "" "$@"
    require REPO --repo
    require_gh
    unexpected="gh returned an unexpected result for the releases of ${REPO}"
    gh_capture release list --repo "${REPO}" --exclude-drafts --limit "$((RELEASE_LIST_LIMIT + 1))" \
        --json "tagName,name,isDraft,isPrerelease,isLatest,publishedAt" --jq "${RELEASE_LIST_PROGRAM}" \
        || die "could not list the releases of ${REPO}: $(gh_failure_text)"

    take_checked_rows "${RELEASE_LIST_LIMIT}" "${RELEASE_ROW_PATTERN}" "${unexpected}" \
        "${REPO} has more than ${RELEASE_LIST_LIMIT} releases, so none is printed"
    print_counted_rows
}

cmd_release() {
    dispatch_subcommand release view release_view list release_list -- "$@"
}

TAG_COMMIT=""
TAG_TYPE=""

# Sets TAG_COMMIT to the commit the tag TAG of REPO points to and TAG_TYPE to lightweight or
# annotated. Only refs/tags/<TAG> is read, and the ref GitHub answers with must be exactly it, so
# neither a branch of the same name nor a tag that only starts with it is ever taken for the tag.
# A lightweight tag names the commit itself; an annotated one names a tag object, which is read
# for the commit it names. That one step is all that is followed: a tag of a tag, or of anything
# that is not a commit, dies. The SHA of the tag object is checked before it goes in a path. A tag
# that is not there, a 404 on the first read, exits TAG_NOT_FOUND_EXIT; a tag object that is not,
# which GitHub has just named, is an unexpected answer.
resolve_tag() {
    local ref type sha end
    local failure="could not read the --tag of ${REPO}" unexpected="gh returned an unexpected result for the --tag of ${REPO}"
    api_read "${failure}" "repos/${REPO}/git/ref/tags/$(branch_path "${TAG}")" \
        "${FIELDS_ROW_DEF} [.ref, .object.type, .object.sha, \"end\"] | fields_row" \
        || not_found_in_repository "${TAG_NOT_FOUND_EXIT}" "the --tag was not found in ${REPO}"
    IFS="${ROW_SEPARATOR}" read -r ref type sha end <<< "${GH_OUTPUT}"
    [[ "${ref}" = "refs/tags/${TAG}" && "${sha}" =~ ^[0-9a-f]{40}$ && "${end}" = end ]] || die "${unexpected}"
    TAG_TYPE=lightweight
    if [ "${type}" = tag ]; then
        TAG_TYPE=annotated
        api_read "${failure}" "repos/${REPO}/git/tags/${sha}" \
            "${FIELDS_ROW_DEF} [.object.type, .object.sha, \"end\"] | fields_row" \
            || die "${unexpected}"
        IFS="${ROW_SEPARATOR}" read -r type sha end <<< "${GH_OUTPUT}"
        [[ "${sha}" =~ ^[0-9a-f]{40}$ && "${end}" = end ]] || die "${unexpected}"
    fi
    [ "${type}" = commit ] || die "the --tag of ${REPO} does not point to a commit, itself or through one annotated tag"
    TAG_COMMIT="${sha}"
}

tag_view() {
    parse_command_options assign_release_option "--repo --tag" "" "$@"
    require REPO --repo
    require TAG --tag
    require_gh
    resolve_tag
    printf 'sha\t%s\ntype\t%s\n' "${TAG_COMMIT}" "${TAG_TYPE}"
}

cmd_tag() {
    dispatch_subcommand tag view tag_view -- "$@"
}

main() {
    if [ "$#" -eq 0 ]; then
        usage_general >&2
        exit 2
    fi

    trap cleanup EXIT

    ARGUMENT_COUNT="$#"
    local command="$1"
    shift
    case "${command}" in
        help | -h | --help) usage_for "${1:-}${2:+ $2}" ;;
        workflow-status) cmd_workflow_status "$@" ;;
        closing-issue-labels) cmd_closing_issue_labels "$@" ;;
        issue) cmd_issue "$@" ;;
        body) cmd_body "$@" ;;
        repo) cmd_repo "$@" ;;
        auth) cmd_auth "$@" ;;
        pr) cmd_pr "$@" ;;
        comment) cmd_comment "$@" ;;
        release) cmd_release "$@" ;;
        tag) cmd_tag "$@" ;;
        *) unknown_argument command "$(($# + 1))" ;;
    esac
}

# Sourced by test/status-mapping-parity.bats (WORKFLOW_STATES) and test/standard-labels-parity.bats
# (STANDARD_LABELS, PRIORITIES and standard_label).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
