#!/bin/bash

# cfwf (Credfeto WorkFlow): one flat command for each recurring multi-step gh
# pattern that agents would otherwise re-derive as a fresh multi-statement
# script every session. Run `cfwf help` for usage.

readonly ITEM_LIMIT=1000
readonly VERIFY_ATTEMPTS=3

CURRENT_COMMAND=""
MODE=""
OWNER=""
PROJECT_NUMBER=""
PROJECT_ID=""
FIELD_ID=""
OPTION_ID=""
ITEM_URL=""
REPO=""
PR=""
ISSUE=""

die() {
    printf 'cfwf: %s\n' "$*" >&2
    exit 1
}

usage_general() {
    cat << 'USAGE'
Usage: cfwf <command> [options]

Commands:
  workflow-status --set    Move an issue or PR to a Workflow board status and verify it persisted
  workflow-status --check  Print the current Workflow Status of an issue or PR
  closing-issue-labels     Print the labels of the issues a PR closes (Blocked and On-Hold excluded)
  help [command]           Show this help, or the help for one command

Run 'cfwf help <command>' for the options of a command.
USAGE
}

usage_workflow_status() {
    cat << 'USAGE'
Usage:
  cfwf workflow-status --set --owner <owner> --project-number <n> --project-id <id> \
       --field-id <id> --option-id <id> --url <issue-or-pr-url>
  cfwf workflow-status --check --owner <owner> --project-number <n> --repo <owner/repo> \
       (--pr <n> | --issue <n>)

--set adds the item to the board if it is not already there (idempotent), sets the
Workflow Status field, then reads it back and retries up to 3 times. It exits 0 only
once the new value is confirmed. The ids come from the generated CLAUDE.md WF_* block.

--check prints the item's current Workflow Status. It exits non-zero when the item is
not on the board.
USAGE
}

usage_closing_issue_labels() {
    cat << 'USAGE'
Usage: cfwf closing-issue-labels --repo <owner/repo> --pr <n>

Prints the sorted, de-duplicated labels across every issue the PR closes, one per line,
with Blocked and On-Hold left out.
USAGE
}

usage_for() {
    case "$1" in
        workflow-status) usage_workflow_status ;;
        closing-issue-labels) usage_closing_issue_labels ;;
        *) usage_general ;;
    esac
}

usage_error() {
    printf 'cfwf: %s\n\n' "$1" >&2
    usage_for "${CURRENT_COMMAND}" >&2
    exit 2
}

validate() {
    local value="$1" pattern="$2" flag="$3"
    [[ "${value}" =~ ${pattern} ]] || usage_error "invalid value for ${flag}: ${value}"
}

assign_option() {
    local flag="$1" value="$2"
    case "${flag}" in
        --owner)
            validate "${value}" '^[A-Za-z0-9_.-]+$' "${flag}"
            OWNER="${value}"
            ;;
        --project-number)
            validate "${value}" '^[0-9]+$' "${flag}"
            PROJECT_NUMBER="${value}"
            ;;
        --project-id)
            validate "${value}" '^[A-Za-z0-9_=-]+$' "${flag}"
            PROJECT_ID="${value}"
            ;;
        --field-id)
            validate "${value}" '^[A-Za-z0-9_=-]+$' "${flag}"
            FIELD_ID="${value}"
            ;;
        --option-id)
            validate "${value}" '^[A-Za-z0-9_=-]+$' "${flag}"
            OPTION_ID="${value}"
            ;;
        --url)
            validate "${value}" '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(issues|pull)/[0-9]+$' "${flag}"
            ITEM_URL="${value}"
            ;;
        --repo)
            validate "${value}" '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' "${flag}"
            REPO="${value}"
            ;;
        --pr)
            validate "${value}" '^[0-9]+$' "${flag}"
            PR="${value}"
            ;;
        --issue)
            validate "${value}" '^[0-9]+$' "${flag}"
            ISSUE="${value}"
            ;;
    esac
}

parse_options() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --set | --check)
                if [ -n "${MODE}" ] && [ "${MODE}" != "${1#--}" ]; then
                    usage_error "--set and --check are mutually exclusive"
                fi
                MODE="${1#--}"
                shift
                ;;
            --owner | --project-number | --project-id | --field-id | --option-id | --url | --repo | --pr | --issue)
                [ "$#" -ge 2 ] || usage_error "$1 needs a value"
                assign_option "$1" "$2"
                shift 2
                ;;
            -h | --help)
                usage_for "${CURRENT_COMMAND}"
                exit 0
                ;;
            *)
                usage_error "unknown option: $1"
                ;;
        esac
    done
}

require() {
    local variable="$1" flag="$2"
    [ -n "${!variable}" ] || usage_error "missing required option ${flag}"
}

require_gh() {
    command -v gh > /dev/null 2>&1 || die "gh is not installed"
}

board_status_of_item() {
    local item_id="$1" actual
    actual=$(gh project item-list "${PROJECT_NUMBER}" --owner "${OWNER}" --format json -L "${ITEM_LIMIT}" \
        --jq ".items[] | select(.id==\"${item_id}\") | .[\"workflow Status\"]") || actual=""
    printf '%s' "${actual}"
}

workflow_status_set() {
    require OWNER --owner
    require PROJECT_NUMBER --project-number
    require PROJECT_ID --project-id
    require FIELD_ID --field-id
    require OPTION_ID --option-id
    require ITEM_URL --url
    require_gh

    local option_name item_id actual attempt
    option_name=$(gh project field-list "${PROJECT_NUMBER}" --owner "${OWNER}" --format json \
        --jq ".fields[] | select(.id==\"${FIELD_ID}\") | .options[] | select(.id==\"${OPTION_ID}\") | .name") \
        || die "could not read the fields of project ${PROJECT_NUMBER}"
    [ -n "${option_name}" ] || die "option ${OPTION_ID} was not found on field ${FIELD_ID} of project ${PROJECT_NUMBER}"

    item_id=$(gh project item-add "${PROJECT_NUMBER}" --owner "${OWNER}" --url "${ITEM_URL}" \
        --format json --jq '.id') || die "could not add ${ITEM_URL} to project ${PROJECT_NUMBER}"
    [[ "${item_id}" =~ ^[A-Za-z0-9_=-]+$ ]] || die "unexpected item id returned for ${ITEM_URL}: ${item_id}"

    gh project item-edit --project-id "${PROJECT_ID}" --id "${item_id}" \
        --field-id "${FIELD_ID}" --single-select-option-id "${OPTION_ID}" > /dev/null \
        || die "could not set the Workflow Status of ${ITEM_URL}"

    actual=""
    for ((attempt = 1; attempt <= VERIFY_ATTEMPTS; attempt++)); do
        actual=$(board_status_of_item "${item_id}")
        if [ "${actual}" = "${option_name}" ]; then
            printf '%s is now %s\n' "${ITEM_URL}" "${option_name}"
            return 0
        fi
        [ "${attempt}" -lt "${VERIFY_ATTEMPTS}" ] && sleep "${attempt}"
    done
    die "the Workflow board write did not persist after ${VERIFY_ATTEMPTS} attempts (wanted '${option_name}', last read '${actual}')"
}

workflow_status_check() {
    require OWNER --owner
    require PROJECT_NUMBER --project-number
    require REPO --repo
    if [ -n "${PR}" ] && [ -n "${ISSUE}" ]; then
        usage_error "--pr and --issue are mutually exclusive"
    fi
    [ -n "${PR}${ISSUE}" ] || usage_error "missing required option --pr or --issue"
    require_gh

    local number content_type status
    if [ -n "${PR}" ]; then
        number="${PR}"
        content_type="PullRequest"
    else
        number="${ISSUE}"
        content_type="Issue"
    fi

    status=$(gh project item-list "${PROJECT_NUMBER}" --owner "${OWNER}" --format json -L "${ITEM_LIMIT}" \
        --jq ".items[] | select(.content.repository==\"${REPO}\" and .content.number==${number} and .content.type==\"${content_type}\") | (.[\"workflow Status\"] // \"(unset)\")") \
        || die "could not list the items of project ${PROJECT_NUMBER}"
    [ -n "${status}" ] || die "${REPO}#${number} is not on project ${PROJECT_NUMBER}"
    printf '%s\n' "${status}"
}

cmd_workflow_status() {
    CURRENT_COMMAND="workflow-status"
    parse_options "$@"
    case "${MODE}" in
        set) workflow_status_set ;;
        check) workflow_status_check ;;
        *) usage_error "workflow-status needs --set or --check" ;;
    esac
}

cmd_closing_issue_labels() {
    CURRENT_COMMAND="closing-issue-labels"
    parse_options "$@"
    require REPO --repo
    require PR --pr
    require_gh

    local numbers number labels="" issue_labels
    numbers=$(gh pr view "${PR}" --repo "${REPO}" --json closingIssuesReferences \
        --jq '.closingIssuesReferences[].number') || die "could not read the closing issues of ${REPO}#${PR}"

    for number in ${numbers}; do
        if issue_labels=$(gh issue view "${number}" --repo "${REPO}" --json labels --jq '.labels[].name'); then
            labels+="${issue_labels}"$'\n'
        else
            printf 'cfwf: warning: could not fetch the labels of %s#%s\n' "${REPO}" "${number}" >&2
        fi
    done

    printf '%s' "${labels}" | { grep -vE '^(Blocked|On-Hold|)$' || true; } | sort -u
}

cmd_help() {
    usage_for "${1:-}"
}

main() {
    if [ "$#" -eq 0 ]; then
        usage_general >&2
        exit 2
    fi

    local command="$1"
    shift
    case "${command}" in
        help | -h | --help) cmd_help "$@" ;;
        workflow-status) cmd_workflow_status "$@" ;;
        closing-issue-labels) cmd_closing_issue_labels "$@" ;;
        *) usage_error "unknown command: ${command}" ;;
    esac
}

main "$@"
