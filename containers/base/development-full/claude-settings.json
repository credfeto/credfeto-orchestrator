  "advisorModel": "opus",
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reject-obfuscated-commands"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-allowed-dirs"
          },
          {
            "type": "command",
            "command": "block-no-verify"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-git-identity"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-git-dash-c"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-git-worktree"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dotnet-tool-install"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-ssh-host-and-key"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-background-for-long-running-commands"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/cache-gh-lookups"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "block-no-verify"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-git-worktree"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
       "read": {
         "denyOnly": ["/"],
         "allowWithinDeny": [
           "/workspace/",
           "~/work"
         ]
       }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "theme": "dark",
  "agentPushNotifEnabled": false,
  "autoCompactEnabled": true,
  "outputStyle": "Concise",
  "remoteControlAtStartup": true,
  "includeGitInstructions": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  }
}
