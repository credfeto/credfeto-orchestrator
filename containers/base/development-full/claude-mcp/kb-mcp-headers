#!/bin/sh

# Claude Code's headersHelper for the kb MCP server (managed-mcp.json). It
# prints the headers to send, as one JSON object on stdout, each time the MCP
# client connects:
#
#   {"Authorization":"Bearer <token>"}
#
# Inside the agent container the token is held by the root-owned token broker,
# so while its socket exists the helper asks the broker for the headers and
# never falls back: the broker answers only this helper started by Claude Code,
# and a refusal exits 1. The broker client runs as a child rather than through
# exec, because the broker checks that its caller's parent is this helper.
#
# Without the broker the token is KB_MCP_TOKEN or, when that is unset or
# empty, the first non-blank line of
# ${XDG_CONFIG_HOME:-$HOME/.config}/kb-mcp/token. The file is only read
# when it is a regular file owned by the current user with mode 0600, so a token
# other local users can read or replace is never sent. Only Claude Code's MCP
# client reads stdout, so the token is never written anywhere else, and no
# failure message names it.
#
# With no token it prints nothing on stdout and exits 1. It never prints `{}`
# instead, because a helper output without Authorization lets Claude Code fall
# back to OAuth discovery against the server.

fail() {
    printf 'kb-mcp-headers: %s\n' "$*" >&2
    exit 1
}

broker_socket="${TOKEN_BROKER_SOCKET:-/run/token-broker/socket}"
if [ -e "${broker_socket}" ] || [ -L "${broker_socket}" ]; then
    "${TOKEN_BROKER_BIN:-/usr/local/sbin/token-broker}" header kb
    exit $?
fi

token_file="${XDG_CONFIG_HOME:-${HOME}/.config}/kb-mcp/token"

token_file_is_private() {
    [ -n "$(find "${token_file}" -prune -type f -user "$(id -u)" -perm 600 2>/dev/null)" ]
}

token_from_file() {
    [ -e "${token_file}" ] || [ -L "${token_file}" ] || return 0
    token_file_is_private || fail "${token_file} must be a regular file owned by you with mode 0600"
    # Only the first non-blank line is the token, so a second line is never joined onto it.
    # Its surrounding whitespace (including the carriage return a CRLF file leaves) is
    # stripped; whitespace inside it is kept, so the token68 check below refuses it.
    while IFS= read -r line || [ -n "${line}" ]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [ -z "${line}" ] || { printf '%s' "${line}"; return 0; }
    done <"${token_file}"
}

token="${KB_MCP_TOKEN:-}"
[ -n "${token}" ] || token=$(token_from_file) || exit 1
[ -n "${token}" ] || fail "no kb token: set KB_MCP_TOKEN, or put it in ${token_file} (mode 0600)"

# RFC 6750's token68 characters only, so a stray newline or header text in the
# token can never smuggle a second header into the request.
case "${token}" in
    *[!A-Za-z0-9._~+/=-]*) fail "the kb token holds characters a bearer token cannot contain" ;;
esac

# The token reaches jq on stdin from the shell's builtin printf, never as an
# argument, so no other local user can read it from /proc/<pid>/cmdline.
printf '%s' "${token}" | jq -cR '{Authorization: ("Bearer " + .)}' 2>/dev/null \
    || fail "jq could not build the Authorization header"
