#!/bin/sh

# Starts the git MCP server (managed-mcp.json) through the shared launcher:
# the repository's git status, diff, log and fetch tools, the credfeto-git-mcp command of the
# Credfeto.Git.Mcp dotnet tool.
#
# Only the values below differ between the dotnet tool MCP servers: every step of finding and
# starting the server (the repository root, the local tool from the user's home tool manifest
# ahead of the global tool, the container's GIT_MCP_TOOL=global path, and stdout kept for the
# MCP stream) lives in the shared dotnet-tool-mcp-launcher in this file's own directory, which is
# sourced here and documents them.
#
# The server has no log directory and starts no dotnet builds. It reads GIT_MCP_REPO_ROOT, which
# the launcher sets to the repository root, and is started from that root too. Large tool output
# goes to GIT_MCP_OUTPUT_DIR, which is left to the server's own per-user default under
# XDG_STATE_HOME (or $HOME/.local/state) unless the caller sets it.

# shellcheck disable=SC2034  # read by the shared launcher sourced below
{
    mcp_name=git-mcp
    mcp_tool_command=credfeto-git-mcp
    mcp_package_id=Credfeto.Git.Mcp
    mcp_env_prefix=GIT_MCP
    mcp_log_dir_name=
    mcp_quiet_sdk_preview=no
}

# The shared launcher is found beside this file, so $0 has to carry its directory, as the absolute
# command in managed-mcp.json does.
case "$0" in
    */*) ;;
    *)
        printf '%s: started without a path, so the shared launcher beside it cannot be found\n' "${mcp_name}" >&2
        exit 1
        ;;
esac
[ -f "${0%/*}/dotnet-tool-mcp-launcher" ] || {
    printf '%s: the shared launcher %s is missing\n' "${mcp_name}" "${0%/*}/dotnet-tool-mcp-launcher" >&2
    exit 1
}
# shellcheck source=containers/base/development-full/claude-mcp/dotnet-tool-mcp-launcher disable=SC1091
. "${0%/*}/dotnet-tool-mcp-launcher"
