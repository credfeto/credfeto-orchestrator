#!/bin/bash

# Installs the development-full container's baked-in Claude Code settings and
# hooks into the current host user's ~/.claude, so the hooks can be exercised
# outside the container. Hook/data files are symlinked straight back into this
# repo (edit here, re-run nothing, the symlink already points at the change);
# settings.json is copied verbatim from the container's copy - its hook
# command strings use the literal "$HOME" token (shell-expanded by whichever
# shell Claude Code invokes the hook through, both in the container as
# developer and here as the host user), so no path rewriting is needed.
#
# It also installs the cfwf workflow helper into a shared bin directory
# (/usr/local/bin by default, override with CFWF_BIN_DIR) with `install`, so
# anyone on the host can run it. If the plain install fails (typically because the
# directory is not writable) it falls back to sudo; if that is unavailable or
# declined the step prints the exact command to run and the rest of the install
# carries on.
#
# Every tool the hooks shell out to must already be present: a hook whose tool
# is missing fails closed and blocks every command, so this refuses to install
# rather than leave a session where nothing can run.

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\n\033[32m✓\033[0m %s\n' "$*"
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

is_ai_agent() {
    [ "${CLAUDECODE}" = "1" ]
}

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

case "${REPO_DIR}" in
    *$'\n'*) die "install-claude-hooks: REPO_DIR contains a newline; aborting." ;;
esac

SOURCE_DIR="${REPO_DIR}/containers/base/development-full"
SOURCE_SETTINGS="${SOURCE_DIR}/claude-settings.json"
SOURCE_HOOKS_DIR="${SOURCE_DIR}/claude-hooks"
SOURCE_CFWF="${SOURCE_DIR}/scripts/cfwf"
CFWF_BIN_DIR="${CFWF_BIN_DIR:-/usr/local/bin}"

# Every external tool the hooks in claude-hooks/ call: jq and shfmt (payload and
# command parsing, used by nearly every hook), base64 (word transport), realpath
# (enforce-allowed-dirs), git and gpg (enforce-git-dash-c, enforce-git-identity),
# ssh-add (enforce-ssh-host-and-key), and sed/grep (enforce-git-identity,
# reject-obfuscated-commands).
REQUIRED_TOOLS=(jq shfmt base64 realpath git gpg ssh-add sed grep)

check_required_tools() {
    local tool
    local missing=()
    for tool in "${REQUIRED_TOOLS[@]}"; do
        command -v "${tool}" >/dev/null 2>&1 || missing+=("${tool}")
    done
    [ "${#missing[@]}" -eq 0 ] || die "Required tool(s) not found: ${missing[*]}"
}

# Installs cfwf with `install` (mode 0755) so it is runnable by every user. If that
# fails it retries under sudo, as root:root, which prompts on the terminal; if sudo
# is missing or declined it prints the exact command to run instead, rather than
# failing the rest of the install.
install_cfwf() {
    local target="${CFWF_BIN_DIR}/cfwf"
    local root_install=(install -m 0755 -o root -g root "${SOURCE_CFWF}" "${target}")

    if install -m 0755 "${SOURCE_CFWF}" "${target}" 2>/dev/null; then
        info "Installed cfwf to ${target}"
        return 0
    fi

    if command -v sudo >/dev/null 2>&1; then
        info "Installing cfwf to ${target} needs elevated permissions, running sudo..."
        if sudo "${root_install[@]}"; then
            info "Installed cfwf to ${target} (with sudo)"
            return 0
        fi
    fi

    info "Could not install cfwf to ${target}. To make it available to every user, run: sudo ${root_install[*]}"
}

# Symlinks every file directly under SOURCE_HOOKS_DIR into TARGET_HOOKS_DIR,
# discovered via find rather than a hardcoded name list -- matches the same
# convention already used for skill-symlinking in this image's Dockerfile, so
# a newly added hook/data file is picked up automatically on the next run.
install_hook_symlinks() {
    local target_hooks_dir="$1"
    local src name
    mkdir -p "${target_hooks_dir}" || die "Failed to create ${target_hooks_dir}"
    while IFS= read -r src; do
        name=$(basename "${src}")
        ln -sf "${src}" "${target_hooks_dir}/${name}" \
            || die "Failed to symlink ${name}"
        info "Symlinked hooks/${name}"
    done < <(find "${SOURCE_HOOKS_DIR}" -mindepth 1 -maxdepth 1 -type f | sort)
}

# Copies SOURCE_SETTINGS to target_settings verbatim - its hook command
# strings use the literal "$HOME" token, which the shell Claude Code invokes
# hooks through expands at execution time, so no rewriting is needed here.
# Validates the copy is well-formed JSON before it is written into place.
# Backs up any pre-existing settings.json first (single fixed name,
# overwritten each run).
install_settings() {
    local target_claude_dir="$1"
    local target_settings="${target_claude_dir}/settings.json"
    local tmp_settings
    tmp_settings=$(mktemp) || die "Failed to create a temp file for settings.json"

    cp -f "${SOURCE_SETTINGS}" "${tmp_settings}" || die "Failed to copy settings.json"
    jq empty "${tmp_settings}" 2>/dev/null || die "settings.json is not valid JSON"

    if [ -f "${target_settings}" ]; then
        cp -f "${target_settings}" "${target_claude_dir}/settings.json.bak" \
            || die "Failed to back up existing settings.json"
        info "Backed up existing settings.json to settings.json.bak"
    fi

    mv "${tmp_settings}" "${target_settings}" || die "Failed to install settings.json"
    info "Installed settings.json"
}

# The symlinked allowed-dirs lists the agent container's /workspace mounts,
# which do not exist on a host - so without a hand-written
# allowed-dirs.local next to it, enforce-allowed-dirs fails closed on every
# cd/git -C/npm --prefix/find/rm/mv/cp here. Point it out rather than
# guessing a host layout (a real file, never a symlink into the repo).
warn_if_no_allowed_dirs_override() {
    local target_hooks_dir="$1"
    [ -f "${target_hooks_dir}/allowed-dirs.local" ] && return 0
    info "No ${target_hooks_dir}/allowed-dirs.local found - enforce-allowed-dirs will block every directory-taking command on this host until one exists. Create it with one allowed root per line, e.g. '~/work' and '\$TMPDIR'."
}

main() {
    is_ai_agent && die "install-claude-hooks must not be run inside a Claude Code session"

    [ -f "${SOURCE_SETTINGS}" ] || die "Source settings not found: ${SOURCE_SETTINGS}"
    [ -d "${SOURCE_HOOKS_DIR}" ] || die "Source hooks directory not found: ${SOURCE_HOOKS_DIR}"
    [ -f "${SOURCE_CFWF}" ] || die "Source cfwf script not found: ${SOURCE_CFWF}"

    check_required_tools

    [ -n "${HOME}" ] || die "\$HOME is not set"
    local target_claude_dir="${HOME}/.claude"
    local target_hooks_dir="${target_claude_dir}/hooks"

    info "Installing Claude Code settings/hooks into ${target_claude_dir} from ${REPO_DIR}..."

    mkdir -p "${target_claude_dir}" || die "Failed to create ${target_claude_dir}"
    install_hook_symlinks "${target_hooks_dir}"
    install_settings "${target_claude_dir}"
    install_cfwf
    warn_if_no_allowed_dirs_override "${target_hooks_dir}"

    success "Claude Code settings/hooks installed for local testing outside the container"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
