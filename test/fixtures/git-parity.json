{
  "description": "Golden cases for the read-only lib/git queries (#252), checked by test/oneshot-git-parity.bats (the shell) and Credfeto.Orchestrator.Git.Tests (the tool). Each scenario's setup runs in an empty directory of the scenario's name, after the prelude, in the environment below with the variables under unset removed; the prelude pins the identity and dates, so the commit ids are the same on every machine. Each case runs its function from that directory, in the same environment, with REPO_WORK_DIR set to <directory>/<repo> (empty when repo is empty) and @ROOT@ in an argument replaced by the directory, and records what the function prints (stdout) and returns (status). tool: answers (the tool must print and return the same), refuses (the tool must exit 3, so bash answers) or not-called (bash returns before it asks the tool). test/oneshot-git-parity.bats regenerates stdout and status when GIT_PARITY_REGENERATE is set",
  "environment": {
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "LC_ALL": "C.UTF-8"
  },
  "unset": [
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_NAMESPACE",
    "GIT_PREFIX"
  ],
  "prelude": "export GIT_AUTHOR_NAME=Parity GIT_AUTHOR_EMAIL=parity@example.com GIT_COMMITTER_NAME=Parity GIT_COMMITTER_EMAIL=parity@example.com\nexport GIT_AUTHOR_DATE='1767225600 +0000' GIT_COMMITTER_DATE='1767225600 +0000'\ncommit() { git -C \"$1\" commit -q --allow-empty -m \"$2\"; }\ncommit_all() { git -C \"$1\" commit -q -a -m \"$2\"; }\nbranch_on() {\n    local seed=\"$1\" remote=\"$2\" branch=\"$3\" count=\"$4\" i\n    git -C \"${seed}\" checkout -q -b \"${branch}\" main\n    for ((i = 1; i <= count; i++)); do commit \"${seed}\" \"${branch} ${i}\"; done\n    git -C \"${seed}\" push -q \"${remote}\" \"${branch}\"\n    git -C \"${seed}\" checkout -q main\n}\n",
  "scenarios": [
    {
      "name": "checkouts",
      "setup": "git init -q --bare -b main origin.git\ngit clone -q origin.git seed 2> /dev/null\nprintf 'one\\n' > seed/file.txt\ngit -C seed add file.txt\ncommit seed initial\ngit -C seed push -q origin main\nfor spec in feat/12-thing:2 chore/12:0 fix/120-other:1 bug/1120-x:1 Feat/34_x:1 34-plain:1 feat2/56-x:1 \\\n    a/b/56-y:1 feat/78:1 feat/78-later:1 dependabot/nuget/90-x:1 docs/readme:1 feat/77-café:1 feat/91-behind:0; do\n    branch_on seed origin \"${spec%:*}\" \"${spec##*:}\"\ndone\ncommit seed \"main moves on\"\ngit -C seed push -q origin main\ngit init -q --bare -b main upstream.git\nbranch_on seed \"${PWD}/upstream.git\" 66-z 1\nbranch_on seed \"${PWD}/upstream.git\" feat/55-up 1\ngit init -q --bare -b main accents.git\ngit -C seed push -q \"${PWD}/accents.git\" main\nbranch_on seed \"${PWD}/accents.git\" fé/88-x 1\nbranch_on seed \"${PWD}/accents.git\" feat/89é 1\nbranch_on seed \"${PWD}/accents.git\" feat/12-also 1\ngit init -q --bare -b main empty.git\nfor name in clean behind unstaged staged untracked deleted detached feature accented conflicted remotes; do\n    git clone -q origin.git \"${name}\"\ndone\ngit clone -q accents.git accents\ngit clone -q empty.git emptyclone 2> /dev/null\ngit -C behind reset -q --hard HEAD~1\nprintf 'two\\n' > unstaged/file.txt\nprintf 'two\\n' > staged/file.txt\ngit -C staged add file.txt\nprintf 'new\\n' > untracked/new.txt\nrm deleted/file.txt\ngit -C detached checkout -q --detach HEAD~1\ngit -C feature checkout -q -b feat/12-thing --track origin/feat/12-thing\ngit -C accented checkout -q -b feat/77-café --track origin/feat/77-café\ngit -C conflicted checkout -q -b side\nprintf 'side\\n' > conflicted/file.txt\ncommit_all conflicted side\ngit -C conflicted checkout -q main\nprintf 'main\\n' > conflicted/file.txt\ncommit_all conflicted \"main side\"\ngit -C conflicted merge -q side > /dev/null 2>&1 || true\ngit -C remotes remote add upstream ../upstream.git\ngit -C remotes fetch -q upstream\ngit init -q -b main unborn\ngit init -q -b main unbornstaged\nprintf 'one\\n' > unbornstaged/file.txt\ngit -C unbornstaged add file.txt\nmkdir plain\n"
    }
  ],
