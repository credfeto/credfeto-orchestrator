# shellcheck shell=bash
# Shared low-level helpers used by every other lib/* file and by oneshot itself: coloured
# status output, the AI-agent-session detector, and the startup tool-availability check.

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

success() {
    if [ -t 1 ]; then
        printf '\n\033[32m✓\033[0m %s\n' "$*"
    else
        printf '\n✓ %s\n' "$*"
    fi
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

warn() {
    if [ -t 2 ]; then
        printf '\n\033[33m!\033[0m %s\n' "$*" >&2
    else
        printf '\n! %s\n' "$*" >&2
    fi
}

# Returns true (0) when running inside a Claude Code Bash-tool session.
# Claude Code sets CLAUDECODE=1 in every shell it spawns via the Bash tool;
# that value is inherited by subprocesses (e.g. git hooks).
# Source: https://docs.anthropic.com/en/docs/claude-code/settings#environment-variables
is_ai_agent() {
    [ "${CLAUDECODE}" = "1" ]
}

# Dies naming the first of the given commands that is not on PATH.
require_tools() {
    local tool
    for tool in "$@"; do
        command -v "${tool}" >/dev/null 2>&1 || die "Required tool not found: ${tool}"
    done
}

check_required_tools() {
    require_tools curl jq podman gh git awk grep flock timeout

    if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
        die "Required tool not found: sha256sum or shasum"
    fi
}

# Reads stdin and writes a SHA-256 digest to stdout.
hash_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{ print $1 }'
    else
        shasum -a 256 | awk '{ print $1 }'
    fi
}

# Checks that token_file exists, has safe permissions, and outputs its contents (whitespace stripped).
# Outputs nothing and returns silently if the file is absent or has unsafe permissions.
read_token_if_safe() {
    local token_file="$1"
    local perms
    [ -f "${token_file}" ] || return
    perms=$(stat -c '%a' "${token_file}" 2>/dev/null || stat -f '%Lp' "${token_file}" 2>/dev/null)
    case "${perms}" in
        600|400) ;;
        *) warn "Token file ${token_file} has permissions ${perms} — expected 600; skipping"
           return
           ;;
    esac
    tr -d '[:space:]' < "${token_file}"
}

# Outputs the OAuth token for the given owner, or empty string if not configured.
# Lookup order:
#   1. $XDG_CONFIG_HOME/orchestrator/tokens/<owner>  (preferred XDG location, defaults to ~/.config)
#   2. Empty string — caller falls back to CLAUDE_CODE_OAUTH_TOKEN from the environment.
# Token files must be readable only by the owner (chmod 600).
load_token_for_owner() {
    local owner="$1"
    local token

    case "${owner}" in
        *[!a-zA-Z0-9_-]*) return ;;
    esac

    token=$(read_token_if_safe "${XDG_CONFIG_HOME:-${HOME}/.config}/orchestrator/tokens/${owner}")
    if [ -n "${token}" ]; then
        printf '%s' "${token}"
    fi
}

# Outputs host lower-cased, with GitHub's own API host folded to github.com: gh normalises
# both the same way, and everything that decides "proxy or direct" (load_env_config,
# prepare_claude_container_args, bootstrap_orchestrator_env_file) compares against the literal
# github.com, so a GitHub.com or api.github.com value must not read as a proxy.
normalize_gh_host() {
    local host="${1,,}"
    case "${host}" in
        api.github.com) host="github.com" ;;
    esac
    printf '%s' "${host}"
}

# Reads DISCORD_WEBHOOK, GH_TOKEN, GH_HOST, GIT_USER_NAME, GIT_USER_EMAIL, and
# GIT_SIGNING_KEY from orchestrator/.env.
# Sets DISCORD_WEBHOOK_URL; exports GH_HOST (normalised) and GH_ENTERPRISE_TOKEN when both are
# present so host-side gh CLI calls use the same proxy as the agent container. For a direct
# github.com host gh ignores GH_ENTERPRISE_TOKEN, so GH_TOKEN is exported as well: the
# container plumbing keys off GH_ENTERPRISE_TOKEN (prepare_claude_container_args renames it at
# the container boundary) while host-side gh reads GH_TOKEN.
# GIT_USER_NAME, GIT_USER_EMAIL, and GIT_SIGNING_KEY are used by build_minimal_gitconfig.
# Silent when the file is absent or a key is missing.
load_env_config() {
    DISCORD_WEBHOOK_URL=""
    GIT_USER_NAME=""
    GIT_USER_EMAIL=""
    GIT_SIGNING_KEY=""
    WHITELISTED_USERS=""
    local env_file="${XDG_CONFIG_HOME:-${HOME}/.config}/orchestrator/.env"
    [ -f "${env_file}" ] || return 0
    local line val gh_token="" gh_host=""
    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in
            DISCORD_WEBHOOK=*|GH_TOKEN=*|GH_HOST=*|GIT_USER_NAME=*|GIT_USER_EMAIL=*|GIT_SIGNING_KEY=*|WHITELISTED_USERS=*|CI_CHECK_TIMEOUT_MINUTES=*)
                val="${line#*=}"
                val="${val%$'\r'}"
                case "${val}" in
                    '"'*'"') val="${val#?}"; val="${val%?}" ;;
                    "'"*"'") val="${val#?}"; val="${val%?}" ;;
                esac
                case "${line}" in
                    DISCORD_WEBHOOK=*)          DISCORD_WEBHOOK_URL="${val}" ;;
                    GH_TOKEN=*)                 gh_token="${val}" ;;
                    GH_HOST=*)                  gh_host="${val}" ;;
                    GIT_USER_NAME=*)            GIT_USER_NAME="${val}" ;;
                    GIT_USER_EMAIL=*)           GIT_USER_EMAIL="${val}" ;;
                    GIT_SIGNING_KEY=*)          GIT_SIGNING_KEY="${val}" ;;
                    WHITELISTED_USERS=*)        WHITELISTED_USERS="${val}" ;;
                    CI_CHECK_TIMEOUT_MINUTES=*) if [[ "${val}" =~ ^[1-9][0-9]*$ ]]; then CI_CHECK_TIMEOUT_MINUTES="${val}"; else warn "CI_CHECK_TIMEOUT_MINUTES must be a positive integer; ignoring '${val}'"; fi ;;
                esac
                ;;
        esac
    done < "${env_file}"
    if [ -n "${gh_host}" ] && [ -n "${gh_token}" ]; then
        gh_host=$(normalize_gh_host "${gh_host}")
        export GH_HOST="${gh_host}"
        export GH_ENTERPRISE_TOKEN="${gh_token}"
        if [ "${gh_host}" = "github.com" ]; then
            export GH_TOKEN="${gh_token}"
        fi
    fi
}

# Validates that all required config files exist and are populated correctly.
# Collects all errors and dies once at the end so every problem is visible at once.
# Must be called after load_env_config so GIT_* variables are already populated.
validate_config() {
    local owner_filter="$1"
    local config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}"
    local errors=0

    if [ ! -f "${config_dir}/orchestrator/.env" ]; then
        printf '\n✗ %s\n' "${config_dir}/orchestrator/.env is missing" >&2
        printf '  Create it with: GIT_USER_NAME, GIT_USER_EMAIL, GIT_SIGNING_KEY, DISCORD_WEBHOOK\n' >&2
        errors=$((errors + 1))
    else
        [ -n "${GIT_USER_NAME}" ] || {
            printf '\n✗ %s\n' "GIT_USER_NAME is not set in ${config_dir}/orchestrator/.env" >&2
            errors=$((errors + 1))
        }
        [ -n "${GIT_USER_EMAIL}" ] || {
            printf '\n✗ %s\n' "GIT_USER_EMAIL is not set in ${config_dir}/orchestrator/.env" >&2
            errors=$((errors + 1))
        }
        [ -n "${GIT_SIGNING_KEY}" ] || {
            printf '\n✗ %s\n' "GIT_SIGNING_KEY is not set in ${config_dir}/orchestrator/.env" >&2
            errors=$((errors + 1))
        }
    fi

    # gh needs either the local credential store or a proxy token from .env.
    if [ -z "${GH_HOST:-}" ] || [ -z "${GH_ENTERPRISE_TOKEN:-}" ]; then
        if [ ! -f "${config_dir}/gh/hosts.yml" ]; then
            printf '\n✗ %s\n' "${config_dir}/gh/hosts.yml is missing — run 'gh auth login' first" >&2
            errors=$((errors + 1))
        fi
    fi

    if [ -n "${owner_filter}" ]; then
        local token_file="${config_dir}/orchestrator/tokens/${owner_filter}"
        if [ ! -f "${token_file}" ]; then
            printf '\n✗ %s\n' "${token_file} is missing — create it with the Claude OAuth token (chmod 600)" >&2
            errors=$((errors + 1))
        else
            local perms
            perms=$(stat -c '%a' "${token_file}" 2>/dev/null)
            case "${perms}" in
                600|400) ;;
                *) printf '\n✗ %s\n' "${token_file} has permissions ${perms} — must be 600 (run: chmod 600 ${token_file})" >&2
                   errors=$((errors + 1)) ;;
            esac
        fi
    fi

    [ "${errors}" -eq 0 ] || die "Config validation failed — fix the above and re-run"
}

# Outputs available disk space in kilobytes for the filesystem containing WORK (or HOME).
# Outputs nothing when df output cannot be parsed.
disk_space_available_kb() {
    local check_path="${WORK:-${HOME}}"
    [ -d "${check_path}" ] || check_path="${HOME}"
    df -k "${check_path}" 2>/dev/null | awk 'NR==2{print $4}'
}

# Returns 0 when sufficient disk space is available (>= MIN_DISK_SPACE_KB).
# Returns 1 when space is below the threshold.
# Warns and returns 0 when available space cannot be determined.
check_disk_space() {
    local available_kb
    available_kb=$(disk_space_available_kb)
    if ! [[ "${available_kb}" =~ ^[0-9]+$ ]]; then
        warn "Could not determine available disk space — proceeding"
        return 0
    fi
    [ "${available_kb}" -ge "${MIN_DISK_SPACE_KB}" ]
}

# --- first-run bootstrap of $XDG_CONFIG_HOME/orchestrator (the `interactive` script) -------------

# True when stdin and stdout are both terminals: what `claude setup-token` and
# `podman run --tty` each need. Its own function (rather than inline [ -t ] tests) so bats
# tests can override it, since a test body never runs on a TTY.
terminal_available() {
    [ -t 0 ] && [ -t 1 ]
}

# Creates dir (and any parents) owner-only (0700). Dies on failure.
_ensure_private_dir() {
    local dir="$1"
    mkdir -p "${dir}" || die "Failed to create ${dir}"
    chmod 700 "${dir}" || die "Failed to set permissions on ${dir}"
}

# Sets GIT_USER_NAME/GIT_USER_EMAIL/GIT_SIGNING_KEY to the identity git itself would commit
# with in the checkout at repo_dir (`git -C <dir> config --get`, so includeIf stanzas and the
# checkout's own .git/config are honoured, unlike `git config --global --get`, which reads only
# the top-level ~/.gitconfig). The agent container hard-requires all three
# (containers/agent/entrypoint.sh) and signs commits with GPG, so an SSH-format signing key
# (gpg.format=ssh) is rejected here rather than failing inside the container. Used by
# bootstrap_orchestrator_env_file to seed .env, and by `interactive` on every launch so the
# container commits under the identity the host would use in that checkout, whichever owner's
# repository it is.
load_checkout_git_identity() {
    local repo_dir="$1"
    local git_name git_email git_key gpg_format
    git_name=$(git -C "${repo_dir}" config --get user.name 2>/dev/null) || git_name=""
    git_email=$(git -C "${repo_dir}" config --get user.email 2>/dev/null) || git_email=""
    git_key=$(git -C "${repo_dir}" config --get user.signingkey 2>/dev/null) || git_key=""
    gpg_format=$(git -C "${repo_dir}" config --get gpg.format 2>/dev/null) || gpg_format=""
    [ -n "${git_name}" ]  || die "git config user.name is not set for ${repo_dir}, the agent container needs it (GIT_USER_NAME)"
    [ -n "${git_email}" ] || die "git config user.email is not set for ${repo_dir}, the agent container needs it (GIT_USER_EMAIL)"
    [ -n "${git_key}" ]   || die "git config user.signingkey is not set for ${repo_dir}, the agent container GPG-signs every commit (GIT_SIGNING_KEY)"
    [ "${gpg_format}" != "ssh" ] || die "git config gpg.format is ssh for ${repo_dir}, the agent container signs with GPG, so user.signingkey must be a GPG key id"
    GIT_USER_NAME="${git_name}"
    GIT_USER_EMAIL="${git_email}"
    GIT_SIGNING_KEY="${git_key}"
}

# Writes $XDG_CONFIG_HOME/orchestrator/.env when no .env exists yet, so a first `interactive`
# run on a developer machine needs no hand-staged config (setup-owner's onboarding flow,
# docs/deployment-and-setup.md, expects an admin to write this file by hand). The git identity
# comes from the checkout at repo_dir (load_checkout_git_identity). GH_HOST and GH_TOKEN come
# from the host's own gh login: the image bakes a proxy GH_HOST and a placeholder token and no
# gh config is mounted, so without a real token every gh call inside the container fails. The
# host's token (`gh auth token`, normally keyring-held and so invisible to the container) is
# obtained BEFORE anything is written and the file is written once, complete: a half-written
# .env would never be revisited (existing files are never rewritten, edit them by hand) and
# would leave the container's gh unauthenticated on every later run. GH_HOST is the host
# shell's proxy when it exports one, otherwise github.com, which prepare_claude_container_args
# (lib/podman) turns into a plain GH_TOKEN rather than GH_ENTERPRISE_TOKEN.
bootstrap_orchestrator_env_file() {
    local repo_dir="$1"
    local config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/orchestrator"
    local env_file="${config_dir}/.env"
    [ -f "${env_file}" ] && return 0

    load_checkout_git_identity "${repo_dir}"

    local gh_host gh_token
    gh_host=$(normalize_gh_host "${GH_HOST:-github.com}")
    gh_token=$(gh auth token 2>/dev/null) || gh_token=""
    [ -n "${gh_token}" ] \
        || die "'gh auth token' returned no token for ${gh_host}, run 'gh auth login' first (nothing was written to ${env_file})"

    _ensure_private_dir "${config_dir}"
    # umask 077 in a subshell, with the redirect inside it so the file is created 0600 and is
    # never world-readable, not even briefly.
    (
        umask 077
        {
            printf 'GIT_USER_NAME=%s\n' "${GIT_USER_NAME}"
            printf 'GIT_USER_EMAIL=%s\n' "${GIT_USER_EMAIL}"
            printf 'GIT_SIGNING_KEY=%s\n' "${GIT_SIGNING_KEY}"
            printf 'GH_HOST=%s\n' "${gh_host}"
            printf 'GH_TOKEN=%s\n' "${gh_token}"
        } > "${env_file}"
    ) || die "Failed to write ${env_file}"
    info "Created ${env_file} from the git identity of ${repo_dir} and the host's gh token for ${gh_host}"
}

# Ensures $XDG_CONFIG_HOME/orchestrator/tokens/<owner> exists (mode 600). When it is missing,
# runs `claude setup-token` attached to the terminal, a browser OAuth flow that prints a
# long-lived token at the end, then reads the pasted token from stdin (silently) and stores
# it. The token is read back from the terminal rather than captured from setup-token's stdout
# because that command is interactive: it drives the terminal itself and its output is not a
# clean single-line value. Dies without a terminal, since neither step can run unattended.
bootstrap_owner_token() {
    local owner="$1"
    local config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/orchestrator"
    local tokens_dir="${config_dir}/tokens"
    local token_file="${tokens_dir}/${owner}"
    [ -f "${token_file}" ] && return 0

    terminal_available || die "No Claude OAuth token file at ${token_file} and no terminal to run 'claude setup-token', create it by hand (see README.md, Per-owner OAuth token)"
    info "No Claude OAuth token for owner ${owner} yet, running 'claude setup-token'. Complete the browser flow, then paste the token it prints when asked."
    claude setup-token || die "claude setup-token failed, no token stored"

    local token
    printf '\nPaste the token for %s (input is hidden): ' "${owner}" >&2
    IFS= read -r -s token || true
    printf '\n' >&2
    token="${token//[[:space:]]/}"
    [ -n "${token}" ] || die "No token entered, nothing stored at ${token_file}"

    _ensure_private_dir "${config_dir}"
    _ensure_private_dir "${tokens_dir}"
    # umask 077 in a subshell: the file is created 0600 (read_token_if_safe refuses anything
    # other than 600/400) and is never world-readable, not even briefly.
    ( umask 077 && printf '%s' "${token}" > "${token_file}" ) || die "Failed to write ${token_file}"
    success "Stored Claude OAuth token for ${owner} at ${token_file} (mode 600)"
}

# `interactive` only: dies when load_env_config found no GH_HOST/GH_TOKEN pair in .env. The
# agent container has no gh config of its own (the image bakes a proxy host and a placeholder
# token, and no hosts.yml is mounted), so unlike oneshot's host, where validate_config accepts
# the host's own hosts.yml instead, a .env without the pair means every gh call inside the
# session fails. A .env predating the bootstrap (GIT_* and DISCORD_WEBHOOK only) is the usual
# case; bootstrap never rewrites an existing file, so the keys have to be added by hand.
require_container_gh_token() {
    local env_file="${XDG_CONFIG_HOME:-${HOME}/.config}/orchestrator/.env"
    if [ -n "${GH_HOST:-}" ] && [ -n "${GH_ENTERPRISE_TOKEN:-}" ]; then
        return 0
    fi
    die "${env_file} has no GH_HOST/GH_TOKEN pair, and the agent container has no gh config of its own: add GH_HOST=<your gh proxy host, or github.com> and GH_TOKEN=<output of 'gh auth token'> to it"
}

# First-run bootstrap for `interactive`: both of the above, in the order validate_config
# checks them. Idempotent, a fully configured host is a no-op.
bootstrap_orchestrator_config() {
    local owner="$1" repo_dir="$2"
    bootstrap_orchestrator_env_file "${repo_dir}"
    bootstrap_owner_token "${owner}"
}
