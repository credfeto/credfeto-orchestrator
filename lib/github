# shellcheck shell=bash
# GitHub trust/collaborators, the priorities feed, and PR/issue discovery: figuring out who is
# trusted, which PR the bot is actually driving, and whether a PR looks human-taken-over.

# Fetches the current repo's collaborator logins (paginated), retrying on transient gh
# failures. Outputs one login per line on success; returns non-zero after
# GH_COLLABORATORS_RETRY_ATTEMPTS failed attempts (#1094).
_fetch_repo_collaborators() {
    local attempt=1 result
    while [ "${attempt}" -le "${GH_COLLABORATORS_RETRY_ATTEMPTS}" ]; do
        # shellcheck disable=SC2153  # REPO_FULL is the global set by set_repo_context (lib/git), not a misspelling
        if result=$(gh api "repos/${REPO_FULL}/collaborators" --paginate --jq '.[].login' 2>/dev/null); then
            printf '%s' "${result}"
            return 0
        fi
        [ "${attempt}" -lt "${GH_COLLABORATORS_RETRY_ATTEMPTS}" ] && [ "${GH_COLLABORATORS_RETRY_DELAY_SECS}" -gt 0 ] \
            && sleep "${GH_COLLABORATORS_RETRY_DELAY_SECS}"
        attempt=$((attempt + 1))
    done
    return 1
}

# Returns a JSON array of trusted GitHub logins for the current repo context.
# Includes: OWNER, repo collaborators, GitHub's own Copilot reviewer and Advanced Security
# (code scanning) bots, and WHITELISTED_USERS.
# The result is cached in _TRUSTED_LOGINS_JSON; cache is cleared by set_repo_context.
# Returns non-zero (and leaves _TRUSTED_LOGINS_JSON empty) if the collaborators list cannot be
# fetched after retrying — callers must skip the item this tick rather than proceed with a
# silently shrunken (and therefore wrong) trust list (#1094): a fingerprint/trust comparison
# using the wrong set of trusted users is worse than doing nothing for one tick.
get_trusted_logins() {
    [ -n "${_TRUSTED_LOGINS_JSON}" ] && { printf '%s' "${_TRUSTED_LOGINS_JSON}"; return 0; }

    # With ORCHESTRATOR_DOTNET_DISCOVERY=1 the tool reads the collaborators (through the cfwf MCP
    # server, with the same retries) and builds the same list (#252); a failure is not cached either.
    if [ "${ORCHESTRATOR_DOTNET_DISCOVERY}" = 1 ] && orchestrator_cmd_supports discovery trusted-logins; then
        local dotnet_logins
        if dotnet_logins=$(_discovery_with_orchestrator_cmd trusted-logins --repo "${REPO_FULL}" \
            --owner "${OWNER}" --whitelist "${WHITELISTED_USERS}" --creator "${PR_CREATOR_LOGIN}" \
            --attempts "${GH_COLLABORATORS_RETRY_ATTEMPTS}" --delay-secs "${GH_COLLABORATORS_RETRY_DELAY_SECS}") \
            && [ -n "${dotnet_logins}" ]; then
            _TRUSTED_LOGINS_JSON="${dotnet_logins}"
            printf '%s' "${_TRUSTED_LOGINS_JSON}"
            return 0
        fi
        return 1
    fi

    local -a logins=()
    [ -n "${OWNER}" ] && logins+=("${OWNER}")

    local login collaborators
    collaborators=$(_fetch_repo_collaborators) || return 1
    while IFS= read -r login; do
        [ -n "${login}" ] && logins+=("${login}")
    done <<< "${collaborators}"

    logins+=("copilot-pull-request-reviewer")
    logins+=("github-advanced-security[bot]")

    if [ -n "${WHITELISTED_USERS}" ]; then
        local user remainder="${WHITELISTED_USERS}"
        while [ -n "${remainder}" ]; do
            user="${remainder%%,*}"
            remainder="${remainder#"${user}"}"
            remainder="${remainder#,}"
            user="${user#"${user%%[! ]*}"}"
            user="${user%"${user##*[! ]}"}"
            [ -n "${user}" ] && logins+=("${user}")
        done
    fi

    # The PR create bot is never trusted, whatever access it has to the repository: it only opens
    # PRs, and a trusted comment of its own must never count as a human's plan approval (#1517).
    _TRUSTED_LOGINS_JSON=$(printf '%s\n' "${logins[@]+"${logins[@]}"}" \
        | jq -R -s --arg creator "${PR_CREATOR_LOGIN}" 'split("\n") | map(select(length > 0 and . != $creator)) | unique')
    printf '%s' "${_TRUSTED_LOGINS_JSON}"
}

# Fetches trusted logins for the current repo into the caller's `trusted_logins` variable,
# warning and bumping the caller's `count_error` on failure (#1094 review). Relies on bash's
# dynamic scoping of `local`s: this must only be called from within main()'s per-item loop,
# where `trusted_logins`, `count_error` and `item_repo` are already declared local — `continue` itself
# can't live inside a called function, so callers combine this with `|| continue` to skip the
# item this tick, e.g.: `require_trusted_logins || continue`.
require_trusted_logins() {
    trusted_logins=$(get_trusted_logins) && return 0
    # shellcheck disable=SC2154  # item_repo is the caller's local, reached by dynamic scoping (see above)
    warn "Failed to fetch trusted collaborators for ${item_repo} — skipping this item for now"
    count_error=$((count_error + 1))
    return 1
}

# Outputs all open, non-on-hold priority items as a JSON array sorted by priority.
# Retries transient fetch failures a few times before giving up. Returns 1 (does NOT die,
# does NOT exit the shell) when every attempt fails to connect — the caller must check this
# explicitly and die itself, because a swallowed failure here previously fell through to a "No
# actionable work items found" success report, masking a priorities-API outage as a healthy idle
# run (#1089). Returns 2 when the API answered but the response body failed to parse (a distinct
# condition from unreachability — the caller must not report this as a connectivity outage).
# When the current GitHub login resolves (resolve_gh_me), it is URL-encoded and sent as the
# optional `user` query parameter so the feed can leave out items assigned to other users; when
# it cannot be resolved the feed is fetched without it, so an identity-lookup blip never fails
# the fetch. This runs inside the caller's command substitution, so the caller should resolve
# the login first to keep _GH_ME cached for the rest of the run.
# With ORCHESTRATOR_DOTNET_DISCOVERY=1 the fetch, its retries and the filter are made by
# `ORCHESTRATOR_CMD discovery priorities` (#252), which exits 0, 1 or 3 for the 0, 1 and 2 above.
fetch_all_priorities() {
    local priorities_json attempt=1 url="${PRIORITIES_URL}" encoded_user

    if resolve_gh_me && encoded_user=$(jq -rn --arg u "${_GH_ME}" '$u|@uri') && [ -n "${encoded_user}" ]; then
        url="${PRIORITIES_URL}?user=${encoded_user}"
    fi

    if [ "${ORCHESTRATOR_DOTNET_DISCOVERY}" = 1 ] && orchestrator_cmd_supports discovery priorities; then
        local -a user_args=()
        [ -n "${encoded_user}" ] && user_args=(--user "${_GH_ME}")
        local cmd_rc=0
        _discovery_with_orchestrator_cmd priorities --url "${PRIORITIES_URL}" ${user_args[@]+"${user_args[@]}"} \
            --attempts "${PRIORITIES_FETCH_RETRY_ATTEMPTS}" --delay-secs "${PRIORITIES_FETCH_RETRY_DELAY_SECS}" \
            || cmd_rc=$?
        case "${cmd_rc}" in
            0) return 0 ;;
            3)
                warn "Failed to parse priorities JSON from ${url}"
                return 2
                ;;
        esac
        warn "Failed to fetch priorities from ${url} after ${PRIORITIES_FETCH_RETRY_ATTEMPTS} attempt(s)"
        return 1
    fi

    while [ "${attempt}" -le "${PRIORITIES_FETCH_RETRY_ATTEMPTS}" ]; do
        if priorities_json=$(curl --silent --fail --connect-timeout 10 --max-time 60 "${url}" 2>/dev/null); then
            printf '%s' "${priorities_json}" | jq -c '[
                .priorities[]
                    | select((.status == "Open" or .status == "Draft") and .isOnHold == false)
            ]' && return 0
            warn "Failed to parse priorities JSON from ${url}"
            return 2
        fi
        [ "${attempt}" -lt "${PRIORITIES_FETCH_RETRY_ATTEMPTS}" ] && [ "${PRIORITIES_FETCH_RETRY_DELAY_SECS}" -gt 0 ] \
            && sleep "${PRIORITIES_FETCH_RETRY_DELAY_SECS}"
        attempt=$((attempt + 1))
    done
    warn "Failed to fetch priorities from ${url} after ${PRIORITIES_FETCH_RETRY_ATTEMPTS} attempt(s)"
    return 1
}

# Prints the login the GitHub token authenticates as (empty when GitHub gives none); returns
# non-zero when it cannot be read. With ORCHESTRATOR_DOTNET_GITHUB=1 the tool reads it through the
# cfwf MCP server's auth_status (#252).
fetch_current_login() {
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github whoami; then
        _github_read_with_orchestrator_cmd whoami
        return
    fi
    gh api user --jq '.login' 2> /dev/null
}

# Runs one work-discovery command of Credfeto.Orchestrator.Cmd (ORCHESTRATOR_DOTNET_DISCOVERY=1, #252):
# the priorities feed, the trusted logins (whose collaborators read asks the cfwf MCP server at
# ORCHESTRATOR_CFWF_MCP_URL, as _github_read_with_orchestrator_cmd does) or the GitHub health gate.
# Arguments: the command's name and options. Its output and exit status are passed through;
# test/fixtures/discovery-parity.json holds the cases the tool and the shell are both tested against.
_discovery_with_orchestrator_cmd() {
    ORCHESTRATOR_CFWF_MCP_URL="${ORCHESTRATOR_CFWF_MCP_URL}" "${ORCHESTRATOR_CMD}" discovery "$@" < /dev/null
}

# Resolves the current GitHub login into the cached _GH_ME, retrying a few times on failure.
# Returns 0 with _GH_ME set on success; on ultimate failure warns and returns 1 WITHOUT dying —
# a transient identity-lookup blip should skip the current item, not abort the whole run (#1085).
resolve_gh_me() {
    [ -n "${_GH_ME}" ] && return 0
    local attempt=1 login
    while [ "${attempt}" -le "${GH_USER_RETRY_ATTEMPTS}" ]; do
        if login=$(fetch_current_login) && [ -n "${login}" ]; then
            _GH_ME="${login}"
            return 0
        fi
        [ "${attempt}" -lt "${GH_USER_RETRY_ATTEMPTS}" ] && [ "${GH_USER_RETRY_DELAY_SECS}" -gt 0 ] \
            && sleep "${GH_USER_RETRY_DELAY_SECS}"
        attempt=$((attempt + 1))
    done
    warn "Failed to determine current GitHub user after ${GH_USER_RETRY_ATTEMPTS} attempt(s)"
    return 1
}

# Lists the numbers of open PRs created by the bot (@me) in the given repo, one per line, in
# gh pr list order.  Shared by find_open_nonblocked_pr_for_repo and
# find_human_taken_over_pr_for_issue so the author filter cannot drift between the pivot and
# stand-off paths (#1134).  PRs carrying the Blocked label are excluded unless include_blocked
# is "true" — the pivot must never work a Blocked PR, but the takeover stand-off must still see
# a Blocked human-driven PR, otherwise tagging it Blocked blinds the stand-off and a reopened
# issue gets duplicate work (#1134 review).
# Returns 1 if the identity lookup or the gh call fails.
# Avoids --author @me because gh 2.93.0 broke that flag (exits 1 with "malformed version:").
# Instead, fetches all open PRs with their author field and filters client-side on the author being
# _GH_ME (the AI agent) or PR_CREATOR_LOGIN (the PR create bot that opens the PRs for its work).
# _GH_ME is resolved lazily (with retries) on the first call and cached for subsequent calls.
list_bot_created_open_prs() {
    local repo_full="$1" include_blocked="${2:-false}"

    resolve_gh_me || return 1

    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github own-open-prs; then
        _github_read_with_orchestrator_cmd own-open-prs --repo "${repo_full}" --me "${_GH_ME}" \
            --creator "${PR_CREATOR_LOGIN}" --include-blocked "${include_blocked}"
        return
    fi

    # --limit raised from gh's default page of 30: in a dependency-bot-heavy repo the bot's own
    # PR can rank past 30, and a truncated list makes the pivot AND the stand-off blind to it —
    # the issue then looks PR-less and gets duplicate work (#1134 review round 3).
    local pr_list
    pr_list=$(gh pr list \
        --repo "${repo_full}" \
        --state open \
        --limit 200 \
        --json number,labels,author \
        2>/dev/null) || return 1
    printf '%s' "${pr_list}" | jq -r --arg me "${_GH_ME}" --arg creator "${PR_CREATOR_LOGIN}" --argjson incb "${include_blocked}" "${_JQ_DEF_OWN_PR_AUTHOR}"'
        .[] | select(
            own_pr_author and
            ($incb or (([(.labels // [])[] | .name | ascii_downcase] | index("blocked")) == null))
        ) | .number
    '
}

# Fetches the given comma-separated --json fields for a PR with the standard retry treatment
# (#1090); single definition shared by every helper that needs a partial PR fetch (#1134).
# Arguments: PR number, field list, repo (defaults to REPO_FULL from the current repo context).
fetch_pr_fields_json() {
    local item_id="$1" fields="$2" repo_full="${3:-${REPO_FULL}}" attempt=1 result
    while [ "${attempt}" -le "${GH_ITEM_FETCH_RETRY_ATTEMPTS}" ]; do
        if result=$(gh pr view "${item_id}" \
            --repo "${repo_full}" \
            --json "${fields}" \
            2>/dev/null); then
            printf '%s' "${result}"
            return 0
        fi
        [ "${attempt}" -lt "${GH_ITEM_FETCH_RETRY_ATTEMPTS}" ] && [ "${GH_ITEM_FETCH_RETRY_DELAY_SECS}" -gt 0 ] \
            && sleep "${GH_ITEM_FETCH_RETRY_DELAY_SECS}"
        attempt=$((attempt + 1))
    done
    return 1
}

# Makes one GitHub read through Credfeto.Orchestrator.Cmd (ORCHESTRATOR_DOTNET_GITHUB=1, #252), which
# asks the cfwf MCP server at ORCHESTRATOR_CFWF_MCP_URL with the GitHub token oneshot exported from
# .env (GH_ENTERPRISE_TOKEN, then GH_TOKEN), as the agent's cfwf-mcp-headers helper does. Arguments:
# the read's name and options. Prints what the gh call it replaces prints
# (test/fixtures/github-parity.json holds the cases both are tested against); the tool prints
# nothing unless the read succeeded, and its non-zero exit status is returned when it fails.
_github_read_with_orchestrator_cmd() {
    ORCHESTRATOR_CFWF_MCP_URL="${ORCHESTRATOR_CFWF_MCP_URL}" "${ORCHESTRATOR_CMD}" github "$@" < /dev/null
}

# Makes one of the CHECKS reads that ask GitHub (ORCHESTRATOR_DOTNET_CHECKS=1, #252) through
# `ORCHESTRATOR_CMD checks <query>`, which asks the cfwf MCP server as _github_read_with_orchestrator_cmd
# does. Arguments: the query and its options. Sets the caller's locals checks_tool_output, to what the
# tool printed (trailing newlines kept), and checks_tool_status, to its exit status; the caller decides
# which statuses are an answer. The tool's stderr is dropped: a caller that answers in bash warns instead.
# test/fixtures/checks-reads-parity.json holds the cases both sides are tested against.
_checks_read_with_orchestrator_cmd() {
    local text
    # The tool's exit status after a dot keeps the output's own trailing newlines, which $(...) would drop
    text=$(
        ORCHESTRATOR_CFWF_MCP_URL="${ORCHESTRATOR_CFWF_MCP_URL}" "${ORCHESTRATOR_CMD}" checks "$@" < /dev/null 2> /dev/null
        printf '.%s' "$?"
    )
    checks_tool_output=${text%.*}
    checks_tool_status=${text##*.}
}

# Prints, as one line of JSON, every open PR in repo_full with the fields
# find_human_taken_over_pr_for_issue reads, newest first:
# [{"number":N,"author":{"login":L},"closingIssuesReferences":[{"number":M}],"headRefName":H}],
# where L is empty when GitHub gives no author and M is the number of an issue the PR closes, in
# any repository. Returns non-zero when the list cannot be read. With ORCHESTRATOR_DOTNET_GITHUB=1
# the tool reads it through the cfwf MCP server's pr_list, which lists every open PR where gh
# stops at 200 (#252).
fetch_open_prs_with_closing_issues() {
    local repo_full="$1" pr_list
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github open-prs-closing-issues; then
        _github_read_with_orchestrator_cmd open-prs-closing-issues --repo "${repo_full}"
        return
    fi
    pr_list=$(gh pr list \
        --repo "${repo_full}" \
        --state open \
        --limit 200 \
        --json number,author,closingIssuesReferences,headRefName \
        2> /dev/null) || return 1
    printf '%s' "${pr_list}" | jq -c '[.[] | {
        number,
        author: {login: (.author.login // "")},
        closingIssuesReferences: [(.closingIssuesReferences // [])[] | {number}],
        headRefName: (.headRefName // "")
    }]'
}

# Prints, as one line of JSON, the login and email of every author and co-author of each commit on
# PR pr_number in repo_full, the fields json_has_commit_author_identity reads:
# {"commits":[{"authors":[{"login":L,"email":E}]}]}, where L is empty when GitHub has not linked
# the email to an account. Retries like fetch_pr_fields_json and returns non-zero once it gives up.
# With ORCHESTRATOR_DOTNET_GITHUB=1 the tool reads them through the cfwf MCP server's pr_view (#252).
fetch_pr_commit_authors_json() {
    local repo_full="$1" pr_number="$2" attempt=1 result
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" != 1 ] || ! orchestrator_cmd_supports github pr-commit-authors; then
        result=$(fetch_pr_fields_json "${pr_number}" commits "${repo_full}") || return 1
        printf '%s' "${result}" | jq -c '{commits: [(.commits // [])[] | {
            authors: [(.authors // [])[] | {login: (.login // ""), email: (.email // "")}]
        }]}'
        return
    fi
    while [ "${attempt}" -le "${GH_ITEM_FETCH_RETRY_ATTEMPTS}" ]; do
        if result=$(_github_read_with_orchestrator_cmd pr-commit-authors --repo "${repo_full}" --pr "${pr_number}"); then
            printf '%s' "${result}"
            return 0
        fi
        [ "${attempt}" -lt "${GH_ITEM_FETCH_RETRY_ATTEMPTS}" ] && [ "${GH_ITEM_FETCH_RETRY_DELAY_SECS}" -gt 0 ] \
            && sleep "${GH_ITEM_FETCH_RETRY_DELAY_SECS}"
        attempt=$((attempt + 1))
    done
    return 1
}

# Prints how many commits branch head_branch of repo_full is behind base_branch (the compare API's
# behind_by, counted from their merge base). Returns non-zero when the comparison cannot be read.
# Both branch names are encoded as single path segments, as fetch_branch_requires_status_checks
# does. With ORCHESTRATOR_DOTNET_GITHUB=1 the tool reads it through the cfwf MCP server's
# branch_compare (#252).
fetch_branch_behind_by() {
    local repo_full="$1" base_branch="$2" head_branch="$3" encoded_base encoded_head
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github branch-behind-by; then
        _github_read_with_orchestrator_cmd branch-behind-by --repo "${repo_full}" \
            --base "${base_branch}" --head "${head_branch}"
        return
    fi
    encoded_base=$(printf '%s' "${base_branch}" | jq -sRr '@uri') || return 1
    encoded_head=$(printf '%s' "${head_branch}" | jq -sRr '@uri') || return 1
    gh api "repos/${repo_full}/compare/${encoded_base}...${encoded_head}" --jq '.behind_by' 2> /dev/null
}

# Prints the number of every issue PR pr_number in repo_full closes, in any repository, one per line in
# GitHub's order; prints nothing when it closes none. Returns non-zero when the PR cannot be read. With
# ORCHESTRATOR_DOTNET_GITHUB=1 the tool reads them through the cfwf MCP server's pr_view (#252).
fetch_pr_closing_issue_numbers() {
    local repo_full="$1" pr_number="$2"
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github pr-closing-issues; then
        _github_read_with_orchestrator_cmd pr-closing-issues --repo "${repo_full}" --pr "${pr_number}"
        return
    fi
    gh pr view "${pr_number}" --repo "${repo_full}" --json closingIssuesReferences \
        --jq '.closingIssuesReferences[].number' 2> /dev/null
}

# Prints the labels of every issue PR pr_number in repo_full closes, each read from the issue's own
# repository, one per line, sorted (by code point) and without repeats. Blocked, On Hold and On-Hold, in
# any case, are left out: they control the workflow of the issue they are on and are not copied (#1321).
# An issue whose labels cannot be read is left out; returns non-zero only when the PR's closing issues
# cannot be read. With ORCHESTRATOR_DOTNET_GITHUB=1 the tool reads them through the cfwf MCP server's
# closing_issue_labels (#252).
fetch_closing_issue_labels() {
    local repo_full="$1" pr_number="$2" references issue_repo issue_number labels=""
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github closing-issue-labels; then
        _github_read_with_orchestrator_cmd closing-issue-labels --repo "${repo_full}" --pr "${pr_number}"
        return
    fi
    references=$(gh pr view "${pr_number}" --repo "${repo_full}" --json closingIssuesReferences \
        --jq '.closingIssuesReferences[] | "\(.repository.owner.login)/\(.repository.name) \(.number)"' \
        2> /dev/null) || return 1
    while read -r issue_repo issue_number; do
        [ -n "${issue_number}" ] || continue
        labels+="$(gh issue view "${issue_number}" --repo "${issue_repo}" --json labels --jq '.labels[].name' 2> /dev/null)"
        labels+=$'\n'
    done <<< "${references}"
    printf '%s' "${labels}" | jq -nRr '
        [inputs | select(. != "" and ((ascii_downcase | . == "blocked" or . == "on hold" or . == "on-hold") | not))]
        | unique | .[]
    '
}

# Prints the numbers of the open PRs in repo_full whose head branch is exactly branch, a fork's
# branch of that name included, one per line, newest first; prints nothing when there is none.
# Returns non-zero when the list cannot be read.
fetch_open_pr_numbers_on_head() {
    local repo_full="$1" branch="$2"
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github open-prs; then
        _github_read_with_orchestrator_cmd open-prs --repo "${repo_full}" --head "${branch}"
        return
    fi
    gh pr list --repo "${repo_full}" --head "${branch}" --state open --json number --jq '.[].number' 2> /dev/null
}

# Prints how many open PRs in repo_full have exactly branch as their head branch, counted as
# fetch_open_pr_numbers_on_head lists them. Returns non-zero when the list cannot be read.
fetch_open_pr_count_on_head() {
    local repo_full="$1" branch="$2"
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github open-pr-count; then
        _github_read_with_orchestrator_cmd open-pr-count --repo "${repo_full}" --head "${branch}"
        return
    fi
    gh pr list --repo "${repo_full}" --head "${branch}" --state open --json number --jq 'length' 2>/dev/null
}

# Prints a JSON array of the names of the checks on the PR's head commit that GitHub reports as
# required for merging this PR, read from the same GraphQL field `gh pr checks --required` filters
# on (isRequired(pullRequestNumber:)). `gh pr view --json statusCheckRollup` never carries
# isRequired, so this is the only way to tell a failing required check from a failing optional
# one. Reading the GraphQL field directly, rather than parsing `gh pr checks` output, also avoids
# the stale "pending" state that command has shown through the API proxy. Returns 1 when the call
# fails, the response has no pull request, or the rollup has more contexts than one page holds,
# so the caller treats required-ness as unknown instead of trusting a partial list. With
# ORCHESTRATOR_DOTNET_CHECKS=1 the tool reads the same names through the cfwf MCP server's pr_view
# (checks, exact names) and prints the same line; when it fails or refuses (a server that gives no
# required flag), this answers with gh, with a warning (#252).
fetch_pr_required_check_names() {
    local item_id="$1" repo_full="${2:-${REPO_FULL}}" response checks_tool_output checks_tool_status
    if [ "${ORCHESTRATOR_DOTNET_CHECKS}" = 1 ] && orchestrator_cmd_supports checks required-check-names; then
        _checks_read_with_orchestrator_cmd required-check-names --repo "${repo_full}" --pr "${item_id}"
        if [ "${checks_tool_status}" = 0 ]; then
            printf '%s' "${checks_tool_output}"
            return 0
        fi
        warn "${ORCHESTRATOR_CMD} checks required-check-names failed (exit ${checks_tool_status}); answering it in bash instead"
    fi
    # shellcheck disable=SC2016  # $owner/$name/$number are GraphQL variables, not shell expansions
    local query='query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){commits(last:1){nodes{commit{statusCheckRollup{contexts(first:100){pageInfo{hasNextPage} nodes{__typename ... on CheckRun{name isRequired(pullRequestNumber:$number)} ... on StatusContext{context isRequired(pullRequestNumber:$number)}}}}}}}}}}'
    response=$(gh api graphql -f query="${query}" -f owner="${repo_full%%/*}" -f name="${repo_full#*/}" -F number="${item_id}" 2>/dev/null) || return 1
    printf '%s' "${response}" | jq -ce '
        .data.repository.pullRequest.commits.nodes as $commits
        | if ($commits | type) != "array" then error("no pull request")
          else ($commits[0].commit.statusCheckRollup.contexts // {nodes: [], pageInfo: {hasNextPage: false}})
          end
        | if .pageInfo.hasNextPage then error("more contexts than one page")
          else [.nodes[] | select(.isRequired == true) | (.name // .context)] | unique
          end
    ' 2>/dev/null
}

# Prints "true" when the base branch has any required status check configured, through classic
# branch protection or a ruleset, and "false" when it has none. This is read from the branch
# itself rather than from a head commit, so it tells apart the two cases where
# fetch_pr_required_check_names prints "[]": a branch that requires nothing, and one whose required
# checks have not reported on this commit yet (just after a push, or a workflow whose paths filter
# this PR does not match). The branch endpoint is used instead of .../protection/required_status_checks
# because it needs only read access and reports an unprotected branch as enforcement_level "off"
# rather than as a 404 that a permission failure also produces. Returns 1 when either call fails or
# base_branch is empty, so the caller treats required-ness as unknown.
fetch_branch_requires_status_checks() {
    local base_branch="$1" repo_full="${2:-${REPO_FULL}}" encoded_branch protection rules
    [ -n "${base_branch}" ] || return 1
    if [ "${ORCHESTRATOR_DOTNET_GITHUB}" = 1 ] && orchestrator_cmd_supports github branch-requires-status-checks; then
        _github_read_with_orchestrator_cmd branch-requires-status-checks --repo "${repo_full}" --branch "${base_branch}"
        return
    fi
    # A branch name may contain "/", "#" or "%", so it is encoded as a single path segment.
    encoded_branch=$(printf '%s' "${base_branch}" | jq -sRr '@uri') || return 1
    protection=$(gh api "repos/${repo_full}/branches/${encoded_branch}" 2>/dev/null) || return 1
    rules=$(gh api "repos/${repo_full}/rules/branches/${encoded_branch}?per_page=100" 2>/dev/null) || return 1
    jq -nr --argjson protection "${protection}" --argjson rules "${rules}" '
        ($protection.protection.required_status_checks // {}) as $classic
        | if ($protection | type) != "object" or $protection.name == null or ($rules | type) != "array"
          then error("unexpected branch or rules response")
          else (
              (($classic.enforcement_level // "off") != "off"
                  and ((($classic.contexts // []) | length) > 0 or (($classic.checks // []) | length) > 0))
              or ($rules | any(.[]; .type == "required_status_checks"))
          )
          end
    ' 2>/dev/null
}

# Returns 0 when a check run on commit head_sha in repository repo_full is still running: its status
# is queued, in_progress, waiting, pending or requested and it has no conclusion yet (a run whose
# conclusion is set is done, whatever its status says, as pr_json_has_pending_ci_checks also
# assumes). Returns 1 when every check run on the commit has finished, or there is none, and 2 when
# the lookup fails. The REST check-runs endpoint lists every run on the commit, including
# push-triggered ones that are not in the PR's statusCheckRollup (#1860). It is paginated at 100
# per page, so a commit with many runs is read in full. With ORCHESTRATOR_DOTNET_CHECKS=1 the tool
# asks the cfwf MCP server's commit_check_runs, which counts the same runs, and its 0, 1 or 2 is
# returned as it is; when it refuses (a server that does not list commit_check_runs) or fails
# otherwise, this asks gh, with a warning (#252).
head_commit_has_running_check_runs() {
    local repo_full="$1" head_sha="$2" statuses checks_tool_output checks_tool_status
    [ -n "${repo_full}" ] && [ -n "${head_sha}" ] || return 2
    if [ "${ORCHESTRATOR_DOTNET_CHECKS}" = 1 ] && orchestrator_cmd_supports checks has-running-check-runs; then
        _checks_read_with_orchestrator_cmd has-running-check-runs --repo "${repo_full}" --sha "${head_sha}"
        case "${checks_tool_status}" in
            0 | 1 | 2) return "${checks_tool_status}" ;;
        esac
        warn "${ORCHESTRATOR_CMD} checks has-running-check-runs failed (exit ${checks_tool_status}); answering it in bash instead"
    fi
    statuses=$(gh api --paginate "repos/${repo_full}/commits/${head_sha}/check-runs?per_page=100" \
        --jq '.check_runs[] | select(.conclusion == null) | .status' 2> /dev/null) || return 2
    printf '%s\n' "${statuses}" | grep -qxE 'queued|in_progress|waiting|pending|requested'
}

# Returns 0 when the PR's head branch is behind its base branch (the compare API's behind_by is
# above zero), 1 when it is not, or when the PR comes from a fork or names no base/head branch, and
# 2 when the lookup fails. Used only once a PR's merge state has stayed UNKNOWN past its timeout
# (#1701): GitHub then gives no BEHIND signal, so this asks directly, through fetch_branch_behind_by.
pr_branch_behind_base() {
    local repo_full="$1" pr_json="$2" base_branch head_branch behind_by
    if printf '%s' "${pr_json}" | jq -e '.isCrossRepository == true' > /dev/null 2>&1; then
        return 1
    fi
    base_branch=$(printf '%s' "${pr_json}" | jq -r '.baseRefName // empty' 2>/dev/null)
    head_branch=$(printf '%s' "${pr_json}" | jq -r '.headRefName // empty' 2>/dev/null)
    [ -n "${base_branch}" ] && [ -n "${head_branch}" ] || return 1
    behind_by=$(fetch_branch_behind_by "${repo_full}" "${base_branch}" "${head_branch}") || return 2
    [[ "${behind_by}" =~ ^[0-9]+$ ]] || return 2
    [ "${behind_by}" -gt 0 ]
}

# Reads JSON with a .commits array on stdin and succeeds when any commit matches the given
# identity — by resolved GitHub login (of that commit's author OR co-author), or, ONLY when that
# ENTIRE COMMIT has no resolved login at all (neither author nor any co-author), by raw
# commit-author email. GitHub maps commit author emails to logins asynchronously after a push; a
# freshly-pushed commit's login can be temporarily empty even though the raw email (whatever the
# committer's git identity actually wrote) is present immediately (#1294 — confirmed live: a
# genuinely bot-authored PR was misclassified as human-driven for ~1h48m purely because the login
# resolution for its latest commit hadn't landed yet).
#
# The email match is deliberately gated per COMMIT, not per individual author entry (#1294
# review, round 2): raw commit-author email is unauthenticated — anyone with push access can set
# `git config user.email`, or add a free-text `Co-authored-by:` trailer, to any string, including
# a value copied from the bot's own commit history (it is literally the author email on every
# commit the bot makes). Gating per author-entry instead of per commit was itself found to be
# bypassable: a commit resolved to a genuine human primary author, plus an attacker-added
# co-author trailer whose email matched, still matched via that co-author entry even though the
# commit as a whole was unambiguously human-authored. Grouping by commit and requiring NONE of
# that commit's authors to have a resolved login before trusting any of their emails closes that
# gap: a commit whose primary author OR any co-author DOES resolve — to the bot, to a human
# taking over, or to anyone else — is decided by that verified signal alone; email only ever
# fills the gap when GitHub has told us nothing at all about that commit's identity, never
# overrides what GitHub has already told us about it.
#
# Comparison is case-insensitive on the email side: a commit's raw author email can be recorded
# in different case than GIT_USER_EMAIL depending on how it was set, and this is not a security
# boundary (unlike the login match, which is exact) — it only ever fires for the one identity we
# supply statically in advance, so any is-obviously-a-different-string values still stay refused.
#
# The email match exists only for identities we know statically in advance (the bot's own
# GIT_USER_EMAIL) — there is no general "trusted emails" list, so this is not a substitute for
# the login check for OTHER (non-bot) trusted identities, only a lag-immune addition to it for
# the one identity callers can supply an email for. Single definition shared by the pivot and
# human-driven predicates so they cannot diverge (#1134).
json_has_commit_author_identity() {
    local me="$1" my_email="${2:-}"
    jq -e --arg me "${me}" --arg my_email "${my_email}" '
        [(.commits // [])[] |
            ((.authors // []) | map(.login // "") | map(select(. != ""))) as $resolved_logins
            | ($resolved_logins | index($me) != null)
              or (
                  ($my_email != "")
                  and ($resolved_logins | length == 0)
                  and ((.authors // []) | any((.email // "" | ascii_downcase) == ($my_email | ascii_downcase)))
              )
        ] | any
    ' > /dev/null 2>&1
}

# Queries GitHub for the first open, non-blocked PR in the given repo that the bot is actually
# driving: created by @me AND containing at least one commit authored by @me (#1131).  PR
# creation authorship alone is not enough — the issue workflow creates the draft PR, but a human
# can take over the branch afterwards (rebasing the bot's placeholder commit away), and such a
# PR must be left alone rather than re-invoked against the human's work.
# Outputs the PR number on stdout, or empty string if no candidate qualifies.
# A candidate whose commits cannot be fetched is scanned past — one broken PR (e.g. from a
# deleted fork) must not block pivoting to a healthy later one (#1134) — but if no bot-driven PR
# is found after such a failure the lookup returns 1, because misreading "could not tell" as
# "PR-less" would let the issue workflow open a duplicate branch.
# Returns 1 if the PR list fetch fails.
# Optional second argument include_blocked ("true"/"false", default "false"): by default a
# Blocked PR is filtered out of the candidate list entirely, same as list_bot_created_open_prs'
# own default — right for a caller that only wants a PR it should actively pivot into and drive.
# A caller that instead needs to recognize "this issue's own PR exists but is Blocked" (so it can
# stand off explicitly, rather than fall through to Blocked-PR-shaped candidates being invisible
# and misread as "no PR yet, still needs one opened") must pass "true" here (#1463 review — see
# oneshot's issue-pivot call site, which pairs this with its own existing pr_json_has_blocked_label
# check once the candidate is fetched).
find_open_nonblocked_pr_for_repo() {
    local repo_full="$1" include_blocked="${2:-false}"

    local candidates candidate commit_rc scan_error=0
    candidates=$(list_bot_created_open_prs "${repo_full}" "${include_blocked}") || return 1
    while IFS= read -r candidate; do
        [ -n "${candidate}" ] || continue
        commit_rc=0
        pr_has_bot_authored_commit "${repo_full}" "${candidate}" || commit_rc=$?
        if [ "${commit_rc}" -eq 0 ]; then
            printf '%s' "${candidate}"
            return 0
        fi
        if [ "${commit_rc}" -eq 2 ]; then
            warn "Failed to fetch commits for PR #${candidate} in ${repo_full} — continuing scan"
            scan_error=1
            continue
        fi
        # Diagnosable trail for a systemic misclassification: if GIT_USER_EMAIL stops mapping
        # to the bot account, every bot PR lands here and the orchestrator goes quiet with only
        # a "human-driven" count to show for it (#1134).
        warn "PR #${candidate} in ${repo_full}: created by the bot but has no bot-authored commits — treating as human-driven"
    done <<< "${candidates}"
    [ "${scan_error}" -eq 0 ] || return 1
    return 0
}

# Tests whether the bot (_GH_ME) has authored (or co-authored) at least one commit on the given
# PR — the signal that the bot, not a human, is driving the branch (#1131).
# Returns 0 when a bot-authored commit exists, 1 when none does, and 2 when the gh fetch fails
# after retries — distinct from 1 so callers can propagate a transient error instead of
# misreading it as "human-driven".
pr_has_bot_authored_commit() {
    local repo_full="$1" pr_number="$2" commits_json
    # An unresolved identity would make every commit look human-authored, so it is a failure to
    # classify, not an answer (#1517).
    resolve_gh_me || return 2
    commits_json=$(fetch_pr_commit_authors_json "${repo_full}" "${pr_number}") || return 2
    printf '%s' "${commits_json}" | json_has_commit_author_identity "${_GH_ME}" "${GIT_USER_EMAIL}"
}

# Finds an open PR that belongs to the given issue and that a human is developing: it has zero
# bot-authored commits (#1131). Such an issue must be stood off: it is invisible to the
# find_open_nonblocked_pr_for_repo pivot (no bot commits), but re-working it as a fresh issue would
# open a duplicate branch/PR alongside the human's work. The PR may have been opened by the bot and
# taken over, by the PR create bot, or by a trusted person (the owner, a collaborator, a
# whitelisted user) from the start; whoever opened it, only whose commits are on it decides (#1517).
# A PR opened by anyone else is not considered: a stranger's PR that says "Closes #N" must not be
# able to park an Issue, nor be tagged Blocked and commented on by the closed-issue path.
# Ownership is matched via closingIssuesReferences; only when a PR declares NO closing
# references at all does the branch-naming convention (issue_branch_regex, lib/git) serve as a
# fallback - a human takeover can edit the "Closes #N" line out of the PR body entirely, and the
# stand-off must not silently vanish with it, but explicit references pointing at a different
# issue must win over a stale branch name (#1134). Blocked PRs are included: a Blocked
# human-driven PR still owns its issue's work (#1134 review).
# One fetch_open_prs_with_closing_issues call returns the author, references and branch name of
# every open PR, so the ownership check costs no per-PR call and only the PR that owns the issue
# needs its commits fetched. When the issue's own PR cannot be classified this returns 2: a permanently unfetchable
# PR that owns the issue keeps its issue conservatively parked rather than risking duplicate work
# alongside it (#1134 review round 3).
# Uses REPO_FULL from the current repo context (set_repo_context).
# Outputs the PR number and returns 0 when such a PR exists; returns 1 when none does; returns 2
# on a gh failure, or when the identity or the trusted logins cannot be resolved (caller should skip
# the item rather than risk duplicating work).
find_human_taken_over_pr_for_issue() {
    local issue_id="$1"

    local pr_list trusted candidates candidate commit_rc branch_regex
    resolve_gh_me || return 2
    trusted=$(get_trusted_logins) || return 2
    branch_regex=$(issue_branch_regex "${issue_id}")
    pr_list=$(fetch_open_prs_with_closing_issues "${REPO_FULL}") || return 2
    candidates=$(printf '%s' "${pr_list}" | jq -r \
        --arg me "${_GH_ME}" --arg creator "${PR_CREATOR_LOGIN}" --argjson trusted "${trusted}" \
        --arg n "${issue_id}" --arg pattern "${branch_regex}" "${_JQ_DEF_OWN_PR_AUTHOR}"'
        .[] | select(
            (own_pr_author or ((.author.login // "") as $author | ($trusted | index($author)) != null))
            and (
                (((.closingIssuesReferences // []) | length) > 0
                    and ([(.closingIssuesReferences // [])[] | .number | tostring] | index($n) != null))
                or (((.closingIssuesReferences // []) | length) == 0
                    and ((.headRefName // "") | test($pattern)))
            )
        ) | .number
    ') || return 2
    while IFS= read -r candidate; do
        [ -n "${candidate}" ] || continue
        # This candidate owns the issue - commit authorship decides who is driving it.
        commit_rc=0
        pr_has_bot_authored_commit "${REPO_FULL}" "${candidate}" || commit_rc=$?
        [ "${commit_rc}" -eq 2 ] && return 2
        # Bot-driven PR - not a takeover; the pivot handles it.
        [ "${commit_rc}" -eq 0 ] && continue
        printf '%s' "${candidate}"
        return 0
    done <<< "${candidates}"
    return 1
}

# Combines find_stale_issue_branch (lib/git) with a confirmation that no open pull request
# already covers the candidate branch (#1262) — the one paid gh call, made only when a
# candidate actually exists. This is a genuinely separate check from the stand-offs above: those
# find a PR through the issue it closes (or its branch name when it closes none), so they cannot
# catch a human who has independently opened their own PR from the exact branch name the bot's
# earlier, now-dead session pushed without linking it to the issue.
# Called from two places that both need the same answer: the fingerprint-unchanged skip
# decision (should this Issue be re-run instead of skipped?) and the work-block prompt build
# (what branch guidance, if any, should the agent be given?) — kept as one function so they
# cannot silently diverge.
# Uses REPO_FULL from the current repo context (set_repo_context), matching the convention of
# find_human_taken_over_pr_for_issue above.
# Outputs the branch name and returns 0 when a resumable stale branch is confirmed; returns 1
# when there is no candidate, or an open PR already covers the one that was found.
resolve_resumable_issue_branch() {
    local issue_id="$1"
    local branch open_pr_count

    branch=$(find_stale_issue_branch "${issue_id}") || return 1
    [ -n "${branch}" ] || return 1

    open_pr_count=$(fetch_open_pr_count_on_head "${REPO_FULL}" "${branch}")
    [[ "${open_pr_count}" =~ ^[0-9]+$ ]] || open_pr_count=1
    [ "${open_pr_count}" -eq 0 ] || return 1

    printf '%s' "${branch}"
    return 0
}

# Says whether PR pr_number in repo carries the Blocked label (case-insensitive). Returns 0 when it
# does, 1 when it does not, and 2 when its labels cannot be read.
_dirty_owner_pr_is_blocked() {
    local repo="$1" pr_number="$2" labels_json
    labels_json=$(fetch_pr_fields_json "${pr_number}" labels "${repo}") || return 2
    if printf '%s' "${labels_json}" | jq -e '[(.labels // [])[] | .name | ascii_downcase] | any(. == "blocked")' > /dev/null 2>&1; then
        return 0
    fi
    return 1
}

# Says whether another item in this run's queue (items_json, the priorities feed after the owner
# filter) owns a dirty checkout's branch, by the same rule as dirty_branch_belongs_to_item
# (lib/git): a queued Issue in the repository owns main and a branch named for it, and a queued
# PR owns its head branch. The current item (item_type, item_id) is left out. An owner that cannot
# be worked does not count (#2053): a queued PR that is on hold in the feed (the dispatcher's
# record of its Blocked label), and a queued Issue when an open PR on the dirty branch carries the Blocked label (the
# Issue's session pivots to that PR, which is skipped while it is Blocked). Without this the
# checkout stayed dirty for good and every other item in the repository was skipped on every
# tick. Outputs the owner as "<type> #<id>" and returns 0 when one is queued: that item recovers
# the work, so the caller keeps skipping. Returns 1 when none is, and always for a detached HEAD
# (an empty branch), so the caller may stash the checkout. Returns 2 when the open PRs on the
# branch, or a candidate owner's labels, cannot be read: whether a queued item owns it is then
# unknown, and the caller must not stash.
dirty_branch_owned_by_queued_item() {
    local items_json="$1" repo="$2" dirty_branch="$3" item_type="$4" item_id="$5"
    [ -n "${dirty_branch}" ] || return 1

    local queued_type queued_id queued_on_hold head_prs pr_number blocked_rc
    local -a queued_prs=() owning_issues=()
    while IFS=$'\t' read -r queued_type queued_id queued_on_hold; do
        [ -n "${queued_id}" ] || continue
        [ "${queued_type}" = "${item_type}" ] && [ "${queued_id}" = "${item_id}" ] && continue
        if [ "${queued_type}" = "Issue" ]; then
            if dirty_branch_belongs_to_item Issue "${queued_id}" "${dirty_branch}" ""; then
                owning_issues+=("${queued_id}")
            fi
        elif [ "${queued_type}" = "PullRequest" ] && [ "${queued_on_hold}" != "true" ]; then
            queued_prs+=("${queued_id}")
        fi
    done < <(printf '%s' "${items_json}" | jq -r --arg repo "${repo}" \
        '.[] | select(.repository == $repo) | [.itemType, (.id | tostring), ((.isOnHold // false) | tostring)] | @tsv' 2> /dev/null)

    [ "${#owning_issues[@]}" -gt 0 ] || [ "${#queued_prs[@]}" -gt 0 ] || return 1
    if ! head_prs=$(fetch_open_pr_numbers_on_head "${repo}" "${dirty_branch}"); then
        warn "Could not list the open PRs on '${dirty_branch}' in ${repo} to tell whether a queued item owns it"
        return 2
    fi

    # A queued Issue owns the branch unless an open PR on it is Blocked.
    if [ "${#owning_issues[@]}" -gt 0 ]; then
        local issue_blocked=false
        while IFS= read -r pr_number; do
            [ -n "${pr_number}" ] || continue
            blocked_rc=0
            _dirty_owner_pr_is_blocked "${repo}" "${pr_number}" || blocked_rc=$?
            if [ "${blocked_rc}" -eq 2 ]; then
                warn "Could not read the labels of PR #${pr_number} in ${repo} to tell whether a queued item owns '${dirty_branch}'"
                return 2
            fi
            if [ "${blocked_rc}" -eq 0 ]; then
                issue_blocked=true
                break
            fi
        done <<< "${head_prs}"
        if [ "${issue_blocked}" = false ]; then
            printf 'Issue #%s' "${owning_issues[0]}"
            return 0
        fi
    fi

    [ "${#queued_prs[@]}" -gt 0 ] || return 1
    while IFS= read -r pr_number; do
        [ -n "${pr_number}" ] || continue
        for queued_id in "${queued_prs[@]}"; do
            if [ "${pr_number}" = "${queued_id}" ]; then
                printf 'PullRequest #%s' "${queued_id}"
                return 0
            fi
        done
    done <<< "${head_prs}"
    return 1
}

pr_has_dependency_label() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '[(.labels // [])[] | .name | ascii_downcase] | any(contains("dependencies"))' > /dev/null 2>&1
}

# A dependency-update PR is recognised by the branch its bump tooling pushed to ("depends/..."
# from credfeto-batch-updates, "dependabot/..." from Dependabot), never by label: issue-label sync
# copies a linked issue's "dependencies" label onto any bot PR, which used to put a bot-authored
# feature PR into the CI-verify-only prompt that forbids code changes. The branch name is chosen
# freely by whoever opens a PR, so only a same-repository branch (whose author has write access)
# counts: a PR from a fork never does, whatever it is called, and so is never exempted from the
# human-driven and assignee stand-off checks or given the verify-only prompt. isCrossRepository is
# only ever true when fetch_pr_json says so, so a PR JSON without the field is treated as
# same-repository.
pr_has_dependency_update_branch() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '((.headRefName // "") | test("^(depends|dependabot)/")) and ((.isCrossRepository // false) | not)' > /dev/null 2>&1
}

# Whether build_pr_claude_md should use its CI-verify-only dependency prompt: a same-repository
# dependency-update branch (pr_has_dependency_update_branch, which refuses a fork PR). Falls back to
# the full phase flow when a reviewer has requested changes (that prompt cannot make code changes),
# when the branch has merge conflicts (DIRTY), when a required check has failed (or a failing
# check's required-ness could not be looked up), or
# when the branch still carries the .deleteme.now placeholder (that prompt would arm auto-merge on
# a scaffold-only PR). A failed check needs a fix, which the verify-only prompt forbids: it could
# only comment and add Blocked, so a dependency bump that breaks the build was parked for a human
# instead of being made to build, as the repository instructions require. The full flow routes it
# to PHASE C (pr_next_phase_for_board_status); once CI is green again, the next session gets this
# prompt back and arms auto-merge.
# Optional second argument has_unaddressed_comment ("true"/"false", default "false"): a trusted
# comment newer than the agent's last session (set_pr_has_unaddressed_comment, lib/github-status)
# also gets the full flow (#1977). The verify-only prompt forbids code changes and never reads the
# comments, so a maintainer's request on an adopted dependency PR was ignored while auto-merge was
# armed or the PR waited; the full flow quotes the comment and acts on it in PHASE C.
pr_should_use_dependency_prompt() {
    local pr_json="$1" has_unaddressed_comment="${2:-false}"
    pr_has_dependency_update_branch "${pr_json}" || return 1
    [ "${has_unaddressed_comment}" = "true" ] && return 1
    printf '%s' "${pr_json}" | jq -e '.reviewDecision != "CHANGES_REQUESTED"' > /dev/null 2>&1 || return 1
    pr_json_has_failed_required_check "${pr_json}" && return 1
    pr_json_has_failed_check_of_unknown_requiredness "${pr_json}" && return 1
    # A DIRTY or BEHIND branch reaches the agent only when the non-agentic rebase hit conflicts
    # or never ran: a successful one skips the agent for this tick, and it is skipped when the
    # working tree is dirty (ensure_repo_current hands the checkout to the agent) or a trusted
    # comment is unaddressed. The verify-only prompt has no rebase or working-tree recovery
    # steps, so the agent found "nothing to do" and the PR was re-invoked every tick, still
    # behind or conflicted (#1706, #1714); the full flow rebases it and recovers the tree.
    printf '%s' "${pr_json}" | jq -e '.mergeStateStatus == "DIRTY" or .mergeStateStatus == "BEHIND"' > /dev/null 2>&1 && return 1
    pr_json_has_placeholder_file "${pr_json}" && return 1
    return 0
}

# Whether a dependency-update PR (pr_has_dependency_update_branch: a same-repository depends/ or
# dependabot/ branch) is adopted by trusted maintainers (#1977): leaving out the neutral assignees,
# the orchestrator's own login ($3, _GH_ME) and the PR create bot (PR_CREATOR_LOGIN), which never
# decide it either way (#1981), it has at least one assignee, and every one of them is in the
# trusted logins ($2, the JSON array get_trusted_logins gives: the repository's collaborators and
# the extra trusted users), compared without regard to case. So a maintainer beside the PR create
# bot adopts it, and the PR create bot alone does not. The neutral logins and the GitHub bots
# get_trusted_logins adds (copilot-pull-request-reviewer and any [bot] login) never count as
# adopters, and a GitHub bot as an assignee is not neutral: only a trusted human adopts one. That
# is how a dependency PR is adopted: a maintainer assigns it (an organisation can never be an
# assignee, so it is a person, not the repository owner), so the assignment is the adopted state,
# not a person claiming the work, and the PR counts as the orchestrator's own. Its assignees are never changed: the agent's prompt for a dependency PR
# has no assign step and forbids any assignee change (_build_dependency_pr_rule, lib/prompts), because
# cfwf --assign-self refuses such a PR like any other PR assigned to someone else. No assignee at
# all, only neutral assignees, any other assignee who is not trusted, or a missing or unreadable
# trusted list is not an adoption: an untrusted assignee is a claim like on any other item.
pr_json_is_owner_adopted_dependency_pr() {
    local pr_json="$1" trusted_logins="$2" me="${3:-}"
    [ -n "${trusted_logins}" ] || return 1
    pr_has_dependency_update_branch "${pr_json}" || return 1
    printf '%s' "${pr_json}" | jq -e --argjson trusted "${trusted_logins}" --arg me "${me}" --arg creator "${PR_CREATOR_LOGIN:-prpixie}" \
        '([$trusted[] | strings | ascii_downcase | select(endswith("[bot]") | not)]
          - [($me | ascii_downcase), ($creator | ascii_downcase), "copilot-pull-request-reviewer", ""]) as $adopters
         | ([(.assignees // [])[] | .login // "" | ascii_downcase]
            - ([$me, $creator] | map(ascii_downcase) - [""])) as $logins
         | ($logins | length > 0) and all($logins[]; . as $login | $adopters | index($login) != null)' > /dev/null 2>&1 \
        || return 1
}

# Whether a PR is assigned to someone other than the orchestrator ($2, _GH_ME), so that the
# orchestrator stands off it (#1142) and cfwf --assign-self refuses it (#1962): it has an assignee
# and the orchestrator is not one of them (logins compared without regard to case). A dependency PR
# adopted by trusted maintainers (pr_json_is_owner_adopted_dependency_pr, $3 the trusted logins JSON
# the caller already holds from get_trusted_logins, so no API call is made here) is not: it is the
# orchestrator's own (#1977). A dependency PR with any untrusted assignee is stood off like any other
# PR: the agent's assign step would be refused, so a session there could only stop at once.
pr_json_assigned_to_another() {
    local pr_json="$1" me="$2" trusted_logins="${3:-}"
    pr_json_is_owner_adopted_dependency_pr "${pr_json}" "${trusted_logins}" "${me}" && return 1
    printf '%s' "${pr_json}" | jq -e --arg me "${me}" \
        '[(.assignees // [])[] | .login // "" | ascii_downcase] as $logins
         | ($logins | length > 0) and ($logins | index($me | ascii_downcase) == null)' > /dev/null 2>&1
}

# Decides whether an open PR from the priorities feed is being driven by a human rather than the
# bot (#1131): the bot has authored no commits on it, AND it is either a PR the bot itself
# created (the issue workflow's draft PR, since taken over; "the bot" here is the AI agent account
# or the PR create bot, PR_CREATOR_LOGIN, which opens that PR) or it contains commits authored by
# a trusted human login.
# Check order matters (#1134): a PR the bot CREATED with zero bot commits is a human takeover
# regardless of its labels — issue-label sync can put a dependencies-ish label on any bot PR, so
# the label must not be consulted first (that was the substring-exemption regression).  Only for
# PRs the bot did NOT create does the "dependencies" label exempt the PR from the stand-off:
# dependency PRs (dependabot and similar) contain no bot commits by design, carry customised
# label variants like "npm dependencies" (hence a case-insensitive substring match), and must
# not be treated as a human takeover even after a trusted human pushes a conflict fix (which
# prompt they then get is decided separately, by branch, in pr_should_use_dependency_prompt).
# The external dependency-bump tooling (credfeto-batch-updates) always pushes to a
# "depends/..." branch and normally has its PR opened under "app/github-actions", so it never
# hits the author-check below. It can, rarely, end up opened under the bot's own login instead
# (observed on credfeto-enum-source-generation#118) — with zero bot commits yet (the bot has
# never touched it), that would otherwise look identical to a real human takeover. Unlike a
# label, the "depends/" and "dependabot/" prefixes (pr_has_dependency_update_branch) are set once
# at push time by the bump tooling and are never retroactively applied by label-sync, so checking
# them ahead of the author check cannot reopen the #1134 hole: human/bot feature branches use
# "fix/", "feat/", "perf/", etc., never these prefixes. A fork PR never counts (the branch name is
# the fork author's choice); see pr_has_dependency_update_branch.
# Operates entirely on the caller's pr_json — fetch_pr_json already includes author, commits and
# headRefName (#1134) — so the only remote failure mode is the identity lookup.
# Returns 0 (human-driven — stand off), 1 (not human-driven — process normally), or 2 when the
# identity lookup fails (caller should skip the item for this tick).
pr_is_human_driven() {
    local pr_json="$1" trusted_logins="$2"

    resolve_gh_me || return 2

    if printf '%s' "${pr_json}" | json_has_commit_author_identity "${_GH_ME}" "${GIT_USER_EMAIL}"; then
        return 1
    fi

    if pr_has_dependency_update_branch "${pr_json}"; then
        return 1
    fi

    if printf '%s' "${pr_json}" | jq -e --arg me "${_GH_ME}" --arg creator "${PR_CREATOR_LOGIN:-prpixie}" \
        "${_JQ_DEF_OWN_PR_AUTHOR}"' own_pr_author' > /dev/null 2>&1; then
        return 0
    fi

    if pr_has_dependency_label "${pr_json}"; then
        return 1
    fi

    # NOTE: this scan keys on resolved .login only, unlike the bot's own identity check above —
    # a trusted human's commit whose login hasn't resolved yet is invisible here, reintroducing
    # the #1294 lag window for non-bot trusted identities (#1294 review). Not fixed here: unlike
    # the bot's own GIT_USER_EMAIL, there is no "trusted emails" list anywhere in this codebase
    # to fall back to (get_trusted_logins/WHITELISTED_USERS only ever carry logins) - closing
    # this gap would need a genuinely new data source, not a threading-through of an existing one.
    if printf '%s' "${pr_json}" | jq -e --arg me "${_GH_ME}" --argjson trusted "${trusted_logins}" '
        [(.commits // [])[] | (.authors // [])[] | .login // empty]
        | any(. as $l | $l != $me and (($trusted | index($l)) != null))
    ' > /dev/null 2>&1; then
        return 0
    fi

    return 1
}

# Copies labels from all closing issues linked to a PR onto the PR, adding any that are missing.
# Never removes existing labels. Uses --add-label for each missing one.
# Excludes Blocked, On Hold and On-Hold in any case (fetch_closing_issue_labels): those are
# workflow-control labels scoped to the issue they were applied to, not classification labels meant to
# propagate — task-workflow.instructions.md's PR Title/Body/Label Sync rule already states this
# explicitly for the agent-driven sync path, but this shell-level helper previously copied them anyway,
# silently re-adding Blocked to a PR every tick even after a human removed it, with no comment
# explaining why (#1321).
# This is the ONLY label sync: oneshot runs it before every PR session, so the generated PR
# prompts no longer ask the agent to sync labels itself (the shell loop they used to prescribe was
# always denied by the command hooks, #1657).
# Arguments: pr_id pr_json
sync_pr_labels_from_linked_issues() {
    local pr_id="$1" pr_json="$2"
    local issue_labels
    issue_labels=$(fetch_closing_issue_labels "${REPO_FULL}" "${pr_id}") || return 0
    [ -n "${issue_labels}" ] || return 0

    local pr_label_list issue_label already_present
    pr_label_list=$(printf '%s' "${pr_json}" | jq -c '[(.labels // [])[] | .name]')
    while IFS= read -r issue_label; do
        [ -n "${issue_label}" ] || continue
        already_present=$(printf '%s' "${pr_label_list}" | jq -r --arg l "${issue_label}" 'map(select(. == $l)) | length')
        if [ "${already_present}" = "0" ]; then
            info "PR #${pr_id}: adding label '${issue_label}' from a linked issue"
            gh pr edit "${pr_id}" --repo "${REPO_FULL}" --add-label "${issue_label}" 2>/dev/null || true
        fi
    done <<< "${issue_labels}"
}
