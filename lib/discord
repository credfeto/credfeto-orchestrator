# shellcheck shell=bash
# Discord webhook notifications: work-item start/resume, no-work, low-disk-space,
# priorities-unreachable, blocked-item, PR-needs-approval, Claude container error,
# permission-denials, and rate-limited notices. Also the shared item-URL builder they use.

# Builds the GitHub URL for a work item. Arguments: item_type (Issue|PullRequest|other),
# item_id, repo (optional, defaults to REPO_FULL). Falls back to the bare repo URL for an
# unrecognised/empty item_type.
# The repo argument exists for notify_discord_no_work's per-item breakdown (#1291): by the time
# that notifier runs, REPO_FULL holds whatever the last-processed item's repo was, not the right
# value for linking items that span many different repos across one tick. Every other caller
# omits it and keeps using REPO_FULL as before.
build_item_url() {
    local item_type="$1" item_id="$2"
    local repo="${3:-${REPO_FULL:-}}"
    case "${item_type}" in
        Issue)       printf '%s' "https://github.com/${repo}/issues/${item_id}" ;;
        PullRequest) printf '%s' "https://github.com/${repo}/pull/${item_id}" ;;
        *)           printf '%s' "https://github.com/${repo}" ;;
    esac
}

# Builds one work-item's terminal-status JSON object for this tick, for notify_discord_no_work's
# per-item breakdown (#1291). Arguments: item_type, item_id, item_repo, reason (derived from the
# reason already given to info/warn at the call site — the redundant "<Type> #<id> in <repo>"
# prefix stripped, since those are captured as separate fields here, but otherwise not
# reinvented). Outputs the compact JSON object on stdout; the caller (oneshot's main loop)
# appends it to its own item_status_log array — kept a pure function, not a caller-array
# mutator, so the data flow is an explicit argument/return at every call site rather than bash's
# dynamic scoping (a rename of item_status_log in oneshot would otherwise silently break this
# with no error, per #1291 review).
record_item_status() {
    local item_type="$1" item_id="$2" item_repo="$3" reason="$4"
    jq -cn \
        --arg type "${item_type}" --arg id "${item_id}" --arg repo "${item_repo}" --arg reason "${reason}" \
        '{type:$type,id:$id,repo:$repo,reason:$reason}'
}

# Serializes the caller's item_status_log entries (each produced by record_item_status) into a
# single compact JSON array, for notify_discord_no_work's items_json argument. Takes the array
# elements as positional arguments ("${item_status_log[@]}") rather than reading a same-named
# variable by dynamic scope, matching record_item_status's explicit-data-flow convention (#1291
# review). Guards the no-arguments case explicitly rather than piping a possibly-empty expansion
# into jq -s — an empty `printf` still succeeds and jq -s on empty stdin already yields "[]", but
# the explicit check avoids depending on that behaviour and keeps this readable as "nothing to do".
serialize_item_status_log() {
    if [ "$#" -eq 0 ]; then
        printf '[]'
        return 0
    fi
    printf '%s\n' "$@" | jq -s -c '.'
}

# Sends a Discord embed notification for an item's state this tick: starting/resuming real work,
# or (since #1375) observed parked waiting on something external. Arguments: msg_type
# (start|resume|waiting), item_type, item_id, item_title, priority_rank (the priorities feed's
# own numeric .priority for this item — see fetch_all_priorities in lib/github — mapped to a tier
# name via priority_name_for_rank for the Priority field; #1375), branch_name (a PR's own head
# branch, used to enrich Sub-status with round-progress detail via
# enrich_substatus_with_round_progress — #1375; empty/omitted for an Issue, which has no round-
# tracked phases anyway), progress_state (free text for the Progress field — "Running" by default,
# or e.g. "Waiting on CI"/"Waiting on human review" for msg_type=waiting — #1375), overall_text
# (optional "N / cap" invocation-count text for the Overall field; omitted entirely when empty —
# #1375), comments_json (optional — the PR's own already-fetched .comments array, e.g. from
# fetch_pr_json/pr_json; forwarded to enrich_substatus_with_round_progress so its round count is
# read from data the caller already has in hand instead of count_pr_comments_matching issuing its
# own redundant `gh pr view` call every tick a round-tracked PR is touched, including ticks whose
# resulting payload the dedup latch above will just discard unsent. Omit for an Issue, or when the
# caller has no pr_json handy — count_pr_comments_matching falls back to fetching fresh itself)
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
# Status/Sub-status/Priority/Progress are derived entirely from already-tracked GitHub/priorities-
# feed state — no Claude invocation, zero extra agentic cost (#1136). Every session is a fresh
# single-phase run, so "New vs. Resume" (the old Status field) was never actually meaningful;
# this replaces it with the coarse board lifecycle stage instead.
# start/resume fire every time, every tick, same as before #1375 (see docs/discord-notifications.md)
# — waiting is different on purpose: it fires once per tick an item is OBSERVED parked, which
# without suppression would repeat identically every single tick for as long as it stays parked
# (potentially indefinitely, e.g. waiting on a slow human review). It is deduped on a content
# hash of substatus+progress_state+priority, latched (no time-based re-arm, unlike the rolling-
# window alerts elsewhere in this file) until that content actually changes, matching
# notify_discord_blocked_item's persistent-latch shape rather than notify_discord_no_work's
# hourly-heartbeat one — #1375 asked only for "don't repeat every tick", not a heartbeat. Every
# start/resume call clears that latch (#1375 review): without an explicit episode boundary, a
# later, genuinely new waiting episode that happens to reproduce the exact same content hash as an
# earlier, already-notified one (e.g. round-tripping back through the same substatus/progress/
# priority after an intervening review cycle) would otherwise compare equal to the stale hash and
# silently never notify — the same problem notify_discord_blocked_item avoids via
# clear_blocked_marker on its own observed-open-and-unblocked path.
notify_discord_work_item() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local msg_type="$1" item_type="$2" item_id="$3" item_title="$4" priority_rank="${5:-}" branch_name="${6:-}" progress_state="${7:-Running}" overall_text="${8:-}" comments_json="${9:-}"
    local url color payload substatus status priority

    case "${msg_type}" in
        start|resume|waiting) ;;
        *) warn "Discord: unknown notification type '${msg_type}'"; return 0 ;;
    esac

    url="$(build_item_url "${item_type}" "${item_id}")"

    case "${msg_type}" in
        start)   color=3066993 ;;  # green (#2ECC71)
        resume)  color=15844367 ;; # gold  (#F1C40F)
        waiting) color=9807270 ;;  # grey  (#95A5A6) — parked, not actively running (#1375)
    esac

    substatus=$(board_substatus_for_item "${item_id}")
    status=$(coarse_status_for_substatus "${substatus}")
    # Coarse status is derived from the RAW substatus above, before enrichment below — its case
    # statement matches exact board names ("AI Review"), not the enriched display text ("AI
    # Review (round 2 of 15)"), which would otherwise silently fall through to "Unknown" (#1375).
    substatus=$(enrich_substatus_with_round_progress "${item_id}" "${substatus}" "${branch_name}" "${comments_json}")
    priority=$(priority_name_for_rank "${priority_rank}")

    payload=$(jq --null-input \
        --argjson color "${color}" \
        --arg title "${item_title}" \
        --arg url "${url}" \
        --arg repo "${REPO_FULL}" \
        --arg type "${item_type}" \
        --arg status "${status}" \
        --arg substatus "${substatus}" \
        --arg priority "${priority}" \
        --arg progress "${progress_state}" \
        --arg overall "${overall_text}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:(
            [
                {name:"Repository",value:$repo,inline:true},
                {name:"Type",value:$type,inline:true},
                {name:"Priority",value:$priority,inline:true},
                {name:"Status",value:$status,inline:true},
                {name:"Sub-status",value:$substatus,inline:true},
                {name:"Progress",value:$progress,inline:true}
            ] + (if ($overall | length) > 0 then [{name:"Overall",value:$overall,inline:true}] else [] end)
        )}]}') \
        || { warn "Discord: failed to build payload for ${item_type} #${item_id}"; return 0; }

    if [ "${msg_type}" != "waiting" ]; then
        # A start/resume observation means the item is no longer parked, the same "episode
        # boundary" signal notify_discord_blocked_item's clear_blocked_marker call sites use to
        # re-arm that latch — so the waiting latch below must not stay keyed off content from a
        # now-closed episode: a later, genuinely new waiting episode that happens to reproduce the
        # exact same substatus+progress+priority text (e.g. round-tripping back to "Human Review"/
        # "Waiting on human review"/"High" after an intervening review cycle) would otherwise
        # compare equal to the stale hash and never notify (#1375 review).
        rm -f "$(_discord_dedup_state_file "work_item_waiting" "${REPO_FULL}/${item_id}")" 2>/dev/null || true
    fi

    if [ "${msg_type}" = "waiting" ]; then
        local dedup_hash state_file last_hash
        dedup_hash=$(printf '%s\n%s\n%s' "${substatus}" "${progress_state}" "${priority}" | hash_sha256) \
            || { warn "Discord: failed to hash waiting notification for dedup"; return 0; }
        state_file=$(_discord_dedup_state_file "work_item_waiting" "${REPO_FULL}/${item_id}")
        if [ -f "${state_file}" ]; then
            read -r last_hash < "${state_file}" 2>/dev/null
            [ "${last_hash}" = "${dedup_hash}" ] && return 0
        fi
        # Reuses the same send-only-record-on-success helper every other deduped notifier in this
        # file already calls, passing the content hash in place of the timestamp its other callers
        # use — see _discord_send_and_record's own doc comment for why that's a valid drop-in.
        _discord_send_and_record "${payload}" "${state_file}" "${dedup_hash}"
        return 0
    fi

    curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1 \
        || warn "Discord webhook notification failed"
}

# Sends a msg_type=waiting notify_discord_work_item notification for a PullRequest, deriving
# title/branch_name/comments from the caller's already-fetched pr_json rather than each of
# oneshot's four "PR parked waiting on something external" call sites re-deriving title and
# headRefName via their own inline `jq` expressions (#1375 review) — title+branch_name are
# extracted in a single jq call (rather than one each) since both are plain scalars; comments
# stays a separate call so its JSON array output is never squeezed through @tsv's row format.
# Arguments: item_id, pr_json, item_priority (the priorities feed's own numeric rank — passed
# straight through to notify_discord_work_item, same as its own priority_rank argument),
# progress_text (free text for the Progress field, e.g. "Waiting on CI"/"Waiting on human
# review"). Also runs discover_or_create_workflow_project first, idempotent/cached, same as every
# other call site in this codebase that needs _WF_PROJECT_ID populated before a Discord
# notification can report a real Sub-status instead of "Unknown" (#1136).
notify_discord_pr_waiting() {
    local item_id="$1" pr_json="$2" item_priority="$3" progress_text="$4"
    local title branch_name
    IFS=$'\t' read -r title branch_name < <(printf '%s' "${pr_json}" | jq -r '[.title // "", .headRefName // ""] | @tsv')
    discover_or_create_workflow_project
    notify_discord_work_item "waiting" "PullRequest" "${item_id}" \
        "${title}" "${item_priority}" "${branch_name}" "${progress_text}" "" \
        "$(printf '%s' "${pr_json}" | jq -c '.comments // []')"
}

# Builds the markdown item-breakdown for notify_discord_no_work's embed description: one line
# per item, e.g. "- [Issue #42 in owner/repo](url): unchanged - skipping", truncated to stay
# under Discord's 4096-character embed-description cap (#1291). Arguments: items_json (JSON
# array of {type,id,repo,reason} objects, as produced by serialize_item_status_log). Reserves
# headroom below the cap for a trailer line so any dropped tail is stated, never silently
# dropped ("... and N more (see the journal for full detail)"). Stops building lines (including
# skipping the build_item_url call) as soon as the budget is exhausted, rather than building
# every line up front and discarding the tail, so a large items_json does not pay for work whose
# result is guaranteed to be thrown away (#1291 review).
# Outputs nothing (not even a trailing newline) when items_json is empty or "[]".
_build_no_work_item_breakdown() {
    local items_json="$1"
    # Single jq pass over items_json: the total item count is derived from counting these rows
    # rather than a separate `jq length` call (#1291 review).
    local tsv_rows
    tsv_rows=$(printf '%s' "${items_json}" | jq -r '.[] | [.type, .id, .repo, .reason] | @tsv' 2>/dev/null)
    [ -n "${tsv_rows}" ] || return 0
    local total
    total=$(printf '%s\n' "${tsv_rows}" | wc -l)

    # Budget leaves headroom under Discord's 4096-char cap for the trailer line below.
    local budget=3900
    local -a kept_lines=()
    local type id repo reason url line used=0 line_len
    while IFS=$'\t' read -r type id repo reason; do
        url="$(build_item_url "${type}" "${id}" "${repo}")"
        line="- [${type} #${id} in ${repo}](${url}): ${reason}"
        line_len=$(( ${#line} + 1 ))   # +1 for the joining newline
        [ "$(( used + line_len ))" -le "${budget}" ] || break
        kept_lines+=("${line}")
        used=$(( used + line_len ))
    done <<< "${tsv_rows}"

    local description
    description=$(printf '%s\n' "${kept_lines[@]+"${kept_lines[@]}"}")
    if [ "${#kept_lines[@]}" -lt "${total}" ]; then
        description="${description}
... and $(( total - ${#kept_lines[@]} )) more (see the journal for full detail)"
    fi
    printf '%s' "${description}"
}

# Sends a Discord notification when no actionable work items are found.
# Arguments: owner (optional), count_blocked, count_unchanged, count_active_repo, count_not_open,
# count_error, count_human_driven, items_json (optional, JSON array of {type,id,repo,reason}
# objects from serialize_item_status_log — defaults to "[]")
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
# Suppresses duplicate messages: if the same title+breakdown was sent within the last hour, it is
# silently dropped.  A changed title or breakdown is always sent immediately.  At most one send
# per hour per owner even when the content is identical.
notify_discord_no_work() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local owner="${1:-}"
    local count_blocked="${2:-0}"
    local count_unchanged="${3:-0}"
    local count_active_repo="${4:-0}"
    local count_not_open="${5:-0}"
    local count_error="${6:-0}"
    local count_human_driven="${7:-0}"
    local items_json="${8:-[]}"
    local prefix title detail description payload
    if [ -n "${owner}" ]; then
        prefix="[${owner}] "
    else
        prefix=""
    fi
    title="${prefix}No actionable work items found."
    detail=""
    [ "${count_blocked}" -gt 0 ]     && detail="${detail:+${detail}, }blocked: ${count_blocked}"
    [ "${count_unchanged}" -gt 0 ]   && detail="${detail:+${detail}, }unchanged: ${count_unchanged}"
    [ "${count_active_repo}" -gt 0 ] && detail="${detail:+${detail}, }repo-active: ${count_active_repo}"
    [ "${count_not_open}" -gt 0 ]    && detail="${detail:+${detail}, }not-open: ${count_not_open}"
    [ "${count_error}" -gt 0 ]       && detail="${detail:+${detail}, }errors: ${count_error}"
    [ "${count_human_driven}" -gt 0 ] && detail="${detail:+${detail}, }human-driven: ${count_human_driven}"
    [ -n "${detail}" ] && title="${title} (${detail})"

    description="$(_build_no_work_item_breakdown "${items_json}")"

    # Dedup key is a hash of title+description, not the raw text (#1291): the breakdown can now
    # be multi-line and much larger than the old single-line content message, so storing it
    # verbatim in the state file would be wasteful and harder to compare reliably.
    local dedup_hash
    dedup_hash=$(printf '%s\n%s' "${title}" "${description}" | hash_sha256) \
        || { warn "Discord: failed to hash no-work notification for dedup"; return 0; }

    local state_file now last_hash last_sent elapsed
    state_file=$(_discord_dedup_state_file no_work "${owner}")
    now=$(date +%s)
    if [ -f "${state_file}" ]; then
        last_hash=$(sed -n '1p' "${state_file}" 2>/dev/null || true)
        last_sent=$(sed -n '2p' "${state_file}" 2>/dev/null || true)
        if [ "${last_hash}" = "${dedup_hash}" ] && \
           printf '%s' "${last_sent}" | grep -qE '^[0-9]+$'; then
            elapsed=$(( now - last_sent ))
            [ "${elapsed}" -lt 3600 ] && return 0
        fi
    fi

    payload=$(jq --null-input \
        --argjson color 3447003 \
        --arg title "${title}" \
        --arg description "${description}" \
        '{embeds:[{title:$title,description:$description,color:$color}]}') \
        || { warn "Discord: failed to build no-work payload"; return 0; }
    curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1 \
        || warn "Discord webhook notification failed"

    mkdir -p "${HOME}/.orchestrator" 2>/dev/null || true
    printf '%s\n%s\n' "${dedup_hash}" "${now}" > "${state_file}"
}

# disk_space_available_kb and check_disk_space are declared in lib/core.

# Builds the per-owner dedup state-file path for a notification key (e.g. "low_disk_space",
# "priorities_unreachable"). Falls back to a shared "_global" file when no owner is given;
# slashes in the owner name are flattened so it can't create subdirectories.
_discord_dedup_state_file() {
    local key="$1" owner_slug="${2:-_global}"
    owner_slug="${owner_slug//\//_}"
    printf '%s' "${HOME}/.orchestrator/.${key}_${owner_slug}.state"
}

# Returns success (allowed to send) unless state_file records a send within the last hour.
# Arguments: state_file, now (unix timestamp — shared with _discord_send_and_record so both
# calls in a single notify_discord_* invocation agree on "now" without forking `date` twice).
_discord_dedup_allowed() {
    local state_file="$1" now="$2" last_sent elapsed
    [ -f "${state_file}" ] || return 0
    read -r last_sent < "${state_file}" 2>/dev/null
    [[ "${last_sent}" =~ ^[0-9]+$ ]] || return 0
    elapsed=$(( now - last_sent ))
    [ "${elapsed}" -lt 3600 ] && return 1
    return 0
}

# Posts payload to DISCORD_WEBHOOK_URL and, only on success, records the given value verbatim in
# state_file so a later call can compare against it. A failed post must NOT be recorded —
# otherwise a Discord-webhook outage coincident with the condition being reported would silently
# suppress retries of an alert that never actually reached anyone. Named for its original callers
# (a time-window dedup, so the recorded value is "now", a unix timestamp — see
# _discord_dedup_allowed above), but the third argument is written as-is with no interpretation,
# so a content-hash-latch caller (notify_discord_work_item's "waiting" branch — #1375) can pass a
# hash instead and compare it directly on its own next call, rather than every caller needing its
# own hand-rolled curl-then-record.
_discord_send_and_record() {
    local payload="$1" state_file="$2" now="$3"
    if curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1; then
        mkdir -p "${HOME}/.orchestrator" 2>/dev/null || true
        printf '%s\n' "${now}" > "${state_file}"
    else
        warn "Discord webhook notification failed"
    fi
}

# Sends a Discord embed notification when disk space is below MIN_DISK_SPACE_KB.
# Deduplicates: at most one notification per hour per owner.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_low_disk_space() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local owner="${1:-}"

    local available_kb available_gb threshold_gb
    available_kb=$(disk_space_available_kb)
    available_gb=$(( ${available_kb:-0} / 1024 / 1024 ))
    threshold_gb=$(( MIN_DISK_SPACE_KB / 1024 / 1024 ))

    local state_file now
    state_file=$(_discord_dedup_state_file low_disk_space "${owner}")
    now=$(date +%s)
    _discord_dedup_allowed "${state_file}" "${now}" || return 0

    local payload
    payload=$(jq --null-input \
        --argjson color 15158332 \
        --arg title "Low Disk Space${owner:+ [${owner}]}" \
        --argjson available_gb "${available_gb}" \
        --argjson threshold_gb "${threshold_gb}" \
        '{embeds:[{title:$title,color:$color,fields:[
            {name:"Available",value:("\($available_gb) GB"),inline:true},
            {name:"Minimum Required",value:("\($threshold_gb) GB"),inline:true}
        ]}]}') \
        || { warn "Discord: failed to build low disk space payload"; return 0; }

    _discord_send_and_record "${payload}" "${state_file}" "${now}"
}

# Sends a Discord embed notification when oneshot detects its OWN checkout is behind
# origin/main — install-timer's self-update ExecStartPre steps are '-'-prefixed (tolerate
# failure, #1098), so a permanently wedged merge (e.g. a stale git lock left by a killed process,
# #1298) is otherwise swallowed silently forever. Deduplicates per owner: at most one
# notification per hour, same as notify_discord_low_disk_space.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_self_update_stale() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local owner="${1:-}" head_sha="${2}" behind_count="${3}"

    local state_file now
    state_file=$(_discord_dedup_state_file self_update_stale "${owner}")
    now=$(date +%s)
    _discord_dedup_allowed "${state_file}" "${now}" || return 0

    local payload
    payload=$(jq --null-input \
        --argjson color 15158332 \
        --arg title "Self-Update Stale${owner:+ [${owner}]}" \
        --arg head_sha "${head_sha}" \
        --argjson behind "${behind_count}" \
        '{embeds:[{title:$title,color:$color,fields:[
            {name:"Running commit",value:$head_sha,inline:true},
            {name:"Commits behind origin/main",value:($behind|tostring),inline:true}
        ]}]}') \
        || { warn "Discord: failed to build self-update-stale payload"; return 0; }

    _discord_send_and_record "${payload}" "${state_file}" "${now}"
}

# Sends a Discord embed notification when fetch_all_priorities exhausts all retry attempts,
# i.e. the priorities API itself is unreachable, distinct from a single item's GitHub calls
# failing. Without this, a sustained priorities-API outage dies loudly in the journal but
# produces no visible alert, so an outage can run for hours with nobody notified (#1171).
# Arguments: owner (optional, included in the alert title only)
# Deduplicates: at most one notification per hour, shared across all owners — PRIORITIES_URL is
# a single global endpoint, so an outage isn't scoped per-owner the way disk space is.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure — a Discord outage
# must never prevent the caller's own die() from firing.
notify_discord_priorities_unreachable() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local owner="${1:-}"

    # Dedup on a single shared key, not per-owner: PRIORITIES_URL is one global endpoint, so an
    # outage affecting every owner running concurrently must produce one alert, not a flood of
    # one per owner.
    local state_file now
    state_file=$(_discord_dedup_state_file priorities_unreachable)
    now=$(date +%s)
    _discord_dedup_allowed "${state_file}" "${now}" || return 0

    local payload
    payload=$(jq --null-input \
        --argjson color 15158332 \
        --arg title "Priorities API Unreachable${owner:+ [${owner}]}" \
        --arg url "${PRIORITIES_URL}" \
        --argjson attempts "${PRIORITIES_FETCH_RETRY_ATTEMPTS}" \
        '{embeds:[{title:$title,color:$color,fields:[
            {name:"URL",value:$url,inline:false},
            {name:"Attempts",value:($attempts|tostring),inline:true}
        ]}]}') \
        || { warn "Discord: failed to build priorities-unreachable payload"; return 0; }

    _discord_send_and_record "${payload}" "${state_file}" "${now}"
}

# blocked_marker_file_path and clear_blocked_marker are declared in lib/state.

# Sends a Discord embed notification when an item is found to be blocked.
# Arguments: item_type (Issue|PullRequest), item_id, reason (optional)
# Notifies only on the transition into the blocked state: a per-item marker file
# suppresses repeat notifications while the item stays blocked. clear_blocked_marker
# re-arms it once the item is observed un-blocked.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
# Priority/Sub-status are derived from already-tracked GitHub state, not a Claude invocation
# (#1136). Unlike notify_discord_work_item, this function's ~12 call sites mostly don't have
# the item's labels/title JSON already in scope, so it fetches them itself — the marker-file
# early-return above means that fetch only ever happens once per NEW blocked spell, not every
# tick a blocked item is (re-)observed.
# The title uses the item's actual title text, not just "Issue #67" — a bare number tells a
# human nothing without clicking through (#1140). The embed also carries a Reason field:
# callers that already know why (oneshot's own blocking paths) pass it explicitly; callers that
# only OBSERVE a label already applied (e.g. by the agent's own session on a prior tick) fall
# back to the item's most recent comment as a best-effort excerpt — reliable so long as the
# agent follows the "always explain a block in the same turn" mandatory rule in build_issue_
# claude_md/build_pr_claude_md, since that comment is then the last thing posted before the
# label landed (#1140).
notify_discord_blocked_item() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local item_type="$1" item_id="$2" reason="${3:-}"
    local url payload marker_file gh_noun item_json item_title labels_json substatus priority truncated_reason

    marker_file=$(blocked_marker_file_path "${item_type}" "${item_id}")
    # Already notified for this blocked spell — stay silent until re-armed.
    [ -f "${marker_file}" ] && return 0

    url="$(build_item_url "${item_type}" "${item_id}")"

    gh_noun=$(gh_noun_for_item_type "${item_type}")
    item_json=$(gh "${gh_noun}" view "${item_id}" --repo "${REPO_FULL}" --json title,labels,comments 2>/dev/null)
    item_title=$(printf '%s' "${item_json}" | jq -r '.title // empty' 2>/dev/null)
    [ -n "${item_title}" ] || item_title="${item_type} #${item_id}"
    # Discord embed titles are capped at 256 characters; "Blocked: " adds 9, so keep the raw
    # title itself well under that (240) — a GitHub issue/PR title can run close to GitHub's
    # own ~256-char limit, and without this curl --fail would reject the whole payload with a
    # 4xx, yet the blocked-marker file is still written unconditionally afterward, permanently
    # suppressing any notification for this blocked spell (#1140 review). Sliced via jq (codepoint-
    # aware) rather than bash's byte-offset ${var:0:N}, which can split a multi-byte UTF-8
    # character in half under a non-UTF-8 locale and corrupt the title (#1140 review).
    item_title=$(printf '%s' "${item_title}" | jq -Rsr '.[0:240]' 2>/dev/null)
    labels_json=$(printf '%s' "${item_json}" | jq -c '.labels // []' 2>/dev/null)
    [ -n "${labels_json}" ] || labels_json="[]"
    priority=$(priority_for_labels "${labels_json}")
    substatus=$(board_substatus_for_item "${item_id}")

    if [ -z "${reason}" ]; then
        reason=$(printf '%s' "${item_json}" | jq -r '(.comments // []) | last | .body // empty' 2>/dev/null)
        [ -n "${reason}" ] || reason="No reason found in the automation's own comments — check the item's labels and comment history on GitHub."
    fi
    # Same codepoint-aware slicing as item_title above, and for the same reason (#1140 review).
    truncated_reason=$(printf '%s' "${reason}" | jq -Rsr '.[0:900]' 2>/dev/null)

    payload=$(jq --null-input \
        --argjson color 15158332 \
        --arg title "Blocked: ${item_title}" \
        --arg url "${url}" \
        --arg repo "${REPO_FULL}" \
        --arg type "${item_type}" \
        --arg priority "${priority}" \
        --arg substatus "${substatus}" \
        --arg reason "${truncated_reason}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:[
            {name:"Repository",value:$repo,inline:true},
            {name:"Type",value:$type,inline:true},
            {name:"Priority",value:$priority,inline:true},
            {name:"Status",value:"Blocked",inline:true},
            {name:"Sub-status",value:$substatus,inline:true},
            {name:"Reason",value:$reason,inline:false}
        ]}]}') \
        || { warn "Discord: failed to build blocked payload for ${item_type} #${item_id}"; return 0; }

    curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1 \
        || warn "Discord webhook notification failed"

    # Record that this blocked spell has been notified, so the next run is silent.
    mkdir -p "${SESSION_BASE_DIR}" 2>/dev/null || true
    printf '%s\n' "blocked" > "${marker_file}" 2>/dev/null || true
}

# Sends a Discord embed notification when a PR is settled (auto-merge armed, nothing
# failed/pending — see pr_json_is_terminal) but reviewDecision is REVIEW_REQUIRED: the PR is
# mergeable in every way except a missing human approval, whether that approval was dismissed by
# a later force-push or never requested at all. Without this the PR sits invisibly "complete"
# indefinitely — oneshot correctly declines to waste an agent invocation on it, but nothing tells
# a human it is waiting (#1278).
# Arguments: item_id, pr_json (the pre-fetched PR JSON, so the title is extracted here rather
# than by every caller — see below)
# Uses the REPO_FULL global (set by set_repo_context) for both the URL and the Repository field,
# matching every other per-item notifier in this file (e.g. notify_discord_blocked_item).
# Deduplicates like notify_discord_low_disk_space/notify_discord_priorities_unreachable: at most
# one notification per hour. Scoped per-repo-and-PR (not per-owner) so two different PRs, or the
# same PR number in two different repos, never suppress each other's alert. Checked before the
# title is extracted, so a `jq` fork over pr_json is only ever paid on ticks that actually send —
# every other tick this fires on (Discord unconfigured, or the once-an-hour dedup window not yet
# open) returns early with no extra work (#1278 review).
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_pr_needs_approval() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local item_id="$1" pr_json="$2"

    local state_file now
    state_file=$(_discord_dedup_state_file pr_needs_approval "${REPO_FULL}/${item_id}")
    now=$(date +%s)
    _discord_dedup_allowed "${state_file}" "${now}" || return 0

    local item_title url payload
    item_title=$(printf '%s' "${pr_json}" | jq -r '.title // empty' 2>/dev/null)
    [ -n "${item_title}" ] || item_title="PullRequest #${item_id}"
    # Same codepoint-aware slicing/reasoning as notify_discord_blocked_item's item_title, and for
    # the same reason: an embed title over Discord's 256-char cap makes curl --fail reject the
    # whole payload (#1140 review).
    item_title=$(printf '%s' "${item_title}" | jq -Rsr '.[0:240]' 2>/dev/null)
    url="$(build_item_url "PullRequest" "${item_id}")"

    payload=$(jq --null-input \
        --argjson color 15844367 \
        --arg title "Needs Approval: ${item_title}" \
        --arg url "${url}" \
        --arg repo "${REPO_FULL}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:[
            {name:"Repository",value:$repo,inline:true},
            {name:"Reason",value:"Auto-merge is armed and all required checks pass, but this PR has no approving review — it cannot merge until a human approves it.",inline:false}
        ]}]}') \
        || { warn "Discord: failed to build pr-needs-approval payload for PR #${item_id}"; return 0; }

    _discord_send_and_record "${payload}" "${state_file}" "${now}"
}

# Sends a Discord embed notification when Claude returns an application-level error.
# Arguments: item_type (Issue|PullRequest|empty), item_id (numeric|empty), error_message
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_claude_error() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local item_type="${1:-}" item_id="${2:-}" error_message="$3"
    local url payload

    url="$(build_item_url "${item_type}" "${item_id}")"

    # Truncate to stay within Discord's 1024-character field limit.
    local truncated_error="${error_message:0:900}"

    payload=$(jq --null-input \
        --argjson color 15158332 \
        --arg title "Claude Error: ${REPO_FULL}" \
        --arg url "${url}" \
        --arg error "${truncated_error}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:[
            {name:"Error",value:$error,inline:false}
        ]}]}') \
        || { warn "Discord: failed to build claude error payload"; return 0; }

    curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1 \
        || warn "Discord webhook notification failed"
}

# Sends a Discord embed notification listing tool calls Claude Code denied during a run
# (parsed from the result JSON's permission_denials array by handle_claude_permission_denials
# in lib/podman - see that function's own comment for what can currently produce a denial).
# Arguments: item_type (Issue|PullRequest|empty), item_id (numeric|empty),
#            summary (multi-line "- tool: detail" text, already built by the caller),
#            denials_count (total number of denials the summary was built from)
# Deduplicates like notify_discord_pr_needs_approval: at most one notification per repo per
# hour. Deliberate noise trade-off, not an oversight - a run that denies the same command
# repeatedly (e.g. a stuck retry loop) would otherwise flood the channel with one near-identical
# embed per invocation. A distinct denial arriving inside that same hour is still visible in
# the warn() log line even while the Discord alert itself is suppressed.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_permission_denials() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local item_type="${1:-}" item_id="${2:-}" summary="$3" denials_count="${4:-?}"

    local state_file now
    state_file=$(_discord_dedup_state_file permission_denials "${REPO_FULL}")
    now=$(date +%s)
    _discord_dedup_allowed "${state_file}" "${now}" || return 0

    local url payload
    url="$(build_item_url "${item_type}" "${item_id}")"

    # Truncate to stay within Discord's 1024-character field limit. Sliced via jq (codepoint-
    # aware) rather than bash's byte-offset ${var:0:N}, which can split a multi-byte UTF-8
    # character in half under a non-UTF-8 locale and corrupt the field - same failure mode and
    # same fix as notify_discord_blocked_item's item_title above (#1140 review). The summary
    # here is built from arbitrary command text and file paths (tool_input.command/.file_path),
    # exactly the kind of content that can legitimately contain multi-byte UTF-8.
    local truncated_summary
    truncated_summary=$(printf '%s' "${summary}" | jq -Rsr '
        if (length > 900) then .[0:900] + "\n... (truncated; see the run log for the full list)"
        else . end
        ' 2>/dev/null) \
        || { warn "Discord: failed to build permission-denials payload"; return 0; }

    # Same 240-char title cap as notify_discord_blocked_item/notify_discord_pr_needs_approval,
    # for the same reason: an embed title over Discord's 256-char limit makes curl --fail reject
    # the whole payload. REPO_FULL is always a short owner/repo slug in practice, but the cap
    # costs nothing and keeps this function honouring the same defensive pattern as its siblings.
    local title
    title=$(printf '%s' "Permission Denials (${denials_count}): ${REPO_FULL}" | jq -Rsr '.[0:240]' 2>/dev/null)

    payload=$(jq --null-input \
        --argjson color 16776960 \
        --arg title "${title}" \
        --arg url "${url}" \
        --arg summary "${truncated_summary}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:[
            {name:"Denied tool calls",value:$summary,inline:false}
        ]}]}') \
        || { warn "Discord: failed to build permission-denials payload"; return 0; }

    _discord_send_and_record "${payload}" "${state_file}" "${now}"
}

# Sends a Discord embed notification when Claude returns a rate-limit error (HTTP 429).
# Arguments: item_type (Issue|PullRequest|empty), item_id (numeric|empty),
#            error_message, reset_unix (unix timestamp, may be empty)
# When reset_unix is provided, includes a Discord timestamp field showing when
# the limit resets in the user's local timezone.
# Silent when DISCORD_WEBHOOK_URL is unset; logs a warning on curl failure.
notify_discord_rate_limited() {
    [ -n "${DISCORD_WEBHOOK_URL}" ] || return 0
    local item_type="${1:-}" item_id="${2:-}" error_message="$3" reset_unix="${4:-}"
    local url payload reset_display truncated_error

    url="$(build_item_url "${item_type}" "${item_id}")"

    truncated_error="${error_message:0:900}"

    # Discord timestamp markup: <t:UNIX:t> = local time, <t:UNIX:R> = relative
    if [ -n "${reset_unix}" ]; then
        reset_display="<t:${reset_unix}:t> (<t:${reset_unix}:R>)"
    else
        reset_display=""
    fi

    payload=$(jq --null-input \
        --argjson color 16776960 \
        --arg title "Rate Limited: ${REPO_FULL}" \
        --arg url "${url}" \
        --arg error "${truncated_error}" \
        --arg reset "${reset_display}" \
        '{embeds:[{title:$title,url:$url,color:$color,fields:(
            [{name:"Error",value:$error,inline:false}] +
            (if $reset != "" then [{name:"Resets",value:$reset,inline:true}] else [] end)
        )}]}') \
        || { warn "Discord: failed to build rate-limit payload"; return 0; }

    curl --silent --fail --max-time 5 \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "${DISCORD_WEBHOOK_URL}" > /dev/null 2>&1 \
        || warn "Discord webhook notification failed"
}
