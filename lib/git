# shellcheck shell=bash
# Per-repo context and git plumbing: resolving the OWNER/REPO/REPO_FULL globals, host<->
# container path mapping, and the git operations that keep the local checkout current.

# Maps a host file path to its container-internal equivalent.
# Paths under REPO_WORK_DIR map to CONTAINER_REPO_PATH; paths under RULES_DIR
# map to CONTAINER_RULES_PATH.  Unrecognised paths are returned unchanged.
host_to_container_path() {
    local host_path="$1"
    local rel
    if [ -n "${REPO_WORK_DIR}" ]; then
        rel="${host_path#"${REPO_WORK_DIR}"}"
        if [ "${rel}" != "${host_path}" ]; then
            printf '%s%s' "${CONTAINER_REPO_PATH}" "${rel}"
            return
        fi
    fi
    if [ -n "${RULES_DIR}" ]; then
        rel="${host_path#"${RULES_DIR}"}"
        if [ "${rel}" != "${host_path}" ]; then
            printf '%s%s' "${CONTAINER_RULES_PATH}" "${rel}"
            return
        fi
    fi
    printf '%s' "${host_path}"
}

# Sets the per-repo globals used by all sub-functions.
# Call once for each repository before invoking any function that reads these globals.
set_repo_context() {
    local repo_full="$1"
    OWNER="${repo_full%%/*}"
    REPO="${repo_full##*/}"
    REPO_FULL="${repo_full}"
    RULES_DIR="${WORK}/${OWNER}/${REPO}/rules"
    REPO_WORK_DIR="${WORK}/${OWNER}/${REPO}/repo"
    SESSION_BASE_DIR="${HOME}/.orchestrator/${OWNER}/${REPO}"
    # Host-side persistent store for the parts of the container's ~/.claude that
    # must survive across invocations (sessions, session-env, plans, cache,
    # backups). Nested under SESSION_BASE_DIR so state stays scoped per-repo,
    # matching how fingerprint/resume-session bookkeeping already works above.
    CLAUDE_STATE_DIR="${SESSION_BASE_DIR}/claude"
    # Host-side persistent store backing the container's ~/.cache/orchestrator/global
    # (the cache-gh-lookups hook / entrypoint.sh's gh-user-login cache, #1380): a
    # separate tree from CLAUDE_STATE_DIR above since it mounts under the container's
    # ~/.cache, not ~/.claude, but the same per-owner-per-repo scoping.
    ORCHESTRATOR_CACHE_DIR="${SESSION_BASE_DIR}/orchestrator-cache"
    _TRUSTED_LOGINS_JSON=""
}

# Returns 0 on success, 1 on failure (a transient network blip on the rules repo — unrelated to
# any individual work item — must not die the whole run and throw away every other priority item
# in the cycle, #1090). A stale or absent rules checkout is handled gracefully downstream by
# find_ai_instructions, which already has its own "no .ai-instructions found" fallback.
ensure_rules_current() {
    if [ -d "${RULES_DIR}/.git" ]; then
        info "Updating rules (cs-template) at ${RULES_DIR}..."
        if ! git -C "${RULES_DIR}" checkout main; then
            warn "Failed to switch cs-template to main at ${RULES_DIR}"
            return 1
        fi
        if ! git -C "${RULES_DIR}" pull --ff-only; then
            warn "Failed to update cs-template at ${RULES_DIR}"
            return 1
        fi
    else
        info "Cloning rules (cs-template) to ${RULES_DIR}..."
        if ! mkdir -p "$(dirname "${RULES_DIR}")"; then
            warn "Failed to create parent directory for ${RULES_DIR}"
            return 1
        fi
        if ! git clone git@github.com:credfeto/cs-template.git "${RULES_DIR}"; then
            warn "Failed to clone cs-template to ${RULES_DIR}"
            return 1
        fi
    fi
}

# Remove any url.*.insteadOf / url.*.pushInsteadOf rules from the local .git/config.
# The agent running inside the container may write these (e.g. via `gh auth setup-git`)
# and they persist across sessions through the bind mount.  The container entrypoint
# rejects them on startup because they are only allowed in the system /etc/gitconfig.
clean_local_git_url_rewrites() {
    local repo_dir="${1:-${REPO_WORK_DIR}}"
    [ -d "${repo_dir}/.git" ] || return 0
    local key
    while IFS= read -r key; do
        [ -z "${key}" ] && continue
        git -C "${repo_dir}" config --local --unset-all "${key}" 2>/dev/null || true
    done < <(git -C "${repo_dir}" config --local --name-only --list 2>/dev/null \
        | grep -iE '\.(insteadof|pushinsteadof)$' || true)
}

# Returns 0 on success. Returns 1 for a dirty/orphaned working tree — the existing "hand off to
# agent to recover" signal. Returns 2 for a transient git-fetch failure specifically: unlike a
# dirty tree, there is nothing for the agent to recover from a network blip, so the caller must
# skip the item entirely rather than burning an agent invocation on stale local state (#1090).
ensure_repo_current() {
    if [ -d "${REPO_WORK_DIR}/.git" ]; then
        # Reset the remote URL to SSH on every iteration. The agent running inside
        # the container may have changed the URL or added extra fetch/push URLs.
        # --unset-all removes every entry (--unset silently fails when multiple
        # values exist), then we write exactly one correct URL for each slot.
        clean_local_git_url_rewrites "${REPO_WORK_DIR}"
        git -C "${REPO_WORK_DIR}" config --unset-all remote.origin.url 2>/dev/null || true
        git -C "${REPO_WORK_DIR}" config remote.origin.url "git@github.com:${OWNER}/${REPO}.git"
        git -C "${REPO_WORK_DIR}" config --unset-all remote.origin.pushurl 2>/dev/null || true
        info "Fetching latest changes for ${REPO_FULL}..."
        if ! git -C "${REPO_WORK_DIR}" fetch --prune origin; then
            warn "Failed to fetch from origin for ${REPO_FULL}"
            return 2
        fi

        local current_branch
        current_branch=$(git -C "${REPO_WORK_DIR}" branch --show-current)
        if ! git -C "${REPO_WORK_DIR}" diff --quiet || ! git -C "${REPO_WORK_DIR}" diff --cached --quiet; then
            DIRTY_BRANCH="${current_branch}"
            warn "Working tree has uncommitted changes on '${current_branch}' for ${REPO_FULL} — handing off to agent to recover"
            return 1
        fi
        if [ "${current_branch}" != "main" ] \
                && ! git -C "${REPO_WORK_DIR}" rev-parse --verify "refs/remotes/origin/${current_branch}" >/dev/null 2>&1; then
            warn "Branch '${current_branch}' no longer exists on origin for ${REPO_FULL} — returning to main"
            git -C "${REPO_WORK_DIR}" checkout main \
                || die "Failed to switch to main after orphaned branch '${current_branch}' for ${REPO_FULL}"
            current_branch="main"
        fi
        if [ "${current_branch}" = "main" ]; then
            info "Rebasing main with origin/main..."
            git -C "${REPO_WORK_DIR}" rebase origin/main || die "Failed to rebase main with origin/main"
        fi
    else
        info "Cloning ${REPO_FULL} to ${REPO_WORK_DIR}..."
        mkdir -p "$(dirname "${REPO_WORK_DIR}")" || die "Failed to create parent directory for ${REPO_WORK_DIR}"
        git clone "git@github.com:${OWNER}/${REPO}.git" "${REPO_WORK_DIR}" || die "Failed to clone ${REPO_FULL} to ${REPO_WORK_DIR}"
    fi
}

# Returns 0 if the repo was on a branch that no longer exists on origin AND has been
# reset to main; returns 1 in all other cases (repo absent, already on main, branch still
# live on remote, or any git failure).  Performs its own fetch --prune because it is
# called before ensure_repo_current in the fingerprint-skip path.
recover_orphaned_branch() {
    [ -d "${REPO_WORK_DIR}/.git" ] || return 1

    local current_branch
    current_branch=$(git -C "${REPO_WORK_DIR}" branch --show-current 2>/dev/null) || return 1
    [ "${current_branch}" = "main" ] && return 1

    git -C "${REPO_WORK_DIR}" fetch --prune origin 2>/dev/null || return 1

    git -C "${REPO_WORK_DIR}" rev-parse --verify "refs/remotes/origin/${current_branch}" >/dev/null 2>&1 \
        && return 1

    # checkout -f below has no dirty-tree check of its own — warn first so a discarded branch's
    # work leaves a trace a human could search for (#1281).
    local dirty_status
    dirty_status=$(git -C "${REPO_WORK_DIR}" status --porcelain --untracked-files=normal 2>/dev/null)
    if [ -n "${dirty_status}" ]; then
        warn "Branch '${current_branch}' for ${REPO_FULL} is orphaned (no longer exists on origin) AND has uncommitted changes that are about to be discarded by the recovery below — this usually means a prior session's commit never landed (e.g. its backgrounding attempt was denied by a container hook and misread as still running, #1281). Files affected:
$(printf '%s' "${dirty_status}" | head -20)"
    fi

    warn "Branch '${current_branch}' no longer exists on origin for ${REPO_FULL} — returning to main"
    git -C "${REPO_WORK_DIR}" checkout -f main \
        || die "Failed to switch to main after orphaned branch '${current_branch}' for ${REPO_FULL}"
    git -C "${REPO_WORK_DIR}" rebase origin/main \
        || die "Failed to rebase origin/main after orphaned branch recovery for ${REPO_FULL}"
    return 0
}

# Outputs the boundary-safe regex matching this repo's issue-branch naming convention
# (<type>/<issue-number>, optionally followed by "-<slug>") for the given issue number. Single
# source of truth shared by find_stale_issue_branch below (matched in bash against local git
# refs) and find_human_taken_over_pr_for_issue (lib/github, matched via jq against a PR's
# headRefName) so the convention has exactly one definition instead of two that can silently
# drift (#1262 review). "([^0-9]|$)" requires a non-digit or end-of-string right after the issue
# number, so neither a shorter number embedded inside a longer one (issue 439 vs branch
# chore/4390-foo) nor a longer number with extra leading digits (issue 439 vs branch
# chore/1439-foo) can match.
issue_branch_regex() {
    printf '^[A-Za-z]+/%s([^0-9]|$)' "$1"
}

# Detects a branch on origin matching issue_branch_regex for this issue that has commits ahead
# of origin/main — the signature of an agent session that pushed work for this issue and then
# died before opening a pull request (#1262). Performs no fetch of its own: called both from the
# fingerprint-unchanged skip decision (where recover_orphaned_branch has usually just fetched,
# since the local checkout stays off main for as long as this stale branch remains unresolved)
# and, for the authoritative answer, from the work block right after ensure_repo_current's own
# fetch — see oneshot and its "#1262 review" comment for why the second call exists.
# Outputs the branch name (without the "origin/" prefix) and returns 0 when found; returns 1
# when the repo has never been cloned locally, no branch matches the convention, or the only
# match has no commits ahead of origin/main.
find_stale_issue_branch() {
    local issue_id="$1"
    [ -d "${REPO_WORK_DIR}/.git" ] || return 1

    local branch_regex full_branch candidate ahead
    branch_regex=$(issue_branch_regex "${issue_id}")

    while IFS= read -r full_branch; do
        [ -n "${full_branch}" ] || continue
        candidate="${full_branch#origin/}"
        [[ "${candidate}" =~ ${branch_regex} ]] || continue
        ahead=$(git -C "${REPO_WORK_DIR}" rev-list --count "origin/main..${full_branch}" 2>/dev/null) || continue
        [ "${ahead}" -gt 0 ] || continue
        printf '%s' "${candidate}"
        return 0
    done < <(git -C "${REPO_WORK_DIR}" branch -r --format='%(refname:short)' 2>/dev/null)

    return 1
}

# Attempts a non-agentic rebase of branch_name onto origin/main.
# Returns 0 if the rebase succeeded and changes were force-pushed; 1 if any
# conflict was encountered or if the push failed. Always leaves the working
# tree on main.
try_nonagentic_rebase() {
    local branch_name="$1"

    [ -n "${branch_name}" ] || return 1

    clean_local_git_url_rewrites "${REPO_WORK_DIR}"
    git -C "${REPO_WORK_DIR}" config --unset-all remote.origin.url 2>/dev/null || true
    git -C "${REPO_WORK_DIR}" config remote.origin.url "git@github.com:${OWNER}/${REPO}.git"
    git -C "${REPO_WORK_DIR}" config --unset-all remote.origin.pushurl 2>/dev/null || true

    if ! git -C "${REPO_WORK_DIR}" checkout "${branch_name}"; then
        git -C "${REPO_WORK_DIR}" checkout main 2>/dev/null || true
        return 1
    fi

    if ! git -C "${REPO_WORK_DIR}" rebase origin/main; then
        git -C "${REPO_WORK_DIR}" rebase --abort 2>/dev/null || true
        git -C "${REPO_WORK_DIR}" checkout main 2>/dev/null || true
        return 1
    fi

    if ! git -C "${REPO_WORK_DIR}" push --force-with-lease; then
        git -C "${REPO_WORK_DIR}" checkout main 2>/dev/null || true
        return 1
    fi

    git -C "${REPO_WORK_DIR}" checkout main 2>/dev/null || true
    return 0
}

# Outputs the path to the .ai-instructions file for the current repo context.
# Returns 1 (with a warning) if neither the repo work dir nor the rules dir has the file.
find_ai_instructions() {
    if [ -f "${REPO_WORK_DIR}/.ai-instructions" ]; then
        printf '%s/.ai-instructions' "${REPO_WORK_DIR}"
    elif [ -f "${RULES_DIR}/.ai-instructions" ]; then
        printf '%s/.ai-instructions' "${RULES_DIR}"
    else
        warn "No .ai-instructions found at ${REPO_WORK_DIR}/.ai-instructions or ${RULES_DIR}/.ai-instructions"
        return 1
    fi
}

# Returns the number of commits `upstream` has that `ref` doesn't (git rev-list --count
# ref..upstream) on stdout. Used by oneshot to detect its OWN checkout falling behind
# origin/main — install-timer's ExecStartPre self-update steps are deliberately '-'-prefixed
# (tolerate failure, #1098), so a merge that gets permanently wedged (e.g. a stale lock file left
# by a killed git process, #1298) is otherwise swallowed silently forever with nothing surfacing
# it. Returns 1 with no output if the count could not be determined — e.g. `upstream` doesn't
# exist because a fetch has never succeeded — callers must treat that as INCONCLUSIVE, never as
# "definitely stale", so a checkout that has simply never fetched yet is not wrongly refused.
git_commits_behind() {
    local repo_dir="$1" ref="$2" upstream="$3"
    local count
    count=$(git -C "${repo_dir}" rev-list --count "${ref}..${upstream}" 2>/dev/null) || return 1
    [[ "${count}" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "${count}"
}
