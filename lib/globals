# shellcheck shell=bash
# Global state for oneshot: config env-var defaults, mutable counters, and the associative-array
# caches used by the Workflow-board functions in lib/workflow-board.
#
# This file must be sourced FIRST, before any other lib/* file — every other library reads or
# writes globals declared here, and bash requires an associative array to be `declare -A`'d
# before any assignment into it. Declarations only: no function definitions, no I/O, no command
# calls.

PRIORITIES_URL="https://git-workflow.markridgwell.com/priorities"
WORK="${XDG_PROJECTS_DIR:-${HOME}/work}"
ORCHESTRATOR_IMAGE="${ORCHESTRATOR_IMAGE:-ghcr.io/credfeto/development-agent:latest}"
CONTAINER_REPO_PATH="/workspace/repo"
CONTAINER_RULES_PATH="/workspace/rules"
# A second registered --add-dir, distinct from CONTAINER_REPO_PATH: throwaway per-invocation
# scratch space (mktemp -d on the host, bind-mounted read-write; entrypoint.sh exports
# TMPDIR/TMP/TEMP/XDG_RUNTIME_DIR pointing here, matching this same fixed path as a hardcoded
# default) for the #1351 experiment testing whether Claude Code's own file-write trust
# boundary — independent of permissions.allow — respects --add-dir for redirect targets outside
# the repo checkout. Not one of the persistent sessions/plans/cache/backups state dirs.
CONTAINER_SCRATCH_PATH="/workspace/tmp"

# Bump whenever a field is added to or removed from fingerprint_issue_json or
# fingerprint_pr_json (lib/fingerprints). Prepended to every computed fingerprint so a saved
# fingerprint from a prior schema always compares unequal to a freshly computed one, forcing a
# recheck of every open Issue/PR on the next tick each is seen — a deliberate, one-line way to
# invalidate every cached fingerprint fleet-wide, decoupled from whether the jq filter's output
# text happens to differ (which incidental/cosmetic filter edits could otherwise trigger by
# accident). This is NOT overridable from the environment: it describes what the code hashes,
# not an operational tuning knob.
FINGERPRINT_SCHEMA_VERSION=2

# Conservative pre-send guard against grossly oversized prompts.
# The launch prompt is deliberately tiny ("Work on <item> in <repo>") — everything of
# substance lives in the generated CLAUDE.md — so this cap is only a sanity backstop and
# is NOT the mechanism that prevents "Prompt is too long".  That failure comes from
# accumulated conversation over many turns exceeding the model context window; the
# phase-per-invocation design (fresh session, one phase, then stop) is what bounds it.
MAX_PROMPT_CHARS=100000

# Extra buffer added to the token-reset time before resuming agentic work.
# Avoids hitting the limit again immediately after it lifts.
RATE_LIMIT_RESUME_BUFFER_SECS=3600

# Where unparseable 429 rate-limit messages are reported so parse_reset_time can be extended.
RATE_LIMIT_ISSUE_REPO="credfeto/credfeto-orchestrator"
RATE_LIMIT_ISSUE_TITLE="Unparseable Claude rate-limit reset time"

# Title of the issue filed in an affected repo when the orchestrator cannot obtain a
# usable "Workflow" project for it (see report_missing_workflow_project).  A bot account
# cannot create a project under a personal account, so the owner must run create-project.
WF_SETUP_ISSUE_TITLE="Workflow project setup required"

# Hard limit on how long a single agent container may run. Prevents a stuck
# Monitor loop from holding resources indefinitely.
# Override with AGENT_TIMEOUT_MINUTES in the environment before calling oneshot.
AGENT_TIMEOUT_MINUTES="${AGENT_TIMEOUT_MINUTES:-90}"
[[ "${AGENT_TIMEOUT_MINUTES}" =~ ^[1-9][0-9]*$ ]] || AGENT_TIMEOUT_MINUTES=90
AGENT_TIMEOUT_SECS=$(( AGENT_TIMEOUT_MINUTES * 60 ))

# Set by setup_cgroup_leaf; passed as --cgroup-parent to every podman run call.
PODMAN_CGROUP_PARENT=""

# Minimum free disk space in kilobytes required to launch a container (10 GB).
MIN_DISK_SPACE_KB=$(( 10 * 1024 * 1024 ))

# Code review, security review, and coverage each get their own round budget below rather than
# sharing one constant: each round is its own fresh invocation (one /code-review, one
# /security-review, or one coverage round, then stop), so these are advisory guidance passed
# into the prompt rather than in-session loop counters, and each is a backstop only. PHASE E/F
# self-detect non-convergence (this round's findings substantially repeating a prior round's)
# and exit early without blocking, well before their cap is normally reached. PHASE G's exit is
# a branch-coverage percentage trend combined with the agent's own judgement of whether the gap
# is realistically closeable, and unlike PHASE E/F it DOES add the Blocked label when it fires,
# with a mandatory PR comment stating the agent's reasoning: a coverage round's pass/fail IS the
# ratchet's own verdict, so giving up there means proposing to waive the gate itself, not merely
# reporting that no new findings turned up. See lib/prompts for the full per-phase logic.
#
# All four budgets below are regex-validated to a positive integer of at most 6 digits (max
# 999999), not just given a string default: MAX_PR_TOTAL_INVOCATIONS' computed default further
# down does real bash arithmetic on all four, and an unvalidated non-numeric override (an
# operator typo, e.g. MAX_CODE_REVIEW_ITERATIONS=fifteen) would silently evaluate to 0 in that
# arithmetic rather than erroring, quietly shrinking the runaway-invocation backstop; an
# unbounded-magnitude override (syntactically a valid integer, just huge) would instead silently
# overflow bash's 64-bit signed arithmetic into a negative, garbage cap. 999999 is already far
# beyond any realistic round budget, so this never constrains a legitimate override.
#
# Code review (PHASE E). Override with MAX_CODE_REVIEW_ITERATIONS in the environment before
# calling oneshot.
#
# Security review (PHASE F), kept independent of MAX_CODE_REVIEW_ITERATIONS so the two can be
# tuned separately: security review is the last line of defence before merge, with no
# downstream phase re-checking its findings the way code review backstops Simplify. Override
# with MAX_SECURITY_REVIEW_ITERATIONS in the environment before calling oneshot.
#
# Coverage ratchet (PHASE G). Lower than the review budgets above because each round is a full
# test/coverage run, not a review pass. Override with MAX_COVERAGE_ITERATIONS in the environment
# before calling oneshot.
#
# Hard cap on /simplify rounds (PHASE D), separate from the review/security/coverage budgets
# above: Simplify is expected to run more rounds than the other phases and never blocks the PR
# on non-convergence, so it gets its own budget. See SIMPLIFY_THRASH_LIMIT below for the earlier
# exit taken when rounds stop making progress. Override with MAX_SIMPLIFY_ITERATIONS in the
# environment before calling oneshot.
#
# All four share the same "positive integer, capped in magnitude, or fall back to the default"
# validation, looped over a name:default list rather than copy-pasted four times or factored
# into a helper function: this file is declarations-only (its own header above: no function
# definitions, no I/O, no command calls), and lib/core, which owns config load/validate helpers
# elsewhere in this codebase, is sourced only AFTER this file, so a real helper function is not
# available here yet. Indirect assignment is done via `printf -v` (not a nameref/`declare -n`, a
# bash feature this codebase does not otherwise use); `${!_budget_var}` on an unset variable
# expands to an empty string here since this codebase does not run under `set -u`. Accumulates
# _budget_sum as it goes (used below by MAX_PR_TOTAL_INVOCATIONS' computed default) so that sum
# is tied to this same list rather than separately naming all four variables again: adding a
# fifth phase's budget here alone is then enough to fold it into the runaway-invocation backstop
# too, instead of a second edit silently going missing.
_budget_sum=0
for _budget_var_default in \
    "MAX_CODE_REVIEW_ITERATIONS:15" \
    "MAX_SECURITY_REVIEW_ITERATIONS:15" \
    "MAX_COVERAGE_ITERATIONS:6" \
    "MAX_SIMPLIFY_ITERATIONS:10"; do
    _budget_var="${_budget_var_default%%:*}"
    _budget_default="${_budget_var_default#*:}"
    _budget_current="${!_budget_var}"
    [ -n "${_budget_current}" ] || _budget_current="${_budget_default}"
    [[ "${_budget_current}" =~ ^[1-9][0-9]{0,5}$ ]] || _budget_current="${_budget_default}"
    printf -v "${_budget_var}" '%s' "${_budget_current}"
    _budget_sum=$(( _budget_sum + _budget_current ))
done
unset _budget_var_default _budget_var _budget_default _budget_current

# Once this many /simplify rounds have run, a thrashing round (its diff is flat or larger than
# the previous round's, i.e. not shrinking) ends the Simplify phase immediately even though
# MAX_SIMPLIFY_ITERATIONS has not been reached. Override with SIMPLIFY_THRASH_LIMIT in the
# environment before calling oneshot.
SIMPLIFY_THRASH_LIMIT="${SIMPLIFY_THRASH_LIMIT:-3}"

# The mirror image of SIMPLIFY_THRASH_LIMIT above, for PHASE E (code review) and PHASE F
# (security review): the earliest round on which their self-detected non-convergence early exit
# (see _build_review_convergence_block in lib/prompts) is allowed to fire at all. A "this round's
# findings substantially repeat an earlier round" verdict on round 2 is just one failed fix
# attempt, not evidence the phase is genuinely stuck; without this floor that single recurrence
# could end the phase without the Blocked label after using almost none of MAX_CODE_REVIEW_ITERATIONS
# / MAX_SECURITY_REVIEW_ITERATIONS, abandoning a real defect on the first retry. Regex-validated
# like the four budgets above even though it is only ever interpolated into prompt prose, never
# bash arithmetic (so an invalid value can't crash oneshot the way an invalid budget could): an
# unvalidated override of 0, negative, or non-numeric would still silently defeat the floor this
# constant exists to enforce, since the raw text would render into PHASE E/F's prompt verbatim
# ("at least 0 code-review rounds...") rather than falling back to a sane default. Override with
# MIN_REVIEW_CONVERGENCE_ROUNDS in the environment before calling oneshot.
MIN_REVIEW_CONVERGENCE_ROUNDS="${MIN_REVIEW_CONVERGENCE_ROUNDS:-3}"
[[ "${MIN_REVIEW_CONVERGENCE_ROUNDS}" =~ ^[1-9][0-9]{0,5}$ ]] || MIN_REVIEW_CONVERGENCE_ROUNDS=3

# Fixed, exact-format status-comment markers PHASE D/E/F/G (lib/prompts' build_pr_claude_md)
# require the agent to post on every round of that phase that continues, and
# _round_marker_and_cap_for_substatus (lib/workflow-board) greps the PR's comment history for to
# count how many rounds have run, for the Discord round-progress display (#1375). Defined once
# here and referenced from both sides so a future reword of either can't silently desync the two
# — an earlier version of this feature hardcoded the same three literals independently in each
# file, with nothing to catch a drift between them. Not overridable via the environment, unlike
# the budgets above: these are internal wire-format constants between two parts of this codebase,
# not an operator-facing tuning knob. ROUND_MARKER_COVERAGE is not a marker invented for this
# purpose — it's a substring of PHASE G's own pre-existing decision-procedure line format
# ("<lang> <pct>% < main <pct>% - returning to Development") — but is still defined here rather
# than left as an independently-hardcoded literal, for the same single-source-of-truth reason as
# the other three (see _round_marker_and_cap_for_substatus's own comment).
ROUND_MARKER_SIMPLIFY="Simplify: applied cleanups"
ROUND_MARKER_CODE_REVIEW="Code review round:"
ROUND_MARKER_SECURITY_REVIEW="Security review round:"
ROUND_MARKER_COVERAGE=" - returning to Development"

# Runaway backstop: the maximum number of agent invocations the orchestrator will spend on
# a single PR before marking it Blocked for a human to look at.  Normal end-to-end flow
# (setup, rebase, fix, a few review rounds, finalize) uses well under this; exceeding it
# means the agent is churning without converging.  Defaults to the sum of the four per-phase
# round budgets above PLUS a flat headroom for the phases with no itemised budget of their own
# (setup/rebase, CI-fix rounds, finalize).  The headroom is a flat add-on rather than a
# percentage of the sum on purpose: those untracked phases' own workload did not grow when the
# review/coverage budgets above did, so a percentage multiplier would let their relative
# headroom shrink every time those budgets are retuned upward - exactly what happened when this
# constant briefly used a percentage multiplier of the sum instead, since the same relative
# margin over a larger sum is a smaller absolute margin than it was over the smaller sum it
# replaced. UNTRACKED_PHASE_HEADROOM (11) instead preserves the absolute headroom this constant
# had before the four budgets were split out, regardless of how the itemised budgets change.
# This is a deliberately simple model, not an exact one: PHASE C's CI-fix workload plausibly
# scales somewhat with how many review/security rounds actually run (each pushed fix commit is a
# fresh CI run that can need its own CI-fix invocation), so a PR with many long-running review
# rounds could still approach this cap before PHASE E/F's own non-blocking early exit fires. If
# that turns out to bite in practice, retune UNTRACKED_PHASE_HEADROOM (or override
# MAX_PR_TOTAL_INVOCATIONS directly) rather than reintroducing a percentage multiplier.
# Computed once into _max_pr_total_invocations_computed_default below and reused for BOTH the
# default substitution and the invalid-override fallback, so the two can never disagree with
# each other or go stale when any of the four budgets above is retuned.  Uses _budget_sum,
# accumulated by the validation loop above, rather than naming all four budget variables again
# here, so the two can never drift apart either (a fifth budget added to the loop's list is
# automatically included).  Safe to compute directly (no separate guard needed here) since all
# four inputs are already validated above to be positive integers of at most 6 digits each, so
# their sum cannot overflow bash's 64-bit signed arithmetic.  Override with MAX_PR_TOTAL_INVOCATIONS.
_UNTRACKED_PHASE_HEADROOM=11
_max_pr_total_invocations_computed_default=$(( _budget_sum + _UNTRACKED_PHASE_HEADROOM ))
unset _budget_sum _UNTRACKED_PHASE_HEADROOM
MAX_PR_TOTAL_INVOCATIONS="${MAX_PR_TOTAL_INVOCATIONS:-${_max_pr_total_invocations_computed_default}}"
# Bounded, not just "one or more digits", for the same reason as the four budgets above:
# MAX_PR_TOTAL_INVOCATIONS is compared with -ge/-eq elsewhere (lib/state), and an extreme
# override could otherwise exceed what bash's arithmetic evaluator can represent. 7 digits here,
# not 6 like its four inputs: this value is their SUM (max 4 * 999999 + 11 = 4000007, itself a
# 7-digit number), so a 6-digit cap would make the invalid-override fallback below a no-op in
# the one case it exists to catch (all four inputs near their own max) - the fallback would
# reassign the same over-limit computed default that just failed the regex.
[[ "${MAX_PR_TOTAL_INVOCATIONS}" =~ ^[1-9][0-9]{0,6}$ ]] || MAX_PR_TOTAL_INVOCATIONS="${_max_pr_total_invocations_computed_default}"
unset _max_pr_total_invocations_computed_default

# Runaway backstop for Issues: max agent invocations spent on one Issue before marking it
# Blocked for a human. MAX_PR_TOTAL_INVOCATIONS is PR-only; an Issue that keeps being worked
# without producing a PR (agent keeps planning/erroring and posting comments) re-fires every
# tick with no cap (#1093). Default is lower than the PR cap — the Issue-only phase count
# (plan → produce PR) should be small; once a PR exists the PR backstop takes over.
MAX_ISSUE_TOTAL_INVOCATIONS="${MAX_ISSUE_TOTAL_INVOCATIONS:-15}"
[[ "${MAX_ISSUE_TOTAL_INVOCATIONS}" =~ ^[1-9][0-9]*$ ]] || MAX_ISSUE_TOTAL_INVOCATIONS=15

# How many consecutive "in-progress" re-invocations to allow on an unchanged PR fingerprint
# before parking it.  Phases that advance the board without pushing (a clean code/security
# review, or the finalize step on a repo where auto-merge cannot be enabled) do not change the
# fingerprint, so the orchestrator re-invokes an unchanged non-terminal PR to let the next phase
# run — but only up to this many times, so a PR that is genuinely done just goes quiet.
# Override with MAX_PR_IDLE_INVOCATIONS in the environment before calling oneshot.
MAX_PR_IDLE_INVOCATIONS="${MAX_PR_IDLE_INVOCATIONS:-5}"
[[ "${MAX_PR_IDLE_INVOCATIONS}" =~ ^[1-9][0-9]*$ ]] || MAX_PR_IDLE_INVOCATIONS=5

# How many consecutive "in-progress" re-invocations to allow on an unchanged, plan-approved Issue
# fingerprint before parking it (#1264). Mirrors MAX_PR_IDLE_INVOCATIONS: an approved Issue whose
# last invocation didn't produce a durable change (no new comment, no PR opened — e.g. it only
# posted a status update) would otherwise sit at "unchanged — skipping" forever, since nothing
# about the Issue's own trusted fields ever changes again on its own. An Issue that is NOT
# plan-approved never re-invokes on this budget at all — that's the correct, unrelated "waiting on
# a human to approve the plan" behaviour and must stay silent.
# Override with MAX_ISSUE_IDLE_INVOCATIONS in the environment before calling oneshot.
MAX_ISSUE_IDLE_INVOCATIONS="${MAX_ISSUE_IDLE_INVOCATIONS:-5}"
[[ "${MAX_ISSUE_IDLE_INVOCATIONS}" =~ ^[1-9][0-9]*$ ]] || MAX_ISSUE_IDLE_INVOCATIONS=5

# How many times oneshot will auto-clear the Blocked label on a PR the agent itself diagnosed as
# blocked by an environment/infrastructure failure (#1118) once a newer agent image has been
# built. Bounds the (rare, low-frequency) case where the "environment" diagnosis was actually
# wrong — a real code bug mistaken for one — which would otherwise auto-clear and immediately
# re-block every time the image happens to rebuild, forever, with no human ever notified.
# Override with MAX_PR_ENV_AUTO_UNBLOCKS.
MAX_PR_ENV_AUTO_UNBLOCKS="${MAX_PR_ENV_AUTO_UNBLOCKS:-3}"
[[ "${MAX_PR_ENV_AUTO_UNBLOCKS}" =~ ^[1-9][0-9]*$ ]] || MAX_PR_ENV_AUTO_UNBLOCKS=3

# How many CONSECUTIVE agent-container failures before Claude ever starts (invoke_claude
# returning 2 — see run_claude_fresh, #1133) an item tolerates before being marked Blocked for
# a human. This budget is separate from MAX_PR_TOTAL_INVOCATIONS/MAX_ISSUE_TOTAL_INVOCATIONS,
# which a pre-flight failure never touches: without a SEPARATE escalation path, a persistently
# broken container (bad image, always-failing pre-flight check) would retry silently forever —
# previously any such failure called die(), killing the whole oneshot run and giving an
# operator an immediate, visible signal; #1133's fix to stop killing the run for a genuinely
# transient failure must not also remove the only escalation path for a non-transient one
# (#1133 review). Resets to 0 the moment a real Claude session runs, however that session ends.
# Override with MAX_CONSECUTIVE_INFRA_FAILURES.
MAX_CONSECUTIVE_INFRA_FAILURES="${MAX_CONSECUTIVE_INFRA_FAILURES:-5}"
[[ "${MAX_CONSECUTIVE_INFRA_FAILURES}" =~ ^[1-9][0-9]*$ ]] || MAX_CONSECUTIVE_INFRA_FAILURES=5

# How long (in minutes) to wait for CI checks to complete before flagging a PR as Blocked.
# Override with CI_CHECK_TIMEOUT_MINUTES in the environment or in .env.
CI_CHECK_TIMEOUT_MINUTES="${CI_CHECK_TIMEOUT_MINUTES:-1440}"
[[ "${CI_CHECK_TIMEOUT_MINUTES}" =~ ^[1-9][0-9]*$ ]] || CI_CHECK_TIMEOUT_MINUTES=120

# How many times to retry the `gh api user` identity lookup, and how long to wait between
# attempts, before giving up. The lookup is cheap and cached for the rest of the run once it
# succeeds, so a transient blip should not sacrifice a whole cycle (#1085). Overridable from the
# environment (tests set the delay to 0 to keep the suite fast).
GH_USER_RETRY_ATTEMPTS="${GH_USER_RETRY_ATTEMPTS:-3}"
[[ "${GH_USER_RETRY_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || GH_USER_RETRY_ATTEMPTS=3
GH_USER_RETRY_DELAY_SECS="${GH_USER_RETRY_DELAY_SECS:-2}"
[[ "${GH_USER_RETRY_DELAY_SECS}" =~ ^[0-9]+$ ]] || GH_USER_RETRY_DELAY_SECS=2

# How many times to retry fetching the priorities feed, and how long to wait between attempts,
# before giving up. This is the single most load-bearing network call in the script — a transient
# blip here must not be reported to the operator as a healthy "no work" run (#1089). Overridable
# from the environment (tests set the delay to 0 to keep the suite fast).
PRIORITIES_FETCH_RETRY_ATTEMPTS="${PRIORITIES_FETCH_RETRY_ATTEMPTS:-3}"
[[ "${PRIORITIES_FETCH_RETRY_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || PRIORITIES_FETCH_RETRY_ATTEMPTS=3
PRIORITIES_FETCH_RETRY_DELAY_SECS="${PRIORITIES_FETCH_RETRY_DELAY_SECS:-2}"
[[ "${PRIORITIES_FETCH_RETRY_DELAY_SECS}" =~ ^[0-9]+$ ]] || PRIORITIES_FETCH_RETRY_DELAY_SECS=2

# Same retry treatment for the per-item gh fetches (fetch_pr_json/fetch_issue_json) called
# throughout the main loop — a transient blip on any one of these previously died the whole run
# and threw away every other priority item in the cycle (#1090). Overridable from the environment
# (tests set the delay to 0 to keep the suite fast).
GH_ITEM_FETCH_RETRY_ATTEMPTS="${GH_ITEM_FETCH_RETRY_ATTEMPTS:-3}"
[[ "${GH_ITEM_FETCH_RETRY_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || GH_ITEM_FETCH_RETRY_ATTEMPTS=3
GH_ITEM_FETCH_RETRY_DELAY_SECS="${GH_ITEM_FETCH_RETRY_DELAY_SECS:-2}"
[[ "${GH_ITEM_FETCH_RETRY_DELAY_SECS}" =~ ^[0-9]+$ ]] || GH_ITEM_FETCH_RETRY_DELAY_SECS=2

# Same retry treatment for the repo-collaborators fetch inside get_trusted_logins — a transient
# blip here previously got swallowed and cached as a silently shrunken (but valid-looking) trust
# list for the rest of the item's processing (#1094). Overridable from the environment (tests
# set the delay to 0 to keep the suite fast).
GH_COLLABORATORS_RETRY_ATTEMPTS="${GH_COLLABORATORS_RETRY_ATTEMPTS:-3}"
[[ "${GH_COLLABORATORS_RETRY_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || GH_COLLABORATORS_RETRY_ATTEMPTS=3
GH_COLLABORATORS_RETRY_DELAY_SECS="${GH_COLLABORATORS_RETRY_DELAY_SECS:-2}"
[[ "${GH_COLLABORATORS_RETRY_DELAY_SECS}" =~ ^[0-9]+$ ]] || GH_COLLABORATORS_RETRY_DELAY_SECS=2

# Token window at which the agent's own Claude Code session should auto-compact its context
# rather than run until it hits the "Prompt is too long" wall (#1051/#1070). Passed into the
# container as CLAUDE_CODE_AUTO_COMPACT_WINDOW, which Claude Code documents as taking precedence
# over any settings.json value. Override with CLAUDE_CODE_AUTO_COMPACT_WINDOW in the environment.
CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-100000}"
[[ "${CLAUDE_CODE_AUTO_COMPACT_WINDOW}" =~ ^[1-9][0-9]*$ ]] || CLAUDE_CODE_AUTO_COMPACT_WINDOW=100000

# Comma-separated list of additional trusted GitHub users, loaded from .env.
WHITELISTED_USERS=""
# Cached JSON array of trusted logins for the current repo context; reset by set_repo_context.
_TRUSTED_LOGINS_JSON=""

# Per-item mutable counters. Initialized here; populated by the load_*/save_* helpers in
# lib/state and lib/github-status.
INFRA_FAILURE_COUNT=0
PR_INVOCATION_TOTAL=0
PR_INVOCATION_IDLE=0
ENV_UNBLOCK_ATTEMPTS=0
ISSUE_INVOCATION_TOTAL=0
ISSUE_INVOCATION_IDLE=0

# Output pair for parse_two_token_counters (lib/state) — shared by load_pr_invocation_counts and
# load_issue_invocation_counts, populated fresh on every call.
_PARSED_COUNT_TOTAL=0
_PARSED_COUNT_IDLE=0

# Workflow project cache — populated by discover_or_create_workflow_project (lib/workflow-board).
# Empty _WF_PROJECT_ID disables all update_workflow_status calls (no-op mode).
_WF_PROJECT_ID=""
_WF_STATUS_FIELD_ID=""
declare -gA _WF_OPTION_IDS
_WF_CACHED_REPO=""
# Per-repo discovery cache: keys are "REPO_FULL:discovered", "REPO_FULL:project_id",
# "REPO_FULL:field_id", "REPO_FULL:opt_names" (newline-delimited option names), and
# "REPO_FULL:opt:<name>" (one entry per status-field option, avoiding any separator
# character that could collide with characters in option names).
declare -gA _WF_CACHE

# Space-delimited list of repos already issued a Workflow-project setup request this run.
# Prevents report_missing_workflow_project re-filing/re-querying once per item in the same
# failing repo; cross-run de-duplication relies on the open issue itself.
_WF_REPORTED_REPOS=""

# Set to "1" by discover_or_create_workflow_project when _wf_create_project returns non-zero,
# so the call site can distinguish a genuine "cannot create project" failure from other reasons
# _WF_PROJECT_ID might be empty (missing status field, GraphQL auth error, etc.).
_WF_CREATION_FAILED=""

# Board-approved items cache — populated by fetch_board_approved_items.
# Keys are "owner/repo/number"; value is "1" when issue is in Approved status.
declare -gA _WF_APPROVED_ITEMS
# Per-repo fetch guard: value "1" means fetch_board_approved_items has already run for that repo.
declare -gA _WF_APPROVED_FETCHED

# Board item-status cache — populated by fetch_board_item_statuses (#1136).
# Keys are "owner/repo/number"; value is the Workflow Status field's current option ID for
# that item. Covers BOTH Issues and PRs (unlike _WF_APPROVED_ITEMS, which only ever needs
# Issues for the plan-approval flow).
declare -gA _WF_ITEM_STATUS_OPTION_ID
# Per-repo fetch guard: value "1" means fetch_board_item_statuses has already run for that repo.
declare -gA _WF_ITEM_STATUS_FETCHED

# Ordered Workflow Status option names, earliest first. Defines the ordinal used by
# sync_pr_workflow_status_from_linked_issues (lib/workflow-board) to compare a PR's card
# against its linked issue's without hardcoding numeric ranks at each call site, and to
# guarantee that mirror never moves a card backward.
_WF_STATUS_ORDER=(
    "Not Started" "Planning" "Approved" "Development" "AI Simplify" "AI Review"
    "AI Security Review" "AI Coverage" "Human Review" "Complete"
)

# How long (seconds) a disk-persisted project cache entry stays valid before
# discover_or_create_workflow_project falls back to a live re-discovery. Override in the
# environment; the project/field/option IDs are effectively permanent once set up, so the
# default of 1 hour is conservative rather than tightly load-bearing.
PROJECT_CACHE_TTL="${PROJECT_CACHE_TTL:-3600}"
