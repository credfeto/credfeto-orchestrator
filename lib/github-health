# shellcheck shell=bash
# The GitHub health gate: whether githubstatus.com reports an unresolved incident on a part of
# GitHub the orchestrator's sessions need. During such an incident a session cannot push, comment
# or write the board, so it achieves nothing and is charged against its item's idle budget; oneshot
# skips the whole tick instead.

# Prints "<name><TAB><created_at>" for the first unresolved incident whose components include one of
# GITHUB_HEALTH_COMPONENTS (lib/globals), read from GITHUB_STATUS_URL, and returns 0.
# Returns 1 when no such incident is open (none at all, or only incidents on other components such
# as Codespaces or Copilot).
# Returns 2 when the status could not be read: curl failed or timed out, or the body is not the
# expected JSON. Callers must treat 2 as "healthy" (fail open), so a githubstatus.com problem never
# stops the fleet on its own.
# Tabs, carriage returns and newlines in the name are replaced with spaces, so the output is always
# one line with exactly one tab.
github_incident_open() {
    local status_json incident
    status_json=$(curl --silent --fail --location --connect-timeout 5 --max-time 10 \
        "${GITHUB_STATUS_URL}" 2>/dev/null) || return 2
    # jq -e: an object without an incidents array (an error page, "null", a bare array) fails the
    # parse, so it is a lookup failure rather than "no incident".
    incident=$(printf '%s' "${status_json}" | jq -er '
        if (type == "object") and ((.incidents | type) == "array") then
            [ .incidents[]
                | select(type == "object")
                | select(any((.components // [])[]?; (.name? // "") as $n | any($ARGS.positional[]; . == $n))) ]
            | if length == 0 then ""
              else first | "\((.name // "unnamed incident") | tostring | gsub("[\t\r\n]"; " "))\t\(.created_at // "unknown time")"
              end
        else
            error("unexpected status JSON")
        end' --args "${GITHUB_HEALTH_COMPONENTS[@]}" 2>/dev/null) || return 2
    [ -n "${incident}" ] || return 1
    printf '%s\n' "${incident}"
}
