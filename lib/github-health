# shellcheck shell=bash
# The GitHub health gate: whether githubstatus.com reports an unresolved incident on a part of
# GitHub the orchestrator's sessions need, and whether it is bad enough to stop work. During a
# serious incident a session cannot push, comment or write the board, so it achieves nothing and is
# charged against its item's idle budget; oneshot skips the whole tick instead. A minor incident
# (a slowdown that leaves those operations working) only earns a warning, so the fleet keeps going.

# Reads the status summary (incidents and components) from GITHUB_STATUS_URL (lib/globals) and
# looks at the unresolved incidents whose components include one of GITHUB_HEALTH_COMPONENTS.
# Such an incident is serious when its impact is one of GITHUB_HEALTH_SERIOUS_IMPACTS (major,
# critical), or when one of those used components currently has a status in
# GITHUB_HEALTH_OUTAGE_STATUSES (partial_outage, major_outage) in the summary's components list.
# Anything else on a used component (minor or no impact, and degraded_performance, operational or
# an unlisted status) is minor.
#
# Returns 0 and prints "<name><TAB><created_at>" for the first serious incident.
# Returns 3 and prints "<name><TAB><created_at><TAB><component>: <status>" for the first minor one
# when no incident is serious; <component> is the first used component it names, and <status> is
# that component's live status ("unknown" when the summary does not list it).
# Returns 1 when no incident is open on a used component (none at all, or only incidents on other
# components such as Codespaces, Copilot or Actions).
# Returns 2 when the status could not be read: curl failed or timed out, or the body is not the
# expected JSON. Callers must treat 2 as "healthy" (fail open), so a githubstatus.com problem never
# stops the fleet on its own.
# Tabs, carriage returns and newlines in names and statuses are replaced with spaces, so the output
# is always one line with a fixed number of tabs.
# With ORCHESTRATOR_DOTNET_DISCOVERY=1 the read and the judgement are made by `ORCHESTRATOR_CMD
# discovery github-incident` (#252) with the lists above, which prints the same line and exits 0, 3, 4
# (no incident) or 1 (not read); 4 becomes 1 here, and 1 or any other failure of the tool (a missing
# tool included) becomes 2, so the gate still fails open.
github_incident_open() {
    local status_json result used impacts outages
    if [ "${ORCHESTRATOR_DOTNET_DISCOVERY}" = 1 ] && orchestrator_cmd_supports discovery github-incident; then
        local -a args=(github-incident --url "${GITHUB_STATUS_URL}")
        local item cmd_rc=0
        for item in "${GITHUB_HEALTH_COMPONENTS[@]}"; do args+=(--component "${item}"); done
        for item in "${GITHUB_HEALTH_SERIOUS_IMPACTS[@]}"; do args+=(--serious-impact "${item}"); done
        for item in "${GITHUB_HEALTH_OUTAGE_STATUSES[@]}"; do args+=(--outage-status "${item}"); done
        result=$(_discovery_with_orchestrator_cmd "${args[@]}") || cmd_rc=$?
        case "${cmd_rc}" in
            0 | 3)
                [ -n "${result}" ] || return 2
                printf '%s\n' "${result}"
                return "${cmd_rc}"
                ;;
            4) return 1 ;;
        esac
        return 2
    fi
    status_json=$(curl --silent --fail --location --connect-timeout 5 --max-time 10 \
        "${GITHUB_STATUS_URL}" 2>/dev/null) || return 2
    used=$(jq -cn '$ARGS.positional' --args "${GITHUB_HEALTH_COMPONENTS[@]}") || return 2
    impacts=$(jq -cn '$ARGS.positional' --args "${GITHUB_HEALTH_SERIOUS_IMPACTS[@]}") || return 2
    outages=$(jq -cn '$ARGS.positional' --args "${GITHUB_HEALTH_OUTAGE_STATUSES[@]}") || return 2
    # jq -e: an object without an incidents array (an error page, "null", a bare array) fails the
    # parse, so it is a lookup failure rather than "no incident". A missing or malformed components
    # list only means no live component status is known.
    result=$(printf '%s' "${status_json}" | jq -er \
        --argjson used "${used}" --argjson impacts "${impacts}" --argjson outages "${outages}" '
        def flat: tostring | gsub("[\t\r\n]"; " ");
        def member($list): . as $v | any($list[]; . == $v);
        if (type == "object") and ((.incidents | type) == "array") then
            ((.components // []) as $c
                | if ($c | type) == "array"
                  then [ $c[] | select(type == "object") | {key: ((.name // "") | tostring), value: ((.status // "") | tostring)} ] | from_entries
                  else {} end) as $live
            | [ .incidents[]
                | select(type == "object")
                | [ (.components // [])[]? | (.name? // "") | select(type == "string") | select(member($used)) ] as $hit
                | select($hit | length > 0)
                | {
                    name: ((.name // "unnamed incident") | flat),
                    created: ((.created_at // "unknown time") | flat),
                    serious: (((.impact // "") | tostring | member($impacts))
                        or any($hit[]; ($live[.] // "") | member($outages))),
                    component: ($hit[0] | flat),
                    state: (($live[$hit[0]] // "unknown") | if . == "" then "unknown" else . end | flat)
                  } ]
            | if length == 0 then ""
              elif any(.[]; .serious) then first(.[] | select(.serious)) | "serious\t\(.name)\t\(.created)"
              else first | "minor\t\(.name)\t\(.created)\t\(.component): \(.state)"
              end
        else
            error("unexpected status JSON")
        end' 2>/dev/null) || return 2
    [ -n "${result}" ] || return 1
    printf '%s\n' "${result#*$'\t'}"
    [ "${result%%$'\t'*}" = "serious" ] && return 0
    return 3
}
