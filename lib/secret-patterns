# shellcheck shell=bash
# The single list of token-form secret patterns redacted from any text oneshot posts outside the
# container (Discord embeds today). Each entry is one sed -E expression so the list can be handed to
# sed unchanged. notify-unit-failure and cfwf are installed standalone and cannot source this file,
# so they carry their own copies; test/secret-patterns.bats fails when either copy drifts from this
# one. Markers never contain "/", because lib/discord's later masking turns any slash-bearing word
# into "[path]" and would hide which kind of secret was removed.
#
# Not readonly: the bats suite re-sources lib files into the same shell.
SECRET_REDACTION_SED_EXPRESSIONS=(
    's#gh[pousr]_[A-Za-z0-9]{16,}#[REDACTED-GH-TOKEN]#g'
    's#github_pat_[A-Za-z0-9_]{20,}#[REDACTED-GH-PAT]#g'
    's#sk-ant-[A-Za-z0-9_-]{16,}#[REDACTED-ANTHROPIC-KEY]#g'
    's#sk-proj-[A-Za-z0-9_-]{16,}#[REDACTED-OPENAI-KEY]#g'
    's#xox[abprs]-[A-Za-z0-9-]{10,}#[REDACTED-SLACK-TOKEN]#g'
    's#(https?://)?([a-z]+\.)?[Dd]iscord(app)?\.com/api/webhooks/[^[:space:]]+#[REDACTED-DISCORD-WEBHOOK]#g'
    's#A[KS]IA[0-9A-Z]{16}#[REDACTED-AWS-KEY-ID]#g'
    's#([Bb]earer|BEARER|[Tt]oken|TOKEN|[Aa]uthorization|AUTHORIZATION)([=:[:space:]]+)[A-Za-z0-9._~+/-]{12,}#\1\2[REDACTED]#g'
)

# Reads text on stdin and writes it to stdout with every SECRET_REDACTION_SED_EXPRESSIONS form
# replaced by its marker, leaving the surrounding text intact so the message stays readable.
redact_secrets() {
    local sed_args=()
    local expression
    for expression in "${SECRET_REDACTION_SED_EXPRESSIONS[@]}"; do
        sed_args+=(-e "${expression}")
    done
    sed -E "${sed_args[@]}"
}
