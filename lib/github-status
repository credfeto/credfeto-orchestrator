# shellcheck shell=bash
# Pure predicates over pre-fetched PR/Issue JSON (terminal state, failed/pending required
# checks, blocked-label detection) and the Blocked-label application/escalation machinery built
# on top of them.

# Whether the PR still carries the .deleteme.now placeholder a template repo's opening commit adds
# (agent-roles.instructions.md, Changelog skip case): the real change has not landed, so the PR
# must never be treated as ready or settled. Only the first 100 files are visible in pr_json, which
# is enough because a placeholder-only PR has one.
pr_json_has_placeholder_file() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '(.files // []) | any(.[]; .path == ".deleteme.now")' > /dev/null 2>&1
}

# Prints pr_json with each statusCheckRollup entry's isRequired set from required_names_json (the
# output of fetch_pr_required_check_names), matched on the check's name or legacy context.
# GitHub's own required-check rules are keyed on that name, so a name match is the same test it
# applies. When required_names_json is "[]" (the lookup succeeded but nothing on this commit is
# required) base_requires_checks (fetch_branch_requires_status_checks: "true", "false", or empty
# when unknown) says which of two cases that is:
# - "false", the base branch requires nothing (no branch protection): every entry is marked
#   required, which is how such a repo was treated before required-ness was looked up at all.
#   With no rule saying a check can be ignored, a failing check still has to be fixed and pending
#   CI still has to finish first. Marking them all optional would let the predicates below
#   disagree about the same failing check, pr_json_is_terminal waiting on it while
#   pr_json_has_failed_required_check denied it.
# - "true", the base branch requires checks but none has reported on this commit yet (just after a
#   push, or a required workflow whose paths filter this PR does not match): every present entry is
#   marked not required, since GitHub says so for each of them, and requiredChecksNotYetReported
#   is set so pr_json_has_pending_ci_checks still waits for the required ones rather than treating
#   CI as finished. A failing optional check is then neither a failed required check nor a reason
#   to stop waiting.
# - empty: pr_json is printed unchanged, as below.
# When required_names_json is empty (the lookup failed, or set_pr_required_checks skipped it because
# every check passed) pr_json is printed unchanged: entries stay without isRequired, which every
# predicate below reads as "required-ness unknown".
annotate_pr_json_required_checks() {
    local pr_json="$1" required_names_json="${2:-}" base_requires_checks="${3:-}"
    if [ -z "${required_names_json}" ]; then
        printf '%s' "${pr_json}"
        return 0
    fi
    if [ "${required_names_json}" = "[]" ] && [ "${base_requires_checks}" != "true" ] && [ "${base_requires_checks}" != "false" ]; then
        printf '%s' "${pr_json}"
        return 0
    fi
    printf '%s' "${pr_json}" | jq -c --argjson required "${required_names_json}" --argjson baseRequires "${base_requires_checks:-false}" '
        if (.statusCheckRollup | type) != "array" then .
        elif ($required | length) > 0
        then .statusCheckRollup |= map(. + {isRequired: ((.name // .context) as $n | $required | index($n) != null)})
        elif $baseRequires
        then (.statusCheckRollup |= map(. + {isRequired: false})) | .requiredChecksNotYetReported = true
        else .statusCheckRollup |= map(. + {isRequired: true})
        end
    ' 2>/dev/null || printf '%s' "${pr_json}"
}

# Returns 0 (true) when every statusCheckRollup entry has finished and passed: a CheckRun (it has
# .status) whose conclusion is SUCCESS, SKIPPED or NEUTRAL, or a legacy StatusContext (no .status)
# whose state is SUCCESS. Also true for an empty rollup. On such a PR no predicate here can come
# out differently for knowing which checks are required, so the lookup is not worth an API call.
pr_json_has_only_passed_checks() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '
        (.statusCheckRollup // [])
        | all(.[];
            if (.status != null)
            then ((.conclusion // "") | . == "SUCCESS" or . == "SKIPPED" or . == "NEUTRAL")
            else (.state // "") == "SUCCESS"
            end
        )
    ' > /dev/null 2>&1
}

# Sets the caller's pr_required_checks from fetch_pr_required_check_names (lib/github) and
# annotates the caller's pr_json with them (annotate_pr_json_required_checks), by dynamic scoping
# like set_pr_has_unaddressed_comment: only call from main()'s per-item loop. Shared by the
# issue-pivot and direct-PR paths. The lookup is skipped, leaving pr_required_checks empty, when
# every check has already passed (pr_json_has_only_passed_checks). When it returns "[]" the base
# branch (pr_json's baseRefName) is also asked whether it requires any check at all
# (fetch_branch_requires_status_checks), and the answer is kept in the caller's
# pr_base_requires_checks for the post-session re-read; that call is made only then, since a
# non-empty list already says which checks are required. A failed lookup, of either kind, leaves
# pr_required_checks empty rather than failing the item: see annotate_pr_json_required_checks for
# how each predicate reads unknown required-ness. A failed lookup is warned about, once per item per
# tick since this runs once per item, and sets the caller's pr_required_checks_lookup_failed to
# "true" ("false" otherwise): with required-ness unknown, pr_json_has_failed_required_check cannot
# see a failed required check, so a lookup that keeps failing would otherwise quietly turn that
# detection off. oneshot passes the flag to block_pr_for_idle_exhausted_no_progress, whose Blocked
# reason then says a failed required check could not be ruled out instead of claiming none failed,
# and plan_unchanged_pr_reinvocation passes it to pr_next_phase_for_board_status, which then still
# routes a failing check to PHASE C.
set_pr_required_checks() {
    local item_id="$1" base_branch
    pr_required_checks=""
    # shellcheck disable=SC2034  # pr_base_requires_checks is main()'s local
    pr_base_requires_checks=""
    # shellcheck disable=SC2034  # pr_required_checks_lookup_failed is main()'s local
    pr_required_checks_lookup_failed=false
    # shellcheck disable=SC2154  # pr_json is main()'s local, read via dynamic scoping
    if ! pr_json_has_only_passed_checks "${pr_json}"; then
        if ! pr_required_checks=$(fetch_pr_required_check_names "${item_id}"); then
            pr_required_checks=""
            # shellcheck disable=SC2034  # see above
            pr_required_checks_lookup_failed=true
            warn "Failed to look up the required checks for PR #${item_id}: a failed required check cannot be detected this tick"
        elif [ "${pr_required_checks}" = "[]" ]; then
            base_branch=$(printf '%s' "${pr_json}" | jq -r '.baseRefName // ""')
            if ! pr_base_requires_checks=$(fetch_branch_requires_status_checks "${base_branch}"); then
                pr_required_checks=""
                pr_base_requires_checks=""
                # shellcheck disable=SC2034  # see above
                pr_required_checks_lookup_failed=true
                warn "Failed to look up whether the base branch of PR #${item_id} requires any check: a failed required check cannot be detected this tick"
            fi
        fi
    fi
    pr_json=$(annotate_pr_json_required_checks "${pr_json}" "${pr_required_checks}" "${pr_base_requires_checks}")
}

# Returns 0 (true) if the PR has reached a terminal state the orchestrator should stop driving:
# auto-merge is enabled and no required check has hard-failed (it will merge once the remaining
# checks/approvals land).  Merged/closed PRs never reach here (filtered earlier as non-OPEN);
# Blocked PRs are filtered by their label.  Auto-merge alone is not enough — it can be enabled
# long before a later push breaks a required check, at which point GitHub will never complete
# the merge and the orchestrator needs to step back in and fix it rather than walk away.  Uses
# the same CheckRun-vs-legacy-StatusContext classification as pr_json_has_pending_ci_checks.
# Unlike pr_json_has_failed_required_check, a failing check whose required-ness is unknown still
# blocks "terminal" here: walking away from a PR that may never merge is the costlier mistake.
# Superseded runs are ignored, as they are there.
# GitHub's own mergeStateStatus (e.g. BLOCKED) is deliberately not consulted here — it reflects
# GitHub's own merge-readiness computation (missing reviews, branch-protection rules, etc.), not
# something the orchestrator itself has any part in, and is not a reliable signal that the PR
# needs a human (#1266). isDraft is checked explicitly rather than trusted to keep
# autoMergeRequest null: GitHub disallows enabling auto-merge on a draft PR, but does not
# document that converting an already-armed PR back to draft clears autoMergeRequest, so a
# non-null value must not be treated as terminal for a PR that is currently a draft.
# Optional second argument review_pipeline_finished ("true"/"false", default "false"): substitutes
# for the autoMergeRequest check, for a repo where auto-merge cannot be armed at all (unsupported,
# so agent-roles.instructions.md's Phase D P3 fell back to `gh pr ready` instead). autoMergeRequest
# is only ever a proxy for "the review pipeline actually finished" — a caller unable to arm
# auto-merge must supply that same fact some other way (see pr_review_pipeline_finished_without_
# auto_merge, lib/workflow-board) rather than this PR staying permanently non-terminal (#1479: on
# such a repo, a settled PR was invoked repeatedly forever, and never got the review-needed
# notification, because both were gated on autoMergeRequest alone). The remaining checks (no
# CHANGES_REQUESTED, no failed required check) still apply regardless of which signal made the
# pipeline "finished" — either can go stale after the fact and both still need a human.
pr_json_is_terminal() {
    local pr_json="$1" review_pipeline_finished="${2:-false}"
    printf '%s' "${pr_json}" | jq -e --argjson finished "${review_pipeline_finished}" "${_JQ_DEF_LATEST_CHECK_RUNS}${_JQ_DEF_CHECK_FAILED}"'
        .isDraft != true
        and ((.files // []) | all(.[]; .path != ".deleteme.now"))
        and (.autoMergeRequest != null or $finished)
        and .reviewDecision != "CHANGES_REQUESTED"
        and (
            (.statusCheckRollup // [])
            | latest_check_runs
            | all(.[]; .isRequired == false or (check_failed | not))
        )
    ' > /dev/null 2>&1
}

# Runs jq_program over pr_json with the REST-shaped review and issue comment arrays bound as
# $reviewComments and $issueComments, and prints its output; any further arguments are jq options
# (-r, --arg, --argjson). The arrays go through temporary files read with --rawfile rather than
# --argjson, because a long PR thread serialises past the per-argument size limit execve enforces
# (see fingerprint_pr_json). Returns 1 when a temporary file cannot be created or jq fails.
_jq_pr_json_with_comment_arrays() {
    local pr_json="$1" review_comments_json="$2" issue_comments_json="$3" jq_program="$4"
    shift 4
    local review_comments_file issue_comments_file output jq_status
    review_comments_file=$(mktemp --suffix=.json) || return 1
    printf '%s' "${review_comments_json}" > "${review_comments_file}"
    issue_comments_file=$(mktemp --suffix=.json) || { rm -f "${review_comments_file}"; return 1; }
    printf '%s' "${issue_comments_json}" > "${issue_comments_file}"
    output=$(printf '%s' "${pr_json}" | jq "$@" \
        --rawfile reviewCommentsRaw "${review_comments_file}" --rawfile issueCommentsRaw "${issue_comments_file}" \
        '($reviewCommentsRaw | fromjson) as $reviewComments | ($issueCommentsRaw | fromjson) as $issueComments | '"${jq_program}")
    jq_status=$?
    rm -f "${review_comments_file}" "${issue_comments_file}"
    [ "${jq_status}" -eq 0 ] || return 1
    printf '%s' "${output}"
}

# Returns the newest trusted-activity timestamp in pr_json — top-level comments, reviews, inline
# review comments (via the optional third argument), AND (via the optional fourth argument)
# REST-fetched top-level issue comments — or empty string if there is none. trusted_logins,
# review_comments_json, and issue_comments_json follow fingerprint_pr_json's shapes exactly (JSON
# array or "null" to trust everyone; REST-shaped comments, author under `.user.login`, timestamp
# under `.updated_at`), and this deliberately covers the same activity sources fingerprint_pr_json
# hashes — omitting reviews/inline comments here would let a trusted review or inline comment
# change the general PR fingerprint while never registering as "unaddressed", reproducing #1307's
# exact symptom via a different surface. GitHub CLI's `--json comments` never actually populates
# `updatedAt` (verified live — only `createdAt` is present), so pr_json.comments alone only ever
# detects a *new* top-level comment, never an edit to an already-seen one; the fourth argument
# closes that gap by feeding in fetch_pr_issue_comments's REST-shaped array, which does carry a
# real `updated_at` per comment (#1309). Kept alongside rather than replacing pr_json.comments so
# every existing call site/test built on the latter keeps working unchanged — the two sources
# describe the same underlying comments, so folding both into the same max-timestamp union is
# always safe (a real edit's `updated_at` can only be >= its `created_at`/`createdAt`).
# Used to record the newest trusted comment a genuine agent invocation was given (oneshot computes it
# from the pre-session PR state and saves it via save_pr_last_agent_comment_seen, #1307), to detect a
# trusted comment posted during a session (via fetch_pr_latest_trusted_comment_timestamp), and, via
# pr_json_has_unaddressed_trusted_comment below, to decide whether one is still unaddressed.
# Optional fifth argument exclude_login: the orchestrator's own login (_GH_ME). It is a trusted
# collaborator, so without this its own status comments would count as new trusted activity: a
# session whose only output was its own comment would look like progress, and would move the
# last-seen marker as if another trusted commenter had spoken. Empty excludes nothing.
pr_json_latest_trusted_comment_timestamp() {
    local pr_json="$1" trusted_logins="${2:-null}" review_comments_json="${3:-[]}" issue_comments_json="${4:-[]}" exclude_login="${5:-}"
    # shellcheck disable=SC2016  # the program's $variables are jq's, not the shell's
    _jq_pr_json_with_comment_arrays "${pr_json}" "${review_comments_json}" "${issue_comments_json}" "${_JQ_DEF_COUNTED_LOGIN}"'
        def tc(cs): cs | map(select(counted_login(.author.login)));
        def trc(cs): cs | map(select(counted_login(.user.login)));
        [
            (tc(.comments // [])[]? | (.updatedAt // .createdAt // "")),
            (tc(.reviews // [])[]? | (.submittedAt // .updatedAt // "")),
            (trc($reviewComments)[]? | (.updated_at // "")),
            (trc($issueComments)[]? | (.updated_at // .created_at // ""))
        ]
        | map(select(. != ""))
        | sort | last // ""
    ' -r --argjson trusted "${trusted_logins}" --arg me "${exclude_login}"
}

# Returns 0 (true) if any trusted-activity timestamp (top-level comment, review, or inline review
# comment) is newer than last_seen_timestamp: a trusted commenter has said something an agent
# has not actually read yet. An empty last_seen_timestamp (no prior record from
# load_pr_last_agent_comment_seen) counts any trusted activity as unaddressed, so a PR with no
# recorded history is never silently skipped. This is a deliberate one-time cost on first deploy:
# every already-open PR with any trusted comment history gets exactly one forced real invocation
# the first time it's observed (no marker file yet) before the marker exists to compare against —
# accepted rather than "fixed" (e.g. by seeding the marker without an invocation whenever the
# general fingerprint already matches) because the PR that motivated this fix
# (funfair-tech/funfair-treasury-reporting#3622) is *exactly* that shape: no marker file, general
# fingerprint already matching due to historical non-agentic-rebase absorption. Silencing the
# empty-marker case would silence that PR's own fix (#1307 review). Callers use this to override
# the free non-agentic-rebase and terminal/"settled" paths in oneshot, both of which would
# otherwise never let a plain PR comment (as opposed to a formal CHANGES_REQUESTED review) reach a
# real agent invocation (#1307). Deliberately built on pr_json_latest_trusted_comment_timestamp
# rather than a second jq pass, so the two functions cannot drift on what counts as "trusted
# activity" — plain
# string comparison is safe here because GitHub always emits these as fixed-width ISO-8601 UTC
# timestamps. Optional sixth argument exclude_login is passed straight through, so the
# orchestrator's own comments are never "unaddressed" and this agrees with the last-seen marker.
pr_json_has_unaddressed_trusted_comment() {
    local pr_json="$1" trusted_logins="${2:-null}" last_seen_timestamp="${3:-}" review_comments_json="${4:-[]}" issue_comments_json="${5:-[]}" exclude_login="${6:-}"
    local latest
    latest=$(pr_json_latest_trusted_comment_timestamp "${pr_json}" "${trusted_logins}" "${review_comments_json}" "${issue_comments_json}" "${exclude_login}")
    [ -n "${latest}" ] && { [ -z "${last_seen_timestamp}" ] || [[ "${latest}" > "${last_seen_timestamp}" ]]; }
}

# Prints the trusted, non-orchestrator PR activity newer than last_seen_timestamp (the same set
# pr_json_has_unaddressed_trusted_comment detects) as quotable text for the PR session's
# generated CLAUDE.md, oldest first: top-level comments (REST issue comments and pr_json.comments
# describe the same comments, so the pair is de-duplicated on author and body), reviews with a
# body or a CHANGES_REQUESTED verdict, and inline review comments with their file path. Each body
# is cut at PR_UNADDRESSED_COMMENT_MAX_CHARS and the whole text at
# PR_UNADDRESSED_COMMENTS_MAX_CHARS. Prints nothing when there is none. Arguments mirror
# pr_json_has_unaddressed_trusted_comment's; the comment arrays go through files because their
# size is unbounded.
pr_json_unaddressed_trusted_comments_text() {
    local pr_json="$1" trusted_logins="${2:-null}" last_seen_timestamp="${3:-}" review_comments_json="${4:-[]}" issue_comments_json="${5:-[]}" exclude_login="${6:-}"
    local text
    # shellcheck disable=SC2016  # the program's $variables are jq's, not the shell's
    text=$(_jq_pr_json_with_comment_arrays "${pr_json}" "${review_comments_json}" "${issue_comments_json}" "${_JQ_DEF_COUNTED_LOGIN}"'
        def clip: if length > $per then .[0:$per] + " [truncated]" else . end;
        [
            ($issueComments[]? | {login: .user.login, ts: (.updated_at // .created_at // ""), kind: "comment", body: (.body // "")}),
            ((.comments // [])[]? | {login: .author.login, ts: (.updatedAt // .createdAt // ""), kind: "comment", body: (.body // "")}),
            ((.reviews // [])[]? | select((.body // "") != "" or .state == "CHANGES_REQUESTED")
                | {login: .author.login, ts: (.submittedAt // .updatedAt // ""), kind: ("review, " + (.state // "COMMENTED")), body: (.body // "")}),
            ($reviewComments[]? | {login: .user.login, ts: (.updated_at // ""), kind: ("inline review comment on " + (.path // "unknown file")), body: (.body // "")})
        ]
        | map(select(.login != null and counted_login(.login) and .ts != "" and ($last == "" or .ts > $last)))
        | unique_by([.login, .kind, .body])
        | sort_by(.ts)
        | map("- \(.login) (\(.kind), \(.ts)):\n\(.body | clip)")
        | join("\n")
    ' -r --argjson trusted "${trusted_logins}" --arg me "${exclude_login}" \
        --arg last "${last_seen_timestamp}" --argjson per "${PR_UNADDRESSED_COMMENT_MAX_CHARS}") || return 1
    if [ "${#text}" -gt "${PR_UNADDRESSED_COMMENTS_MAX_CHARS}" ]; then
        text="${text:0:${PR_UNADDRESSED_COMMENTS_MAX_CHARS}}
[further comments truncated: read the rest on the PR]"
    fi
    printf '%s' "${text}"
}

# Sets the caller's `pr_has_unaddressed_comment` from the caller's pre-fetched
# `pr_json`/`trusted_logins`/`pr_review_comments`/`pr_issue_comments` and the persisted
# last-agent-comment-seen marker for item_id. Relies on bash's dynamic scoping of `local`s, same
# convention as require_trusted_logins (lib/github): must only be called from within main()'s
# per-item loop, where `pr_json`, `pr_review_comments`, `pr_issue_comments`, and
# `pr_has_unaddressed_comment` are already declared local. Shared by both PR code paths
# (issue-pivot and direct-PR) so this derivation cannot drift between them (#1307).
set_pr_has_unaddressed_comment() {
    local id="$1" last_seen
    last_seen=$(load_pr_last_agent_comment_seen "${id}")
    # shellcheck disable=SC2034  # set via dynamic scoping for the caller, same as
    # require_trusted_logins (lib/github) does for trusted_logins/count_error
    pr_has_unaddressed_comment=false
    # shellcheck disable=SC2034,SC2154  # pr_json/pr_review_comments/pr_issue_comments read here
    # are set by the caller via dynamic scoping, same as item_repo is for require_trusted_logins
    # (lib/github)
    pr_json_has_unaddressed_trusted_comment "${pr_json}" "${trusted_logins}" "${last_seen}" "${pr_review_comments}" "${pr_issue_comments}" "${_GH_ME:-}" \
        && pr_has_unaddressed_comment=true
}

# Returns 0 (true) if any required check has definitively failed (CheckRun conclusion FAILURE, or
# legacy StatusContext state FAILURE/ERROR).  Used to distinguish a PR that has legitimately
# settled (idle-parked while waiting on a human, e.g. for review/approval) from one that is
# idle-parked *despite* an active failure nobody is fixing — the idle-invocation budget alone
# cannot tell these apart.  Uses the same CheckRun-vs-legacy-StatusContext classification as
# pr_json_has_pending_ci_checks / pr_json_is_terminal.
# Only a check positively known to be required counts (isRequired == true, set by
# annotate_pr_json_required_checks), and only its latest run: this feeds the human-facing "failed
# required check" Blocked reason, which must agree with `gh pr checks --required`. A check whose
# required-ness is unknown, or a failure a later run superseded, never produces that claim.
pr_json_has_failed_required_check() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e "${_JQ_DEF_LATEST_CHECK_RUNS}${_JQ_DEF_CHECK_FAILED}"'
        (.statusCheckRollup // [])
        | latest_check_runs
        | any(.[]; .isRequired == true and check_failed)
    ' > /dev/null 2>&1
}

# Returns 0 (true) if the latest run of any check whose required-ness is unknown (no isRequired,
# as annotate_pr_json_required_checks leaves every entry when the required-check lookup failed)
# has definitively failed. Such a failure may be a failed required check, so it must still be
# fixed even though pr_json_has_failed_required_check cannot claim it: pr_json_is_terminal already
# treats it as blocking, and pr_next_phase_for_board_status routes it the same way.
pr_json_has_failed_check_of_unknown_requiredness() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e "${_JQ_DEF_LATEST_CHECK_RUNS}${_JQ_DEF_CHECK_FAILED}"'
        (.statusCheckRollup // [])
        | latest_check_runs
        | any(.[]; .isRequired == null and check_failed)
    ' > /dev/null 2>&1
}

# Maps an item_type ("Issue"|"PullRequest") to the gh CLI noun ("issue"|"pr") used in `gh pr
# ...`/`gh issue ...` subcommands. Single definition shared by every call site that needs this
# mapping so a future item type can't be updated in only some of them (#1136 review).
gh_noun_for_item_type() {
    local item_type="$1"
    if [ "${item_type}" = "Issue" ]; then
        printf 'issue'
    else
        printf 'pr'
    fi
}

# Issues a single live, direct `gh ... view --json labels` call — never the tick's own
# already-fetched JSON — and prints "true"/"false" (or nothing, on failure) for whether the item
# currently carries a Blocked label. Shared by apply_blocked_label (verify-after-write) and
# item_confirmed_not_blocked_live (verify-before-reset) so the endpoint/jq shape lives in exactly
# one place; each caller greps the raw output for the specific literal/fail-safe direction it
# needs, since "gh failed" must NOT be conflated with a confirmed true or false reading.
_live_item_blocked_label_status() {
    local item_type="$1" item_id="$2" item_repo="$3"
    local gh_noun
    gh_noun=$(gh_noun_for_item_type "${item_type}")
    gh "${gh_noun}" view "${item_id}" --repo "${item_repo}" --json labels \
        --jq '[.labels[].name] | index("Blocked") != null' 2>/dev/null
}

# Applies the Blocked label to an Issue or PullRequest and VERIFIES it actually landed —
# `gh ... edit --add-label` can fail silently (e.g. the repo has no "Blocked" label yet), and an
# unverified label-add is how every escalation path in this file used to lose its escalation:
# the label never lands, so the next tick's pr_json_has_blocked_label check never catches it, the
# item falls back into the work queue, and (because the bot's own comment is trusted) gets
# re-invoked and re-blocked every tick forever (#1092). Retries once, self-healing by creating
# the label if it doesn't exist in the repo. Returns 0 only once the label is CONFIRMED present.
apply_blocked_label() {
    local item_type="$1" item_id="$2" item_repo="$3"
    local gh_noun
    gh_noun=$(gh_noun_for_item_type "${item_type}")

    local attempt
    for attempt in 1 2; do
        gh "${gh_noun}" edit "${item_id}" --repo "${item_repo}" --add-label Blocked >/dev/null 2>&1
        if _live_item_blocked_label_status "${item_type}" "${item_id}" "${item_repo}" | grep -q '^true$'; then
            return 0
        fi
        [ "${attempt}" -eq 1 ] \
            && gh label create Blocked --repo "${item_repo}" --color "d73a4a" --description "Needs human attention" >/dev/null 2>&1
    done
    warn "Failed to verify Blocked label on ${item_type} #${item_id} in ${item_repo} after retry"
    return 1
}

# Returns 0 (true) only when a live, direct re-check positively confirms the item does NOT
# currently carry a Blocked label (#1310) — see reset_pr_invocation_counts_if_capped/
# reset_issue_invocation_counts_if_capped (lib/state) for why this re-check exists. Fails safe:
# a failed/empty gh response counts as still-blocked, since an inconclusive re-check can't
# overrule the cached read it exists to double-check.
item_confirmed_not_blocked_live() {
    _live_item_blocked_label_status "$1" "$2" "$3" | grep -q '^false$'
}

# Applies the Blocked label, posts an explanatory comment (only once the label is CONFIRMED —
# see apply_blocked_label), sends the Discord blocked notification with the same reason, and
# marks the item for forgiveness, the sequence every automatic blocking path in this file needs,
# previously copy-pasted at every call site (#1140 review). Forgiveness-marking is centralised
# here rather than left as a per-caller opt-in: mark_capped_block_for_forgiveness is itself
# self-gating (lib/state), a no-op unless the item's invocation total or idle counter is already
# at/over its cap, so calling it unconditionally on every successful block never marks an item
# that isn't actually capped, regardless of which reason blocked it. lib/state's own
# runaway_blocked_marker_file_path header already documents this as "regardless of which
# mechanism applied the Blocked label". A per-caller opt-in would have required every new
# blocking function to separately remember to add the call; block_pr_for_ci_timeout and
# block_issue_for_unapplied_plan_approval below never got such an opt-in at all, so centralising
# here is also what closes that gap for them. Returns apply_blocked_label's own exit status so
# callers can still do their own extra bookkeeping (e.g. clearing a pending-CI state file)
# conditionally on success.
apply_blocked_label_with_reason() {
    local item_type="$1" item_id="$2" item_repo="$3" reason="$4"
    local rc=0
    apply_blocked_label "${item_type}" "${item_id}" "${item_repo}" || rc=$?
    if [ "${rc}" -eq 0 ]; then
        gh "$(gh_noun_for_item_type "${item_type}")" comment "${item_id}" --repo "${item_repo}" \
            --body "${reason}" 2>/dev/null || true
        mark_capped_block_for_forgiveness "${item_type}" "${item_id}" "${item_repo}"
    fi
    notify_discord_blocked_item "${item_type}" "${item_id}" "${reason}"
    return "${rc}"
}

# Appends the last session's diagnostic (if any was recorded for this item - see
# record_last_session_diagnostic, lib/podman) to an idle-exhaustion/runaway Blocked reason,
# fenced under a short heading and truncated via the same truncate_for_display (lib/discord)
# notify_discord_permission_denials uses for the same text (#1448). Fencing and truncation both
# matter: the raw text is tool_input.command/.file_path content (or a short diagnostic-refusal
# result), which can contain @name or #123 sequences that would otherwise ping a user or
# cross-link an unrelated issue when posted unfenced into a PR/issue comment. Returns reason
# unchanged when no marker exists, so callers can always pass their reason through this
# unconditionally.
#
# The diagnostic is attacker-influenceable (it is the literal tool_input.command/.file_path of a
# denied tool call, which can echo content from an issue/PR body Claude was working from), so any
# backtick run it contains is neutralised before fencing - otherwise a "```" sequence in the
# diagnostic would close the fence early and un-fence the remainder, defeating the very protection
# this comment describes (code review, #1467).
append_last_diagnostic_to_reason() {
    local item_type="$1" item_id="$2" reason="$3"
    local diagnostic
    diagnostic=$(load_last_diagnostic "${item_type}" "${item_id}")
    [ -n "${diagnostic}" ] || { printf '%s' "${reason}"; return 0; }

    local truncated
    truncated=$(truncate_for_display "${diagnostic}" 2>/dev/null) || truncated="${diagnostic}"
    truncated=${truncated//\`/\'}

    local heading="Last session's diagnostic:"
    # shellcheck disable=SC2016  # the backticks are a literal Markdown code fence, not a substitution
    printf '%s\n\n%s\n```\n%s\n```' "${reason}" "${heading}" "${truncated}"
}

# Posts a Blocked-marking comment and label when a PR's idle-invocation budget has been
# exhausted while a required check is still definitively failed, so a human is pulled in instead
# of the PR silently rotting forever — the idle budget alone has no way to escalate. The label is
# applied and VERIFIED first; the comment is only posted once the label is confirmed, so a label
# failure never produces a comment-without-a-label (which would otherwise re-trigger this same
# escalation every tick forever, see apply_blocked_label). notify_discord_blocked_item is called
# directly (it is idempotent per blocked spell) rather than relying on the next tick's
# pr_json_has_blocked_label check, since that indirection is exactly what a label failure breaks.
# Forgiveness-marking is handled by apply_blocked_label_with_reason itself, so a human who
# unblocks before any later tick observes this PR still carrying Blocked still gets a fresh budget.
block_pr_for_idle_exhausted_failure() {
    local item_id="$1" item_repo="$2"
    local reason="This PR has a failed required check and the automation's idle-invocation budget (${MAX_PR_IDLE_INVOCATIONS}) is exhausted without further progress. Blocking this PR until a human investigates."
    reason=$(append_last_diagnostic_to_reason "PullRequest" "${item_id}" "${reason}")
    apply_blocked_label_with_reason "PullRequest" "${item_id}" "${item_repo}" "${reason}"
}

# Returns 0 (true) if GitHub's own review-decision aggregate is CHANGES_REQUESTED — a reviewer
# has asked for changes and not yet re-approved or dismissed. GitHub does not clear this on a new
# push, so it stays true until a human is satisfied — exactly the signal needed to keep driving a
# PR that already has auto-merge enabled (which otherwise makes pr_json_is_terminal stop early).
pr_json_has_unaddressed_review_request() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '.reviewDecision == "CHANGES_REQUESTED"' > /dev/null 2>&1
}

# Returns 0 (true) if GitHub's own review-decision aggregate is REVIEW_REQUIRED — auto-merge is
# armed and no required check has failed (i.e. the PR is otherwise "settled", see
# pr_json_is_terminal), but it cannot merge because no approving review exists yet, whether that
# review was dismissed by a later force-push or was never requested at all. Distinct from
# pr_json_has_unaddressed_review_request (CHANGES_REQUESTED), which is a reviewer actively asking
# for changes rather than the PR just sitting unapproved (#1278).
pr_json_needs_review_approval() {
    local pr_json="$1"
    printf '%s' "${pr_json}" | jq -e '.reviewDecision == "REVIEW_REQUIRED"' > /dev/null 2>&1
}

# Posts a Blocked-marking comment and label when a PR's idle-invocation budget has been exhausted
# while a reviewer's requested changes are still outstanding, so a human is pulled in instead of
# the PR silently rotting forever. Same shape as block_pr_for_idle_exhausted_failure, above.
block_pr_for_idle_exhausted_review() {
    local item_id="$1" item_repo="$2"
    local reason="This PR has an unaddressed review requesting changes and the automation's idle-invocation budget (${MAX_PR_IDLE_INVOCATIONS}) is exhausted without further progress. Blocking this PR until a human investigates."
    reason=$(append_last_diagnostic_to_reason "PullRequest" "${item_id}" "${reason}")
    apply_blocked_label_with_reason "PullRequest" "${item_id}" "${item_repo}" "${reason}"
}

# Posts a Blocked-marking comment and label when a PR's idle-invocation budget has been exhausted
# with neither a failed required check nor an unaddressed review request to explain why — the
# third PR escalation path, covering the "everything's fine, just idle" gap the two siblings above
# don't (#1463). Without this, pr_should_advance_unchanged keeps returning "park" forever once the
# idle budget is exhausted and neither sibling condition applies (e.g. a PR sitting at a board
# column between workflow phases with CI green and no requested changes), with nothing left in
# oneshot's decision tree to call — the PR silently rotted with zero signal except a human noticing
# and commenting. Same shape as its two siblings; the "no known blocking reason" wording mirrors
# block_issue_for_idle_exhausted_no_progress below so a human immediately understands why the PR
# was blocked despite nothing being visibly wrong.
# Optional third argument required_checks_unknown ("true"/"false", default "false"): set when the
# required-check lookup failed this tick (set_pr_required_checks), so "no required check has
# failed" is not something the orchestrator knows; the reason then says so, pointing the human at
# the lookup rather than asserting the PR has no failed required check.
block_pr_for_idle_exhausted_no_progress() {
    local item_id="$1" item_repo="$2" required_checks_unknown="${3:-false}"
    local reason="This PR's automation idle-invocation budget (${MAX_PR_IDLE_INVOCATIONS}) is exhausted with no known blocking reason — no required check has failed and there is no unaddressed review request. Blocking this PR until a human investigates."
    if [ "${required_checks_unknown}" = "true" ]; then
        reason="This PR's automation idle-invocation budget (${MAX_PR_IDLE_INVOCATIONS}) is exhausted with no known blocking reason, but the lookup of which checks are required failed, so a failed required check could not be ruled out. There is no unaddressed review request. Blocking this PR until a human investigates."
    fi
    reason=$(append_last_diagnostic_to_reason "PullRequest" "${item_id}" "${reason}")
    apply_blocked_label_with_reason "PullRequest" "${item_id}" "${item_repo}" "${reason}"
}

# Posts a Blocked-marking comment and label when a plan-approved Issue's idle-invocation budget
# has been exhausted with no durable progress observed (no new PR, no new trusted comment/label/
# state change) — mirrors block_pr_for_idle_exhausted_failure/_review for Issues (#1264). Pushing
# more agent invocations at an Issue that already isn't producing anything won't help; a human
# needs to check whether work genuinely stalled (e.g. an expected PR was never opened).
block_issue_for_idle_exhausted_no_progress() {
    local item_id="$1" item_repo="$2"
    local reason="This issue's plan is approved but no further progress (e.g. a Pull Request) has been observed, and the automation's idle-invocation budget (${MAX_ISSUE_IDLE_INVOCATIONS}) is exhausted. Blocking this issue until a human investigates."
    reason=$(append_last_diagnostic_to_reason "Issue" "${item_id}" "${reason}")
    apply_blocked_label_with_reason "Issue" "${item_id}" "${item_repo}" "${reason}"
}

# Posts a Blocked-marking comment and label when an Issue's idle-invocation budget has been
# exhausted without ever producing an Implementation Plan comment: the sibling gap to
# block_issue_for_idle_exhausted_no_progress above (plan approved, no progress) and
# block_issue_for_unapplied_plan_approval below (plan posted, Blocked never applied). This is the
# third state: no plan was ever posted, e.g. the issue was Blocked by an environment failure before
# planning started, then unblocked, with no forcing function anywhere else in oneshot's decision
# tree to ever revisit it. The reason states the actual recovery contract, not just the symptom,
# since a human reading it needs to know where to look and what unblocking buys them.
block_issue_for_idle_exhausted_no_plan() {
    local item_id="$1" item_repo="$2"
    local reason="This issue was re-invoked ${MAX_ISSUE_IDLE_INVOCATIONS} times to produce an implementation plan, but none was posted. Check agent transcripts / orchestrator logs for a session ending without output. Blocking this issue until a human investigates; removing Blocked grants a fresh idle budget."
    reason=$(append_last_diagnostic_to_reason "Issue" "${item_id}" "${reason}")
    apply_blocked_label_with_reason "Issue" "${item_id}" "${item_repo}" "${reason}"
}

# Returns 0 (true) if the pre-fetched Issue JSON contains a comment matching "## Implementation
# Plan" (case-insensitive). Same detector used to decide whether an issue needs a plan at all
# (see the identical check embedded into the generated CLAUDE.md, lib/prompts).
issue_json_has_plan_comment() {
    local issue_json="$1"
    printf '%s' "${issue_json}" | jq -e '
        [.comments[]?.body // ""] | any(test("##\\s*Implementation Plan";"i"))
    ' > /dev/null 2>&1
}

# Returns 0 (true) if the pre-fetched Issue JSON contains a genuine HUMAN approval comment
# (approved / go ahead / looks good / lgtm — case-insensitive, whole word) posted by someone other
# than the orchestrator itself ($me_login) and a member of $trusted_logins_json, at any point AFTER
# the most recent "## Implementation Plan" comment. Restricting the matching author to a trusted
# human is what stops the orchestrator's OWN comments from ever satisfying the check — verified
# live on funfair-build-check#434 and adblockplusrules#615, where the only "approved"-matching text
# on the issue was the bot's own comment explaining that approval was MISSING (#1286). Single
# source of truth for "was this plan approved by a human": used both by
# issue_plan_awaiting_human_approval below and — via human_plan_approval_jq_literal, same filter
# text baked into a self-contained one-liner — the identical check embedded into the generated
# CLAUDE.md (lib/prompts) for no-board repos, so the orchestrator and the agent it launches always
# agree on what counts as "approved".
issue_json_has_human_plan_approval() {
    local issue_json="$1" me_login="$2" trusted_logins_json="$3"
    printf '%s' "${issue_json}" | jq -e --arg me "${me_login}" --argjson trusted "${trusted_logins_json:-null}" '
        (.comments) as $c
        | (first(range($c|length) | select($c[.].body // "" | test("##\\s*Implementation Plan";"i"))) // -1) as $i
        | if $i >= 0 then
            $c[($i+1):]
            | map(select(.author.login as $login | $login != $me and (($trusted // []) | index($login)) != null))
            | any(.[]; .body // "" | test("\\b(approved|go ahead|looks good|lgtm)\\b";"i"))
          else
            false
          end
    ' > /dev/null 2>&1
}

# Same semantics as issue_json_has_human_plan_approval's inner filter, but with $me_login/
# $trusted_logins_json already baked in as jq literals rather than passed via --arg/--argjson, so
# the result is a single self-contained string an agent can paste directly after `gh ... --jq`,
# which — unlike the `jq` CLI itself — has no separate --arg/--argjson flags. Keeping this
# generation in the SAME file as the shell-side predicate (rather than hand-duplicating the filter
# text at the lib/prompts call site) is what makes the two copies impossible to drift apart —
# exactly the class of bug #1286 exists to catch.
human_plan_approval_jq_literal() {
    local me_login="$1" trusted_logins_json="$2"
    # shellcheck disable=SC2016 # intentional — this is jq syntax ($c, $i), not a bash variable
    printf '%s' '(.comments) as $c | (first(range($c|length)|select($c[.].body|test("##\\s*Implementation Plan";"i"))) // -1) as $i | if $i>=0 then ($c[($i+1):]|map(select(.author.login as $login | $login != "'"${me_login}"'" and ('"${trusted_logins_json:-[]}"'|index($login)) != null))|any(.[]; .body|test("\\b(approved|go ahead|looks good|lgtm)\\b";"i"))) else false end'
}

# Returns 0 (true) if the Issue has a plan comment with no genuine human approval following it —
# the drift oneshot self-heals by applying Blocked (#1286). Operates on already-fetched issue JSON,
# no extra API call. See issue_json_has_plan_comment / issue_json_has_human_plan_approval for what
# "plan" and "approved" mean. Optional fourth argument has_plan_comment ("true"/"false"): when the
# caller already knows this (oneshot computes it once per Issue for issue_should_advance_unchanged),
# pass it here too to skip re-deriving it via a second jq pass over the same JSON; omitted entirely
# (checked via "$#", not a value test, so an explicit empty string can never be mistaken for
# "not passed"), this derives it itself exactly as before, which is what every direct unit test of
# this function's own plan-comment detection still wants. Kept as the single call this predicate has,
# rather than letting a caller duplicate its body inline, so the definition of "awaiting approval"
# can never drift between two copies, the same concern that centralised
# issue_json_has_human_plan_approval in the first place.
issue_plan_awaiting_human_approval() {
    local issue_json="$1" me_login="$2" trusted_logins_json="$3" has_plan_comment="${4-}"
    if [ "$#" -ge 4 ]; then
        [ "${has_plan_comment}" = "true" ] || return 1
    else
        issue_json_has_plan_comment "${issue_json}" || return 1
    fi
    ! issue_json_has_human_plan_approval "${issue_json}" "${me_login}" "${trusted_logins_json}"
}

# Posts a Blocked-marking comment and label when an Issue's own posted plan was never followed by
# the Blocked label — the self-heal for #1286 (an agent posted "## Implementation Plan" and ended
# its session without applying Blocked; the fingerprint then never changes, so Claude is never
# re-invoked to notice its own omission). Reuses _build_plan_approval_instruction (lib/prompts) so
# the human-facing wording of what to do next (board vs. comment-based approval) stays in exactly
# one place, matching what the agent itself would have said.
block_issue_for_unapplied_plan_approval() {
    local item_id="$1" item_repo="$2"
    local reason
    reason="This issue has a posted Implementation Plan with no human approval since, but the Blocked label was never applied — self-healing by applying it now. $(_build_plan_approval_instruction)"
    apply_blocked_label_with_reason "Issue" "${item_id}" "${item_repo}" "${reason}"
}

# Decides whether to re-invoke a PR whose fingerprint is UNCHANGED, so the next workflow phase
# can run (phases that only advance the board — e.g. a clean review — leave the fingerprint
# unchanged because the orchestrator re-saves it after each run).  Returns 0 (advance) when the
# PR is non-terminal and still within the idle budget; 1 (park) otherwise.  Read-only: the idle
# counter is persisted at invocation time via save_pr_invocation_counts.
# Optional third argument has_unaddressed_comment ("true"/"false", default "false"): an
# unaddressed trusted PR comment (#1307) is treated as its own advance-reason that overrides the
# terminal short-circuit — a comment left on an otherwise-"done" PR still deserves a real look —
# but it is NOT exempt from the idle budget below: once PR_INVOCATION_IDLE reaches the cap this
# still returns 1 (park) exactly like any other stuck-unchanged reason, so the caller's
# failed-check/unaddressed-review-request escalation gets a real chance to fire instead of being
# silently defeated for as long as the comment stays unaddressed (#1307 review).
pr_should_advance_unchanged() {
    local item_id="$1" pr_json="$2" has_unaddressed_comment="${3:-false}"
    pr_json_is_terminal "${pr_json}" && [ "${has_unaddressed_comment}" != "true" ] && return 1
    load_pr_invocation_counts "${item_id}"
    [ "${PR_INVOCATION_IDLE}" -lt "${MAX_PR_IDLE_INVOCATIONS}" ]
}

# Decides whether a PR session re-invoked with no external change should be left uncharged against
# the idle budget, from values captured either side of it: Workflow board status, newest trusted
# comment timestamp with the orchestrator's own login excluded, and head commit. An empty post
# comment timestamp is inconclusive: oneshot passes one when that lookup failed, when it was not
# made, or when the pre-session value could not be computed (so the two are not comparable).
# Prints which signal moved and returns 0 when one did; returns 1, printing nothing, when none did,
# which is when the session is charged. A board move or a pushed commit is the agent's own
# progress. A later comment timestamp is not: with the orchestrator's login excluded on both sides,
# it can only be another trusted commenter's comment that arrived while the session ran, which the
# agent was never given and which the last-agent-comment-seen marker leaves unaddressed; it still
# resets the idle count, so the next run that answers it is not parked by an idle cap that comment
# reached. The orchestrator's own comments never move it, so they cannot cause a re-run loop. An
# "Unknown" board read on either side is inconclusive rather than a move, because
# fetch_single_item_workflow_status reports a failed lookup that way too. The head commit stands
# in for the full fingerprint, which would also see the agent's own comment and the
# mergeStateStatus/statusCheckRollup fields that change on their own while nothing about the PR
# does.
pr_session_progress_reason() {
    local pre_board="$1" post_board="$2" pre_comment_ts="$3" post_comment_ts="$4" pre_head="$5" post_head="$6"
    if [ -n "${pre_board}" ] && [ -n "${post_board}" ] && [ "${pre_board}" != "Unknown" ] && [ "${post_board}" != "Unknown" ] \
        && [ "${pre_board}" != "${post_board}" ]; then
        printf 'board moved from %s to %s' "${pre_board}" "${post_board}"
        return 0
    fi
    # Strictly later, not merely different: a newest comment deleted (or dropping out of the
    # trusted set) during the session leaves an older timestamp, which is not a comment arriving.
    # ISO-8601 UTC timestamps compare correctly as strings, and an empty pre sorts before any post.
    if [ -n "${post_comment_ts}" ] && [[ "${post_comment_ts}" > "${pre_comment_ts}" ]]; then
        printf 'a trusted comment arrived during the session and is left unaddressed for the next run'
        return 0
    fi
    if [ -n "${pre_head}" ] && [ -n "${post_head}" ] && [ "${pre_head}" != "${post_head}" ]; then
        printf 'a commit was pushed'
        return 0
    fi
    return 1
}

# Names the build_pr_claude_md phase an unchanged, non-terminal PR should run next, from its
# Workflow board status (the agent's own phase marker) and pr_json. Prints the phase and returns 0
# when one can be named; returns 2 when it cannot, where the caller falls back to invoking without
# naming a phase. That covers an unknown or unrecognised status (no board, or a custom status) and
# Complete. Complete is deliberately not read as "nothing left to do" on a PR that is still open
# and non-terminal: sync_pr_workflow_status_from_linked_issues (lib/workflow-board) raises a PR's
# card to the highest status among its linked issues, so one already-closed linked issue sets the
# card to Complete before the PR's own work is done. Invoking without a phase is how every
# unchanged PR was invoked before the board was consulted, and the agent then works out the phase
# from the PR itself. A failed required check or a CHANGES_REQUESTED review outranks the board, as
# it does in the prompt.
# Optional third argument required_checks_unknown ("true"/"false", default "false"): set when the
# required-check lookup failed this tick (set_pr_required_checks). A failing check whose
# required-ness is then unknown also outranks the board, as it already blocks pr_json_is_terminal:
# otherwise a Human Review board would hand the PR PHASE H while the failure may be on a required
# check nobody is fixing.
pr_next_phase_for_board_status() {
    local board_status="$1" pr_json="$2" required_checks_unknown="${3:-false}"
    if pr_json_has_failed_required_check "${pr_json}"; then
        printf 'PHASE C (fix the failed required check)'
        return 0
    fi
    if [ "${required_checks_unknown}" = "true" ] && pr_json_has_failed_check_of_unknown_requiredness "${pr_json}"; then
        printf 'PHASE C (fix the failed check: whether it is required could not be looked up)'
        return 0
    fi
    if printf '%s' "${pr_json}" | jq -e '.reviewDecision == "CHANGES_REQUESTED"' > /dev/null 2>&1; then
        printf 'PHASE C (address the requested changes)'
        return 0
    fi
    case "${board_status}" in
        "Not Started"|Planning|Approved|Development)
            printf 'PHASE C (finish any outstanding linked-issue work), otherwise PHASE D (simplify)' ;;
        "AI Simplify")
            printf 'PHASE D (simplify)' ;;
        "AI Review")
            printf 'PHASE E (code review)' ;;
        "AI Security Review")
            printf 'PHASE F (security review)' ;;
        "AI Coverage")
            printf 'PHASE G (coverage)' ;;
        "Human Review")
            if printf '%s' "${pr_json}" | jq -e '.autoMergeRequest == null' > /dev/null 2>&1; then
                printf 'PHASE H (finalize)'
            else
                printf 'PHASE C (auto-merge is armed but the PR cannot merge: find and fix what is stopping it)'
            fi ;;
        *)
            return 2 ;;
    esac
}

# Decides how to re-invoke a PR that pr_should_advance_unchanged has allowed to advance, and sets
# the caller's pr_next_phase (dynamic scoping, same convention as set_pr_has_unaddressed_comment:
# only call from main()'s per-item loop, where pr_json, pr_has_unaddressed_comment,
# pr_required_checks_lookup_failed and pr_next_phase are locals) to the phase to hand the agent, or
# to empty when none can be named. The PR is always invoked; this only chooses what it is told.
plan_unchanged_pr_reinvocation() {
    local item_id="$1" item_repo="$2" board_status
    pr_next_phase=""
    # shellcheck disable=SC2154  # set by the caller via dynamic scoping
    if [ "${pr_has_unaddressed_comment}" = "true" ]; then
        info "PR #${item_id} in ${item_repo}: unchanged but has an unaddressed trusted comment, so the agent handles that first"
        return 0
    fi
    # Populated here, outside the command substitution below, so the per-tick board cache
    # survives for every later lookup this tick instead of dying with the subshell.
    discover_or_create_workflow_project
    fetch_board_item_statuses
    board_status=$(board_substatus_for_item "${item_id}")
    # shellcheck disable=SC2154  # set by the caller via dynamic scoping
    if pr_next_phase=$(pr_next_phase_for_board_status "${board_status}" "${pr_json}" "${pr_required_checks_lookup_failed:-false}"); then
        info "PR #${item_id} in ${item_repo}: board status '${board_status}', next phase is ${pr_next_phase}"
    else
        pr_next_phase=""
        info "PR #${item_id} in ${item_repo}: board status '${board_status}' names no phase, invoking without one"
    fi
}

# Decides whether to re-invoke an Issue whose fingerprint is UNCHANGED, mirroring
# pr_should_advance_unchanged (#1264). Issues have no CI/review sub-state to distinguish
# "terminal" from "stuck" the way pr_json_is_terminal does for PRs — plan approval is the only
# available "is there still real intent here" signal, but there are three states, not two:
# plan approved, plan posted and awaiting a human decision, and no plan posted at all. The middle
# state must stay silent here, since issue_plan_awaiting_human_approval below self-heals a missing
# Blocked label for it instead: nobody owes a decision until a plan exists. The third state (an
# Issue that never had a plan posted, e.g. blocked by an environment failure before planning
# started, then unblocked) has no forcing function anywhere else in oneshot's decision tree, so it
# parked at "unchanged, skipping" forever with no idle counter, no escalation, nothing.
# has_plan_comment lets the caller report that third state, which is then treated the same as
# plan_approved for the idle-budget purpose below: re-invoked periodically, up to the idle budget,
# to actually produce a plan. A plan-approved Issue whose last invocation produced no durable
# change (e.g. only a status-update comment, no PR opened) gets periodically re-poked the same way.
# Both arguments are mandatory: oneshot's single call site always has both already computed and
# passes them explicitly; a default would exist only to justify its own existence, not serve a
# real caller.
issue_should_advance_unchanged() {
    local item_id="$1" plan_approved="$2" has_plan_comment="$3"
    [ "${plan_approved}" = "true" ] || [ "${has_plan_comment}" != "true" ] || return 1
    load_issue_invocation_counts "${item_id}"
    [ "${ISSUE_INVOCATION_IDLE}" -lt "${MAX_ISSUE_IDLE_INVOCATIONS}" ]
}

# Returns 0 (true) if the pre-fetched PR JSON has at least one required check that has not yet
# reached a terminal result. Returns 1 (false) when statusCheckRollup is absent, empty, or every
# required entry is terminal. Non-required (optional) checks are ignored so they cannot gate agent
# invocation. Also returns 0 when annotate_pr_json_required_checks set requiredChecksNotYetReported
# (the base branch requires checks but none has reported on this commit): those required checks
# are pending even though no rollup entry stands for them. Right after a push that is a short wait.
# For a required workflow whose paths filter this PR does not match it never ends, but GitHub will
# not merge such a PR either, so the ci_checks_timed_out escalation to a human is the right outcome.
pr_json_has_pending_ci_checks() {
    local pr_json="$1"
    # statusCheckRollup mixes two GraphQL node types: CheckRun (modern GitHub Actions
    # checks, has .status) and StatusContext (legacy commit statuses, has only .state
    # and no .status at all). Treating a StatusContext's absent .status as "not
    # COMPLETED" makes it look pending forever, even once its .state is a terminal
    # SUCCESS/FAILURE/ERROR, so each entry is classified by which field it actually has.
    # A CheckRun's .status can be stale relative to its own terminal .conclusion: GitHub can
    # serve a node with status still IN_PROGRESS but conclusion already SUCCESS (and
    # completedAt set), a persistent inconsistency observed live, not a transient blip. Since
    # GitHub can desynchronise these two fields in one direction, nothing rules out the same kind
    # of inconsistency the other way, so pending requires BOTH fields to still say not-done
    # instead of trusting either one alone: whichever field reaches a terminal value first is
    # enough to call the check done. A genuine re-run still reads as pending, since it surfaces
    # as a new CheckRun node whose own conclusion starts out unset: null in raw GraphQL/REST, but
    # "" in `gh pr view --json statusCheckRollup` (what this is fed), so both count (#1483).
    printf '%s' "${pr_json}" | jq -e '
        .requiredChecksNotYetReported == true
        or ((.statusCheckRollup // [])
        | (length > 0) and any(.[];
            .isRequired != false
            and (
                if (.status != null)
                then .status != "COMPLETED" and ((.conclusion // "") == "")
                else ((.state // "") | . == "PENDING" or . == "EXPECTED")
                end
            )
        ))
    ' > /dev/null
}

# Posts a Blocked-marking comment and label when a PR's CI checks have been pending past the
# configured timeout, so a human is pulled in. The label is applied and VERIFIED first (see
# apply_blocked_label); the pending-CI state file is only cleared once the label is confirmed —
# otherwise the timeout clock is left alone so the NEXT tick re-attempts the escalation, rather
# than silently re-arming a fresh full-length wait every tick forever (#1092).
block_pr_for_ci_timeout() {
    local item_id="$1" item_repo="$2"
    local reason="CI checks have been pending for over ${CI_CHECK_TIMEOUT_MINUTES} minutes. Blocking this PR until a human investigates."
    info "PR #${item_id} in ${item_repo}: CI checks pending past ${CI_CHECK_TIMEOUT_MINUTES}-minute timeout — blocking"
    if ! apply_blocked_label_with_reason "PullRequest" "${item_id}" "${item_repo}" "${reason}"; then
        return 1
    fi
    clear_pr_ci_pending_state "${item_id}"
}

# Returns 0 (true) if the pre-fetched JSON contains a label named 'blocked' (case-insensitive).
_json_has_blocked_label() {
    local json="$1"
    printf '%s' "${json}" | jq -r '(.labels // [])[] | .name' | grep -qi '^blocked$'
}

# Returns 0 (true) if the pre-fetched PR JSON contains a label named 'blocked' (case-insensitive).
pr_json_has_blocked_label() {
    _json_has_blocked_label "$1"
}

# Extracts the image SHA an agent recorded when it self-diagnosed a Blocked-ing failure as an
# environment/infrastructure problem (#1118) — e.g. a missing tool in the container, not a bug in
# the PR's own code. The agent leaves a machine-readable trailer alongside its human-facing
# diagnosis comment:
#   <!-- orchestrator:env-block image-sha=<sha> -->
# Uses the LAST matching comment (not the first) so a later re-diagnosis on the same PR always
# wins over a stale one. Outputs the SHA on stdout; empty output (and non-zero status) if no PR
# comment carries the marker — the normal case for every other kind of Blocked.
pr_json_env_block_image_sha() {
    local pr_json="$1" sha
    sha=$(printf '%s' "${pr_json}" | jq -r '
        [.comments[]?.body // "" | capture("<!--\\s*orchestrator:env-block\\s+image-sha=(?<sha>[0-9a-f]+)\\s*-->").sha] | last // empty
    ' 2>/dev/null)
    [ -n "${sha}" ] || return 1
    printf '%s' "${sha}"
}

# Returns 0 (true) if the pre-fetched Issue JSON contains a label named 'blocked' (case-insensitive).
issue_json_has_blocked_label() {
    _json_has_blocked_label "$1"
}
